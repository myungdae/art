                                                        "http://www.w3.org/2001/XMLSchema#string"
                                                        >https://ko.wikipedia.org/wiki/%EB%B8%94%EB%A1%9D%EC%B2%B4%EC%9D%B8</Wiki>
                                                        <Keyword_Topic rdf:resource="http://silkroads.eventpool.kr/resource/아카이브_2.0_플랫폼을_지원하는_새로운_정보_통신_4대_기술"/>
                                                        <Keyword_Topic rdf:resource="http://silkroads.eventpool.kr/resource/아카이브_2.0_-_기록의_4대_속성_지원_기술_Block_Chain"/>
                                                        <skos:altLabel
                                                         rdf:datatype=
