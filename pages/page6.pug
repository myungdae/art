    style.
      /* 추가된 CSS 스타일 */
      body {
        font-family: Arial, sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        overflow-y: auto; /* 스크롤 추가 */
      }
      label {
        display: block;
        margin-top: 10px;
      }
      .hr-line {
        width: 100%;
        border-top: 1px solid #add8e6; /* 옅은 파란색으로 변경 */
        margin: 10px 0; /* 간격 조절 */
      }
      /* 추가된 CSS 스타일 */
      textarea#recordDesc {
        height: 100px; /* 높이를 조절하여 입력창 크기 조절 */
        width: 700px; /* 너비를 조절하여 입력창 크기 조절 */
      }
      .altLabelBox {
        display: flex;
        margin-top: 10px;
      }
      .altLabelBox input {
        margin-right: 5px;
      }
