      script.
        // JavaScript로 추가된 부분을 제어
        document.getElementById('addAltLabel').addEventListener('click', function() {
          var container = document.getElementById('altLabelContainer');
          var newBox = document.createElement('div');
          newBox.className = 'altLabelBox';
          newBox.innerHTML = '<input type="text" name="name" required><button type="button" class="removeAltLabel">- 제거</button>';
          container.appendChild(newBox);

          // 추가된 박스에서 제거 버튼을 눌렀을 때 해당 박스 제거
          newBox.querySelector('.removeAltLabel').addEventListener('click', function() {
            container.removeChild(newBox);
          });
        });

        // 이미지 드래그 앤 드롭 이벤트 처리
        function dragOverHandler(event) {
          event.preventDefault();
        }

        function dragEnterHandler(event) {
          event.preventDefault();
          document.getElementById('imageContainer').style.border = '2px dashed #aaa';
        }

        function dragLeaveHandler(event) {
          event.preventDefault();
          document.getElementById('imageContainer').style.border = '2px dashed #ddd';
        }

        function dropHandler(event) {
          event.preventDefault();
          var files = event.dataTransfer.files;
          handleFiles(files);
          document.getElementById('imageContainer').style.border = '2px dashed #ddd';
        }

        function handleFiles(files) {
          var fileList = document.getElementById('imageContainer');
          fileList.innerHTML = '';

          for (var i = 0; i < files.length; i++) {
            var file = files[i];
            var image = document.createElement('img');
            image.src = URL.createObjectURL(file);
            image.style.width = '100px';
            image.style.marginRight = '10px';
            fileList.appendChild(image);
          }
        }
