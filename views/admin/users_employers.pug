extends layout

block content
  style.
    .user-stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    
    .stat-card {
      background: white;
      border-radius: 12px;
      padding: 1.5rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      border-left: 3px solid #ef4444;
    }
    
    .stat-value {
      font-size: 2rem;
      font-weight: 800;
      color: #1e293b;
      margin-bottom: 0.5rem;
    }
    
    .stat-label {
      font-size: 0.875rem;
      color: #64748b;
      font-weight: 600;
    }
    
    .user-table-card {
      background: white;
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }
    
    .table-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }
    
    .table-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: #1e293b;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .filter-buttons {
      display: flex;
      gap: 0.5rem;
    }
    
    .filter-btn {
      padding: 0.5rem 1rem;
      border: 2px solid #e2e8f0;
      background: white;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .filter-btn.active {
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
      color: white;
      border-color: transparent;
    }
    
    .search-box {
      position: relative;
      margin-bottom: 1.5rem;
    }
    
    .search-box input {
      width: 100%;
      padding: 0.875rem 1rem 0.875rem 3rem;
      border: 2px solid #e2e8f0;
      border-radius: 12px;
    }
    
    .search-box i {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: #64748b;
    }
    
    .user-table {
      width: 100%;
      border-collapse: collapse;
    }
    
    .user-table thead th {
      background: #f8fafc;
      padding: 1rem;
      text-align: left;
      font-weight: 700;
      font-size: 0.75rem;
      text-transform: uppercase;
      color: #64748b;
      border-bottom: 2px solid #e2e8f0;
    }
    
    .user-table tbody tr {
      border-bottom: 1px solid #f1f5f9;
      transition: background 0.2s ease;
    }
    
    .user-table tbody tr:hover {
      background: #f8fafc;
    }
    
    .user-table tbody td {
      padding: 1rem;
      color: #475569;
    }
    
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 0.375rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      gap: 0.375rem;
    }
    
    .badge.active {
      background: #d1fae5;
      color: #059669;
    }
    
    .badge.inactive {
      background: #fee2e2;
      color: #dc2626;
    }
    
    .action-btn {
      padding: 0.5rem 0.75rem;
      border: none;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .delete-btn {
      background: #fee2e2;
      color: #dc2626;
    }
    
    .delete-btn:hover {
      background: #fecaca;
    }

  //- Statistics
  .user-stats-grid
    .stat-card
      .stat-value= stats.total
      .stat-label 
        i.fas.fa-briefcase.me-2
        | Total Employers
    .stat-card(style="border-left-color: #10b981;")
      .stat-value= stats.withCredits
      .stat-label 
        i.fas.fa-check-circle.me-2
        | With Credits
    .stat-card(style="border-left-color: #ef4444;")
      .stat-value= stats.withoutCredits
      .stat-label 
        i.fas.fa-times-circle.me-2
        | Without Credits
    .stat-card(style="border-left-color: #3b82f6;")
      .stat-value= stats.totalCredits
      .stat-label 
        i.fas.fa-ad.me-2
        | Total Ad Credits

  //- Employers Table
  .user-table-card
    .table-header
      h2.table-title
        i.fas.fa-briefcase(style="color: #ef4444;")
        | All Employers
      .filter-buttons
        button.filter-btn.active(data-filter="all") All
        button.filter-btn(data-filter="with-credits") With Credits
        button.filter-btn(data-filter="no-credits") No Credits
    
    .search-box
      i.fas.fa-search
      input#searchInput(type="text", placeholder="Search by username or email...")
    
    .table-responsive
      table.user-table
        thead
          tr
            th Username
            th Email
            th Ad Credits
            th Registered
            th Status
            th Actions
        tbody
          if employers && employers.length > 0
            each emp in employers
              tr(data-has-credits=emp.hasCredits ? 'true' : 'false')
                td= emp.username
                td= emp.email
                td
                  if emp.remainingTokens > 0
                    span.badge.active= emp.remainingTokens
                  else
                    span.badge.inactive 0
                td= emp.createdAtDisplay
                td
                  if emp.hasCredits
                    span.badge.active
                      i.fas.fa-check-circle
                      | Active
                  else
                    span.badge.inactive
                      i.fas.fa-times-circle
                      | No Credits
                td
                  button.action-btn.delete-btn(
                    onclick=`deleteUser('${emp.id}', '${emp.username}', '${emp.email}')`
                  )
                    i.fas.fa-trash.me-1
                    | Delete
          else
            tr
              td(colspan="6", style="text-align: center; padding: 3rem; color: #94a3b8;")
                i.fas.fa-inbox(style="font-size: 3rem; display: block; margin-bottom: 1rem;")
                div No employers found

  script.
    // Delete user function
    async function deleteUser(userId, username, email) {
      if (!confirm(`Are you sure you want to delete this employer?\n\nUsername: ${username}\nEmail: ${email}\n\nThis action cannot be undone.`)) {
        return;
      }
      
      try {
        const response = await fetch('/admin/delete-user', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            userId: userId,
            userType: 'employer'
          })
        });
        
        const result = await response.json();
        
        if (result.success) {
          alert('✅ Employer deleted successfully!');
          location.reload();
        } else {
          alert('❌ Failed to delete employer: ' + (result.message || 'Unknown error'));
        }
      } catch (error) {
        console.error('Delete error:', error);
        alert('❌ Failed to delete employer: ' + error.message);
      }
    }
    
    // Filter functionality
    document.addEventListener('DOMContentLoaded', function() {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const tableRows = document.querySelectorAll('.user-table tbody tr');
      
      filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          filterBtns.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          
          const filter = this.getAttribute('data-filter');
          
          tableRows.forEach(row => {
            if (filter === 'all') {
              row.style.display = '';
            } else if (filter === 'with-credits') {
              row.style.display = row.getAttribute('data-has-credits') === 'true' ? '' : 'none';
            } else if (filter === 'no-credits') {
              row.style.display = row.getAttribute('data-has-credits') === 'false' ? '' : 'none';
            }
          });
        });
      });
      
      // Search functionality
      const searchInput = document.getElementById('searchInput');
      if (searchInput) {
        searchInput.addEventListener('input', function() {
          const query = this.value.toLowerCase();
          
          tableRows.forEach(row => {
            const text = row.textContent.toLowerCase();
            const matches = text.includes(query);
            
            // Only show if matches search AND passes current filter
            const filterBtn = document.querySelector('.filter-btn.active');
            const filter = filterBtn.getAttribute('data-filter');
            const hasCredits = row.getAttribute('data-has-credits') === 'true';
            
            let showByFilter = true;
            if (filter === 'with-credits') showByFilter = hasCredits;
            if (filter === 'no-credits') showByFilter = !hasCredits;
            
            row.style.display = (matches && showByFilter) ? '' : 'none';
          });
        });
      }
    });
