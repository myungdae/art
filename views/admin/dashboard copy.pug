extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-4 Admin Dashboard

    p.text-end.mb-4
      strong Date: 
      | #{currentDate}

    hr

    // ✅ Job Vacancies Table
    h3.mb-3 Job Vacancies
    table.table.table-bordered
      thead
        tr
          th Username
          th Email
          th Remaining Tokens
          th Created At
      tbody
        each jv in jobVacancies
          tr
            td= jv.username || 'N/A'
            td= jv.email || 'N/A'
            td= (typeof jv.remainingTokens === 'number') ? jv.remainingTokens : 'N/A'
            td= jv.createdAt ? jv.createdAt.toDateString() : 'N/A'

    hr

    // ✅ Job Seekers Table
    h3.mt-5.mb-3 Job Seekers
    table.table.table-bordered
      thead
        tr
          th Username
          th Email
          th Remaining Days
          th Created At
      tbody
        each js in jobSeekers
          - const now = new Date();
          - const startDate = js.resumeAccess?.startDate ? new Date(js.resumeAccess.startDate) : null;
          - const durationDays = js.resumeAccess?.durationDays || 0;
          - const remainingDays = (startDate && durationDays) ? Math.max(0, Math.ceil((startDate.getTime() + durationDays * 86400000 - now.getTime()) / 86400000)) : 'N/A';
          tr
            td= js.username || 'N/A'
            td= js.email || 'N/A'
            td= remainingDays
            td= js.createdAt ? js.createdAt.toDateString() : 'N/A'

    hr

    // ✅ Online Tutors Table
    h3.mt-5.mb-3 Online Tutors
    table.table.table-bordered
      thead
        tr
          th Username
          th Email
          th Remaining Days
          th Created At
      tbody
        each tutor in tutors
          - const now = new Date();
          - const startDate = tutor.resumeAccess?.startDate ? new Date(tutor.resumeAccess.startDate) : null;
          - const durationDays = tutor.resumeAccess?.durationDays || 0;
          - const remainingDays = (startDate && durationDays) ? Math.max(0, Math.ceil((startDate.getTime() + durationDays * 86400000 - now.getTime()) / 86400000)) : 'N/A';
          tr
            td= tutor.username || 'N/A'
            td= tutor.email || 'N/A'
            td= remainingDays
            td= tutor.createdAt ? tutor.createdAt.toDateString() : 'N/A'
