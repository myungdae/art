extends layout

block content
  style.
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    
    .stat-card {
      background: white;
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      border-left: 4px solid;
      transition: all 0.3s ease;
    }
    
    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }
    
    .stat-card.employers {
      border-left-color: #ef4444;
    }
    
    .stat-card.job-seekers {
      border-left-color: #3b82f6;
    }
    
    .stat-card.tutors {
      border-left-color: #8b5cf6;
    }
    
    .stat-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }
    
    .stat-title {
      font-size: 1.125rem;
      font-weight: 600;
      color: #64748b;
    }
    
    .stat-number {
      font-size: 2.5rem;
      font-weight: 800;
      color: #1e293b;
      margin-bottom: 1rem;
    }
    
    .stat-details {
      display: flex;
      justify-content: space-between;
      padding-top: 1rem;
      border-top: 1px solid #f1f5f9;
    }
    
    .stat-detail-item {
      text-align: center;
    }
    
    .stat-detail-value {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1e293b;
    }
    
    .stat-detail-label {
      font-size: 0.75rem;
      color: #64748b;
      text-transform: uppercase;
      margin-top: 0.25rem;
    }
    
    .delete-btn {
      margin-top: 1rem;
      width: 100%;
      padding: 0.75rem;
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
      color: white;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .delete-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 12px rgba(239, 68, 68, 0.3);
    }

  .stats-grid
    //- Employers Card
    .stat-card.employers
      .stat-header
        .stat-title
          i.fas.fa-briefcase.me-2
          | Employers
      .stat-number= stats.employers.total || 0
      .stat-details
        .stat-detail-item
          .stat-detail-value= stats.employers.withCredits || 0
          .stat-detail-label With Credits
        .stat-detail-item
          .stat-detail-value= stats.employers.withoutCredits || 0
          .stat-detail-label No Credits
      if stats.employers.withoutCredits > 0
        button.delete-btn(onclick="deleteInactive('employers')")
          i.fas.fa-trash-alt.me-2
          | Delete All Without Credits (#{stats.employers.withoutCredits})
    
    //- Job Seekers Card
    .stat-card.job-seekers
      .stat-header
        .stat-title
          i.fas.fa-user-tie.me-2
          | Job Seekers
      .stat-number= stats.jobSeekers.total || 0
      .stat-details
        .stat-detail-item
          .stat-detail-value= stats.jobSeekers.active || 0
          .stat-detail-label Active
        .stat-detail-item
          .stat-detail-value= stats.jobSeekers.inactive || 0
          .stat-detail-label Inactive
      if stats.jobSeekers.inactive > 0
        button.delete-btn(onclick="deleteInactive('jobseekers')")
          i.fas.fa-trash-alt.me-2
          | Delete All Inactive (#{stats.jobSeekers.inactive})
    
    //- Online Tutors Card
    .stat-card.tutors
      .stat-header
        .stat-title
          i.fas.fa-chalkboard-teacher.me-2
          | Online Tutors
      .stat-number= stats.onlineTutors.total || 0
      .stat-details
        .stat-detail-item
          .stat-detail-value= stats.onlineTutors.active || 0
          .stat-detail-label Active
        .stat-detail-item
          .stat-detail-value= stats.onlineTutors.inactive || 0
          .stat-detail-label Inactive
      if stats.onlineTutors.inactive > 0
        button.delete-btn(onclick="deleteInactive('tutors')")
          i.fas.fa-trash-alt.me-2
          | Delete All Inactive (#{stats.onlineTutors.inactive})

  script.
    function deleteInactive(userType) {
      const typeNames = {
        'employers': 'Employers without credits',
        'jobseekers': 'Inactive Job Seekers',
        'tutors': 'Inactive Online Tutors'
      };
      
      const typeName = typeNames[userType] || userType;
      
      if (!confirm(`⚠️ WARNING: This will permanently delete all ${typeName}!\n\nAre you sure?`)) {
        return;
      }
      
      const btn = event.target.closest('button');
      const originalHTML = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Deleting...';
      
      fetch('/admin/delete-inactive', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userType })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          alert(`✅ Deleted ${data.deletedCount} ${typeName}`);
          window.location.reload();
        } else {
          alert('❌ Error: ' + (data.error || 'Failed to delete'));
          btn.disabled = false;
          btn.innerHTML = originalHTML;
        }
      })
      .catch(err => {
        alert('❌ Error: ' + err.message);
        btn.disabled = false;
        btn.innerHTML = originalHTML;
      });
    }
