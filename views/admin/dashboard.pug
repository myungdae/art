//- views/admin/dashboard.pug
extends ../layout

block content
  style.
    /* High-visibility filter buttons */
    .btn-group .btn {
      font-size: 1.1rem !important;
      font-weight: 700 !important;
      padding: 0.75rem 1.5rem !important;
      border: 2px solid #333 !important;
      margin: 0 0.25rem !important;
      transition: all 0.3s ease !important;
    }
    
    .btn-group .btn-primary {
      background-color: #007bff !important;
      color: white !important;
    }
    
    .btn-group .btn-outline-primary {
      background-color: white !important;
      color: #007bff !important;
      border-color: #007bff !important;
    }
    
    .btn-group .btn-outline-primary:hover {
      background-color: #e7f1ff !important;
    }
    
    .btn-group .btn-primary:hover {
      background-color: #0056b3 !important;
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }
    
    .btn-group .btn-primary.active,
    .btn-group .btn-primary:active {
      background-color: #28a745 !important;
      border-color: #28a745 !important;
      font-weight: 800 !important;
    }
    
    /* High-visibility delete buttons */
    .btn-danger {
      font-size: 1.15rem !important;
      font-weight: 700 !important;
      padding: 1rem 2rem !important;
      background-color: #dc3545 !important;
      color: white !important;
      border: 2px solid #c82333 !important;
      transition: all 0.3s ease !important;
    }
    
    .btn-danger:hover {
      background-color: #c82333 !important;
      transform: translateY(-2px);
      box-shadow: 0 6px 12px rgba(220, 53, 69, 0.4);
    }
    
    .btn-danger i {
      font-size: 1.2rem !important;
    }
    
    /* Delete button containers */
    .delete-container {
      display: none;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 2px solid #dc3545;
    }
    
    .delete-container.show {
      display: block;
    }
  
  .max-w-7xl.mx-auto.px-4.py-8
    // Header
    .flex.items-center.justify-between.mb-8
      div
        h1.text-3xl.font-bold.mb-2
          i.fas.fa-tachometer-alt.mr-2
          | Admin Dashboard
        p.text-sm.text-gray-500 Manage users, monitor access, and track statistics
      div.text-right
        a.btn.btn-sm.btn-outline-secondary(href='/admin/logout')
          i.fas.fa-sign-out-alt.mr-1
          | Logout

    // Summary Statistics
    .grid.grid-cols-1.md_grid-cols-3.gap-6.mb-10
      // Employers Card
      .bg-gradient-to-br.from-red-50.to-red-100.rounded-xl.shadow-lg.p-6
        .flex.items-center.justify-between.mb-4
          h3.text-lg.font-semibold.text-red-700
            i.fas.fa-briefcase.mr-2
            | Employers
          span.text-3xl.font-bold.text-red-600= stats.employers.total
        .space-y-2.text-sm
          .flex.justify-between
            span.text-gray-600 With Credits:
            span.font-semibold.text-green-600= stats.employers.withCredits
          .flex.justify-between
            span.text-gray-600 Without Credits:
            span.font-semibold.text-red-600= stats.employers.withoutCredits
        if stats.employers.withoutCredits > 0
          .mt-4.pt-4.border-t.border-red-200
            button.btn.btn-sm.btn-danger.w-full(onclick="deleteInactive('employers')")
              i.fas.fa-trash-alt.mr-1
              | Delete All Without Credits (#{stats.employers.withoutCredits})

      // Job Seekers Card
      .bg-gradient-to-br.from-green-50.to-green-100.rounded-xl.shadow-lg.p-6
        .flex.items-center.justify-between.mb-4
          h3.text-lg.font-semibold.text-green-700
            i.fas.fa-users.mr-2
            | Job Seekers
          span.text-3xl.font-bold.text-green-600= stats.jobSeekers.total
        .space-y-2.text-sm
          .flex.justify-between
            span.text-gray-600 Active Access:
            span.font-semibold.text-green-600= stats.jobSeekers.active
          .flex.justify-between
            span.text-gray-600 Inactive:
            span.font-semibold.text-red-600= stats.jobSeekers.inactive
        if stats.jobSeekers.inactive > 0
          .mt-4.pt-4.border-t.border-green-200
            button.btn.btn-sm.btn-danger.w-full(onclick="deleteInactive('jobseekers')")
              i.fas.fa-trash-alt.mr-1
              | Delete All Inactive (#{stats.jobSeekers.inactive})

      // Online Tutors Card
      .bg-gradient-to-br.from-blue-50.to-blue-100.rounded-xl.shadow-lg.p-6
        .flex.items-center.justify-between.mb-4
          h3.text-lg.font-semibold.text-blue-700
            i.fas.fa-chalkboard-teacher.mr-2
            | Online Tutors
          span.text-3xl.font-bold.text-blue-600= stats.onlineTutors.total
        .space-y-2.text-sm
          .flex.justify-between
            span.text-gray-600 Active Access:
            span.font-semibold.text-green-600= stats.onlineTutors.active
          .flex.justify-between
            span.text-gray-600 Inactive:
