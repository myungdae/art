extends ../layout

block content
  h1.text-center.mb-4 Admin Dashboard

  // ✅ Employers
  h2.text-danger.mt-4 Employers
  if employers && employers.length
    table.table.table-striped
      thead
        tr
          th Username
          th Email
          th Remaining Tokens
          th Created At
      tbody
        each emp in employers
          tr
            td= emp.username || 'N/A'
            td= emp.email || 'N/A'
            td= emp.adsAvailable !== undefined ? emp.adsAvailable : 'N/A'
            td= emp.createdAt || 'N/A'
  else
    p.text-muted No active Employers found

  // ✅ Job Seekers
  h2.text-success.mt-5 Job Seekers
  if jobSeekers && jobSeekers.length
    table.table.table-striped
      thead
        tr
          th Username
          th Email
          th Remaining Days
          th Created At
      tbody
        each js in jobSeekers
          tr
            td= js.username || 'N/A'
            td= js.email || 'N/A'
            td= js.remainingDays !== undefined ? js.remainingDays : 'N/A'
            td= js.createdAt || 'N/A'
  else
    p.text-muted No active Job Seekers found

  // ✅ Online Tutors
  h2.text-primary.mt-5 Online Tutors
  if onlineTutors && onlineTutors.length
    table.table.table-striped
      thead
        tr
          th Username
          th Email
          th Remaining Days
          th Created At
      tbody
        each ot in onlineTutors
          tr
            td= ot.username || 'N/A'
            td= ot.email || 'N/A'
            td= ot.remainingDays !== undefined ? ot.remainingDays : 'N/A'
            td= ot.createdAt || 'N/A'
  else
    p.text-muted No active Online Tutors found
