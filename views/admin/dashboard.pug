extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-4 Admin Dashboard

    // ✅ EMPLOYERS
    h4.mb-3.text-primary Employers
    table.table.table-bordered.table-striped
      thead
        tr
          th Username
          th Email
          th Remaining Tokens
          th Created At
      tbody
        each emp in employers
          tr
            td= emp.username || 'N/A'
            td= emp.email || 'N/A'
            td= emp.adsAvailable !== undefined ? emp.adsAvailable : 'N/A'
            td= emp.createdAt ? new Date(emp.createdAt).toLocaleDateString() : 'N/A'

    // ✅ JOB SEEKERS
    h4.mt-5.mb-3.text-success Job Seekers
    table.table.table-bordered.table-striped
      thead
        tr
          th Username
          th Email
          th Remaining Days
          th Created At
      tbody
        each js in jobSeekers
          - const now = new Date();
          - const startDate = js.resumeAccess?.startDate ? new Date(js.resumeAccess.startDate) : null;
          - const durationDays = js.resumeAccess?.durationDays || 0;
          - const remainingDays = (startDate && durationDays) ? Math.max(0, Math.ceil((startDate.getTime() + durationDays * 86400000 - now.getTime()) / 86400000)) : 'N/A';
          tr
            td= js.username || 'N/A'
            td= js.email || 'N/A'
            td= remainingDays
            td= js.createdAt ? new Date(js.createdAt).toLocaleDateString() : 'N/A'

    // ✅ ONLINE TUTORS
    h4.mt-5.mb-3.text-info Online Tutors
    table.table.table-bordered.table-striped
      thead
        tr
          th Username
          th Email
          th Remaining Days
          th Created At
      tbody
        each ot in onlineTutors
          - const now = new Date();
          - const startDate = ot.resumeAccess?.startDate ? new Date(ot.resumeAccess.startDate) : null;
          - const durationDays = ot.resumeAccess?.durationDays || 0;
          - const remainingDays = (startDate && durationDays) ? Math.max(0, Math.ceil((startDate.getTime() + durationDays * 86400000 - now.getTime()) / 86400000)) : 'N/A';
          tr
            td= ot.username || 'N/A'
            td= ot.email || 'N/A'
            td= remainingDays
            td= ot.createdAt ? new Date(ot.createdAt).toLocaleDateString() : 'N/A'
