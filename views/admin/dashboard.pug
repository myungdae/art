                th.sortable.border.px-4.py-3.text-center.cursor-pointer.hover_bg-gray-200(data-key="remainingTokens")
                  | Ad Credits 
                  i.fas.fa-sort.ml-1.text-gray-400
                th.sortable.border.px-4.py-3.text-left.cursor-pointer.hover_bg-gray-200(data-key="createdAtDisplay")
                  | Registered 
                  i.fas.fa-sort.ml-1.text-gray-400
