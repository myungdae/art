extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-4 Admin Dashboard

    .row.mb-4
      .col-md-4
        .card.text-white.bg-primary.mb-3
          .card-header Job Vacancies
          .card-body
            h5.card-title= jobVacancyCount
            p.card-text Total Job Ads

      .col-md-4
        .card.text-white.bg-success.mb-3
          .card-header Job Seekers
          .card-body
            h5.card-title= jobSeekerCount
            p.card-text Total Job Seekers

      .col-md-4
        .card.text-white.bg-info.mb-3
          .card-header Tutors
          .card-body
            h5.card-title= tutorCount
            p.card-text Total Tutors

    h3.mt-5 Job Seekers with Resume Board Access

    table.table.table-striped
      thead
        tr
          th Username
          th Email
          th Remaining Days
      tbody
        each js in jobSeekers
          - const msPerDay = 1000 * 60 * 60 * 24;
          - const now = new Date();
          - let remaining = 'N/A';
          - if (js.resumeAccess && js.resumeAccess.startDate && js.resumeAccess.durationDays) {
          -   const endDate = new Date(js.resumeAccess.startDate).getTime() + js.resumeAccess.durationDays * msPerDay;
          -   remaining = Math.max(0, Math.ceil((endDate - now.getTime()) / msPerDay));
          - }
          tr
            td= js.username
            td= js.email
            td= remaining

    h3.mt-5 Online Tutors with Resume Board Access

    table.table.table-striped
      thead
        tr
          th Username
          th Email
          th Remaining Days
      tbody
        each tutor in tutors
          - const msPerDay = 1000 * 60 * 60 * 24;
          - const now = new Date();
          - let remaining = 'N/A';
          - if (tutor.resumeAccess && tutor.resumeAccess.startDate && tutor.resumeAccess.durationDays) {
          -   const endDate = new Date(tutor.resumeAccess.startDate).getTime() + tutor.resumeAccess.durationDays * msPerDay;
          -   remaining = Math.max(0, Math.ceil((endDate - now.getTime()) / msPerDay));
          - }
          tr
            td= tutor.username
            td= tutor.email
            td= remaining
