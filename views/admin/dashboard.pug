extends ../layout

block content
  .container
    .d-flex.justify-content-between.align-items-center.mb-4
      h2.mb-0 Admin Dashboard
      a.btn.btn-outline-danger(href="/admin/logout") Logout

    if jobs.length === 0
      p.mt-3 No job vacancies available.
    else
      table.table.table-striped.mt-4
        thead
          tr
            th Title
            th Country
            th Student Type
            th Teaching Area
            th Date Posted
            th Email
            th Actions
        tbody
          each job in jobs
            tr
              td= job.title
              td= job.country
              td= job.studentType
              td= job.teachingArea
              td= job.datePosted ? job.datePosted.toISOString().slice(0, 10) : ''
              td= job.email
              td
                form(method='POST', action=`/admin/delete/${job._id}`)
                  button.btn.btn-sm.btn-danger(type='submit') Delete
