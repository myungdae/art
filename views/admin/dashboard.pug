extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-4 Admin Dashboard

    .row.text-center
      .col-md-4.mb-4
        .card.border-info
          .card-body
            h5.card-title Job Vacancies
            p.card-text.text-primary #{jobVacancyCount}

      .col-md-4.mb-4
        .card.border-success
          .card-body
            h5.card-title Job Seekers
            p.card-text.text-success #{jobSeekerCount}

      .col-md-4.mb-4
        .card.border-warning
          .card-body
            h5.card-title Online Tutors
            p.card-text.text-warning #{tutorCount}

    hr
    .text-center.mt-3
      small.text-muted Data as of #{currentDate}
