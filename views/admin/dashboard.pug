extends ../layout

block content
  .container.mt-5
    h1.text-center.mb-5 Admin Dashboard

    .row.text-center.mb-4
      .col-md-4
        .card.shadow
          .card-header.bg-danger.text-white Job Vacancies
          .card-body
            h2= jobVacancyCount

      .col-md-4
        .card.shadow
          .card-header.bg-success.text-white Job Seekers
          .card-body
            h2= jobSeekerCount

      .col-md-4
        .card.shadow
          .card-header.bg-warning.text-white Online Tutors
          .card-body
            h2= tutorCount

    // ✅ Job Vacancies Table
    h3.mt-5.mb-3 Job Vacancies
    table.table.table-bordered
      thead
        tr
          th Username
          th Email
          th Remaining Tokens
          th Date Registered
      tbody
        each job in jobVacancies
          tr
            td= job.username || 'N/A'
            td= job.email || 'N/A'
            td= (typeof job.remainingTokens === 'number') ? job.remainingTokens : 'N/A'
            td= job.createdAt ? new Date(job.createdAt).toLocaleDateString() : 'N/A'

    // ✅ Job Seekers Table
    h3.mt-5.mb-3 Job Seekers
    table.table.table-bordered
      thead
        tr
          th Username
          th Email
          th Remaining Days
          th Date Registered
      tbody
        each js in jobSeekers
          - const start = js.resumeAccess?.startDate ? new Date(js.resumeAccess.startDate) : null
          - const duration = js.resumeAccess?.durationDays || 0
          - const remainingDays = (start) ? Math.max(0, Math.ceil((start.getTime() + duration * 86400000 - Date.now()) / 86400000)) : 'N/A'
          tr
            td= js.username || 'N/A'
            td= js.email || 'N/A'
            td= typeof remainingDays === 'number' ? remainingDays + ' days' : 'N/A'
            td= js.createdAt ? new Date(js.createdAt).toLocaleDateString() : 'N/A'

    // ✅ Online Tutors Table
    h3.mt-5.mb-3 Online Tutors
    table.table.table-bordered
      thead
        tr
          th Username
          th Email
          th Remaining Days
          th Date Registered
      tbody
        each tutor in tutors
          - const start = tutor.resumeAccess?.startDate ? new Date(tutor.resumeAccess.startDate) : null
          - const duration = tutor.resumeAccess?.durationDays || 0
          - const remainingDays = (start) ? Math.max(0, Math.ceil((start.getTime() + duration * 86400000 - Date.now()) / 86400000)) : 'N/A'
          tr
            td= tutor.username || 'N/A'
            td= tutor.email || 'N/A'
            td= typeof remainingDays === 'number' ? remainingDays + ' days' : 'N/A'
            td= tutor.createdAt ? new Date(tutor.createdAt).toLocaleDateString() : 'N/A'
