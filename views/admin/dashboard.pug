extends layout

block content
  //- Chart.js 추가
  script(src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js")
  
  style.
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    
    .stat-card {
      background: white;
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      border-left: 4px solid;
      transition: all 0.3s ease;
    }
    
    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }
    
    .stat-card.employers {
      border-left-color: #ef4444;
    }
    
    .stat-card.job-seekers {
      border-left-color: #3b82f6;
    }
    
    .stat-card.tutors {
      border-left-color: #8b5cf6;
    }
    
    .stat-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }
    
    .stat-title {
      font-size: 1.125rem;
      font-weight: 600;
      color: #64748b;
    }
    
    .stat-number {
      font-size: 2.5rem;
      font-weight: 800;
      color: #1e293b;
      margin-bottom: 1rem;
    }
    
    .stat-details {
      display: flex;
      justify-content: space-between;
      padding-top: 1rem;
      border-top: 1px solid #f1f5f9;
    }
    
    .stat-detail-item {
      text-align: center;
    }
    
    .stat-detail-value {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1e293b;
    }
    
    .stat-detail-label {
      font-size: 0.75rem;
      color: #64748b;
      text-transform: uppercase;
      margin-top: 0.25rem;
    }
    
    .delete-btn {
      margin-top: 1rem;
      width: 100%;
      padding: 0.75rem;
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
      color: white;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .delete-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 12px rgba(239, 68, 68, 0.3);
    }
    
    .quick-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    
    .quick-stat-item {
      background: white;
      border-radius: 12px;
      padding: 1.5rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      border-left: 3px solid #3b82f6;
      transition: transform 0.2s ease;
    }
    
    .quick-stat-item:hover {
      transform: translateY(-2px);
    }
    
    .quick-stat-value {
      font-size: 2rem;
      font-weight: 800;
      color: #1e293b;
      margin-bottom: 0.5rem;
    }
    
    .quick-stat-label {
      font-size: 0.875rem;
      color: #64748b;
      font-weight: 500;
    }
    
    .chart-container {
      background: white;
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      margin-bottom: 2rem;
      height: 400px;
    }
    
    .chart-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
    }
    
    .charts-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

  //- Quick Stats Summary
  .quick-stats
    .quick-stat-item
      .quick-stat-value= (stats.employers.total || 0) + (stats.jobSeekers.total || 0) + (stats.onlineTutors.total || 0)
      .quick-stat-label 
        i.fas.fa-users.me-2
        | Total Users
    .quick-stat-item
      .quick-stat-value= (stats.employers.withCredits || 0) + (stats.jobSeekers.active || 0) + (stats.onlineTutors.active || 0)
      .quick-stat-label 
        i.fas.fa-check-circle.me-2
        | Active Users
    .quick-stat-item
      .quick-stat-value= (stats.employers.withoutCredits || 0) + (stats.jobSeekers.inactive || 0) + (stats.onlineTutors.inactive || 0)
      .quick-stat-label 
        i.fas.fa-times-circle.me-2
        | Inactive Users
    .quick-stat-item
      - const totalUsers = (stats.employers.total || 0) + (stats.jobSeekers.total || 0) + (stats.onlineTutors.total || 0)
      - const activeUsers = (stats.employers.withCredits || 0) + (stats.jobSeekers.active || 0) + (stats.onlineTutors.active || 0)
      - const activeRate = totalUsers > 0 ? ((activeUsers / totalUsers) * 100).toFixed(1) : 0
      .quick-stat-value #{activeRate}%
      .quick-stat-label 
        i.fas.fa-chart-line.me-2
        | Active Rate

  //- Charts Section
  .charts-row
    .chart-container
      h3.chart-title
        i.fas.fa-chart-pie.me-2
        | User Distribution
      canvas#userDistributionChart
    .chart-container
      h3.chart-title
        i.fas.fa-chart-bar.me-2
        | Active vs Inactive
      canvas#activeInactiveChart

  //- Detailed Stats Grid
  .stats-grid
    //- Employers Card
    .stat-card.employers
      .stat-header
        .stat-title
          i.fas.fa-briefcase.me-2
          | Employers
      .stat-number= stats.employers.total || 0
      .stat-details
        .stat-detail-item
          .stat-detail-value= stats.employers.withCredits || 0
          .stat-detail-label With Credits
        .stat-detail-item
          .stat-detail-value= stats.employers.withoutCredits || 0
          .stat-detail-label No Credits
      if stats.employers.withoutCredits > 0
        button.delete-btn(onclick="deleteInactive('employers')")
          i.fas.fa-trash-alt.me-2
          | Delete All Without Credits (#{stats.employers.withoutCredits})
    
    //- Job Seekers Card
    .stat-card.job-seekers
      .stat-header
        .stat-title
          i.fas.fa-user-tie.me-2
          | Job Seekers
      .stat-number= stats.jobSeekers.total || 0
      .stat-details
        .stat-detail-item
          .stat-detail-value= stats.jobSeekers.active || 0
          .stat-detail-label Active
        .stat-detail-item
          .stat-detail-value= stats.jobSeekers.inactive || 0
          .stat-detail-label Inactive
      if stats.jobSeekers.inactive > 0
        button.delete-btn(onclick="deleteInactive('jobseekers')")
          i.fas.fa-trash-alt.me-2
          | Delete All Inactive (#{stats.jobSeekers.inactive})
    
    //- Online Tutors Card
    .stat-card.tutors
      .stat-header
        .stat-title
          i.fas.fa-chalkboard-teacher.me-2
          | Online Tutors
      .stat-number= stats.onlineTutors.total || 0
      .stat-details
        .stat-detail-item
          .stat-detail-value= stats.onlineTutors.active || 0
          .stat-detail-label Active
        .stat-detail-item
          .stat-detail-value= stats.onlineTutors.inactive || 0
          .stat-detail-label Inactive
      if stats.onlineTutors.inactive > 0
        button.delete-btn(onclick="deleteInactive('tutors')")
          i.fas.fa-trash-alt.me-2
          | Delete All Inactive (#{stats.onlineTutors.inactive})

  script.
    function deleteInactive(userType) {
      const typeNames = {
        'employers': 'Employers without credits',
        'jobseekers': 'Inactive Job Seekers',
        'tutors': 'Inactive Online Tutors'
      };
      
      const typeName = typeNames[userType] || userType;
      
      if (!confirm(`⚠️ WARNING: This will permanently delete all ${typeName}!\n\nAre you sure?`)) {
        return;
      }
      
      const btn = event.target.closest('button');
      const originalHTML = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Deleting...';
      
      fetch('/admin/delete-inactive', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userType })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          alert(`✅ Deleted ${data.deletedCount} ${typeName}`);
          window.location.reload();
        } else {
          alert('❌ Error: ' + (data.error || 'Failed to delete'));
          btn.disabled = false;
          btn.innerHTML = originalHTML;
        }
      })
      .catch(err => {
        alert('❌ Error: ' + err.message);
        btn.disabled = false;
        btn.innerHTML = originalHTML;
      });
    }
    
    // Chart.js 차트 생성
    document.addEventListener('DOMContentLoaded', function() {
      // User Distribution Pie Chart
      const userDistCtx = document.getElementById('userDistributionChart');
      if (userDistCtx) {
        new Chart(userDistCtx, {
          type: 'doughnut',
          data: {
            labels: ['Employers', 'Job Seekers', 'Online Tutors'],
            datasets: [{
              data: [
                #{stats.employers.total || 0},
                #{stats.jobSeekers.total || 0},
                #{stats.onlineTutors.total || 0}
              ],
              backgroundColor: ['#ef4444', '#3b82f6', '#8b5cf6'],
              borderWidth: 2,
              borderColor: '#fff'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: {
                  padding: 15,
                  font: {
                    size: 12,
                    weight: 600
                  }
                }
              }
            }
          }
        });
      }
      
      // Active vs Inactive Bar Chart
      const activeInactiveCtx = document.getElementById('activeInactiveChart');
      if (activeInactiveCtx) {
        new Chart(activeInactiveCtx, {
          type: 'bar',
          data: {
            labels: ['Employers', 'Job Seekers', 'Tutors'],
            datasets: [
              {
                label: 'Active',
                data: [
                  #{stats.employers.withCredits || 0},
                  #{stats.jobSeekers.active || 0},
                  #{stats.onlineTutors.active || 0}
                ],
                backgroundColor: '#10b981',
                borderRadius: 8
              },
              {
                label: 'Inactive',
                data: [
                  #{stats.employers.withoutCredits || 0},
                  #{stats.jobSeekers.inactive || 0},
                  #{stats.onlineTutors.inactive || 0}
                ],
                backgroundColor: '#ef4444',
                borderRadius: 8
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: {
                  padding: 15,
                  font: {
                    size: 12,
                    weight: 600
                  }
                }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  stepSize: 1
                }
              }
            }
          }
        });
      }
    });
