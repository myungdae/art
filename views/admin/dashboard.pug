        | Click column headers to sort. Use search boxes and filter buttons to refine results.
      p.mt-1 All times are in KST (UTC+9). Last updated: #{new Date(Date.now() + 9*60*60*1000).toISOString().replace('T',' ').slice(0,16)}

  // =============== Client-side Search, Sort & Filter Script ===============
  script.
    (function(){
      // Utility functions
      function text(row, idx){
        const cell = row.children[idx];
        return (cell ? cell.textContent : '').trim();
      }
      
      function parseNumber(v){
        const n = Number(String(v).replace(/[^0-9.-]/g,''));
        return isNaN(n) ? null : n;
      }
      
      function compare(a, b, keyIdx, numeric){
        const av = text(a, keyIdx);
        const bv = text(b, keyIdx);
        if (numeric){
          const an = parseNumber(av), bn = parseNumber(bv);
          if (an === null && bn === null) return 0;
          if (an === null) return -1;
          if (bn === null) return 1;
          return an - bn;
        }
        return av.localeCompare(bv);
      }
      
      function applySort(tableId, th, dir){
        const table = document.getElementById(tableId);
        if (!table) return;
        const thead = table.querySelector('thead tr');
        const headers = Array.from(thead.children);
        const keyIdx = headers.indexOf(th);
        const numeric = /(Days|Credits|Tokens)/i.test(th.textContent);
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.children);
        rows.sort((r1, r2) => {
          const c = compare(r1, r2, keyIdx, numeric);
          return dir === 'asc' ? c : -c;
        });
        rows.forEach(r => tbody.appendChild(r));
        
        // Visual feedback
        headers.forEach(h => h.classList.remove('bg-gray-200'));
        th.classList.add('bg-gray-200');
      }
      
      function applyFilter(tableId, inputId, countId, statusFilter, deleteContainerId){
        console.log('applyFilter called:', tableId, statusFilter);
        const q = (document.getElementById(inputId)?.value || '').toLowerCase();
        const table = document.getElementById(tableId);
        if (!table) {
          console.error('Table not found:', tableId);
          return;
        }
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.children);
        let shown = 0;
        let inactiveCount = 0;
        
        console.log('Total rows:', rows.length);
        
        rows.forEach(row => {
          const cells = Array.from(row.children).map(td => td.textContent.toLowerCase());
          const textMatch = !q || cells.some(v => v.includes(q));
          
          let statusMatch = true;
          if (statusFilter === 'active') {
            statusMatch = row.dataset.isActive === 'true' || row.dataset.hasCredits === 'true';
          } else if (statusFilter === 'inactive') {
            statusMatch = row.dataset.isActive === 'false' || row.dataset.hasCredits === 'false';
            if (statusMatch && textMatch) inactiveCount++;
          } else if (statusFilter === 'with-credits') {
            statusMatch = row.dataset.hasCredits === 'true';
          } else if (statusFilter === 'no-credits') {
            statusMatch = row.dataset.hasCredits === 'false';
            if (statusMatch && textMatch) inactiveCount++;
          }
          
          const show = textMatch && statusMatch;
          row.style.display = show ? '' : 'none';
          if (show) shown++;
        });
        
        console.log('Shown rows:', shown, 'Inactive count:', inactiveCount);
        
        if (countId){
          const el = document.getElementById(countId);
          if (el) el.textContent = shown + ' / ' + rows.length + ' rows';
        }
        
        // Show/hide delete button
        if (deleteContainerId) {
          const deleteContainer = document.getElementById(deleteContainerId);
          if (deleteContainer) {
            if ((statusFilter === 'inactive' || statusFilter === 'no-credits') && inactiveCount > 0) {
              deleteContainer.classList.add('show');
              const countSpan = deleteContainer.querySelector('span[id$="DeleteCount"]');
              if (countSpan) countSpan.textContent = ' (' + inactiveCount + ')';
            } else {
              deleteContainer.classList.remove('show');
            }
          }
        }
      }
      
      function wire(tableId, inputId, countId, filterButtons, deleteContainerId){
        let currentFilter = 'all';
        
        // Sort functionality
        const table = document.getElementById(tableId);
        if (!table) return;
        const thead = table.querySelector('thead');
        if (thead){
          Array.from(thead.querySelectorAll('th.sortable')).forEach(th => {
            let dir = 'asc';
            th.addEventListener('click', () => {
              applySort(tableId, th, dir);
              dir = (dir === 'asc') ? 'desc' : 'asc';
            });
          });
        }
        
        // Search functionality
        const input = document.getElementById(inputId);
        if (input){
          let t;
          input.addEventListener('input', () => {
            clearTimeout(t);
            t = setTimeout(() => applyFilter(tableId, inputId, countId, currentFilter, deleteContainerId), 200);
          });
        }
        
        // Filter buttons
        if (filterButtons) {
          filterButtons.forEach(({id, filter}) => {
            const btn = document.getElementById(id);
            if (btn) {
              btn.addEventListener('click', () => {
                console.log('Filter button clicked:', id, filter);
                currentFilter = filter;
                
                // Update button styles
                filterButtons.forEach(fb => {
                  const b = document.getElementById(fb.id);
                  if (b) {
                    b.classList.remove('btn-primary');
                    b.classList.add('btn-outline-primary');
                  }
                });
                btn.classList.remove('btn-outline-primary');
                btn.classList.add('btn-primary');
                
                console.log('Applying filter:', currentFilter);
                // Apply filter
                applyFilter(tableId, inputId, countId, currentFilter, deleteContainerId);
              });
            } else {
              console.error('Button not found:', id);
            }
          });
        }
        
        // Initial count
        applyFilter(tableId, inputId, countId, currentFilter, deleteContainerId);
      }
      
      // Wire all three tables
      wire('empTable', 'empSearch', 'empCount', [
        {id: 'empFilterAll', filter: 'all'},
        {id: 'empFilterWithCredits', filter: 'with-credits'},
        {id: 'empFilterNoCredits', filter: 'no-credits'}
      ], 'empDeleteContainer');
      
      wire('jsTable', 'jsSearch', 'jsCount', [
        {id: 'jsFilterAll', filter: 'all'},
        {id: 'jsFilterActive', filter: 'active'},
        {id: 'jsFilterInactive', filter: 'inactive'}
      ], 'jsDeleteContainer');
      
      wire('otTable', 'otSearch', 'otCount', [
        {id: 'otFilterAll', filter: 'all'},
        {id: 'otFilterActive', filter: 'active'},
        {id: 'otFilterInactive', filter: 'inactive'}
      ], 'otDeleteContainer');
    })();
    
    // =============== Delete Inactive Users Function ===============
    function deleteInactive(userType) {
      const typeNames = {
        'employers': 'Employers without credits',
        'jobseekers': 'Inactive Job Seekers',
        'tutors': 'Inactive Online Tutors'
      };
      
      const typeName = typeNames[userType] || userType;
      
      if (!confirm(`⚠️ WARNING: This will permanently delete all ${typeName}!\n\nAre you sure you want to continue?`)) {
        return;
      }
      
      // Show loading state
      const btn = event.target.closest('button');
      const originalHTML = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Deleting...';
      
      // Send delete request
      fetch('/admin/delete-inactive', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ userType })
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          alert(`✅ Success!\n\nDeleted ${data.deletedCount} ${typeName}\n\n${data.deletedUsers.length > 0 ? 'Deleted users:\n' + data.deletedUsers.join('\n') : ''}`);
          // Reload page to reflect changes
          window.location.reload();
        } else {
          alert('❌ Error: ' + (data.error || 'Failed to delete users'));
          btn.disabled = false;
          btn.innerHTML = originalHTML;
        }
      })
      .catch(error => {
        console.error('Delete error:', error);
        alert('❌ Error: ' + error.message);
        btn.disabled = false;
        btn.innerHTML = originalHTML;
      });
