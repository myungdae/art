//- views/home.pug
extends layout

block home_below_search
  style.
    .stat-spinner{width:18px;height:18px;border:2px solid #e5e7eb;border-top-color:#f97316;border-radius:50%;animation:spin .8s linear infinite;display:inline-block;vertical-align:middle}
    @keyframes spin{to{transform:rotate(360deg)}}
    .hide{display:none}
    .stat-number { color: #FF7A00; font-size: 50px; }
    .stat-card {
      background: #F2F2F2;
      border: 1px solid #FFEDD5;
      border-radius: 20px;
      width: 400px; height: 240px;
      display: flex; flex-direction: column; justify-content: center;
      box-shadow: 0 18px 40px rgba(0,0,0,.06);
    }
    .stat-card:hover{background:#FFEAD5;box-shadow:0 22px 46px rgba(249,115,22,.12)}
    .stat-label{color:#6b7280; font-size:20px; font-weight: 400; padding-top: 20px;}
    .home-stats-belt{ margin-top: 18px; }

    @media (max-width: 1200px){
      .stat-card{ width: 360px; height: 220px; }
    }
    @media (max-width: 992px){
      .stat-card{ width: 320px; height: 200px; }
    }
    @media (max-width: 768px){
      .stat-card{ width: 90vw; height: 180px; }
    }

    /* --- Promo Modal styles --- */
    .promo-backdrop {
      position: fixed; inset: 0; background: rgba(15, 23, 42, 0.55);
      z-index: 60; display: flex; align-items: center; justify-content: center;
      padding: 20px;
    }
    .promo-card {
      background: #fff; border-radius: 16px; max-width: 720px; width: 100%;
      box-shadow: 0 22px 60px rgba(0,0,0,.25); overflow: hidden;
    }
    .promo-header {
      padding: 18px 22px; background: #EEF2FF; border-bottom: 1px solid #E5E7EB;
    }
    .promo-body { padding: 18px 22px; }
    .promo-footer
    a.btn.btn-primary.btn-lg(href="/promo/start") Get Started
    button.btn.btn-lg(type="button" data-promo-close) Close
    
    .btn { padding: 10px 14px; border-radius: 10px; border: 1px solid #E5E7EB; background: #fff; cursor: pointer; font-weight: 600; }
    .btn-primary { background: #FF7A00; border-color: #FF7A00; color: #fff; }
    .btn-lg { padding: 14px 22px; font-size: 16px; border-radius: 12px; }


  - var S = (typeof stats === 'object' && stats) || {};

// --- Promo Modal (first visit during free window) ---
  if freeNow
    #promoModal.promo-backdrop.hide(data-key="promo-2025-modal-v1")
      .promo-card
        .promo-header
          h3(style="margin:0;font-weight:800;color:#111827") Year-end Free Registration
        .promo-body
          p(style="margin:0 0 10px 0;color:#374151")
            | Enjoy free access until #{freeUntilStr}. Here’s what you get:
          ul(style="margin:0 0 12px 18px;color:#111827")
            li Employers: 1 free job posting token (no payment required)
            li Job Seekers: profile listed free for 90 days
            li Online Tutors: profile listed free for 90 days
          p(style="margin:8px 0 0 0;color:#6B7280;font-size:12px")
            | Posts remain after the promo; expired items are simply hidden from search.
        .promo-footer
          a.btn.btn-primary.btn-lg(href="/promo/start") Get Started
          button.btn.btn-lg(type="button" data-promo-close) Close


  section.home-stats-belt
    div(class="d-flex flex-column flex-md-row align-items-center justify-content-center gap-3 gap-md-4")
      a(href="/facet/Job_Vacancies" class="stat-card text-center px-4 transition transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-orange-400" aria-label="Job Vacancies")
        .d-flex.align-items-center.justify-content-center.gap-3
          span#spin-v.stat-spinner
          div#stat-v.stat-number= (S.vCount != null ? S.vCount : 0)
        div.stat-label.mt-1 Job Vacancies

      a(href="/facet/Job_Seekers" class="stat-card text-center px-4 transition transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-orange-400" aria-label="Job Seekers")
        .d-flex.align-items-center.justify-content-center.gap-3
          span#spin-s.stat-spinner
          div#stat-s.stat-number= (S.sCount != null ? S.sCount : 0)
        div.stat-label.mt-1 Job Seekers

      a(href="/facet/Online_Tutors" class="stat-card text-center px-4 transition transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-orange-400" aria-label="Online Tutors")
        .d-flex.align-items-center.justify-content-center.gap-3
          span#spin-t.stat-spinner
          div#stat-t.stat-number= (S.tCount != null ? S.tCount : 0)
        div.stat-label.mt-1 Online Tutors

block content
  - var enc = encodeURIComponent;
  - var RV = Array.isArray(recentVacancies) ? recentVacancies : [];
  - var RS = Array.isArray(recentSeekers) ? recentSeekers : [];
  - var RT = Array.isArray(recentTutors) ? recentTutors : [];

  .container.mx-auto.max-w-6xl.py-10
    .text-center.mb-10
      h1(class="text-4xl font-extrabold mb-3" style="font-size: 50px;")
        span(style="color: #FF7A00") ESL
        |  Plus
      p(class="text-gray-600 mb-3") The fast ESL hiring & tutoring hub
      p(class="text-lg text-black-300 mt-1" style="font-size: 18px; font-weight: 500")
        | Teach Beyond Borders. Inspire Minds. From ESL to STEM, Your Classroom Is Everywhere.

    hr.my-3
    .mb-12

    // ===================== Video Section =====================
