//- views/matching/candidates.pug
extends ../layout

block content
  .container.mx-auto.max-w-6xl.py-8
    // Header
    .mb-6
      .flex.items-center.gap-2.mb-2
        a.text-blue-600.hover_underline(href=`/rdf-resource/Job_Vacancies/${jobVacancy.id}`) ← Back to Job Vacancy
      h1.text-3xl.font-bold.mb-2(style="color: #1f2937;")
        i.fas.fa-users.mr-2(style="color: #FF7A00;")
        | AI-Powered Candidate Matching
      p.text-lg(style="color: #6b7280;")= `Finding best candidates for: ${jobVacancy.title}`

    // Job Vacancy Summary Card
    .border.rounded-lg.p-6.mb-6(style="border-color: #FF7A00; background: #FFF5EB;")
      h3.text-xl.font-bold.mb-3(style="color: #1f2937;") Job Requirements
      .grid.grid-cols-1.md_grid-cols-2.gap-4
        if jobVacancy.location
          div
            .text-sm.text-gray-500.uppercase Location
            .font-semibold= jobVacancy.location
        if jobVacancy.teachingAreas
          div
            .text-sm.text-gray-500.uppercase Teaching Areas
            .font-semibold= jobVacancy.teachingAreas
        if jobVacancy.studentType
          div
            .text-sm.text-gray-500.uppercase Student Type
            .font-semibold= jobVacancy.studentType

    // Matching Statistics
    .grid.grid-cols-1.md_grid-cols-3.gap-4.mb-6
      .border.rounded-lg.p-4.text-center(style="border-color: #e5e7eb;")
        .text-3xl.font-bold(style="color: #FF7A00;")= totalCandidates
        .text-sm.text-gray-500 Total Job Seekers
      .border.rounded-lg.p-4.text-center(style="border-color: #e5e7eb;")
        .text-3xl.font-bold(style="color: #10b981;")= relevantCandidates
        .text-sm.text-gray-500 Relevant Matches
      .border.rounded-lg.p-4.text-center(style="border-color: #e5e7eb;")
        .text-3xl.font-bold(style="color: #6366f1;")
          if relevantCandidates > 0
            = `${Math.round((relevantCandidates / totalCandidates) * 100)}%`
          else
            | 0%
        .text-sm.text-gray-500 Match Rate

    // Results
    if matches.length > 0
      h2.text-2xl.font-bold.mb-4(style="color: #1f2937;")
        i.fas.fa-star.mr-2(style="color: #FF7A00;")
        | Top Matching Candidates

      .space-y-4
        each match in matches
          .border.rounded-lg.p-6.hover_shadow-lg.transition-shadow(style="border-color: #e5e7eb;")
            .flex.justify-between.items-start.mb-4
              div
                h3.text-xl.font-bold.mb-1
                  a.text-blue-600.hover_underline(href=`/rdf-resource/Job_Seekers/${match.id}`)= match.title
                .flex.gap-2.mt-2
                  if match.nationality
                    span.px-3.py-1.rounded-full.text-sm(style="background: #E5E7EB;")
                      i.fas.fa-flag.mr-1
                      = match.nationality
                  if match.major
                    span.px-3.py-1.rounded-full.text-sm(style="background: #E5E7EB;")
                      i.fas.fa-graduation-cap.mr-1
                      = match.major
              div.text-right
                .text-3xl.font-bold.mb-1(style=`color: ${match.percentage >= 70 ? '#10b981' : match.percentage >= 50 ? '#f59e0b' : '#6b7280'};`)= `${match.percentage}%`
                .text-sm.text-gray-500 Match Score

            // Matches
            if match.matches.length > 0
              .mb-3
                .text-sm.font-semibold.text-gray-500.mb-2 ✓ Matching Qualifications:
                .flex.flex-wrap.gap-2
                  each item in match.matches
                    span.px-3.py-1.rounded-full.text-sm(style="background: #D1FAE5; color: #065F46;")
                      strong= item.field + ": "
                      = item.value

            // Mismatches
            if match.mismatches.length > 0
              .mb-3
                .text-sm.font-semibold.text-gray-500.mb-2 ⚠ Areas to Consider:
                .flex.flex-wrap.gap-2
                  each item in match.mismatches
                    span.px-3.py-1.rounded-full.text-sm(style="background: #FEF3C7; color: #92400E;")
                      strong= item.field + ": "
                      = `Need ${item.wanted}, has ${item.have}`

            // Contact Info
            if match.email
              .mt-4.pt-4.border-t(style="border-color: #e5e7eb;")
                .flex.gap-4
                  a.btn.btn-primary(href=`/rdf-resource/Job_Seekers/${match.id}` style="background-color: #FF7A00; border-color: #FF7A00;")
                    i.fas.fa-user.mr-2
                    | View Full Profile
                  a.btn.btn-outline-primary(href=`mailto:${match.email}` style="border-color: #FF7A00; color: #FF7A00;")
                    i.fas.fa-envelope.mr-2
                    | Contact Candidate

    else
      .border.rounded-lg.p-8.text-center(style="border-color: #e5e7eb; background: #f9fafb;")
        i.fas.fa-search.text-6xl.mb-4(style="color: #d1d5db;")
        h3.text-xl.font-bold.mb-2(style="color: #6b7280;") No Matching Candidates Found
        p.text-gray-500 Try adjusting the job requirements or check back later for new job seekers.
