//- views/matching/jobs.pug
extends ../layout

block content
  style.
    html, body { overflow-x: hidden !important; width: 100%; }
    @media (max-width: 768px) {
      .container { overflow-x: hidden; max-width: 100vw; }
      .border.rounded-lg { max-width: calc(100vw - 2rem); overflow: hidden; }
      h1, h2, h3, p, span, a { word-break: break-word; overflow-wrap: anywhere; }
      .btn { min-width: 0; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .flex { min-width: 0; }
    }

  .container.mx-auto.max-w-6xl.py-4.md_py-8.px-4(style="overflow-x: hidden; max-width: 100vw;")
    // Header
    .mb-4.md_mb-6(style="overflow-x: hidden;")
      .flex.items-center.gap-2.mb-2
        a.text-blue-600.hover_underline(href=`/rdf-resource/Job_Seekers/${jobSeeker.id}`) ← Back
      h1.text-2xl.md_text-3xl.font-bold.mb-2(style="color: #1f2937; word-break: break-word;")
        i.fas.fa-briefcase.mr-2(style="color: #FF7A00;")
        | AI-Powered Job Matching
      p.text-base.md_text-lg(style="color: #6b7280; word-break: break-word;")= `Finding best job opportunities for: ${jobSeeker.title}`

    // Job Seeker Summary Card
    .border.rounded-lg.p-4.md_p-6.mb-4.md_mb-6(style="border-color: #FF7A00; background: #FFF5EB; overflow: hidden;")
      h3.text-lg.md_text-xl.font-bold.mb-3(style="color: #1f2937;") Your Profile
      .grid.grid-cols-1.md_grid-cols-2.gap-3.md_gap-4
        if jobSeeker.nationality
          div(style="min-width: 0; overflow: hidden;")
            .text-sm.text-gray-500.uppercase Nationality
            .font-semibold(style="word-break: break-word;")= jobSeeker.nationality
        if jobSeeker.preferredLocations
          div(style="min-width: 0; overflow: hidden;")
            .text-sm.text-gray-500.uppercase Preferred Work Locations
            .font-semibold(style="word-break: break-word;")= jobSeeker.preferredLocations
        if jobSeeker.major
          div(style="min-width: 0; overflow: hidden;")
            .text-sm.text-gray-500.uppercase Major
            .font-semibold(style="word-break: break-word;")= jobSeeker.major
        if jobSeeker.languages
          div(style="min-width: 0; overflow: hidden;")
            .text-sm.text-gray-500.uppercase Languages
            .font-semibold(style="word-break: break-word;")= jobSeeker.languages

    // Matching Statistics
    .grid.grid-cols-3.gap-2.md_gap-4.mb-4.md_mb-6
      .border.rounded-lg.p-2.md_p-4.text-center(style="border-color: #e5e7eb; overflow: hidden;")
        .text-xl.md_text-3xl.font-bold(style="color: #FF7A00;")= totalJobs
        .text-xs.md_text-sm.text-gray-500(style="word-break: keep-all;") Total
      .border.rounded-lg.p-2.md_p-4.text-center(style="border-color: #e5e7eb; overflow: hidden;")
        .text-xl.md_text-3xl.font-bold(style="color: #10b981;")= relevantJobs
        .text-xs.md_text-sm.text-gray-500(style="word-break: keep-all;") Matches
      .border.rounded-lg.p-2.md_p-4.text-center(style="border-color: #e5e7eb; overflow: hidden;")
        .text-xl.md_text-3xl.font-bold(style="color: #6366f1;")
          if relevantJobs > 0
            = `${Math.round((relevantJobs / totalJobs) * 100)}%`
          else
            | 0%
        .text-xs.md_text-sm.text-gray-500(style="word-break: keep-all;") Rate

    // Results
    if matches.length > 0
      h2.text-xl.md_text-2xl.font-bold.mb-3.md_mb-4(style="color: #1f2937;")
        i.fas.fa-star.mr-2(style="color: #FF7A00;")
        | Top Matching Job Opportunities

      .space-y-3.md_space-y-4
        each match in matches
          .border.rounded-lg.p-4.md_p-6.hover_shadow-lg.transition-shadow(style="border-color: #e5e7eb; overflow: hidden;")
            .flex.flex-col.md_flex-row.justify-between.items-start.gap-3.mb-4(style="min-width: 0;")
              div.flex-1(style="min-width: 0; overflow: hidden;")
                h3.text-lg.md_text-xl.font-bold.mb-1(style="word-break: break-word;")
                  a.text-blue-600.hover_underline(href=`/rdf-resource/Job_Vacancies/${match.id}`)= match.title
                .flex.flex-wrap.gap-2.mt-2(style="min-width: 0;")
                  if match.location
                    span.px-2.md_px-3.py-1.rounded-full.text-xs.md_text-sm(style="background: #E5E7EB; word-break: keep-all;")
                      i.fas.fa-map-marker-alt.mr-1
                      = match.location
                  if match.companyName
                    span.px-2.md_px-3.py-1.rounded-full.text-xs.md_text-sm(style="background: #E5E7EB; word-break: keep-all;")
                      i.fas.fa-building.mr-1
                      = match.companyName
              div.text-left.md_text-right.w-full.md_w-auto.flex-shrink-0
                .text-2xl.md_text-3xl.font-bold.mb-1(style=`color: ${match.percentage >= 70 ? '#10b981' : match.percentage >= 50 ? '#f59e0b' : '#6b7280'};`)= `${match.percentage}%`
                .text-xs.md_text-sm.text-gray-500 Match Score

            // Job Details
            if match.teachingAreas || match.studentType
              .mb-3(style="overflow: hidden;")
                .text-xs.md_text-sm.font-semibold.text-gray-500.mb-2 📋 Job Details:
                .flex.flex-wrap.gap-1.md_gap-2(style="min-width: 0;")
                  if match.teachingAreas
                    span.px-2.md_px-3.py-1.rounded-full.text-xs.md_text-sm(style="background: #E5E7EB; word-break: break-word;")
                      strong Teaching: 
                      = match.teachingAreas
                  if match.studentType
                    span.px-2.md_px-3.py-1.rounded-full.text-xs.md_text-sm(style="background: #E5E7EB; word-break: keep-all;")
                      strong Students: 
                      = match.studentType

            // Matches
            if match.matches.length > 0
              .mb-3(style="overflow: hidden;")
                .text-xs.md_text-sm.font-semibold.text-gray-500.mb-2 ✓ Matching Qualifications:
                .flex.flex-wrap.gap-1.md_gap-2(style="min-width: 0;")
                  each item in match.matches
                    span.px-2.md_px-3.py-1.rounded-full.text-xs.md_text-sm(style="background: #D1FAE5; color: #065F46; word-break: break-word;")
                      strong= item.field + ": "
                      = item.value

            // Mismatches
            if match.mismatches.length > 0
              .mb-3(style="overflow: hidden;")
                .text-xs.md_text-sm.font-semibold.text-gray-500.mb-2 ⚠ Areas to Consider:
                .flex.flex-wrap.gap-1.md_gap-2(style="min-width: 0;")
                  each item in match.mismatches
                    span.px-2.md_px-3.py-1.rounded-full.text-xs.md_text-sm(style="background: #FEF3C7; color: #92400E; word-break: break-word;")
                      strong= item.field + ": "
                      = `Need ${item.wanted}, has ${item.have}`

            // Action Buttons
            .mt-3.md_mt-4.pt-3.md_pt-4.border-t(style="border-color: #e5e7eb; overflow: hidden;")
              .flex.flex-col.sm_flex-row.gap-2.md_gap-4(style="min-width: 0;")
                a.btn.btn-primary.text-sm.md_text-base(href=`/rdf-resource/Job_Vacancies/${match.id}` style="background-color: #FF7A00; border-color: #FF7A00; flex: 1; min-width: 0;")
                  i.fas.fa-briefcase.mr-2
                  span.hidden.sm_inline View Full Details
                  span.inline.sm_hidden View Details
                a.btn.btn-outline-primary.text-sm.md_text-base(href=`#apply-${match.id}` style="border-color: #FF7A00; color: #FF7A00; flex: 1; min-width: 0;")
                  i.fas.fa-paper-plane.mr-2
                  | Apply Now

    else
      .border.rounded-lg.p-6.md_p-8.text-center(style="border-color: #e5e7eb; background: #f9fafb; overflow: hidden;")
        i.fas.fa-search.text-4xl.md_text-6xl.mb-3.md_mb-4(style="color: #d1d5db;")
        h3.text-lg.md_text-xl.font-bold.mb-2(style="color: #6b7280;") No Matching Jobs Found
        p.text-sm.md_text-base.text-gray-500 Try updating your profile or check back later for new job opportunities.
