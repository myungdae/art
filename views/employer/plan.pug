//- views/employer/plan.pug
extends ../layout

block content
  .container.mx-auto.px-4.py-10
    h1.text-2xl.text-center.mb-8 Employer Plan

    .max-w-xl.mx-auto.bg-white.rounded-xl.shadow.p-6
      p.text-gray-700.mb-4 Select an Employer subscription plan for job posting and management.

      form(method='POST', action='/user/employer/plan')
        .flex.items-center.gap-3
          select(name='employerPeriod').border.rounded.p-2
            option(value='1') 1 Ad
            option(value='4') 4 Ads
            option(value='12') 12 Ads
            option(value='24') 24 Ads

          button.btn.btn-primary(type='submit') Continue to Payment

      .text-sm.text-gray-500.mt-6
        p After payment is complete, the "Register Job Vacancy" button will be activated on your dashboard.

