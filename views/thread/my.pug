//- views/thread/my.pug
extends ../layout

block content
  .mypage-scope
    .container
      .d-flex.align-items-baseline.justify-content-between.mb-3
        h1.mp-title-xl.mb-0 My Activity
        if user
          span.mp-muted.fs-6 #{user.email}

      p.mp-subtext.mb-4 Your recent actions (login, create, update, delete).

      if items && items.length
        .mp-card.mb-3
          .card-header
            strong Recent Activity
          .card-body
            ul.mp-list
              each t in items
                li
                  .d-flex.justify-content-between.align-items-baseline
                    .flex-grow-1
                      .mp-list-title #{t.title || (t.action + ' ' + t.source)}
                      .mp-list-sub
                        | #{t.summary || ''} ·
                        |  #{new Date(t.createdAt).toLocaleString('en-US')}
                    .text-nowrap.ms-3
                      span.badge.bg-light.text-dark.me-2 #{t.type || 'activity'}
                      span.badge.bg-primary.me-2 #{t.action}
                      span.badge.bg-secondary #{t.source}
        if pages && pages > 1
          nav(aria-label="Activity pagination").mt-3
            ul.pagination
              - const prev = page > 1 ? page - 1 : 1;
              - const next = page < pages ? page + 1 : pages;
              li.page-item(class=page===1 ? 'disabled' : '')
                a.page-link(href=`/thread/my?page=${prev}&limit=${pageSize}`) ‹ Prev
              li.page-item.disabled
                span.page-link Page #{page} / #{pages}
              li.page-item(class=page===pages ? 'disabled' : '')
                a.page-link(href=`/thread/my?page=${next}&limit=${pageSize}`) Next ›
      else
        .mp-card
          .card-header
            strong Recent Activity
          .card-body
            p.mp-muted No activity yet.
            p.mp-muted Actions like creating/updating Online Tutors or Job Seekers will appear here.

