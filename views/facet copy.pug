extends layout
block content
  .container(style="padding-top:30px;")
    .row
      #left_facets.col-md-3
        #filter_wrap
          if(filter_item.length > 0)
            each item in filter_item
              - var _name = item.split('::')[0].replace(/_/g, ' ');
              - var _title = item.split('::')[1].replace(/_/g, ' ');
              - var _attr = item.split('::')[2].replace(/_/g, ' ');
              .bg-white.border.p-2.my-2
                .d-flex.justify-content-between
                  b(data-title=_title, data-attr=_attr) #{_name} 
                  .now-ui-icons.ui-1_simple-remove.d-flex.flex-column.justify-content-center.pointer(onclick='fnRemoveFilter("' + item.replace(/ /g, "_") + '")')
        #facet_wrap(style='padding-top:5em;')
          each item in list
            - var facet_title = item[0].parentType.replace(title,'').replace('_','');
            .card
              .card-header.p-2.bg-default.text-light(style='border-top:0px; solid #000; padding:0px;') #{facet_title}
              .card-body.overflow-auto(style='max-height:200px;')
                span
                each i in item
                  - var id = i['_id'].replace(resource,'')
                  - var attr = typeof i.attr === 'object' ? id : i.attr
                  - var element = id.replace(/_/g, ' ');
                  h8.hand(style="font-size:14px;line-height:1.6;" onclick='fnFilterLeft("' + element.replace(/ /g, '_') + '", "' + attr.replace(resource,'').replace(/ /g, '_') + '","' + i.parentType.replace(title, '').replace('_', '') + '")') #{element.replace(/\[dot\]/g, '.')} (#{i['sum']})
                  br

      .col-md-9
        .row
          #body_data.col-md-12(about='body 부분')
            .body_title_wrap
              each facet in body
                h2.d-inline-block #{facet._id.replace(resource, '')} 
                span.text-dark (#{facet.count})
                if(allow_map)
                  span(style='float: right')
                    | Show as:&nbsp;
                    a(href=facet._id.replace(resource, '')) Map
                    | &nbsp;|&nbsp;
                    b Text
                .body_wrap(name='0')
                  each doc in facet.list
                    .card(style='border-top:2px solid #000')
                      .card-body
                        .d-flex.justify-content-start
                          a(href=doc['@id'].replace(resource, '/resource/'))
                            if(doc[resource + '그림'])
                              if(doc[resource + '그림']['@value'])
                                img(style='width:100px; min-width:100px;margin-right:15px;' name="pic" src=((doc[resource + '그림']['@value']).replace(/\[dot\]/g, '.')))
                            else
                              img(style='width:100px; min-width:100px;margin-right:15px;' name="pic" src="/assets/img/empty.gif")
                          .desc_wrap
                            if(doc[label])
                              - var labelText = doc[label]['@value'] ? doc[label]['@value'].replace(/\[dot\]/g, '.') : (Array.isArray(doc[label]) ? doc[label][0]['@value'].replace(/\[dot\]/g, '.') : '')
                              a.text-info.font-weight-bold(href=doc['@id'].replace(resource, '/resource/'))= labelText
                            if(doc[description])
                              if(doc[description]['@value'])
                                p.description.overflow-auto.my-0(style='max-height:100px;') #{doc[description]['@value'].replace(/\[dot\]/g, '.')}
                              else
                                p.description.overflow-auto.my-0(style='max-height:100px;') #{doc[description].replace(/\[dot\]/g, '.')}
                            if(doc[resource + '설명'])
                              if(doc[resource + '설명']['@value'])
                                p.description.overflow-auto.my-0(style='max-height:100px;') #{doc[resource + '설명']['@value'].replace(/\[dot\]/g, '.')} 
                              else
                                p.description.overflow-auto.my-0(style='max-height:100px;') #{doc[resource + '설명'].replace(/\[dot\]/g, '.')}

