extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-6.col-lg-5
        .card.shadow(style="border-color: #FFD6B3 !important; border-width: 2px; background-color: #FFF9F5;")
          .card-header.text-white.text-center(style="background-color: #FF7A00 !important;")
            h2(style="margin: 0; font-weight: bold; font-size: 1.8rem;") 
              i.fas.fa-key.me-2
              | Forgot Password

          .card-body
            if message
              .alert.alert-success.mt-2
                i.fas.fa-check-circle.me-2
                != message
            
            if error
              .alert.alert-danger.mt-2
                i.fas.fa-exclamation-circle.me-2
                != error

            .text-center.mb-4
              p.text-muted(style="font-size: 0.95rem;") 
                | Enter your email address and we'll send you a link to reset your password.

            form(method="POST", action="/user/forgot-password")
              .form-group.mb-4
                label(for="email", style="font-size: 1.1rem; font-weight: bold;") 
                  i.fas.fa-envelope.me-2
                  | Email Address
                input.form-control.rounded-pill(type="email", name="email", id="email", placeholder="Enter your registered email", required)

              .form-group.text-center.mt-4
                button.btn.btn-success.btn-lg.px-5(type="submit") 
                  i.fas.fa-paper-plane.me-2
                  | Send Reset Link

              .text-center.mt-4
                a.text-muted(href="/user/login", style="font-size: 0.95rem; text-decoration: none;")
                  i.fas.fa-arrow-left.me-2
                  | Back to Login
