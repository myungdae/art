extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-4 My Page

    if user
      .mb-3
        p
          strong Username:
          | #{user.username}
        p
          strong Email:
          | #{user.email}
        p
          strong Role:
          | #{user.role}
        p
          strong Ads Available:
          span.text-success.ms-2 #{(typeof user.adsAvailable === 'number') ? user.adsAvailable : 0}

      hr

      h3 My Job Ads
      if jobVacancies && jobVacancies.length > 0
        table.table.table-bordered
          thead
            tr
              th Title
              th Country
              th Date Posted
              th Actions
          tbody
            each vacancy in jobVacancies
              tr
                td #{vacancy.title}
                td #{vacancy.country}
                td
                  - let dateStr = 'N/A';
                  - if (vacancy.datePosted) {
                  -   dateStr = new Date(vacancy.datePosted).toISOString().substring(0, 10);
                  - } else if (vacancy.createdAt) {
                  -   dateStr = new Date(vacancy.createdAt).toISOString().substring(0, 10);
                  - }
                  = dateStr
                td
                  a.btn.btn-sm.btn-primary.me-2(href='/job-vacancies/' + vacancy._id) View
                  a.btn.btn-sm.btn-secondary.me-2(href='/job-vacancies/' + vacancy._id + '/edit') Edit

      else
        p.text-muted.mt-2 You haven’t posted any job vacancies yet. Post your first one below.

      hr

      h3 My Job Ads (with Delete)
      if jobVacancies && jobVacancies.length > 0
        table.table.table-striped.table-hover
          thead
            tr
              th Title
              th Country
              th Date Posted
              th Actions
          tbody
            each vacancy in jobVacancies
              tr
                td #{vacancy.title}
                td #{vacancy.country}
                td
                  - let dateStr = 'N/A';
                  - if (vacancy.datePosted) {
                  -   dateStr = new Date(vacancy.datePosted).toISOString().substring(0, 10);
                  - } else if (vacancy.createdAt) {
                  -   dateStr = new Date(vacancy.createdAt).toISOString().substring(0, 10);
                  - }
                  = dateStr
                td
                  a.btn.btn-sm.btn-primary.me-2(href='/job-vacancies/' + vacancy._id) View
                  a.btn.btn-sm.btn-secondary.me-2(href='/job-vacancies/' + vacancy._id + '/edit') Edit
                  form.d-inline(method="POST", action='/job-vacancies/' + vacancy._id + '?_method=DELETE')
                    button.btn.btn-sm.btn-danger(type="submit" onclick="return confirm('Are you sure you want to delete this ad?')") Delete

      hr

      h3 Post a New Job
      if user.adsAvailable > 0
        a.btn.btn-success(href='/job-vacancies/new_paid_user') Post Job (Paid User)
      else
        a.btn.btn-warning(href='/paypal/checkout') Buy Ad & Post Job

    else
      p.text-danger You must be logged in to view this page.
