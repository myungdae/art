extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-5(style="font-size: 2rem;") My Page

    if user
      - var roleMap = { 'Employer': 'Employer', 'Job_Seeker': 'Job Seeker', 'Online_Tutor': 'Online Tutor' };
      - var displayRole = roleMap[user.role] || user.role;

      .mb-4
        p(style="font-size: 1.2rem;")
          strong Username:
          | #{user.username}
        p(style="font-size: 1.2rem;")
          strong Email:
          | #{user.email}
        p(style="font-size: 1.2rem;")
          strong Role:
          | #{displayRole}

      // ✅ 버튼 영역
      .mt-4.d-flex.flex-wrap.gap-2
        a.btn.text-white.bg-success.px-4.py-2.rounded.shadow(href='/job-vacancies/new') ➕ Post New Job Vacancy
        a.btn.text-white.bg-orange-600.px-4.py-2.rounded.shadow(href='/job-vacancies/new_paid_user') 💼 Post Paid Job Ad
        a.btn.text-white.bg-gray-700.px-4.py-2.rounded.shadow(href='/payments') 💳 Make Payment
        a.btn.text-white.bg-blue-600.px-4.py-2.rounded.shadow(href='/payments/history') 📜 View Payment History

      // ✅ Job Vacancies
      if jobVacancies && jobVacancies.length
        h4.mt-4.text-info My Job Vacancies
        ul
          each job in jobVacancies
            li
              a(href=`/job-vacancies/${job._id}`)= job.title
      else
        p.text-muted.mt-3 No job vacancies posted yet.

      // ✅ Job Seeker Resumes
      if user.role === 'Job_Seeker'
        if jobSeekerData && jobSeekerData.resumeAccess
          - var startDate = new Date(jobSeekerData.resumeAccess.startDate)
          - var duration = jobSeekerData.resumeAccess.durationDays
          - var endDate = new Date(startDate.getTime() + duration * 86400000)
          - var now = new Date()
          - var remainingDays = Math.max(0, Math.ceil((endDate - now) / 86400000))

          h4.mt-4.text-success 🧭 Resume Visibility
          p 📅 Start: #{startDate.toISOString().substring(0,10)}
          p 🛑 End: #{endDate.toISOString().substring(0,10)}
          p(style="font-weight:bold; color:green; font-size:1.3rem;") ⏳ Remaining Days: #{remainingDays}

          if myResumes && myResumes.length
            h4.mt-3.text-info My Resumes
            ul
              each resume in myResumes
                li
                  a(href=`/job-seekers/${resume._id}`)= resume.name
          else
            p.text-muted.mt-3 No resumes posted yet.

          a.btn.btn-primary.mt-3(href='/job-seekers/new') ➕ Post New Resume
        else
          p.text-muted.mt-3 No active resume access.
          a.btn.btn-warning.mt-3.text-dark(href='/resume-access') 🧾 Purchase Resume Access
    else
      p.text-danger You must be logged in to view this page.
