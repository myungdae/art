extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-5(style="font-size: 2rem;") My Page

    if user
      - var roleMap = { 'Employer': 'Employer', 'Job_Seeker': 'Job Seeker', 'Online_Tutor': 'Online Tutor' };
      - var displayRole = roleMap[user.role] || user.role;

      .mb-4
        p
          strong Username:
          | #{user.username}
        p
          strong Email:
          | #{user.email}
        p
          strong Role:
          | #{displayRole}
        p
          strong Ads Available:
          | #{(typeof user.adsAvailable === 'number') ? user.adsAvailable : 0}

      if user.role === 'Job_Seeker'
        if jobSeeker && jobSeeker.resumeAccess
          - var startDate = new Date(jobSeeker.resumeAccess.startDate);
          - var duration = jobSeeker.resumeAccess.durationDays;
          - var endDate = new Date(startDate.getTime() + duration * 86400000);
          - var now = new Date();
          - var remainingDays = Math.max(0, Math.ceil((endDate - now) / 86400000));
          p.text-success.font-weight-bold
            | 📅 Resume Access: #{remainingDays} days remaining (until #{endDate.toISOString().substring(0,10)})
          if canPostResume
            a.btn.btn-primary.mt-3(href='/job-seekers/new') ➕ Post Resume
        else
          p.text-muted No active resume access
          a.btn.btn-warning.mt-2(href='/resume-access') 🧾 Purchase Resume Access

      else if user.role === 'Employer'
        h3 My Job Ads
        if jobVacancies.length
          ul
            each ad in jobVacancies
              li= ad.title
        else
          p.text-muted You have no job ads

      else if user.role === 'Online_Tutor'
        p Online Tutor features coming soon!

    else
      p.text-danger You must be logged in to view this page.
