extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-5(style="font-size: 2rem;") My Page

    if user
      - var roleMap = { 'Employer': 'Employer', 'Job_Seeker': 'Job Seeker', 'Online_Tutor': 'Online Tutor' };
      - var displayRole = roleMap[user.role] || user.role;

      .mb-4
        p(style="font-size: 1.2rem;")
          strong Username:
          | #{user.username}
        p(style="font-size: 1.2rem;")
          strong Email:
          | #{user.email}
        p(style="font-size: 1.2rem;")
          strong Role:
          | #{displayRole}

      // ✅ Remaining Tokens 표시 (아직 결제 전이면 0)
      p.mt-3(style="font-weight: bold; font-size: 1.3rem; color: red;") 🔑 Remaining Tokens: 0

      // ✅ 버튼: Post Paid Job Ad + Make Payment
      .mt-4.d-flex.flex-wrap.gap-2
        a.btn.text-white.bg-orange-600.px-4.py-2.rounded.shadow(href='/job-vacancies/new_paid_user') 💼 Post Paid Job Ad
      
        button.btn.btn-secondary(onclick="window.location.href='/paypal/checkout'") Make Payment


      // ✅ Job Vacancies
      if jobVacancies && jobVacancies.length
        h4.mt-4.text-info My Job Vacancies
        ul
          each job in jobVacancies
            li
              a(href=`/job-vacancies/${job._id}`)= job.title
      else
        p.text-muted.mt-3 No job vacancies posted yet.

    else
      p.text-danger You must be logged in to view this page.
