extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-5(style="font-size: 2rem;") My Page

    if user
      - var roleMap = { 'Employer': 'Employer', 'Job_Seeker': 'Job Seeker', 'Online_Tutor': 'Online Tutor' };
      - var displayRole = roleMap[user.role] || user.role;

      .mb-4
        p(style="font-size: 1.2rem;")
          strong Username:
          | #{user.username}

        p(style="font-size: 1.2rem;")
          strong Email:
          | #{user.email}

        p(style="font-size: 1.2rem;")
          strong Role:
          | #{displayRole}

      if user.role === 'Employer'
        h3.mt-4.mb-3 My Job Ads

        if jobVacancies && jobVacancies.length
          table.table.table-bordered
            thead
              tr
                th Title
                th Country
                th Date Posted
                th.text-center Actions
            tbody
              each job in jobVacancies
                tr
                  td= job.title
                  td= job.country
                  td= job.createdAt ? new Date(job.createdAt).toISOString().substring(0,10) : 'N/A'
                  td.text-center
                    a.btn.btn-outline-dark.btn-sm(href='/job-vacancies/' + job._id) View
                    a.btn.btn-outline-dark.btn-sm(href='/job-vacancies/' + job._id + '/edit') Edit
                    form.d-inline(method='POST', action='/job-vacancies/' + job._id + '?_method=DELETE')
                      button.btn.btn-sm.btn-danger(type='submit', onclick='return confirm("Delete this ad?")') Delete
        else
          p.text-muted No job ads posted yet.

        a.btn.btn-lg.btn-danger.mt-3.text-white(href='/job-vacancies/new_paid_user')
          | ➕ Post Job (Paid User)

      else if user.role === 'Job_Seeker'
        if jobSeekerData && jobSeekerData.resumeAccess
          - var startDate = new Date(jobSeekerData.resumeAccess.startDate)
          - var duration = jobSeekerData.resumeAccess.durationDays
          - var endDate = new Date(startDate.getTime() + duration * 86400000)
          - var now = new Date()
          - var remainingDays = Math.max(0, Math.ceil((endDate - now) / 86400000))

          h4.mt-4.text-success 🧭 Resume Visibility
          p(style="font-size: 1.1rem;") 📅 Start: #{startDate.toISOString().substring(0,10)}
          p(style="font-size: 1.1rem;") 🛑 End: #{endDate.toISOString().substring(0,10)}
          p(style="font-size: 1.3rem; font-weight: bold; color: green;") ⏳ Remaining Days: #{remainingDays}

          a.btn.btn-lg.btn-primary.mt-3.text-white(href='/resume-access') 🔄 Extend Resume Access
        else
          p.text-muted.mt-4 No active resume access.
          a.btn.btn-lg.btn-warning.mt-3.text-dark(href='/resume-access') 🧾 Purchase Resume Access

      else if user.role === 'Online_Tutor'
        // 비슷한 방식으로 Online Tutor visibility 출력
        p.text-muted.mt-4 Visibility status coming soon...
        a.btn.btn-lg.btn-warning.mt-3.text-dark(href='/tutor-access') 🧾 Purchase Tutor Visibility

    else
      p.text-danger You must be logged in to view this page.
