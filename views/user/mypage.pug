extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-5(style="font-size: 2rem;") My Page

    if user
      - var roleMap = {
        'Employer': 'Employer',
        'Job_Seeker': 'Job Seeker',
        'Online_Tutor': 'Online Tutor'
      }
      - var displayRole = roleMap[user.role] || user.role;
      .mb-4
        p(style="font-size: 1.1rem;")
          strong Username:
          | #{user.username}

        p(style="font-size: 1.1rem;")
          strong Email:
          | #{user.email}

        p(style="font-size: 1.1rem;")
          strong Role:
          | #{displayRole}

        p(style="font-size: 1.1rem;")
          strong Ads Available:
          span.text-dark.ms-2 #{(typeof user.adsAvailable === 'number') ? user.adsAvailable : 0}

        //- ✅ Resume Access or Tutor Visibility
        if (user.role === 'Job_Seeker' || user.role === 'Online_Tutor') && user.resumeAccess
          - var startDate = new Date(user.resumeAccess.startDate);
          - var duration = user.resumeAccess.durationDays;
          - var endDate = new Date(startDate.getTime() + duration * 86400000);
          - var now = new Date();
          - var diffTime = endDate - now;
          - var remainingDays = Math.max(0, Math.ceil(diffTime / 86400000));
          - var percentUsed = Math.min(100, Math.floor(((duration - remainingDays) / duration) * 100));
          - var formatDate = function(date) { return date.toISOString().substring(0, 10); };

          h4.text-center.text-primary.mt-4(style="font-weight: bold;") 🧭 Tutor Visibility Status

          .text-center.mt-2
            p.mb-1(style="font-size: 1.05rem;")
              | 📅 Start Date:
              span.text-dark #{formatDate(startDate)}
            p.mb-1(style="font-size: 1.05rem;")
              | 🛑 End Date:
              span.text-dark #{formatDate(endDate)}
            p.mb-2(style="font-size: 1.1rem; font-weight: bold; color: #007bff")
              | ⏳ Remaining Days: #{(remainingDays === 1) ? '1 day' : `${remainingDays} days`}


          .progress.mx-auto(style="height: 22px; max-width: 420px; margin-top: 10px;")
            .progress-bar.bg-info(
              role="progressbar",
              style=`width: ${100 - percentUsed}%`,
              ariaValuenow=remainingDays,
              ariaValuemin="0",
              ariaValuemax=duration
            ) #{100 - percentUsed}%

          .d-flex.justify-content-center.mt-4
            a.btn.btn-success.btn-lg.text-white(
              href='/tutor-access',
              style='padding: 16px 36px; font-size: 1.2rem; font-weight: bold;'
            ) 🔄 Extend Visibility

      hr

      if user.role === 'Employer'
        h3.mb-3(style="font-size: 1.5rem;") My Job Ads

        if jobVacancies && jobVacancies.length > 0
          table.table.table-bordered.table-hover(style="font-size: 1.05rem;")
            thead
              tr
                th Title
                th Country
                th Date Posted
                th.text-center Actions
            tbody
              each vacancy in jobVacancies
                - var dateStr = 'N/A';
                if vacancy.datePosted
                  - dateStr = new Date(vacancy.datePosted).toISOString().substring(0, 10);
                else if vacancy.createdAt
                  - dateStr = new Date(vacancy.createdAt).toISOString().substring(0, 10);

                tr
                  td= vacancy.title
                  td= vacancy.country
                  td= dateStr
                  td.text-center
                    a.btn.btn-outline-dark.btn-sm.me-1(href='/job-vacancies/' + vacancy._id) View
                    a.btn.btn-outline-dark.btn-sm.me-1(href='/job-vacancies/' + vacancy._id + '/edit') Edit
                    form.d-inline(method="POST", action='/job-vacancies/' + vacancy._id + '?_method=DELETE')
                      button.btn.btn-sm.btn-danger(type="submit", style="color: white;" onclick="return confirm('Are you sure you want to delete this ad?')") Delete
        else
          p.text-muted.mt-2 You haven’t posted any job vacancies yet. Post your first one below.

        hr

        h3.mt-4(style="font-size: 1.5rem;") Post a New Job
        if user.adsAvailable > 0
          a.btn.btn-danger.btn-lg.mt-3.text-white(
            href='/job-vacancies/new_paid_user',
            style='padding: 14px 28px; font-size: 1.1rem; font-weight: bold;'
          ) ➕ Post Job (Paid User)
        else
          a.btn.btn-warning.btn-lg.mt-3.text-dark(
            href='/paypal/checkout',
            style='padding: 14px 28px; font-size: 1.1rem; font-weight: bold;'
          ) 💳 Buy Ad & Post Job

      else if user.role === 'Job_Seeker'
        h3.text-center.mt-5 Resume Access
        p.text-center.mt-2(style='color: #343a40; font-size: 1.15rem; font-weight: 600;')
          | Gain visibility and connect with recruiters worldwide.
        .d-flex.justify-content-center.mt-4
          a.btn.btn-warning.btn-lg.text-white(
            href='/resume-access',
            style='padding: 18px 36px; font-size: 1.3rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px;'
          ) 🧾 Purchase Resume Access

      else if user.role === 'Online_Tutor'
        h3.text-center.mt-5 Tutor Visibility
        p.text-center.mt-2(style='color: #343a40; font-size: 1.15rem; font-weight: 600;')
          | Gain visibility and connect with students worldwide.
        .d-flex.justify-content-center.mt-4
          a.btn.btn-warning.btn-lg.text-white(
            href='/tutor-access',
            style='padding: 18px 36px; font-size: 1.3rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px;'
          ) 🧾 Purchase Tutor Visibility

    else
      p.text-danger You must be logged in to view this page.
