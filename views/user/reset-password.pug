extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-6.col-lg-5
        .card.shadow(style="border-color: #FFD6B3 !important; border-width: 2px; background-color: #FFF9F5;")
          .card-header.text-white.text-center(style="background-color: #FF7A00 !important;")
            h2(style="margin: 0; font-weight: bold; font-size: 1.8rem;") 
              i.fas.fa-lock-open.me-2
              | Reset Password

          .card-body
            if error
              .alert.alert-danger.mt-2
                i.fas.fa-exclamation-circle.me-2
                != error

            .text-center.mb-4
              p.text-muted(style="font-size: 0.95rem;") 
                | Please enter your new password below.

            form(method="POST", action=`/user/reset-password/${token}`)
              .form-group.mb-4
                label(for="password", style="font-size: 1.1rem; font-weight: bold;") New Password
                .position-relative
                  input.form-control.rounded-pill#password-input(type="password", name="password", placeholder="Enter new password", required, style="padding-right: 45px;")
                  button.btn.btn-link.position-absolute#toggle-password(type="button", style="right: 10px; top: 50%; transform: translateY(-50%); text-decoration: none; color: #666;", title="Show/Hide Password")
                    i.fas.fa-eye#eye-icon
                
                // Password strength indicator
                .mt-2#password-strength-container(style='display: none;')
                  .d-flex.align-items-center
                    span.me-2(style='font-size: 0.875rem; color: #666;') Strength:
                    .flex-grow-1
                      .progress(style='height: 8px;')
                        .progress-bar#password-strength-bar(role='progressbar', style='width: 0%; transition: all 0.3s ease;')
                    span.ms-2#password-strength-text(style='font-size: 0.875rem; font-weight: 600;')
                  
                  // Password requirements checklist
                  .mt-2(style='font-size: 0.8rem; color: #666;')
                    div#req-length
                      i.fas.fa-circle(style='font-size: 0.5rem; color: #ddd;')
                      span.ms-1 At least 8 characters
                    div#req-uppercase
                      i.fas.fa-circle(style='font-size: 0.5rem; color: #ddd;')
                      span.ms-1 One uppercase letter
                    div#req-lowercase
                      i.fas.fa-circle(style='font-size: 0.5rem; color: #ddd;')
                      span.ms-1 One lowercase letter
                    div#req-number
                      i.fas.fa-circle(style='font-size: 0.5rem; color: #ddd;')
                      span.ms-1 One number
                    div#req-special
                      i.fas.fa-circle(style='font-size: 0.5rem; color: #ddd;')
                      span.ms-1 One special character

              .form-group.mb-4
                label(for="password-confirm", style="font-size: 1.1rem; font-weight: bold;") Confirm New Password
                input.form-control.rounded-pill(type="password", name="password-confirm", id="password-confirm", placeholder="Re-enter new password", required)
                .invalid-feedback#password-match-error(style='display: none; font-size: 0.875rem;')
                  i.fas.fa-exclamation-circle
                  span.ms-1 Passwords do not match
                .valid-feedback#password-match-success(style='display: none; font-size: 0.875rem;')
                  i.fas.fa-check-circle
                  span.ms-1 Passwords match

              .form-group.text-center.mt-4
                button.btn.btn-success.btn-lg.px-5#reset-btn(type="submit", disabled) 
                  i.fas.fa-check.me-2
                  | Reset Password

              .text-center.mt-4
                a.text-muted(href="/user/login", style="font-size: 0.95rem; text-decoration: none;")
                  i.fas.fa-arrow-left.me-2
                  | Back to Login

  script.
    document.addEventListener('DOMContentLoaded', function() {
      const passwordInput = document.getElementById('password-input');
      const confirmInput = document.getElementById('password-confirm');
      const toggleButton = document.getElementById('toggle-password');
      const eyeIcon = document.getElementById('eye-icon');
      const strengthContainer = document.getElementById('password-strength-container');
      const strengthBar = document.getElementById('password-strength-bar');
      const strengthText = document.getElementById('password-strength-text');
      const resetBtn = document.getElementById('reset-btn');
      const matchError = document.getElementById('password-match-error');
      const matchSuccess = document.getElementById('password-match-success');
      
      const reqLength = document.getElementById('req-length');
      const reqUppercase = document.getElementById('req-uppercase');
      const reqLowercase = document.getElementById('req-lowercase');
      const reqNumber = document.getElementById('req-number');
      const reqSpecial = document.getElementById('req-special');

      let passwordValid = false;
      let passwordsMatch = false;

      // Toggle password visibility
      if (toggleButton && passwordInput && eyeIcon) {
        toggleButton.addEventListener('click', function(e) {
          e.preventDefault();
          if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            eyeIcon.classList.remove('fa-eye');
            eyeIcon.classList.add('fa-eye-slash');
          } else {
            passwordInput.type = 'password';
            eyeIcon.classList.remove('fa-eye-slash');
            eyeIcon.classList.add('fa-eye');
          }
        });
      }

      // Password strength check
      function checkPasswordStrength(password) {
        if (!password) {
          strengthContainer.style.display = 'none';
          return { score: 0, text: '', color: '' };
        }

        strengthContainer.style.display = 'block';

        const checks = {
          length: password.length >= 8,
          uppercase: /[A-Z]/.test(password),
          lowercase: /[a-z]/.test(password),
          number: /[0-9]/.test(password),
          special: /[!@#$%^&*(),.?":{}|<>]/.test(password)
        };

        updateRequirement(reqLength, checks.length);
        updateRequirement(reqUppercase, checks.uppercase);
        updateRequirement(reqLowercase, checks.lowercase);
        updateRequirement(reqNumber, checks.number);
        updateRequirement(reqSpecial, checks.special);

        const score = Object.values(checks).filter(Boolean).length;
        let strength = { score: 0, text: 'Very Weak', color: '#dc3545', width: '20%' };
        
        if (score === 5) {
          strength = { score: 5, text: 'Very Strong', color: '#28a745', width: '100%' };
          passwordValid = true;
        } else if (score === 4) {
          strength = { score: 4, text: 'Strong', color: '#20c997', width: '80%' };
          passwordValid = true;
        } else if (score === 3) {
          strength = { score: 3, text: 'Medium', color: '#ffc107', width: '60%' };
          passwordValid = true;
        } else if (score === 2) {
          strength = { score: 2, text: 'Weak', color: '#fd7e14', width: '40%' };
          passwordValid = false;
        } else {
          passwordValid = false;
        }

        return strength;
      }

      function updateRequirement(element, isValid) {
        const icon = element.querySelector('i');
        const text = element.querySelector('span');
        if (isValid) {
          icon.style.color = '#28a745';
          text.style.color = '#28a745';
          text.style.fontWeight = '600';
        } else {
          icon.style.color = '#ddd';
          text.style.color = '#666';
          text.style.fontWeight = '400';
        }
      }

      function checkPasswordMatch() {
        const password = passwordInput.value;
        const confirm = confirmInput.value;

        if (!confirm) {
          matchError.style.display = 'none';
          matchSuccess.style.display = 'none';
          confirmInput.classList.remove('is-invalid', 'is-valid');
          passwordsMatch = false;
          return;
        }

        if (password === confirm) {
          matchError.style.display = 'none';
          matchSuccess.style.display = 'block';
          confirmInput.classList.remove('is-invalid');
          confirmInput.classList.add('is-valid');
          passwordsMatch = true;
        } else {
          matchError.style.display = 'block';
          matchSuccess.style.display = 'none';
          confirmInput.classList.remove('is-valid');
          confirmInput.classList.add('is-invalid');
          passwordsMatch = false;
        }
      }

      function updateSubmitButton() {
        if (passwordValid && passwordsMatch) {
          resetBtn.disabled = false;
          resetBtn.style.opacity = '1';
        } else {
          resetBtn.disabled = true;
          resetBtn.style.opacity = '0.6';
        }
      }

      passwordInput.addEventListener('input', function() {
        const strength = checkPasswordStrength(this.value);
        if (this.value) {
          strengthBar.style.width = strength.width;
          strengthBar.style.backgroundColor = strength.color;
          strengthText.textContent = strength.text;
          strengthText.style.color = strength.color;
        }
        if (confirmInput.value) {
          checkPasswordMatch();
        }
        updateSubmitButton();
      });

      confirmInput.addEventListener('input', function() {
        checkPasswordMatch();
        updateSubmitButton();
      });

      document.querySelector('form').addEventListener('submit', function(e) {
        if (!passwordsMatch || !passwordValid) {
          e.preventDefault();
          alert('Please ensure your password meets all requirements and both passwords match.');
        }
      });
    });
