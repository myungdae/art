extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-5 My Page (Employer)

    p
      strong Username:
      | #{user.username}

    p
      strong Email:
      | #{user.email}

    p
      strong Role:
      | Employer

    p.mt-3
      | 🔑 Remaining Tokens:
      strong= user.adsAvailable || 0

    .mt-4.d-flex.flex-wrap.gap-2
      a.btn.btn-warning(href="/job-vacancies/new_paid_user") Post Paid Job Ad
      a.btn.btn-secondary(href="/paypal/checkout") Make Payment

    if jobVacancies && jobVacancies.length
      h4.mt-4 My Job Vacancies
      ul
        each job in jobVacancies
          li
            a(href=`/job-vacancies/${job._id}`)= job.title
    else
      p.text-muted.mt-3 No job vacancies posted yet.
