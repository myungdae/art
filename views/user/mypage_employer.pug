//- views/user/mypage-employer.pug
extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-5 Employer Dashboard

    // 사용자 카드
    .card.shadow-sm.p-4.mb-4
      p.mb-2
        strong Username:
        |  #{(user && user.username) || ''}
      p.mb-2
        strong Email:
        |  #{(user && user.email) || ''}
      p.mb-0
        strong Role:
        |  Employer

    // 상태 + 액션
    .card.shadow-sm.p-4
      .row
        .col-12.col-md-6
          p.mb-2
            strong Active postings:
            if totalSlots != null
              |  #{activeJobs || 0} / #{totalSlots}
            else
              |  #{activeJobs || 0}
        .col-12.col-md-6
          p.mb-2
            strong Remaining ad credits:
            // remainingSlots 또는 adCredits 중 내려오는 값 사용
            |  #{(typeof adCredits !== 'undefined' && adCredits != null) ? adCredits : ((typeof remainingSlots !== 'undefined' && remainingSlots != null) ? remainingSlots : 0)}

      .mt-3.d-flex.flex-wrap.gap-2
        if canPost
          //- 크레딧 있으면 바로 등록
          a.btn.btn-primary(href="/job-vacancies/new") Post Job Vacancy
        else
          //- 크레딧 없으면 구매
          a.btn.btn-warning(href="/paypal/checkout?type=employer") Buy Ad Credits

        if (activeJobs || 0) > 0
          a.btn.btn-secondary(href="/job-vacancies/mine") My Job Vacancies
        else
          button.btn.btn-secondary(disabled) My Job Vacancies

    if (activeJobs || 0) === 0
      p.text-muted.mt-3 No job vacancies posted yet.
