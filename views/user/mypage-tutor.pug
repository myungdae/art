//- views/user/mypage-tutor.pug
extends ../layout

block content
  style.
    /* High-visibility text styling */
    .dashboard-label {
      font-weight: 900 !important;
      font-size: 1.35rem !important;
      color: #000 !important;
      letter-spacing: -0.02em !important;
    }
    .dashboard-value {
      font-weight: 800 !important;
      font-size: 1.35rem !important;
      color: #000 !important;
      letter-spacing: -0.02em !important;
    }
    .dashboard-status {
      font-weight: 900 !important;
      font-size: 1.6rem !important;
    }
    .dashboard-days {
      font-weight: 900 !important;
      font-size: 1.8rem !important;
    }
    .alert {
      font-size: 1.15rem !important;
    }
    .alert strong {
      font-weight: 900 !important;
      font-size: 1.25rem !important;
      color: #000 !important;
    }
    .btn {
      font-weight: 800 !important;
      font-size: 1.2rem !important;
    }
  
  .container.mx-auto.px-4.py-10
    .max-w-2xl.mx-auto.p-6.border.rounded-lg(style="border-color: #FFD6B3 !important; border-width: 3px; background-color: #FFF9F5;")
      h1.text-3xl.font-bold.text-center.mb-8(style="color: #FF7A00; font-weight: 900; font-size: 3rem; letter-spacing: -0.02em;") Online Tutor Dashboard
      p.text-center.mb-6(style="font-size: 1.2rem; font-weight: 700; color: #333;") Keep your tutor profile active to reach the right students and schools.

      // ===== 사전 계산 (optional chaining 미사용) =====
      - var u = (typeof user !== 'undefined' && user) ? user : {};
      - var ta = (u.tutorAccess && u.tutorAccess.startDate && u.tutorAccess.durationDays) ? u.tutorAccess : null;
      - var remainLocal = (typeof tutorRemainingDays !== 'undefined') ? tutorRemainingDays : (ta ? Math.max(0, Math.ceil(((new Date(ta.startDate)).getTime() + Number(ta.durationDays)*86400000 - Date.now())/86400000)) : 0);
      - var flagActive = (u.isPaidUser && u.tutorVisibilityExpiresAt && (new Date(u.tutorVisibilityExpiresAt).getTime() > Date.now())) ? true : false;
      - var hasActive = (typeof hasActiveTutorAccess !== 'undefined') ? hasActiveTutorAccess : (flagActive || remainLocal > 0);
      - var purchaseLink = (typeof tutorPurchaseLink !== 'undefined') ? tutorPurchaseLink : '/user/online-tutors/visibility';

      // User info
      .bg-white.rounded-lg.shadow-sm.p-5.mb-6.border(style="border-color: #FFE4CC;")
        p.mb-2
          strong.dashboard-label Username: 
          span.dashboard-value= (user && user.username) || ''
        p.mb-2
          strong.dashboard-label Email: 
          span.dashboard-value= (user && user.email) || ''
        p
          strong.dashboard-label Role: 
          span.dashboard-value= (user && user.role) || ''

      // Tutor Visibility Status card
      .bg-white.rounded-lg.shadow-sm.p-5.mb-6.border(style="border-color: #FFE4CC;")
        p.mb-3
          span.me-2(style="font-size: 1.5rem;") 🧑‍🏫
          strong.dashboard-label Tutor Visibility: 
          if hasActive
            span.dashboard-status(style="color: #28a745;")
              i.fas.fa-check-circle.mr-1
              | Active
          else
            span.dashboard-status(style="color: #dc3545;")
              i.fas.fa-times-circle.mr-1
              | Inactive
        
        if hasActive
          p.mb-0
            strong.dashboard-label Remaining Days: 
            span.dashboard-days(style="color: #28a745;") #{remainLocal} days
        else
          p.mb-0
            strong.dashboard-label Remaining Days: 
            span.dashboard-days(style="color: #dc3545;") 0 days

      // Actions
      .flex.flex-col.gap-3.mt-5
        if hasActive
          .w-full
            .alert.alert-success.text-center.mb-4(style="background-color: #D4EDDA; border-color: #C3E6CB; font-size: 1rem;")
              i.fas.fa-check-circle.mr-2
              strong Your tutor visibility is active. You can create your profile!
            a.btn.btn-lg.w-full(href="/online-tutors/new" style="background-color: #FF7A00; border-color: #FF7A00; color: white; font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem;")
              i.fas.fa-plus-circle.mr-2
              | Create Tutor Profile
            a.btn.btn-outline-secondary.btn-lg.w-full(href="/facet/Online_Tutors" style="border-width: 2px; font-size: 1rem;")
              i.fas.fa-search.mr-2
              | Browse Tutors
        else
          .w-full
            .alert.alert-warning.text-center.mb-4(style="background-color: #FFF3CD; border-color: #FFE69C; font-size: 1rem;")
              i.fas.fa-exclamation-triangle.mr-2
              strong You need to purchase tutor visibility to create your profile
            a.btn.btn-lg.w-full(href=purchaseLink style="background-color: #FF7A00; border-color: #FF7A00; color: white; font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem;")
              i.fas.fa-credit-card.mr-2
              | Purchase Tutor Visibility
            a.btn.btn-outline-secondary.btn-lg.w-full(href="/facet/Online_Tutors" style="border-width: 2px; font-size: 1rem;")
              i.fas.fa-search.mr-2
              | Browse Tutors

      // Info
      .mt-4
        .alert.alert-info.mb-0(style="background-color: #D1ECF1; border-color: #BEE5EB; border-width: 2px;")
          p.mb-0(style="font-size: 1.2rem; font-weight: 800; color: #000; line-height: 1.6;")
            i.fas.fa-info-circle.mr-2(style="font-size: 1.3rem; color: #0c5460;")
            strong When visibility expires, creating/updating your tutor profile is blocked. 
            | Renew anytime; new days will extend from the remaining period.
