//- views/user/mypage-tutor.pug
extends ../layout

block content
  .container.mt-5.mb-5
    // ===== 헤더 =====
    .d-flex.flex-column.align-items-center.text-center.mb-4
      h2.mp-title-xl.mb-2 My Page (Online Tutor)
      p.mp-subtext Keep your tutor profile active to reach the right students and schools.

    // ===== 사전 계산 (optional chaining 미사용) =====
    - var u = (typeof user !== 'undefined' && user) ? user : {};
    - var ta = (u.tutorAccess && u.tutorAccess.startDate && u.tutorAccess.durationDays) ? u.tutorAccess : null;
    - var remainLocal = (typeof tutorRemainingDays !== 'undefined')
    -   ? tutorRemainingDays
    -   : (ta ? Math.max(0, Math.ceil(((new Date(ta.startDate)).getTime() + Number(ta.durationDays)*86400000 - Date.now())/86400000)) : 0);
    - var flagActive = (u.isPaidUser && u.tutorVisibilityExpiresAt && (new Date(u.tutorVisibilityExpiresAt).getTime() > Date.now())) ? true : false;
    - var hasActive = (typeof hasActiveTutorAccess !== 'undefined') ? hasActiveTutorAccess : (flagActive || remainLocal > 0);
    - var purchaseLink = (typeof tutorPurchaseLink !== 'undefined') ? tutorPurchaseLink : '/user/online-tutors/visibility';

    // ===== 요약 카드 =====
    .card.shadow-sm.p-4(style="max-width: 720px; margin: 0 auto;")
      .row.g-2
        .col-12.col-md-6
          p.mb-2
            strong Username:
            |  #{u.username || ''}
        .col-12.col-md-6
          p.mb-2
            strong Email:
            |  #{u.email || ''}
        .col-12.col-md-6
          p.mb-2
            strong Role:
            |  #{u.role || ''}

      .mt-2
        p.mb-0
          span.me-1 🧑‍🏫
          b Tutor Visibility:
          if hasActive
            span.ms-1.text-success Active
            span.ms-1.text-muted (#{remainLocal} days left)
          else
            span.ms-1.text-danger Not Active

      // ===== ✅ 버튼 블록 (가시성 상태에 따른 제어) =====
      .d-flex.justify-content-center.mt-3.btn-block-mobile
        .btn-group(role="group", aria-label="Tutor actions")
          if hasActive
            a.btn.btn-success.btn-lg(href="/online-tutors/new") Create Tutor Profile
            a.btn.btn-outline-secondary.btn-lg(href="/facet/Online_Tutors") Browse Tutors
          else
            a.btn.btn-primary.btn-lg(href=purchaseLink) Purchase Tutor Visibility
            a.btn.btn-outline-secondary.btn-lg(href="/facet/Online_Tutors") Browse Tutors

    // ===== 안내 =====
    .mt-4.mx-auto(style="max-width: 720px;")
      .alert.alert-info.mb-0
        small
          | When visibility expires, creating/updating your tutor profile is blocked.
          |  Renew anytime; new days will extend from the remaining period.
