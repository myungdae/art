//- views/user/mypage-tutor.pug
extends ../layout

block content
  style.
    /* High-visibility text styling */
    .dashboard-label {
      font-weight: 900 !important;
      font-size: 1.35rem !important;
      color: #000 !important;
      letter-spacing: -0.02em !important;
    }
    .dashboard-value {
      font-weight: 800 !important;
      font-size: 1.35rem !important;
      color: #000 !important;
      letter-spacing: -0.02em !important;
    }
    .dashboard-status {
      font-weight: 900 !important;
      font-size: 1.6rem !important;
    }
    .dashboard-days {
      font-weight: 900 !important;
      font-size: 1.8rem !important;
    }
    .alert {
      font-size: 1.15rem !important;
    }
    .alert strong {
      font-weight: 900 !important;
      font-size: 1.25rem !important;
      color: #000 !important;
    }
    .btn {
      font-weight: 800 !important;
      font-size: 1.2rem !important;
    }
  
  .container.mx-auto.px-4.py-10
    .max-w-2xl.mx-auto.p-6.border.rounded-lg(style="border-color: #FFD6B3 !important; border-width: 3px; background-color: #FFF9F5;")
      h1.text-3xl.font-bold.text-center.mb-8(style="color: #FF7A00; font-weight: 900; font-size: 3rem; letter-spacing: -0.02em;") Online Tutor Dashboard
      p.text-center.mb-6(style="font-size: 1.2rem; font-weight: 700; color: #333;") Keep your tutor profile active to reach the right students and schools.

      // ===== 사전 계산 (optional chaining 미사용) =====
      - var u = (typeof user !== 'undefined' && user) ? user : {};
      - var ta = (u.tutorAccess && u.tutorAccess.startDate && u.tutorAccess.durationDays) ? u.tutorAccess : null;
      - var remainLocal = (typeof tutorRemainingDays !== 'undefined') ? tutorRemainingDays : (ta ? Math.max(0, Math.ceil(((new Date(ta.startDate)).getTime() + Number(ta.durationDays)*86400000 - Date.now())/86400000)) : 0);
      - var flagActive = (u.isPaidUser && u.tutorVisibilityExpiresAt && (new Date(u.tutorVisibilityExpiresAt).getTime() > Date.now())) ? true : false;
      - var hasActive = (typeof hasActiveTutorAccess !== 'undefined') ? hasActiveTutorAccess : (flagActive || remainLocal > 0);
      - var purchaseLink = (typeof tutorPurchaseLink !== 'undefined') ? tutorPurchaseLink : '/user/online-tutors/visibility';

      // User info
      .bg-white.rounded-lg.shadow-sm.p-5.mb-6.border(style="border-color: #FFE4CC;")
        p.mb-2
          strong.dashboard-label Username: 
          span.dashboard-value= (user && user.username) || ''
        p.mb-2
          strong.dashboard-label Email: 
          span.dashboard-value= (user && user.email) || ''
        p
          strong.dashboard-label Role: 
          span.dashboard-value= (user && user.role) || ''

      // Tutor Visibility Status card
      .bg-white.rounded-lg.shadow-sm.p-5.mb-6.border(style="border-color: #FFE4CC;")
        p.mb-3
          span.me-2(style="font-size: 1.5rem;") 🧑‍🏫
          strong.dashboard-label Tutor Visibility: 
          if hasActive
            span.dashboard-status(style="color: #28a745;")
              i.fas.fa-check-circle.mr-1
              | Active
          else
            span.dashboard-status(style="color: #dc3545;")
              i.fas.fa-times-circle.mr-1
              | Inactive
        
        if hasActive
          p.mb-0
            strong.dashboard-label Remaining Days: 
            span.dashboard-days(style="color: #28a745;") #{remainLocal} days
        else
          p.mb-0
            strong.dashboard-label Remaining Days: 
            span.dashboard-days(style="color: #dc3545;") 0 days

      // Actions
      .flex.flex-col.gap-3.mt-5
        if hasActive
          .w-full
            .alert.alert-success.text-center.mb-4(style="background-color: #D4EDDA; border-color: #C3E6CB; font-size: 1rem;")
              i.fas.fa-check-circle.mr-2
              strong Your tutor visibility is active. You can create your profile!
            a.btn.btn-lg.w-full(href="/online-tutors/new" style="background-color: #FF7A00; border-color: #FF7A00; color: white; font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem;")
              i.fas.fa-plus-circle.mr-2
              | Create Tutor Profile
            a.btn.btn-outline-secondary.btn-lg.w-full(href="/facet/Online_Tutors" style="border-width: 2px; font-size: 1rem;")
              i.fas.fa-search.mr-2
              | Browse Tutors
        else
          .w-full
            .alert.alert-warning.text-center.mb-4(style="background-color: #FFF3CD; border-color: #FFE69C; font-size: 1rem;")
              i.fas.fa-exclamation-triangle.mr-2
              strong You need to purchase tutor visibility to create your profile
            a.btn.btn-lg.w-full(href=purchaseLink style="background-color: #FF7A00; border-color: #FF7A00; color: white; font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem;")
              i.fas.fa-credit-card.mr-2
              | Purchase Tutor Visibility
            a.btn.btn-outline-secondary.btn-lg.w-full(href="/facet/Online_Tutors" style="border-width: 2px; font-size: 1rem;")
              i.fas.fa-search.mr-2
              | Browse Tutors

      // Info
      .mt-4
        .alert.alert-info.mb-0(style="background-color: #D1ECF1; border-color: #BEE5EB; border-width: 2px;")
          p.mb-0(style="font-size: 1.2rem; font-weight: 800; color: #000; line-height: 1.6;")
            i.fas.fa-info-circle.mr-2(style="font-size: 1.3rem; color: #0c5460;")
            strong When visibility expires, creating/updating your tutor profile is blocked. 
            | Renew anytime; new days will extend from the remaining period.

      // Purchase History Section
      .mt-8.bg-white.rounded-lg.shadow-sm.p-5.border(style="border-color: #FFE4CC;")
        h3.text-xl.font-bold.mb-4(style="color: #FF7A00;")
          i.fas.fa-receipt.mr-2
          | Purchase History
        
        if payments && payments.length > 0
          .table-responsive
            table.table.table-hover
              thead(style="background-color: #FFF9F5;")
                tr
                  th Date
                  th Package
                  th Amount
                  th Status
                  th Action
              tbody
                each payment in payments
                  tr
                    td= new Date(payment.paidAt).toLocaleDateString('ko-KR')
                    td= payment.packageType || 'Tutor Visibility'
                    td ₩#{payment.amount.toLocaleString('ko-KR')}
                    td
                      if payment.status === 'paid'
                        if payment.refundRequest
                          span.badge.bg-warning.text-dark Refund Requested
                        else
                          span.badge.bg-success Paid
                      else if payment.status === 'refunded'
                        span.badge.bg-secondary Refunded
                      else
                        span.badge.bg-info= payment.status
                    td
                      if payment.status === 'paid' && !payment.refundRequest
                        - const purchaseDate = new Date(payment.paidAt)
                        - const daysSincePurchase = Math.floor((Date.now() - purchaseDate) / (1000 * 60 * 60 * 24))
                        if daysSincePurchase <= 7
                          button.btn.btn-sm.btn-warning.request-refund-btn(
                            data-payment-id=payment.paymentId,
                            data-merchant-uid=payment.merchantUid,
                            data-amount=payment.amount,
                            style="font-weight: 600;"
                          )
                            i.fas.fa-undo.mr-1
                            | Request Refund
                          span.text-muted.ms-2(style="font-size: 0.85rem;") (Auto-approved)
                        else
                          button.btn.btn-sm.btn-outline-warning.request-refund-btn(
                            data-payment-id=payment.paymentId,
                            data-merchant-uid=payment.merchantUid,
                            data-amount=payment.amount,
                            style="font-weight: 600;"
                          )
                            i.fas.fa-undo.mr-1
                            | Request Refund
                          span.text-muted.ms-2(style="font-size: 0.85rem;") (Admin review)
                      else if payment.refundRequest
                        span.text-muted.small
                          i.fas.fa-clock.mr-1
                          | Pending approval
                      else if payment.status === 'refunded'
                        span.text-success.small
                          i.fas.fa-check-circle.mr-1
                          | Completed
        else
          p.text-center.text-muted.mb-0(style="font-size: 1rem; padding: 2rem 0;") No purchase history yet.

      // Refund Request Modal
      #refundRequestModal.modal.fade(tabindex="-1" aria-labelledby="refundRequestModalLabel" aria-hidden="true")
        .modal-dialog.modal-dialog-centered
          .modal-content
            .modal-header(style="background-color: #FFF9F5; border-bottom: 2px solid #FFE4CC;")
              h5#refundRequestModalLabel.modal-title(style="font-weight: 700; color: #FF7A00;")
                i.fas.fa-undo.mr-2
                | Request Refund
              button.close(type="button" data-dismiss="modal" aria-label="Close")
                span(aria-hidden="true") &times;
            .modal-body
              .alert.alert-info.mb-3
                i.fas.fa-info-circle.mr-2
                | Please provide a reason for your refund request
              form#refundRequestForm
                input#refund-payment-id(type="hidden" name="paymentId")
                input#refund-merchant-uid(type="hidden" name="merchantUid")
                input#refund-amount(type="hidden" name="amount")
                
                .mb-3
                  label.form-label(for="refund-reason" style="font-weight: 600;") Reason for refund
                  textarea#refund-reason.form-control(
                    name="reason"
                    rows="4"
                    required
                    placeholder="Please explain why you are requesting a refund..."
                  )
                
                .alert.alert-warning.mb-3(style="font-size: 0.9rem;")
                  strong Auto-Approval Conditions:
                  ul.mb-0.mt-2
                    li Within 7 days of purchase
                    li Tutor profile not yet created
                  p.mb-0.mt-2 If conditions are not met, your request will be reviewed by an administrator.
            .modal-footer
              button.btn.btn-secondary(type="button" data-dismiss="modal") Cancel
              button#submit-refund-request.btn.btn-warning(type="button" style="font-weight: 600;")
                i.fas.fa-paper-plane.mr-2
                | Submit Request

  script.
    // Refund Request Handler (Bootstrap 4 Compatible)
    window.addEventListener('DOMContentLoaded', function() {
      // Check if jQuery is loaded
      if (typeof $ === 'undefined') {
        console.error('❌ jQuery is not loaded!');
        return;
      }
      
      console.log('🔍 Refund script loaded');
      console.log('🔍 Found refund buttons:', $('.request-refund-btn').length);
      
      const refundForm = document.getElementById('refundRequestForm');
      const submitBtn = document.getElementById('submit-refund-request');
      
      // Open modal when clicking refund button (Bootstrap 4 jQuery syntax)
      $('.request-refund-btn').on('click', function(e) {
        console.log('🔍 Refund button clicked!');
        e.preventDefault(); // Prevent any default behavior
        
        const paymentId = $(this).data('payment-id');
        const merchantUid = $(this).data('merchant-uid');
        const amount = $(this).data('amount');
        
        console.log('🔍 Payment data:', { paymentId, merchantUid, amount });
        
        $('#refund-payment-id').val(paymentId);
        $('#refund-merchant-uid').val(merchantUid);
        $('#refund-amount').val(amount);
        $('#refund-reason').val('');
        
        $('#refundRequestModal').modal('show');
      });
      
      // Submit refund request (Bootstrap 4 compatible)
      $('#submit-refund-request').on('click', async function() {
        const paymentId = $('#refund-payment-id').val();
        const merchantUid = $('#refund-merchant-uid').val();
        const amount = $('#refund-amount').val();
        const reason = $('#refund-reason').val().trim();
        
        if (!reason) {
          alert('Please provide a reason for the refund request.');
          return;
        }
        
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Processing...';
        
        try {
          const response = await fetch('/user/request-refund', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              paymentId,
              merchantUid,
              amount: Number(amount),
              reason
            })
          });
          
          const result = await response.json();
          
          if (response.ok && result.success) {
            $('#refundRequestModal').modal('hide');
            
            if (result.autoApproved) {
              alert('✅ ' + (result.message || 'Your refund has been automatically approved and processed!'));
            } else {
              alert('✅ ' + (result.message || 'Your refund request has been submitted. An administrator will review it shortly.'));
            }
            
            // Reload page to show updated status
            window.location.reload();
          } else {
            alert('❌ ' + (result.message || 'Failed to submit refund request. Please try again.'));
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-paper-plane mr-2"></i>Submit Request';
          }
        } catch (error) {
          console.error('Refund request error:', error);
          alert('❌ An error occurred. Please try again later.');
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<i class="fas fa-paper-plane mr-2"></i>Submit Request';
        }
      });
    }, false);
