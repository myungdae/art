//- views/user/mypage-tutor.pug
extends ../layout

block content
  .container.my-5
    // 헤더 (Job Seeker 페이지와 동일한 배치/타이포)
    h2.text-center.mb-4 My Page (Online Tutor)

    // 정보 카드
    .row.justify-content-center
      .col-lg-8.col-md-10
        .card.border-0.shadow-lg.rounded-xl
          .card-body.p-4
            .row
              // 좌측: 사용자 기본 정보
              .col-md-7
                p.mb-2
                  strong Username:
                  |  #{(user && user.username) || (session && session.user && session.user.username) || '-'}
                p.mb-2
                  strong Email:
                  |  #{(user && user.email) || (session && session.user && session.user.email) || '-'}
                p.mb-0
                  strong Role:
                  |  #{(user && user.role) || (session && session.user && session.user.role) || '-'}

                // 상태 라인 (Job Seeker의 “Remaining Days…” 자리에 해당)
                if onlineTutor
                  p.mt-3.mb-0.text-success
                    | ✅ Tutor Profile: Active
                else
                  p.mt-3.mb-0.text-warning
                    | ⚠️ Tutor Profile: Not Created

              // 우측: 액션 버튼(정렬/간격 Job Seeker와 동일 스타일)
              .col-md-5.mt-3.mt-md-0.d-flex.align-items-center
                .w-100
                  if onlineTutor
                    .d-flex.flex-column.flex-sm-row
                      a.btn.btn-success.mb-2.mb-sm-0.mr-sm-2.w-100(href=`/online-tutors/${onlineTutor._id}/edit`)
                        | Edit Profile
                      a.btn.btn-outline-primary.w-100(href=`/rdf-resource/Online_Tutors/${onlineTutor._id}`)
                        | View Public Page
                    // 삭제 버튼은 한 줄 아래로 분리(실수 방지)
                    form.mt-2(method="POST", action=`/online-tutors/${onlineTutor._id}`)
                      input(type="hidden", name="_method", value="DELETE")
                      button.btn.btn-outline-danger.btn-block(type="submit", onclick="return confirm('Delete this profile?')")
                        | Delete Profile
                  else
                    .d-flex.flex-column.flex-sm-row
                      a.btn.btn-success.mb-2.mb-sm-0.mr-sm-2.w-100(href="/online-tutors/new")
                        | Create Tutor Profile
                      a.btn.btn-outline-secondary.w-100(href="/facet/Online_Tutors")
                        | Browse Tutors

    // 하단 보조 네비(옵션, Job Seeker 페이지의 흐름과 맞춤)
    .text-center.mt-4
      a.btn.btn-light.px-4(href="/") ← Back to Home
