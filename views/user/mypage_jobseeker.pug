extends ../layout

block content
  .container.mt-5
    .text-center
      h2.mb-4(style="font-size: 2.5rem; font-weight: bold; color: #333;") My Page (Job Seeker)

    .card.shadow.p-4(style="max-width: 500px; margin: 0 auto; border-radius: 1rem; background: #f9f9f9;")
      p.mb-2(style="font-size: 1.2rem;") 
        strong Username:
        |  #{user.username}

      p.mb-2(style="font-size: 1.2rem;")
        strong Email:
        |  #{user.email}

      p.mb-2(style="font-size: 1.2rem;")
        strong Role:
        |  #{user.role}

      p.mb-4(style="font-size: 1.3rem; color: #28a745;")
        span 🔑 
        | Remaining Days of Resume Access: 
        strong #{remainingDays}

      .d-flex.justify-content-center.gap-3
        a.btn.btn-lg.btn-success(href="/resume/register") Register Resume
        if remainingDays <= 0
          a.btn.btn-lg.btn-primary(href="/paypal/checkout-resume") Purchase Resume Visibility
        else
          a.btn.btn-lg.btn-secondary.disabled Purchase Resume Visibility
