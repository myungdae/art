extends ../layout

block content
  .container.mx-auto.px-4.py-10
    h1.text-2xl.text-center.mb-8 Employer Dashboard

    // User info
    .max-w-xl.mx-auto.bg-white.rounded-xl.shadow.p-6
      p Username: #{user.username}
      p Email: #{user.email}
      p Role: #{user.role}

    // Slots card
    .max-w-xl.mx-auto.mt-6.bg-gray-50.rounded-xl.shadow.p-6
      p Current postings: #{activeJobs} / #{totalSlots}
      p Remaining slots: #{remainingSlots}
      if nextExpireAt
        p Soonest expiration: #{nextExpireTitle ? `${nextExpireTitle} — ` : ''}#{nextExpireAt} (#{expireTag})

      // Actions
      .flex.gap-3.mt-4
        if canPost
          a.btn.btn-primary(href='/job-vacancies/new') Buy Ad Credits
          a.btn(href='/job-vacancies/mine') My Job Vacancies
        else
          a.btn.btn-primary(href="/job-vacancies/new") Buy Ad Credits
          a.btn(href='/job-vacancies/mine') My Job Vacancies

    // Job list
    if jobVacancies && jobVacancies.length
      ul.mt-6.max-w-xl.mx-auto.list-disc.pl-6
        each j in jobVacancies
          li #{j.title}
    else
      p.mt-6.text-gray-500.text-center No job vacancies posted yet.
