extends ../layout

block content
  .container.mx-auto.px-4.py-10
    .max-w-2xl.mx-auto.p-6.border.rounded-lg(style="border-color: #FFD6B3 !important; border-width: 3px; background-color: #FFF9F5;")
      h1.text-3xl.font-bold.text-center.mb-8(style="color: #FF7A00;") Employer Dashboard

      // User info
      .bg-white.rounded-lg.shadow-sm.p-5.mb-6.border(style="border-color: #FFE4CC;")
        p.mb-2.text-lg
          strong.text-gray-700 Username: 
          span.text-gray-900 #{user.username}
        p.mb-2.text-lg
          strong.text-gray-700 Email: 
          span.text-gray-900 #{user.email}
        p.text-lg
          strong.text-gray-700 Role: 
          span.text-gray-900 #{user.role}

      // Account Validity Period
      .alert.alert-info.mb-6(style="background-color: #E3F2FD; border: 2px solid #2196F3; border-left: 6px solid #2196F3; border-radius: 8px; padding: 1.25rem;")
        .d-flex.align-items-start
          i.fas.fa-info-circle(style="color: #1976D2; font-size: 1.5rem; margin-top: 3px; margin-right: 14px; flex-shrink: 0;")
          div(style="font-size: 1.05rem; line-height: 1.7; color: #000;")
            strong(style="font-size: 1.15rem; font-weight: 700; color: #000;") ACCOUNT VALIDITY PERIOD
            p.mb-2.mt-2(style="font-weight: 500; color: #000;") Your account will remain active for 120 days from registration.
            ul.mb-0.ps-3(style="font-size: 1rem; font-weight: 500; line-height: 1.8;")
              li(style="color: #000;") You will receive email reminders at 90 days and 110 days
              li(style="color: #000;") Accounts with no credits will be automatically deleted after 120 days
              li(style="color: #000;") Accounts with active credits will never expire

      // Slots card
      .bg-white.rounded-lg.shadow-sm.p-5.border(style="border-color: #FFE4CC;")
        p.mb-3.text-lg
          strong.text-gray-700 Current postings: 
          span.font-bold.text-xl(style="color: #FF7A00;") #{activeJobs}
        p.mb-4.text-lg
          strong.text-gray-700 Ad Credits Available: 
          span.font-bold.text-xl(class=credits > 0 ? '' : 'text-red-600' style=credits > 0 ? 'color: #28a745;' : '') #{credits}

        // Actions
        .flex.flex-col.gap-3.mt-5
          if canPost
            a.btn.btn-lg.w-full(href='/job-vacancies/new' style="background-color: #FF7A00; border-color: #FF7A00; color: white; font-size: 1.125rem; font-weight: 600;")
              i.fas.fa-plus-circle.mr-2
              | Post New Job
            a.btn.btn-outline-secondary.btn-lg.w-full(href='/job-vacancies/mine' style="border-width: 2px; font-size: 1rem;")
              i.fas.fa-list.mr-2
              | My Job Vacancies
          else
            .w-full
              .alert.alert-warning.text-center.mb-4(style="background-color: #FFF3CD; border-color: #FFE69C; font-size: 1rem;")
                i.fas.fa-exclamation-triangle.mr-2
                strong You need to purchase ad credits to post job vacancies
              a.btn.btn-lg.w-full(href="/paddle/checkout" style="background-color: #FF7A00; border-color: #FF7A00; color: white; font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem;")
                i.fas.fa-credit-card.mr-2
                | Buy Ad Credits
              a.btn.btn-outline-secondary.btn-lg.w-full(href='/job-vacancies/mine' style="border-width: 2px; font-size: 1rem;")
                i.fas.fa-list.mr-2
                | My Job Vacancies

      // Job list
      if activeJobs > 0
      else
        p.mt-6.text-gray-500.text-center.text-lg No job vacancies posted yet.
