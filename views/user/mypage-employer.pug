extends ../layout

block content
  style.
    .employer-dashboard {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    .employer-dashboard h1 {
      font-size: 2.5rem;
      font-weight: 800;
      color: #FF7A00 !important;
    }
    .employer-dashboard .info-label {
      font-size: 1.1rem;
      font-weight: 700;
      color: #000 !important;
    }
    .employer-dashboard .info-value {
      font-size: 1.1rem;
      font-weight: 600;
      color: #000 !important;
    }
    .employer-dashboard .stat-label {
      font-size: 1.15rem;
      font-weight: 700;
      color: #000 !important;
    }
    .employer-dashboard .stat-number {
      font-size: 1.5rem;
      font-weight: 800;
    }
    .employer-dashboard .warning-text {
      font-size: 1.1rem;
      font-weight: 700;
      color: #000 !important;
    }
    
  .container.mx-auto.px-4.py-10.employer-dashboard
    .max-w-2xl.mx-auto.p-6.border.rounded-lg(style="border-color: #FFD6B3 !important; border-width: 3px; background-color: #FFF9F5;")
      h1.text-center.mb-8 Employer Dashboard

      // User info
      .bg-white.rounded-lg.shadow-sm.p-5.mb-6.border(style="border-color: #FFE4CC;")
        p.mb-3
          span.info-label Username: 
          span.info-value #{user.username}
        p.mb-3
          span.info-label Email: 
          span.info-value #{user.email}
        p
          span.info-label Role: 
          span.info-value #{user.role}

      // Account Validity Period
      .alert.alert-info.mb-6(style="background-color: #E3F2FD; border: 2px solid #2196F3; border-left: 6px solid #2196F3; border-radius: 8px; padding: 1.25rem;")
        .d-flex.align-items-start
          i.fas.fa-info-circle(style="color: #1976D2; font-size: 1.5rem; margin-top: 3px; margin-right: 14px; flex-shrink: 0;")
          div(style="font-size: 1.05rem; line-height: 1.7; color: #000;")
            strong(style="font-size: 1.15rem; font-weight: 700; color: #000;") ACCOUNT VALIDITY PERIOD
            p.mb-2.mt-2(style="font-weight: 500; color: #000;") Your account will remain active for 120 days from registration.
            ul.mb-0.ps-3(style="font-size: 1rem; font-weight: 500; line-height: 1.8;")
              li(style="color: #000;") You will receive email reminders at 90 days and 110 days
              li(style="color: #000;") Accounts with no credits will be automatically deleted after 120 days
              li(style="color: #000;") Accounts with active credits will never expire

      // Slots card
      .bg-white.rounded-lg.shadow-sm.p-5.border(style="border-color: #FFE4CC;")
        p.mb-4
          span.stat-label Current postings: 
          span.stat-number(style="color: #FF7A00;") #{activeJobs}
        p.mb-5
          span.stat-label Ad Credits Available: 
          span.stat-number(style=credits > 0 ? 'color: #28a745;' : 'color: #dc3545;') #{credits}

        // Actions
        .flex.flex-col.gap-3.mt-5
          if canPost
            a.btn.btn-lg.w-full(href='/job-vacancies/new' style="background-color: #FF7A00; border-color: #FF7A00; color: white; font-size: 1.2rem; font-weight: 700; padding: 1rem;")
              i.fas.fa-plus-circle.mr-2
              | Post New Job
            a.btn.btn-outline-secondary.btn-lg.w-full(href='/job-vacancies/mine' style="border-width: 2px; border-color: #333; font-size: 1.1rem; font-weight: 600; color: #000; padding: 0.9rem;")
              i.fas.fa-list.mr-2
              | My Job Vacancies
          else
            .w-full
              .alert.alert-warning.text-center.mb-4(style="background-color: #FFF3CD; border: 2px solid #FFE69C; border-radius: 8px; padding: 1.25rem;")
                i.fas.fa-exclamation-triangle.mr-2(style="font-size: 1.2rem; color: #856404;")
                span.warning-text YOU NEED TO PURCHASE AD CREDITS TO POST JOB VACANCIES
              a.btn.btn-lg.w-full(href="/portone/checkout" style="background-color: #FF7A00; border-color: #FF7A00; color: white; font-size: 1.2rem; font-weight: 700; margin-bottom: 0.75rem; padding: 1rem;")
                i.fas.fa-credit-card.mr-2
                | Buy Ad Credits
              a.btn.btn-outline-secondary.btn-lg.w-full(href='/job-vacancies/mine' style="border-width: 2px; border-color: #333; font-size: 1.1rem; font-weight: 600; color: #000; padding: 0.9rem;")
                i.fas.fa-list.mr-2
                | My Job Vacancies

      // Job list
      if activeJobs > 0
      else
        p.mt-6.text-center(style="font-size: 1.1rem; font-weight: 600; color: #666;") No job vacancies posted yet.

      // Purchase History Section
      .mt-8.bg-white.rounded-lg.shadow-sm.p-5.border(style="border-color: #FFE4CC;")
        h3.mb-4(style="font-size: 1.5rem; font-weight: 700; color: #FF7A00;")
          i.fas.fa-receipt.mr-2
          | Purchase History
        
        if payments && payments.length > 0
          .table-responsive
            table.table.table-hover
              thead(style="background-color: #FFF9F5;")
                tr
                  th Date
                  th Package
                  th Amount
                  th Status
                  th Action
              tbody
                each payment in payments
                  tr
                    td= new Date(payment.paidAt).toLocaleDateString('ko-KR')
                    td= payment.packageType || 'Ad Credits'
                    td ₩#{payment.amount.toLocaleString('ko-KR')}
                    td
                      if payment.status === 'paid'
                        if payment.refundRequest
                          span.badge.bg-warning.text-dark Refund Requested
                        else
                          span.badge.bg-success Paid
                      else if payment.status === 'refunded'
                        span.badge.bg-secondary Refunded
                      else
                        span.badge.bg-info= payment.status
                    td
                      if payment.status === 'paid' && !payment.refundRequest
                        - const purchaseDate = new Date(payment.paidAt)
                        - const daysSincePurchase = Math.floor((Date.now() - purchaseDate) / (1000 * 60 * 60 * 24))
                        if daysSincePurchase <= 7
                          button.btn.btn-sm.btn-warning.request-refund-btn(
                            data-payment-id=payment.paymentId,
                            data-merchant-uid=payment.merchantUid,
                            data-amount=payment.amount,
                            style="font-weight: 600;"
                          )
                            i.fas.fa-undo.mr-1
                            | Request Refund
                          span.text-muted.ms-2(style="font-size: 0.85rem;") (Auto-approved)
                        else
                          button.btn.btn-sm.btn-outline-warning.request-refund-btn(
                            data-payment-id=payment.paymentId,
                            data-merchant-uid=payment.merchantUid,
                            data-amount=payment.amount,
                            style="font-weight: 600;"
                          )
                            i.fas.fa-undo.mr-1
                            | Request Refund
                          span.text-muted.ms-2(style="font-size: 0.85rem;") (Admin review)
                      else if payment.refundRequest
                        span.text-muted.small
                          i.fas.fa-clock.mr-1
                          | Pending approval
                      else if payment.status === 'refunded'
                        span.text-success.small
                          i.fas.fa-check-circle.mr-1
                          | Completed
        else
          p.text-center.text-muted.mb-0(style="font-size: 1rem; padding: 2rem 0;") No purchase history yet.

      // Refund Request Modal
      #refundRequestModal.modal.fade(tabindex="-1" aria-labelledby="refundRequestModalLabel" aria-hidden="true")
        .modal-dialog.modal-dialog-centered
          .modal-content
            .modal-header(style="background-color: #FFF9F5; border-bottom: 2px solid #FFE4CC;")
              h5#refundRequestModalLabel.modal-title(style="font-weight: 700; color: #FF7A00;")
                i.fas.fa-undo.mr-2
                | Request Refund
              button.close(type="button" data-dismiss="modal" aria-label="Close")
                span(aria-hidden="true") &times;
            .modal-body
              .alert.alert-info.mb-3
                i.fas.fa-info-circle.mr-2
                | Please provide a reason for your refund request
              form#refundRequestForm
                input#refund-payment-id(type="hidden" name="paymentId")
                input#refund-merchant-uid(type="hidden" name="merchantUid")
                input#refund-amount(type="hidden" name="amount")
                
                .mb-3
                  label.form-label(for="refund-reason" style="font-weight: 600;") Reason for refund
                  textarea#refund-reason.form-control(
                    name="reason"
                    rows="4"
                    required
                    placeholder="Please explain why you are requesting a refund..."
                  )
                
                .alert.alert-warning.mb-3(style="font-size: 0.9rem;")
                  strong Auto-Approval Conditions:
                  ul.mb-0.mt-2
                    li Within 7 days of purchase
                    li No job ads posted after purchase
                  p.mb-0.mt-2 If conditions are not met, your request will be reviewed by an administrator.
            .modal-footer
              button.btn.btn-secondary(type="button" data-dismiss="modal") Cancel
              button#submit-refund-request.btn.btn-warning(type="button" style="font-weight: 600;")
                i.fas.fa-paper-plane.mr-2
                | Submit Request

  script.
    // Refund Request Handler (Bootstrap 4 Compatible)
    $(document).ready(function() {
      const refundForm = document.getElementById('refundRequestForm');
      const submitBtn = document.getElementById('submit-refund-request');
      
      // Open modal when clicking refund button (Bootstrap 4 jQuery syntax)
      $('.request-refund-btn').on('click', function() {
        const paymentId = $(this).data('payment-id');
        const merchantUid = $(this).data('merchant-uid');
        const amount = $(this).data('amount');
        
        $('#refund-payment-id').val(paymentId);
        $('#refund-merchant-uid').val(merchantUid);
        $('#refund-amount').val(amount);
        $('#refund-reason').val('');
        
        $('#refundRequestModal').modal('show');
      });
      
      // Submit refund request (Bootstrap 4 compatible)
      $('#submit-refund-request').on('click', async function() {
        const paymentId = $('#refund-payment-id').val();
        const merchantUid = $('#refund-merchant-uid').val();
        const amount = $('#refund-amount').val();
        const reason = $('#refund-reason').val().trim();
        
        if (!reason) {
          alert('Please provide a reason for the refund request.');
          return;
        }
        
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Processing...';
        
        try {
          const response = await fetch('/user/request-refund', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              paymentId,
              merchantUid,
              amount: Number(amount),
              reason
            })
          });
          
          const result = await response.json();
          
          if (response.ok && result.success) {
            $('#refundRequestModal').modal('hide');
            
            if (result.autoApproved) {
              alert('✅ ' + (result.message || 'Your refund has been automatically approved and processed!'));
            } else {
              alert('✅ ' + (result.message || 'Your refund request has been submitted. An administrator will review it shortly.'));
            }
            
            // Reload page to show updated status
            window.location.reload();
          } else {
            alert('❌ ' + (result.message || 'Failed to submit refund request. Please try again.'));
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-paper-plane mr-2"></i>Submit Request';
          }
        } catch (error) {
          console.error('Refund request error:', error);
          alert('❌ An error occurred. Please try again later.');
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<i class="fas fa-paper-plane mr-2"></i>Submit Request';
        }
      });
    });
