extends ../layout

block content
  style.
    /* High-visibility text styling */
    .dashboard-label {
      font-weight: 900 !important;
      font-size: 1.35rem !important;
      color: #000 !important;
      letter-spacing: -0.02em !important;
    }
    .dashboard-value {
      font-weight: 800 !important;
      font-size: 1.35rem !important;
      color: #000 !important;
      letter-spacing: -0.02em !important;
    }
    .dashboard-status {
      font-weight: 900 !important;
      font-size: 1.6rem !important;
    }
    .dashboard-days {
      font-weight: 900 !important;
      font-size: 1.8rem !important;
    }
    .alert {
      font-size: 1.15rem !important;
    }
    .alert strong {
      font-weight: 900 !important;
      font-size: 1.25rem !important;
      color: #000 !important;
    }
    .btn {
      font-weight: 800 !important;
      font-size: 1.2rem !important;
    }
  
  .container.mx-auto.px-4.py-10
    .max-w-2xl.mx-auto.p-6.border.rounded-lg(style="border-color: #FFD6B3 !important; border-width: 3px; background-color: #FFF9F5;")
      h1.text-3xl.font-bold.text-center.mb-8(style="color: #FF7A00; font-weight: 900; font-size: 3rem; letter-spacing: -0.02em;") Job Seeker Dashboard

      // User info
      .bg-white.rounded-lg.shadow-sm.p-5.mb-6.border(style="border-color: #FFE4CC;")
        p.mb-2
          strong.dashboard-label Username: 
          span.dashboard-value #{user.username}
        p.mb-2
          strong.dashboard-label Email: 
          span.dashboard-value #{user.email}
        p
          strong.dashboard-label Role: 
          span.dashboard-value #{user.role}

      // My Resume card
      if hasResume
        .bg-white.rounded-lg.shadow-sm.p-5.mb-6.border(style="border-color: #FFE4CC;")
          h3.text-xl.font-bold.mb-4(style="color: #FF7A00;")
            i.fas.fa-file-alt.mr-2
            | My Resume
          if userResume
            p.mb-2
              strong.dashboard-label Title: 
              span.dashboard-value #{userResume.title || 'No title'}
            p.mb-2
              strong.dashboard-label Nationality: 
              span.dashboard-value #{userResume.nationality || 'N/A'}
            p.mb-2
              strong.dashboard-label Preferred Location: 
              span.dashboard-value #{userResume.preferredWorkLocation || 'N/A'}
            p.mb-3(style="font-size: 1rem; font-weight: 600; color: #666;")
              | Last updated: #{formattedUpdatedAt}
          .flex.flex-col.gap-3.mt-4
            a.btn.btn-lg.w-full(href=`/job-seekers/${userResume._id}/edit` style="background-color: #FF7A00; border-color: #FF7A00; color: white; font-size: 1.125rem; font-weight: 600;")
              i.fas.fa-edit.mr-2
              | Edit Resume
            a.btn.btn-outline-secondary.btn-lg.w-full(href='/facet/Job_Seekers' style="border-width: 2px; font-size: 1rem;")
              i.fas.fa-search.mr-2
              | View All Resumes

      // Resume Access Status card
      .bg-white.rounded-lg.shadow-sm.p-5.border(style="border-color: #FFE4CC;")
        p.mb-3
          strong.dashboard-label Resume Access Status: 
          if hasActiveResumeAccess
            span.dashboard-status(style="color: #28a745;")
              i.fas.fa-check-circle.mr-1
              | Active
          else
            span.dashboard-status(style="color: #dc3545;")
              i.fas.fa-times-circle.mr-1
              | Inactive

        if hasActiveResumeAccess
          p.mb-2
            strong.dashboard-label Remaining Days: 
            span.dashboard-days(style="color: #28a745;") #{remainingDays} days
          if expiryDate
            p.mb-4
              strong.dashboard-label Expires on: 
              span.dashboard-value #{expiryDate}
        else
          p.mb-4
            strong.dashboard-label Remaining Days: 
            span.dashboard-days(style="color: #dc3545;") 0 days

        // Actions (Same logic as Employer: Check Access FIRST, then Resume)
        .flex.flex-col.gap-3.mt-5
          if !hasActiveResumeAccess
            // No active access - show purchase button (Like Employer "Buy Credits")
            .w-full
              .alert.alert-warning.text-center.mb-4(style="background-color: #FFF3CD; border-color: #FFE69C; font-size: 1rem;")
                i.fas.fa-exclamation-triangle.mr-2
                strong You need to purchase resume access to search for jobs
              a.btn.btn-lg.w-full(href='/portone/checkout?type=resume&accessPeriod=30' style="background-color: #FF7A00; border-color: #FF7A00; color: white; font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem;")
                i.fas.fa-credit-card.mr-2
                | Purchase Resume Access
              if hasResume
                a.btn.btn-outline-secondary.btn-lg.w-full(href=`/job-seekers/${userResume._id}/edit` style="border-width: 2px; font-size: 1rem;")
                  i.fas.fa-edit.mr-2
                  | Edit My Resume
          else if !hasResume
            // Has access but no resume - show register button (Like Employer "Post New Job")
            .w-full
              .alert.alert-info.text-center.mb-4(style="background-color: #D1ECF1; border-color: #BEE5EB; font-size: 1rem;")
                i.fas.fa-info-circle.mr-2
                strong You have resume access! Create your resume to start applying for jobs
              a.btn.btn-lg.w-full(href='/job-seekers/new' style="background-color: #FF7A00; border-color: #FF7A00; color: white; font-size: 1.125rem; font-weight: 600;")
                i.fas.fa-plus-circle.mr-2
                | Register Resume
          else
            // Has access and resume - show search links
            .w-full
              .alert.alert-success.text-center.mb-4(style="background-color: #D4EDDA; border-color: #C3E6CB; font-size: 1rem;")
                i.fas.fa-check-circle.mr-2
                strong Your resume is active. You can search for jobs!
              a.btn.btn-lg.w-full(href='/job-vacancies' style="background-color: #FF7A00; border-color: #FF7A00; color: white; font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem;")
                i.fas.fa-briefcase.mr-2
                | Search Job Vacancies
              a.btn.btn-outline-secondary.btn-lg.w-full(href='/portone/checkout?type=resume&accessPeriod=30' style="border-width: 2px; font-size: 1rem;")
                i.fas.fa-sync.mr-2
                | Extend Resume Access

      // Purchase History Section
      .mt-8.bg-white.rounded-lg.shadow-sm.p-5.border(style="border-color: #FFE4CC;")
        h3.text-xl.font-bold.mb-4(style="color: #FF7A00;")
          i.fas.fa-receipt.mr-2
          | Purchase History
        
        if payments && payments.length > 0
          .table-responsive
            table.table.table-hover
              thead(style="background-color: #FFF9F5;")
                tr
                  th Date
                  th Package
                  th Amount
                  th Status
                  th Action
              tbody
                each payment in payments
                  tr
                    td= new Date(payment.paidAt).toLocaleDateString('ko-KR')
                    td= payment.packageType || 'Resume Access'
                    td ₩#{payment.amount.toLocaleString('ko-KR')}
                    td
                      if payment.status === 'paid'
                        if payment.refundRequest
                          span.badge.bg-warning.text-dark Refund Requested
                        else
                          span.badge.bg-success Paid
                      else if payment.status === 'refunded'
                        span.badge.bg-secondary Refunded
                      else
                        span.badge.bg-info= payment.status
                    td
                      if payment.status === 'paid' && !payment.refundRequest
                        - const purchaseDate = new Date(payment.paidAt)
                        - const daysSincePurchase = Math.floor((Date.now() - purchaseDate) / (1000 * 60 * 60 * 24))
                        if daysSincePurchase <= 7
                          button.btn.btn-sm.btn-warning.request-refund-btn(
                            data-payment-id=payment.paymentId,
                            data-merchant-uid=payment.merchantUid,
                            data-amount=payment.amount,
                            style="font-weight: 600;"
                          )
                            i.fas.fa-undo.mr-1
                            | Request Refund
                          span.text-muted.ms-2(style="font-size: 0.85rem;") (Auto-approved)
                        else
                          button.btn.btn-sm.btn-outline-warning.request-refund-btn(
                            data-payment-id=payment.paymentId,
                            data-merchant-uid=payment.merchantUid,
                            data-amount=payment.amount,
                            style="font-weight: 600;"
                          )
                            i.fas.fa-undo.mr-1
                            | Request Refund
                          span.text-muted.ms-2(style="font-size: 0.85rem;") (Admin review)
                      else if payment.refundRequest
                        span.text-muted.small
                          i.fas.fa-clock.mr-1
                          | Pending approval
                      else if payment.status === 'refunded'
                        span.text-success.small
                          i.fas.fa-check-circle.mr-1
                          | Completed
        else
          p.text-center.text-muted.mb-0(style="font-size: 1rem; padding: 2rem 0;") No purchase history yet.

      // Refund Request Modal
      #refundRequestModal.modal.fade(tabindex="-1" aria-labelledby="refundRequestModalLabel" aria-hidden="true")
        .modal-dialog.modal-dialog-centered
          .modal-content
            .modal-header(style="background-color: #FFF9F5; border-bottom: 2px solid #FFE4CC;")
              h5#refundRequestModalLabel.modal-title(style="font-weight: 700; color: #FF7A00;")
                i.fas.fa-undo.mr-2
                | Request Refund
              button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
            .modal-body
              .alert.alert-info.mb-3
                i.fas.fa-info-circle.mr-2
                | Please provide a reason for your refund request
              form#refundRequestForm
                input#refund-payment-id(type="hidden" name="paymentId")
                input#refund-merchant-uid(type="hidden" name="merchantUid")
                input#refund-amount(type="hidden" name="amount")
                
                .mb-3
                  label.form-label(for="refund-reason" style="font-weight: 600;") Reason for refund
                  textarea#refund-reason.form-control(
                    name="reason"
                    rows="4"
                    required
                    placeholder="Please explain why you are requesting a refund..."
                  )
                
                .alert.alert-warning.mb-3(style="font-size: 0.9rem;")
                  strong Auto-Approval Conditions:
                  ul.mb-0.mt-2
                    li Within 7 days of purchase
                    li Resume access not yet used
                  p.mb-0.mt-2 If conditions are not met, your request will be reviewed by an administrator.
            .modal-footer
              button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
              button#submit-refund-request.btn.btn-warning(type="button" style="font-weight: 600;")
                i.fas.fa-paper-plane.mr-2
                | Submit Request

  script.
    // Refund Request Handler
    document.addEventListener('DOMContentLoaded', function() {
      const refundModal = new bootstrap.Modal(document.getElementById('refundRequestModal'));
      const refundForm = document.getElementById('refundRequestForm');
      const submitBtn = document.getElementById('submit-refund-request');
      
      // Open modal when clicking refund button
      document.querySelectorAll('.request-refund-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const paymentId = this.dataset.paymentId;
          const merchantUid = this.dataset.merchantUid;
          const amount = this.dataset.amount;
          
          document.getElementById('refund-payment-id').value = paymentId;
          document.getElementById('refund-merchant-uid').value = merchantUid;
          document.getElementById('refund-amount').value = amount;
          document.getElementById('refund-reason').value = '';
          
          refundModal.show();
        });
      });
      
      // Submit refund request
      submitBtn.addEventListener('click', async function() {
        const paymentId = document.getElementById('refund-payment-id').value;
        const merchantUid = document.getElementById('refund-merchant-uid').value;
        const amount = document.getElementById('refund-amount').value;
        const reason = document.getElementById('refund-reason').value.trim();
        
        if (!reason) {
          alert('Please provide a reason for the refund request.');
          return;
        }
        
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Processing...';
        
        try {
          const response = await fetch('/user/request-refund', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              paymentId,
              merchantUid,
              amount: Number(amount),
              reason
            })
          });
          
          const result = await response.json();
          
          if (response.ok && result.success) {
            refundModal.hide();
            
            if (result.autoApproved) {
              alert('✅ ' + (result.message || 'Your refund has been automatically approved and processed!'));
            } else {
              alert('✅ ' + (result.message || 'Your refund request has been submitted. An administrator will review it shortly.'));
            }
            
            // Reload page to show updated status
            window.location.reload();
          } else {
            alert('❌ ' + (result.message || 'Failed to submit refund request. Please try again.'));
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-paper-plane mr-2"></i>Submit Request';
          }
        } catch (error) {
          console.error('Refund request error:', error);
          alert('❌ An error occurred. Please try again later.');
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<i class="fas fa-paper-plane mr-2"></i>Submit Request';
        }
      });
    });
