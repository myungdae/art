extends ../layout

block content
  .container.mx-auto.px-4.py-10
    h1.text-2xl.text-center.mb-8 Job Seeker Dashboard

    // User info
    .max-w-xl.mx-auto.bg-white.rounded-xl.shadow.p-6
      p Username: #{user.username}
      p Email: #{user.email}
      p Role: #{user.role}

    // My Resume card
    if hasResume
      .max-w-xl.mx-auto.mt-6.bg-gray-50.rounded-xl.shadow.p-6
        h3.text-lg.font-bold.mb-3
          i.fas.fa-file-alt.mr-2
          | My Resume
        if userResume
          p.mb-2
            strong Title: 
            span #{userResume.title || 'No title'}
          p.mb-2
            strong Nationality: 
            span #{userResume.nationality || 'N/A'}
          p.mb-2
            strong Preferred Location: 
            span #{userResume.preferredWorkLocation || 'N/A'}
          p.mb-2.text-sm.text-gray-600
            | Last updated: #{formattedUpdatedAt}
        .flex.gap-3.mt-4
          a.btn.btn-outline-primary(href=`/job-seekers/${userResume._id}/edit`)
            i.fas.fa-edit.mr-2
            | Edit Resume
          a.btn.btn-outline-secondary(href='/facet/Job_Seekers')
            i.fas.fa-search.mr-2
            | View All Resumes

    // Resume Access Status card
    .max-w-xl.mx-auto.mt-6.bg-gray-50.rounded-xl.shadow.p-6
      p.mb-2
        strong Resume Access Status: 
        if hasActiveResumeAccess
          span.text-green-600.font-bold
            i.fas.fa-check-circle.mr-1
            | Active
        else
          span.text-red-600.font-bold
            i.fas.fa-times-circle.mr-1
            | Inactive

      if hasActiveResumeAccess
        p.mb-2
          strong Remaining Days: 
          span.text-green-600.font-bold #{remainingDays} days
        if expiryDate
          p.mb-2
            strong Expires on: 
            span #{expiryDate}
      else
        p.mb-2
          strong Remaining Days: 
          span.text-red-600.font-bold 0 days

      // Actions (Same logic as Employer: Check Access FIRST, then Resume)
      .flex.flex-col.gap-3.mt-4
        if !hasActiveResumeAccess
          // No active access - show purchase button (Like Employer "Buy Credits")
          .w-full
            p.text-red-600.mb-3.text-center
              i.fas.fa-exclamation-circle.mr-2
              | You need to purchase resume access to search for jobs
            a.btn.btn-primary.w-full(href='/stripe/checkout?type=resume&accessPeriod=30')
              i.fas.fa-credit-card.mr-2
              | Purchase Resume Access
            if hasResume
              a.btn.btn-outline-secondary.w-full.mt-2(href=`/job-seekers/${userResume._id}/edit`)
                i.fas.fa-edit.mr-2
                | Edit My Resume
        else if !hasResume
          // Has access but no resume - show register button (Like Employer "Post New Job")
          .w-full
            p.text-blue-600.mb-3.text-center
              i.fas.fa-info-circle.mr-2
              | You have resume access! Create your resume to start applying for jobs
            a.btn.btn-success.w-full(href='/job-seekers/new')
              i.fas.fa-plus-circle.mr-2
              | Register Resume
        else
          // Has access and resume - show search links
          .w-full
            p.text-green-600.mb-3.text-center
              i.fas.fa-check-circle.mr-2
              | Your resume is active. You can search for jobs!
            a.btn.btn-success.w-full(href='/job-vacancies')
              i.fas.fa-briefcase.mr-2
              | Search Job Vacancies
            a.btn.btn-outline-primary.w-full.mt-2(href='/stripe/checkout?type=resume&accessPeriod=30')
              i.fas.fa-sync.mr-2
              | Extend Resume Access
