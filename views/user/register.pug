extends ../layout

block content
  .container.mt-5
    h3.mb-4.text-center 회원가입

    form(method="POST", action="/user/register")
      .form-group.mb-3
        label(for="username") 사용자 이름
        input#username.form-control(type="text", name="username", placeholder="사용자 이름 입력", required)

      .form-group.mb-3
        label(for="email") 이메일
        input#email.form-control(type="email", name="email", placeholder="이메일 입력", required)

      .form-group.mb-3
        label(for="password") 비밀번호
        input#password.form-control(type="password", name="password", placeholder="비밀번호 입력", required)

      .form-group.mb-4
        label(for="role") 회원 종류 선택
        select#role.form-control(name="role", required)
          option(value="") -- 선택하세요 --
          option(value="Job_Vacancies") Job Vacancies
          option(value="Job_Seekers") Job Seekers
          option(value="Online_Tutor") Online Tutor

      .form-group.text-center
        button.btn.btn-primary(type="submit") 가입하기
