extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-6
        .p-4.border.rounded(style="border-color: #FFD6B3 !important; border-width: 2px; background-color: #FFF9F5;")
          h2.text-center.mb-5.fs-2 Register

          form(method='POST', action='/user/register')
          .mb-4
            label.form-label(for='username') Username
            input.form-control.fs-5(type='text', name='username', id='username', placeholder='Enter your name', required)

          .mb-4
            label.form-label(for='email') Email
            input.form-control.fs-5(type='email', name='email', id='email', placeholder='Enter your email', required)

          .mb-4
            label.form-label(for='password') Password
            input.form-control.fs-5(type='password', name='password', id='password', placeholder='Enter your password', required)

          .mb-4
            label.form-label(for='role') Select your role
            select.form-select.fs-5(name='role', id='role', required)
              option(value='') -- Please select --
              option(value='Employer') Employer
              option(value="Job_Seeker") Job Seeker
              option(value='OnlineTutor') Online Tutor

            .d-grid.mt-4
              button.btn.btn-lg.btn-primary(type='submit') Register
