//- views/user/register.pug
extends ../layout

block append_on_header
  style.
    .auth-card{width:100%;max-width:640px;background:#fff;border-radius:10px;box-shadow:0 10px 26px rgba(0,0,0,.1);overflow:hidden;margin:0 auto}
    .auth-title{background:#FF7A00;color:#fff;font-weight:700;text-align:center;padding:.8rem 1rem;font-size:28px}
    .auth-field{margin:16px 20px 0}
    .auth-field label{display:block;font-weight:700;color:#333;margin-bottom:6px}
    .auth-field .form-control{height:3rem;border-radius:9999px;padding:0 1rem}
    .auth-actions{padding:20px}
    .auth-actions .btn-success{background:#2ecc71;border-color:#2ecc71;padding:.6rem 1.5rem;border-radius:8px;font-weight:700}
    .auth-note{padding:0 20px 16px;color:#6b7280}
    .auth-role{margin:4px 20px 0}
    .role-grid{display:grid;grid-template-columns:1fr;gap:12px}
    @media (min-width:576px){.role-grid{grid-template-columns:repeat(3,1fr)}}
    .role-option{display:flex;gap:10px;align-items:flex-start;border:1px solid #e5e7eb;border-radius:12px;padding:12px;cursor:pointer;background:#fff}
    .role-option:hover{border-color:#FF7A00;box-shadow:0 0 0 3px rgba(255,122,0,.12)}
    .role-option input{display:none}
    .role-option .role-body .role-label{font-weight:700}
    .role-option .role-body .role-desc{font-size:.9rem;color:#6b7280;margin-top:2px}
    .role-option input:checked + .role-body{border-left:4px solid #FF7A00;padding-left:8px}

block content
  .container.mx-auto.py-8
    .auth-card
      .auth-title Membership

      if errors && errors._global
        .alert.alert-danger.m-3= errors._global
      if typeof flash !== 'undefined' && flash
        .alert.alert-success.m-3= flash
      if promo
        .alert.alert-success.m-3 Year-end promo active. No payment required for the included benefits.

      form(method="POST", action="/user/register", novalidate)
        //- 히든 파라미터
        input(type="hidden", name="promo", value=promo)
        if prefRole
          input(type="hidden", name="prefRole", value=prefRole)
        if next
          input(type="hidden", name="next", value=next)

        .auth-field
          label(for="name") Name
          input#name.form-control(type="text", name="name", required, placeholder="Your name", value=(values && values.name) || '')
          if errors && errors.name
            small.text-danger= errors.name

        .auth-field
          label(for="email") Email
          input#email.form-control(type="email", name="email", required, placeholder="you@example.com", value=(values && values.email) || '')
          if errors && errors.email
            small.text-danger= errors.email

        .auth-field
          label Select your role
        .auth-role
          .role-grid
            - var r = (values && values.role) || ((prefRole || '').toLowerCase().replace(' ', '_'))
            label.role-option
              input(type="radio", name="role", value="employer", checked=(r==='employer'))
              .role-body
                .role-label Employer / Recruiter
                .role-desc Post job vacancies and manage candidates.
            label.role-option
              input(type="radio", name="role", value="job_seeker", checked=(r==='job_seeker'))
              .role-body
                .role-label Job Seeker
                .role-desc Find and apply for ESL jobs.
            label.role-option
              input(type="radio", name="role", value="tutor", checked=(r==='tutor'))
              .role-body
                .role-label Online Tutor
                .role-desc Offer tutoring and get student leads.
          if errors && errors.role
            small.text-danger.mt-1(style="display:block")= errors.role

        .auth-field
          label(for="password") Password
          input#password.form-control(type="password", name="password", required, placeholder="Choose a strong password")
          if errors && errors.password
            small.text-danger= errors.password

        .auth-field
          label(for="passwordConfirm") Confirm Password
          input#passwordConfirm.form-control(type="password", name="passwordConfirm", required, placeholder="Re-enter your password")
          if errors && errors.passwordConfirm
            small.text-danger= errors.passwordConfirm

        .auth-field
          label
            input(type="checkbox", name="agree", value="1", checked)
            |  I agree to the 
            a(href="/policy/terms", target="_blank") Terms
            |  and 
            a(href="/policy/privacy", target="_blank") Privacy Policy
          if errors && errors.agree
            small.text-danger= errors.agree

        .d-none
          input(type="text", name="hp", autocomplete="off", tabindex="-1")

        .auth-actions.text-center
          button.btn.btn-success(type="submit") Create account
          a.btn.btn-outline-secondary.ms-2(href="/user/login") Already have an account? Login

      .auth-note.text-center
        small By creating an account, you agree to our terms.
