extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-4 My Page (Job Seeker)

    p
      strong Username:
      | #{user.username}
    p
      strong Email:
      | #{user.email}
    p
      strong Role:
      | Job Seeker
    p.mt-3
      strong 🔑 Remaining Days of Resume Access:
      | #{remainingDays}

    .mt-4.d-flex.flex-wrap.gap-2
      a.btn.btn-primary(href='/job-seekers/new') Register Resume
      a.btn.btn-secondary(href=purchaseLink) Purchase Resume Visibility
