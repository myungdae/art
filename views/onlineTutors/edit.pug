extends ../layout

block content
  h2 Edit Online Tutor
  form(method="POST", action=`/online-tutors/edit/${tutor._id}`)
    .form-group
      label(for="name") Name:
      input.form-control(type="text", name="name", value=tutor.name)

    .form-group
      label(for="nationality") Nationality:
      input.form-control(type="text", name="nationality", value=tutor.nationality)

    .form-group
      label(for="gender") Gender:
      select.form-control(name="gender")
        option(value="") Select Gender
        option(value="male", selected=tutor.gender === 'male') Male
        option(value="female", selected=tutor.gender === 'female') Female

    .form-group
      label(for="expertise") Expertise:
      each val in ['basic', 'intermediate', 'expert']
        label
          input(type="checkbox", name="expertise", value=val, checked=tutor.expertise.includes(val))&nbsp;
          | #{val}

    .form-group
      label(for="tutoringExperience") Tutoring Experience:
      select.form-control(name="tutoringExperience")
        option(value="") Select Experience
        option(value="none", selected=tutor.tutoringExperience === 'none') None
        option(value="beginner", selected=tutor.tutoringExperience === 'beginner') Beginner
        option(value="intermediate", selected=tutor.tutoringExperience === 'intermediate') Intermediate
        option(value="advanced", selected=tutor.tutoringExperience === 'advanced') Advanced

    .form-group
      label(for="communicationMethods") Communication Methods:
      each val in ['zoom', 'skype', 'email', 'phone']
        label
          input(type="checkbox", name="communicationMethods", value=val, checked=tutor.communicationMethods.includes(val))&nbsp;
          | #{val}

    .form-group
      label(for="availableTime") Available Time:
      input.form-control(type="text", name="availableTime", value=tutor.availableTime)

    .form-group
      label(for="availableFrom") Available From:
      input.form-control(type="date", name="availableFrom", value=tutor.availableFrom ? tutor.availableFrom.toISOString().substring(0,10) : '')

    button.btn.btn-primary(type="submit") Save
