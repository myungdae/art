//- views/home.pug
extends layout

block content
  .container.mt-5

    // 🎉 메인 환영 메시지 (헤더 타이틀과 중복되는 큰 타이틀 제거)
    .text-center.mb-5
      h3(style="font-size: 1.75rem; font-weight: 700;") Welcome to the ESL Semantic Platform!
      p.text-muted.mt-3(style="font-size: 1.1rem; max-width: 900px; margin: 0 auto;")
        | Discover job opportunities, connect with qualified tutors, or showcase your talent to language institutions worldwide.

    // 🧠 RDF 메시지 박스
    .card.shadow.mb-5
      .card-body
        h4.text-danger.text-center.mb-3(style="font-size: 1.2rem; font-weight: 800;")
          | RDF-Compliant · Semantically-Driven · Facet-Linked
        p.text-center(style="font-size: 1rem;")
          | Your ESL platform is a semantic knowledge interface with RDF-compliant data and facet-based navigation.

    // ℹ️ 안내 문구
    p.text-center.text-muted.mt-4
      | Use the search bar above or the navigation menu to get started.
