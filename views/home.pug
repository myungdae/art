//- views/home.pug
extends layout

block content
  - var enc = encodeURIComponent;
  - var S  = (typeof stats === 'object' && stats) || {};
  - var RV = Array.isArray(recentVacancies) ? recentVacancies : [];
  - var RS = Array.isArray(recentSeekers) ? recentSeekers : [];
  - var RT = Array.isArray(recentTutors) ? recentTutors : [];

  // Stats (clickable + spinner + count-up, light orange theme) - 배경 이미지 위로 겹치기
  style.
    .stat-spinner{width:18px;height:18px;border:2px solid #e5e7eb;border-top-color:#f97316;border-radius:50%;animation:spin .8s linear infinite;display:inline-block;vertical-align:middle}
    @keyframes spin{to{transform:rotate(360deg)}}
    .hide{display:none}
    .stat-number {
      color: #FF7A00;
      font-size: 50px;
    }
    .stat-card {
      background: #F2F2F2;
      border: 4px solid #FF7A00;
      border-radius: 20px;
      width: 400px;
      height: 240px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .stat-card:hover{background:#FFEAD5;box-shadow:0 6px 18px rgba(249,115,22,.12)}
    .stat-label{color:#6b7280; font-size:20px; font-weight: 400; padding-top: 20px;}
    .stats-overlay {
      margin-top: -320px;
      position: relative;
      z-index: 10;
    }
  
  // 통계 카드를 배경 이미지 위로 올리기 (음수 마진 사용)
  .stats-overlay
    div(class="flex flex-col md:flex-row items-center justify-center gap-6 mb-12")
      a(href="/facet/Job_Vacancies" aria-label="Browse Job Vacancies" 
        class="stat-card block p-5 text-center transition transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-orange-400"
        )
        .flex.items-center.justify-center.gap-3
          span#spin-v.stat-spinner
          div#stat-v.text-3xl.font-bold.stat-number= (S.vCount != null ? S.vCount : 0)
        div.stat-label.mt-1 Job Vacancies

      a(href="/facet/Job_Seekers" aria-label="Browse Job Seekers" class="stat-card block p-5 text-center transition transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-orange-400")
        .flex.items-center.justify-center.gap-3
          span#spin-s.stat-spinner
          div#stat-s.text-3xl.font-bold.stat-number= (S.sCount != null ? S.sCount : 0)
        div.stat-label.mt-1 Job Seekers

      a(href="/facet/Online_Tutors" aria-label="Browse Online Tutors" class="stat-card block p-5 text-center transition transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-orange-400")
        .flex.items-center.justify-center.gap-3
          span#spin-t.stat-spinner
          div#stat-t.text-3xl.font-bold.stat-number= (S.tCount != null ? S.tCount : 0)
        div.stat-label.mt-1 Online Tutors
  
  // 나머지 콘텐츠
  .container.mx-auto.max-w-6xl.py-10
    hr.my-3
    .mb-15
    div(class="flex flex-col md:flex-row items-center md:items-start gap-12")
      // 좌측 텍스트 영역
      div(class="w-full md:w-1/3 text-center md:text-left")
        h1(class="text-5.3xl font-extrabold mb-3") ESL Plus:
        p(class="text-4xl") Bridge to the World

      // 우측 영상/이미지 컨테이너
      div(class="w-full md:w-2/3 flex justify-center")
        div(class="relative" style="display: inline-block;")
          video#videoPlayer.rounded-3xl.w-full(loop playsinline preload="metadata" poster="/assets/img/video.png" style="border: 4px solid #FF7A00; box-shadow: 0 4px 6px rgba(0,0,0,0.1); display: block; object-fit: cover;")
            source(src="/assets/video/eslplus.mp4?v=20251014a" type="video/mp4")
            | Your browser does not support the video tag.
          
          // 커스텀 재생 버튼 (빨간색)
          button#playButton.absolute.top-1_2.left-1_2(
            style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: none; border: none; cursor: pointer; z-index: 10;"
            onclick="document.getElementById('videoPlayer').play(); this.style.display='none';"
          )
            img(src="/assets/img/play_btn.png" alt="Play" style="width: 80px; height: 80px; filter: brightness(0) saturate(100%) invert(23%) sepia(89%) saturate(7471%) hue-rotate(359deg) brightness(95%) contrast(118%);")

    // Latest Job Vacancies
    if RV.length
      h2(class="text-xl font-semibold mb-3 mt-10") Latest Job Vacancies
      div(class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12")
        each v in RV
          .border.rounded.p-4.flex.flex-col
            a.font-semibold.mb-1(href='/rdf-resource/Job_Vacancies/' + (v.id || ''))= (v.title || 'Untitled')
            .text-sm.text-gray-500.mb-2
              if v.date
                - var d1 = new Date(v.date)
                span= d1.toISOString().slice(0,10)
              if v.country
                span.mx-1 •
                span= v.country
            if v.studentType
              .flex.flex-wrap.gap-2.mb-2
                a(href='/facet/Job_Vacancies?studentType=' + enc(v.studentType) class="inline-flex items-center px-2 py-1 text-xs rounded-full border")= v.studentType
            if Array.isArray(v.teachingAreas) && v.teachingAreas.length
              .flex.flex-wrap.gap-2.mt-auto
                each area in v.teachingAreas.slice(0,3)
                  a(href='/facet/Job_Vacancies?teachingArea=' + enc(area) class="inline-flex items-center px-2 py-1 text-xs rounded-full border")= area

    // Latest Job Seekers
    if RS.length
      h2(class="text-xl font-semibold mb-3") Latest Job Seekers
      div(class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12")
        each s in RS
          .border.rounded.p-4.flex.flex-col
            a.font-semibold.mb-1(href='/rdf-resource/Job_Seekers/' + (s.id || ''))= (s.title || 'Untitled')
            .text-sm.text-gray-500.mb-2
              if s.date
                - var d2 = new Date(s.date)
                span= d2.toISOString().slice(0,10)
              if s.country
                span.mx-1 •
                span= s.country
            if Array.isArray(s.languages) && s.languages.length
              .flex.flex-wrap.gap-2.mt-auto
                each lang in s.languages.slice(0,3)
                  a(href='/facet/Job_Seekers?language=' + enc(lang) class="inline-flex items-center px-2 py-1 text-xs rounded-full border")= lang

    // Latest Online Tutors
    if RT.length
      h2(class="text-xl font-semibold mb-3") Latest Online Tutors
      div(class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12")
        each t in RT
          .border.rounded.p-4.flex.flex-col
            a.font-semibold.mb-1(href='/rdf-resource/Online_Tutors/' + (t.id || ''))= (t.title || 'Untitled')
            .text-sm.text-gray-500.mb-2
              if t.date
                - var d3 = new Date(t.date)
                span= d3.toISOString().slice(0,10)
              if t.country
                span.mx-1 •
                span= t.country
            if Array.isArray(t.languages) && t.languages.length
              .flex.flex-wrap.gap-2.mt-auto
                each lang in t.languages.slice(0,3)
                  a(href='/facet/Online_Tutors?language=' + enc(lang) class="inline-flex items-center px-2 py-1 text-xs rounded-full border")= lang

   
    // 카운트업 스크립트
    script.
      (function () {
        function animateCount(el, from, to, ms, onDone) {
          from = Number(from)||0; to = Number(to)||0;
          if (ms <= 0 || from === to) { el.textContent = String(to); onDone && onDone(); return; }
          var start = null;
          function step(ts){
            if(!start) start = ts;
            var p = Math.min((ts - start) / ms, 1);
            var eased = 1 - Math.pow(1 - p, 3);
            var val = Math.round(from + (to - from) * eased);
            el.textContent = String(val);
            if(p < 1) requestAnimationFrame(step); else onDone && onDone();
          }
          requestAnimationFrame(step);
        }
        function hideSpinner(id){
          var sp = document.getElementById(id);
          if(sp){ sp.classList.add('hide'); }
        }
        async function hydrate() {
          var ids = [
            { num: 'stat-v', spin: 'spin-v', key: 'vCount' },
            { num: 'stat-s', spin: 'spin-s', key: 'sCount' },
            { num: 'stat-t', spin: 'spin-t', key: 'tCount' },
          ];
          try {
            ids.forEach(o => {
              var sp = document.getElementById(o.spin);
              if (sp) sp.classList.remove('hide');
            });
            var res = await fetch('/api/home/stats', { headers: { 'Accept': 'application/json' }});
            if(!res || !res.ok) throw new Error('stats http ' + (res && res.status));
            var data = await res.json();
            ids.forEach(o => {
              var el = document.getElementById(o.num);
              if(!el) return;
              var from = parseInt(el.textContent, 10) || 0;
              var to   = Number(data && data[o.key]) || 0;
              var dur  = Math.max(500, Math.min(1200, Math.abs(to - from) * 20));
              animateCount(el, from, to, dur, function(){ hideSpinner(o.spin); });
            });
          } catch (e) {
            setTimeout(function(){ ids.forEach(o => hideSpinner(o.spin)); }, 600);
          }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', hydrate);
        } else { hydrate(); }
      })();
      
      // 비디오 재생 버튼 제어
      (function() {
        function initVideoPlayer() {
          var video = document.getElementById('videoPlayer');
          var playBtn = document.getElementById('playButton');
          if (!video || !playBtn) return;
          
          // 비디오가 일시정지되면 버튼 표시
          video.addEventListener('pause', function() {
            playBtn.style.display = 'block';
          });
          
          // 비디오가 재생되면 버튼 숨김
          video.addEventListener('play', function() {
            playBtn.style.display = 'none';
          });
          
          // 비디오 클릭 시 재생/일시정지 토글
          video.addEventListener('click', function() {
            if (video.paused) {
              video.play();
            } else {
              video.pause();
            }
          });
        }
        
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initVideoPlayer);
        } else { initVideoPlayer(); }
      })();
