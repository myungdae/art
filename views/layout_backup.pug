doctype html
html(lang='en')
  head
    meta(http-equiv='Content-Type', content='text/html; charset=utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0')
    title Edu Bridge
    link(rel='shortcut icon', href='/assets/img/favicon.ico', type='image/x-icon')
    link(rel='stylesheet', href='https://netdna.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css')
    link(rel='stylesheet', href='/assets/css/jquery-ui.min.css')
    link(rel='stylesheet', href='/assets/css/bootstrap.min.css')
    link(href='/assets/css/animate.min.css', rel='stylesheet')
    link(href='/assets/css/now-ui-kit.css?v=1.3.0', rel='stylesheet')
    link(href='/assets/css/custom.css', rel='stylesheet')
    block append_on_header

  body
    include common_value

    header.header
      .container
        .row.justify-content-center
          .col-md
            h5.main-top-menu
            
              if session && session.user
                a(href="/user/mypage", style="padding-left:20px;color:#000000;")
                  | Mypage
                  if session.user.adsAvailable !== undefined
                    |  (#{session.user.adsAvailable} left)
                a(href="/user/logout", style="padding-left:20px;color:red;") Logout
              else
                a(href="/user/register", style="padding-left:20px;color:#000000;") membership
                a(href="/user/login", style="padding-left:20px;color:#000000;") Login

              a(href="/admin/login", style="padding-left:20px;color:#000000;") Admin
              if session && session.isAdmin
                a(href="/admin/logout", style="padding-left:20px;color:red;") Logout

    header.main-search-header
      .container.main-header-search(style="background-color:#000000 !important")
        .row.justify-content-center
          .col-md-4
            a(href='/' style="padding:0px;color:#000000;")
              img.main-logo-img(src="/assets/img/travel.png", width="300px", height="70px", alt="로고")
              h5.font-weight-bolder(style="font-size:16px;") 관광 연계탑산 아카이브

          .col-md-6.main-search
            - if (!searchKeyword) searchKeyword = "검색어를 입력해주세요"
            .input-group(style="margin-top:20px;")
              input#searchText.form-control.rounded-pill.border-end-0.ui-autocomplete-input(
                autocomplete='off',
                type='text',
                placeholder=searchKeyword.replace(/\[dot\]/g, '.'),
                value=searchText,
                style="color:#adadad;height:50px;font-size:12pt;border-color:#adadad"
              )
              span.input-group-append
                button.sstyly.border-bottom-0.border.rounded-pill(style="margin-left:-65px;margin-top:5px;")
                  img(src="/assets/img/main/icon-search.png", alt="검색", width="35px")
                span.input-group(style="margin-left:40px;margin-top:10px;")
                  a(href="http://kodex.eventpool.kr/", target="_blank")
                    img(src="/assets/img/main/btn_silkroads_link.png", alt="링크", width="30px")
                    span &nbsp; 영어 플랫폼

    nav.navbar.navbar-expand-md.main_nav_bar
      .container
        ul.navbar-nav.justify-content-center
          li.nav-item.text-nowrap
            a.nav-link.h5.my-0(href='/') HOME

    block content

    footer.footer
      .container
        .row
          .row.justify-content-center(style="font-size:15pt")
            h6.text-white Linked Data Center

    script(src='/assets/js/core/jquery.min.js', type='text/javascript')
    script(src='/assets/js/core/jquery-ui.min.js', type='text/javascript')
    script(src='/assets/js/core/popper.min.js', type='text/javascript')
    script(src='/assets/js/core/bootstrap.min.js', type='text/javascript')
    script(src='/assets/js/plugins/perfect-scrollbar.jquery.min.js')
    script(src='/assets/js/plugins/bootstrap-switch.js')
    script(src='/assets/js/plugins/nouislider.min.js', type='text/javascript')
    script(src='/assets/js/plugins/moment-with-locale.js', type='text/javascript')
    script(src='/assets/js/plugins/bootstrap-selectpicker.js')
    script(src='/assets/js/plugins/bootstrap-datetimepicker.js', type='text/javascript')
    script(src='/assets/js/now-ui-kit.js?v=1.3.0', type='text/javascript')
    script(src='/assets/js/plugins/bootstrap-notify.js', type='text/javascript')
    script(src='/assets/js/custom/searchBox.js', type='text/javascript')
    script(src='/assets/js/custom/commconst.js')
    script(src='/assets/js/custom/menu.js')

    block append_js
