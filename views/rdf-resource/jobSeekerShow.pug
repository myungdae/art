//- views/rdf-resource/jobVacancyShow.pug
extends ../layout

block content
  .max-w-5xl.mx-auto.px-4.py-10
    if vm
      // Title
      h1.text-3xl.font-semibold.text-gray-900= vm.title || 'Untitled'

      // === Semantic browsing (chips) ===
      h2.mt-6.text-sm.font-semibold.uppercase.tracking-wide.text-gray-500 Semantic browsing
      if vm.semanticChips && vm.semanticChips.length
        .mt-3
          .flex.flex-wrap.gap-2
            each chip in vm.semanticChips
              - const vals = Array.isArray(chip && chip.values) ? chip.values : (chip && chip.values ? [chip.values] : []);
              each val in vals
                a(
                  href=`/facet/${vm.facetBase}?${chip.key}=${encodeURIComponent(val)}`
                  title=`Filter by ${chip.key}: ${val}`
                  class="inline-block px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-sm font-medium hover:bg-blue-200"
                )= val
      else
        p.mt-2.text-gray-400 No semantic tags.

      // === Description ===
      h2.mt-8.text-sm.font-semibold.uppercase.tracking-wide.text-gray-500 Description
      .mt-3.rounded-xl.border.bg-white.shadow-sm
        .p-5.prose.max-w-none.text-gray-900
          if vm.descriptionHtml
            != vm.descriptionHtml
          else
            p.text-gray-500 No description provided.

      // === Details card (Company/Location/Country/Posted/Email/Pay/Housing/Website) ===
      - const hasDetails = vm.meta && (vm.meta.companyName || vm.meta.jobLocation || vm.meta.country || vm.meta.datePosted || vm.meta.email || vm.meta.pay || vm.meta.housing || vm.meta.homepage);
      if hasDetails
        .mt-8.rounded-xl.border.bg-white.shadow-sm
          .p-5
            h3.text-sm.uppercase.tracking-wide.text-gray-500.mb-3 Details

            .grid.grid-cols-1.gap-4(class="md:grid-cols-2")
              if vm.meta.companyName
                .p-3.rounded-lg.bg-gray-50
                  div.text-xs.uppercase.tracking-wide.text-gray-500 Company
                  div.mt-1.text-gray-900= vm.meta.companyName

              if vm.meta.jobLocation
                .p-3.rounded-lg.bg-gray-50
                  div.text-xs.uppercase.tracking-wide.text-gray-500 Location
                  div.mt-1.text-gray-900= vm.meta.jobLocation

              if vm.meta.country
                .p-3.rounded-lg.bg-gray-50
                  div.text-xs.uppercase.tracking-wide.text-gray-500 Country
                  div.mt-1.text-gray-900= vm.meta.country

              if vm.meta.datePosted
                - const _d = new Date(vm.meta.datePosted).toISOString().slice(0,10)
                .p-3.rounded-lg.bg-gray-50
                  div.text-xs.uppercase.tracking-wide.text-gray-500 Posted
                  div.mt-1.text-gray-900= _d

              if vm.meta.email
                .p-3.rounded-lg.bg-gray-50
                  div.text-xs.uppercase.tracking-wide.text-gray-500 Email
                  a(
                    href=`mailto:${vm.meta.email}`
                    class="mt-1 inline-block text-blue-700 hover:underline"
                  )= vm.meta.email

              if vm.meta.pay
                .p-3.rounded-lg.bg-gray-50
                  div.text-xs.uppercase.tracking-wide.text-gray-500 Pay
                  div.mt-1.text-gray-900= vm.meta.pay

              if vm.meta.housing
                .p-3.rounded-lg.bg-gray-50
                  div.text-xs.uppercase.tracking-wide.text-gray-500 Housing
                  div.mt-1.text-gray-900= vm.meta.housing

              if vm.meta.homepage
                .p-3.rounded-lg.bg-gray-50(class="md:col-span-2")
                  div.text-xs.uppercase.tracking-wide.text-gray-500 Website
                  a(
                    target="_blank" rel="noopener" href=vm.meta.homepage
                    class="mt-1 block text-blue-700 truncate hover:underline"
                  )= vm.meta.homepage

      // Debug: description candidates
      if vm.descDebug && vm.descDebug.length
        details.mt-8
          summary.text-sm.text-gray-500 Description candidates (debug)
          ul.mt-2.text-xs.text-gray-600.list-disc.pl-6
            each cand in vm.descDebug
              li= cand

      // Back
      .mt-10
        a(
          href=`/facet/${vm.facetBase}`
          class="inline-flex items-center gap-2 px-4 py-2 rounded-md border hover:bg-gray-50"
        )
          span ← Back to list
    else
      .text-center.py-16.text-gray-500 Not found
