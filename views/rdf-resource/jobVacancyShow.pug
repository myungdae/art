//- views/rdf-resource/jobVacancyShow.pug
extends ../layout

block content
  main.container.mx-auto.max-w-4xl.px-4.py-6
    // Header
    h1.text-2xl.font-bold.mb-2= vm && vm.title ? vm.title : 'Untitled Job Vacancy'

    if vm && vm.meta
      .text-sm.text-gray-600.mb-4
        if vm.meta.companyName
          span.mr-2 #{vm.meta.companyName}
        if vm.meta.jobLocation
          span.mr-2 · #{vm.meta.jobLocation}
        if vm.meta.country
          span.mr-2 · #{vm.meta.country}
        if vm.meta.datePosted
          - const _d = new Date(vm.meta.datePosted);
          span · Posted: #{isNaN(_d) ? '' : _d.toISOString().slice(0,10)}

    // Semantic chips
    if vm && Array.isArray(vm.semanticChips) && vm.semanticChips.length
      .mb-4
        each chip in vm.semanticChips
          - const vals = Array.isArray(chip && chip.values) ? chip.values : (chip && chip.values ? [chip.values] : []);
          each val in vals
            a(
              class="inline-block px-3 py-1 mr-2 mb-2 rounded-full bg-blue-100 text-blue-800 text-sm font-medium hover:bg-blue-200"
              href=('/facet/' + (vm && vm.facetBase ? vm.facetBase : 'Job_Vacancies') + '?' + chip.key + '=' + encodeURIComponent(val))
              title=`Filter by ${chip.key}: ${val}`
            )= val

    // Description
    if vm && vm.descriptionHtml
      .prose.max-w-none
        .content!= vm.descriptionHtml
    else
      p.text-gray-500.italic No description provided.

    // Core meta
    if vm && vm.meta
      div(class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6")
        if vm.meta.pay
          .p-4.rounded-lg.border
            div.text-xs.uppercase.tracking-wide.text-gray-500 Pay
            div.mt-1.font-medium= vm.meta.pay
        if vm.meta.housing
          .p-4.rounded-lg.border
            div.text-xs.uppercase.tracking-wide.text-gray-500 Housing
            div.mt-1.font-medium= vm.meta.housing
        if vm.meta.email
          .p-4.rounded-lg.border
            div.text-xs.uppercase.tracking-wide.text-gray-500 Contact
            div.mt-1
              a(
                class="text-blue-700 underline hover:text-blue-900"
                href=`mailto:${vm.meta.email}`
              )= vm.meta.email
        if vm.meta.homepage
          .p-4.rounded-lg.border
            div.text-xs.uppercase.tracking-wide.text-gray-500 Website
            div.mt-1
              a(
                class="text-blue-700 underline hover:text-blue-900 break-all"
                href=vm.meta.homepage
                rel="noopener"
                target="_blank"
              )= vm.meta.homepage

    // Extras
    if vm && Array.isArray(vm.extras) && vm.extras.length
      h2.text-xl.font-semibold.mt-8.mb-3 Additional Information
      dl.divide-y.divide-gray-200.border.rounded-lg
        each item in vm.extras
          .px-4.py-3.grid.grid-cols-3.gap-3
            dt.col-span-1.text-sm.text-gray-600= item.label
            dd.col-span-2.font-medium= item.value

    // Debug (optional)
    if vm && Array.isArray(vm.descDebug) && vm.descDebug.length
      details.mt-6
        summary.cursor-pointer.text-sm.text-gray-600 Description candidates (debug)
        ul.list-disc.pl-6.mt-2
          each c in vm.descDebug
            li.text-sm= c

    // Back to list — 강제 절대경로 (Form GET)
    - const facetBase = (vm && vm.facetBase) ? vm.facetBase : 'Job_Vacancies'
    - const backHref  = '/facet/' + facetBase
    form(action=backHref method="get" class="mt-8")
      button(
        type="submit"
        class="inline-flex items-center px-4 py-2 rounded-md border text-blue-700 hover:bg-gray-50"
        aria-label="Back to list"
      ) ← Back to list
