extends ../layout

block content
  .container.mx-auto.max-w-5xl.py-8
    // Title with Edit and Back to List buttons
    .flex.justify-between.items-center.mb-6
      h1.text-3xl.font-bold= vm.title || 'Job Vacancy'
      .flex.gap-2
        a.btn.btn-outline-secondary(href="/facet/Job_Vacancies" style="border-color: #6c757d; color: #6c757d;")
          i.fas.fa-list.mr-2
          | Back to List
        if vm.canEdit
          a.btn.btn-primary(href=`/job-vacancies/${vm.id}/edit` style="background-color: #FF7A00; border-color: #FF7A00;")
            i.fas.fa-edit.mr-2
            | Edit

    h3 Description
    hr.my-3
    // Description (왼쪽)
    if vm.descriptionHtml
      .prose.max-w-none.mb-8.mx-auto.text-left
        != vm.descriptionHtml
    ul.nav.nav-tabs.justify-center.mb-4(role="tablist")
      li.nav-item
        a.nav-link.active(
          id="tab-basic",
          data-toggle="tab",
          href="#panel-basic",
          role="tab",
          aria-controls="panel-basic"
        ) Basic Information
      li.nav-item
        a.nav-link(
          id="tab-semantic",
          data-toggle="tab",
          href="#panel-semantic",
          role="tab",
          aria-controls="panel-semantic"
        ) Semantic Browsing
    // Tab panels
    .tab-content.text-left
      // Basic Information Panel
      .tab-pane.fade.show.active#panel-basic(role="tabpanel" aria-labelledby="tab-basic")
        if vm.meta.datePosted
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Date Posted
            - const d = new Date(vm.meta.datePosted)
            div.mt-2= d.toISOString().slice(0,10).replace(/-/g, '/')

        if vm.meta.email
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Contact Email
            div.mt-2
              a.text-blue-600(href=`mailto:${vm.meta.email}`)= vm.meta.email

        if vm.meta.companyName
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Company Name
            div.mt-2= vm.meta.companyName

        if vm.meta.jobLocation
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Job Location
            div.mt-2= vm.meta.jobLocation

        if vm.meta.pay
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Pay
            div.mt-2= vm.meta.pay

        if vm.meta.housing
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Housing
            div.mt-2= vm.meta.housing

        if vm.meta.cellphoneNumber
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Cellphone
            div.mt-2= vm.meta.cellphoneNumber

        if vm.meta.homepage
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Homepage
            div.mt-2
              a.text-blue-600(href=vm.meta.homepage target="_blank" rel="noopener")= vm.meta.homepage

        if vm.meta.languages && vm.meta.languages.length
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Languages
            div.mt-2.flex.flex-wrap.gap-2
              each lang in vm.meta.languages
                a(href=`/facet/${vm.facetBase}?language=${(lang)}` class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition")= lang

      // Semantic Browsing Panel
      .tab-pane.fade#panel-semantic(role="tabpanel" aria-labelledby="tab-semantic")
        if vm.semanticChips && vm.semanticChips.length
          .grid.grid-cols-1.md
            each chip in vm.semanticChips
              .border.rounded.p-3
                div.text-xs.text-gray-500.uppercase= chip.label
                div.mt-2.flex.flex-wrap.gap-2
                  each val in chip.values
                    a(
                      href=`/facet/${vm.facetBase}?${encodeURIComponent(chip.key)}=${encodeURIComponent(val)}`,
                      class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition"
                    )= val
