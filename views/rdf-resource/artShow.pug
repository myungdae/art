//- views/rdf-resource/artShow.pug — ART+ 상세 페이지 (밝은 테마)
extends ../layout

block content
  style.
    html, body { background: #f5f4f0; color: #1a1a1a; }

    .detail-wrap {
      max-width: 1100px; margin: 0 auto; padding: 40px 24px 80px;
    }

    /* 뒤로 가기 */
    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 13px; font-weight: 700; color: #888;
      text-decoration: none; margin-bottom: 28px;
      transition: color 0.2s;
    }
    .back-link:hover { color: #c9a227; }

    /* 메인 그리드: 이미지 + 정보 */
    .detail-grid {
      display: grid;
      grid-template-columns: 420px 1fr;
      gap: 40px;
      align-items: start;
    }
    @media (max-width: 768px) {
      .detail-grid { grid-template-columns: 1fr; gap: 24px; }
    }

    /* 이미지 */
    .detail-img-box {
      background: #f0ece0;
      border-radius: 18px;
      border: 1px solid #e8e4da;
      aspect-ratio: 4/3;
      display: flex; align-items: center; justify-content: center;
      font-size: 6rem; overflow: hidden;
    }
    .detail-img-box img {
      width: 100%; height: 100%; object-fit: cover; border-radius: 18px;
    }

    /* 정보 패널 */
    .detail-info {}
    .detail-klass {
      font-size: 11px; font-weight: 800; color: #c9a227;
      text-transform: uppercase; letter-spacing: 2px; margin-bottom: 10px;
    }
    .detail-title {
      font-size: clamp(1.5rem, 3vw, 2.2rem);
      font-weight: 900; color: #1a1a1a; line-height: 1.2;
      margin-bottom: 16px;
    }

    /* 태그 행 */
    .tag-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
    .dtag {
      display: inline-flex; align-items: center;
      padding: 5px 14px; border-radius: 50px;
      font-size: 12px; font-weight: 700;
      text-decoration: none; transition: all 0.2s;
    }
    .dtag-gold { background: #fdf6e3; border: 1px solid #d4af37; color: #a07800; }
    .dtag-gold:hover { background: #fcefc0; }
    .dtag-blue { background: #eff6ff; border: 1px solid #93c5fd; color: #1d4ed8; }
    .dtag-blue:hover { background: #dbeafe; }
    .dtag-gray { background: #f5f5f5; border: 1px solid #ddd; color: #555; }
    .dtag-gray:hover { background: #eee; }
    .dtag-rose { background: #fff1f2; border: 1px solid #fda4af; color: #be123c; }

    /* 속성 테이블 */
    .detail-props {
      background: #fff; border: 1px solid #e8e4da;
      border-radius: 14px; overflow: hidden; margin-bottom: 20px;
    }
    .prop-row {
      display: grid; grid-template-columns: 130px 1fr;
      border-bottom: 1px solid #f0ece0; padding: 11px 18px;
    }
    .prop-row:last-child { border-bottom: none; }
    .prop-key {
      font-size: 12px; font-weight: 700; color: #888;
      text-transform: uppercase; letter-spacing: 0.5px;
      padding-right: 12px;
    }
    .prop-val { font-size: 13px; color: #1a1a1a; word-break: break-word; }
    .prop-val a { color: #c9a227; text-decoration: none; }
    .prop-val a:hover { text-decoration: underline; }

    /* ── 통합 정보 카드 (설명 + 속성 테이블) ── */
    .detail-card {
      background: #fff;
      border: 1px solid #e8e4da;
      border-radius: 16px;
      overflow: hidden;
      margin-bottom: 20px;
    }

    /* 설명 영역 */
    .detail-desc {
      padding: 18px 22px 16px;
      border-bottom: 2px solid #f0ece0;
    }
    .detail-desc-label {
      font-size: 10px; font-weight: 800; color: #c9a227;
      text-transform: uppercase; letter-spacing: 2px;
      margin-bottom: 10px;
    }
    .detail-desc-body {
      max-height: 130px;
      overflow-y: auto;
      font-size: 13.5px; line-height: 1.85; color: #444;
      padding-right: 6px;
    }
    .detail-desc-body.no-desc {
      color: #bbb; font-style: italic; font-size: 13px;
    }
    .detail-desc-body::-webkit-scrollbar { width: 4px; }
    .detail-desc-body::-webkit-scrollbar-track { background: #f5f2ea; border-radius: 4px; }
    .detail-desc-body::-webkit-scrollbar-thumb { background: #d4af37; border-radius: 4px; }
    .detail-desc-body::-webkit-scrollbar-thumb:hover { background: #c9a227; }

    /* ── Photo Gallery (작가 작품 목록) ──────────────────────── */
    .gallery-section {
      margin-top: 64px;
      padding-top: 40px;
      border-top: 2px solid #ede9e0;
    }
    .gallery-hd {
      display: flex; align-items: baseline; justify-content: space-between;
      margin-bottom: 24px;
    }
    .gallery-hd-title {
      font-size: 1.2rem; font-weight: 900; color: #1a1a1a;
      display: flex; align-items: center; gap: 10px;
    }
    .gallery-hd-title .accent { color: #c9a227; }
    .gallery-hd-title .cnt-badge {
      font-size: 12px; font-weight: 700;
      background: #fdf6e3; border: 1px solid #e8d9a0;
      color: #a07800; padding: 2px 10px; border-radius: 50px;
    }
    .gallery-hd-more {
      font-size: 13px; font-weight: 700; color: #bbb;
      text-decoration: none; transition: color 0.2s;
    }
    .gallery-hd-more:hover { color: #c9a227; }

    /* 스크롤 가능한 갤러리 그리드 */
    .gallery-scroll-wrap {
      position: relative;
    }
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 18px;
    }

    /* 작품 카드 */
    .gcard {
      background: #fff;
      border: 1.5px solid #e8e2d5;
      border-radius: 14px;
      overflow: hidden;
      text-decoration: none;
      display: block;
      transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
    }
    .gcard:hover {
      transform: translateY(-5px);
      border-color: #c9a227;
      box-shadow: 0 12px 30px rgba(180,140,20,0.14);
    }
    .gcard-thumb {
      width: 100%;
      aspect-ratio: 4/3;
      background: linear-gradient(135deg, #f5edd0 0%, #ede0b0 100%);
      display: flex; align-items: center; justify-content: center;
      font-size: 3rem; overflow: hidden; position: relative;
    }
    .gcard-thumb img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform 0.4s ease;
    }
    .gcard:hover .gcard-thumb img { transform: scale(1.06); }
    .gcard-body { padding: 12px 14px 14px; }
    .gcard-title {
      font-size: 13px; font-weight: 800; color: #1a1a1a;
      margin-bottom: 6px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .gcard-year {
      font-size: 11px; color: #aaa; margin-bottom: 8px;
    }
    .gcard-tags { display: flex; flex-wrap: wrap; gap: 5px; }
    .gtag {
      display: inline-block; padding: 2px 9px;
      border-radius: 50px; font-size: 10px; font-weight: 700;
      text-decoration: none;
    }
    .gtag-gold { background: #fdf8ee; border: 1px solid #e8d9a0; color: #a07800; }
    .gtag-blue { background: #eff6ff; border: 1px solid #bfdbfe; color: #1d4ed8; }
    .gtag-gray { background: #f5f5f5; border: 1px solid #ddd; color: #555; }

    /* 빈 갤러리 */
    .gallery-empty {
      text-align: center; padding: 48px 0;
      color: #bbb; font-size: 14px;
    }
    .gallery-empty .ei { font-size: 2.5rem; margin-bottom: 10px; }

    /* Lightbox 오버레이 */
    .lb-overlay {
      display: none;
      position: fixed; inset: 0; z-index: 1000;
      background: rgba(0,0,0,0.88);
      align-items: center; justify-content: center;
      flex-direction: column;
    }
    .lb-overlay.open { display: flex; }
    .lb-img-wrap {
      position: relative;
      max-width: 90vw; max-height: 82vh;
      display: flex; align-items: center; justify-content: center;
    }
    .lb-img-wrap img {
      max-width: 90vw; max-height: 80vh;
      object-fit: contain;
      border-radius: 10px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }
    .lb-placeholder {
      width: 60vw; max-width: 500px; aspect-ratio: 4/3;
      background: #1a1a1a; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 6rem; color: #555;
    }
    .lb-close {
      position: absolute; top: -44px; right: 0;
      font-size: 28px; color: #fff; cursor: pointer;
      background: none; border: none; opacity: 0.7; transition: opacity 0.2s;
    }
    .lb-close:hover { opacity: 1; }
    .lb-nav {
      display: flex; align-items: center; gap: 16px; margin-top: 18px;
    }
    .lb-btn {
      background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.25);
      color: #fff; border-radius: 8px; padding: 8px 20px;
      font-size: 14px; font-weight: 700; cursor: pointer;
      transition: background 0.2s;
    }
    .lb-btn:hover { background: rgba(255,255,255,0.22); }
    .lb-btn:disabled { opacity: 0.25; cursor: default; }
    .lb-caption {
      color: rgba(255,255,255,0.75); font-size: 13px; font-weight: 600;
      text-align: center; max-width: 60vw;
    }
    .lb-counter {
      color: rgba(255,255,255,0.45); font-size: 12px; margin-top: 4px;
    }

    @media (max-width: 640px) {
      .gallery-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    }

  .detail-wrap

    //- 뒤로가기
    a.back-link(href=`/facet/${vm.facetBase}`) ← #{vm.klassLabel} 목록으로

    .detail-grid

      //- 이미지
      .detail-img-box
        if vm.raw && vm.raw.imageUrl
          img(src=vm.raw.imageUrl alt=vm.title)
        else
          = vm.klassIcon

      //- 정보
      .detail-info
        .detail-klass= vm.klassLabel
        h1.detail-title= vm.title

        //- 주요 태그
        .tag-row
          if vm.raw.genre
            a.dtag.dtag-blue(href=`/facet/Artworks?genre=${encodeURIComponent(vm.raw.genre)}`)
              | 🎨 #{vm.raw.genre}
          if vm.raw.style
            a.dtag.dtag-gold(href=`/facet/Artworks?style=${encodeURIComponent(vm.raw.style)}`)
              | ✦ #{vm.raw.style}
          if vm.raw.medium
            a.dtag.dtag-gray(href=`/facet/Artworks?medium=${encodeURIComponent(vm.raw.medium)}`)
              | 🖌️ #{vm.raw.medium}
          if vm.raw.country
            a.dtag.dtag-blue(href=`/facet/${vm.facetBase}?country=${encodeURIComponent(vm.raw.country)}`)
              | 🌍 #{vm.raw.country}
          if vm.raw.movement
            a.dtag.dtag-gray(href=`/facet/${vm.facetBase}?movement=${encodeURIComponent(vm.raw.movement)}`)
              | 📚 #{vm.raw.movement}
          if vm.raw.orientation
            a.dtag.dtag-gray(href=`/facet/Artworks?orientation=${encodeURIComponent(vm.raw.orientation)}`)
              | ⬛ #{vm.raw.orientation}
          if vm.raw.size
            a.dtag.dtag-gray(href=`/facet/Artworks?size=${encodeURIComponent(vm.raw.size)}`)
              | 📐 #{vm.raw.size}
          if vm.raw.creationYear
            span.dtag.dtag-rose 📅 #{vm.raw.creationYear}

        //- ── 통합 카드: 설명 + 속성 테이블 ──
        .detail-card

          //- ① 설명 영역 (라우터에서 항상 finalDescriptionHtml 로 전달됨)
          .detail-desc
            .detail-desc-label 설명
            .detail-desc-body
              != vm.descriptionHtml

          //- ② 속성 목록
          .detail-props
            if vm.raw.artistName
              .prop-row
                span.prop-key 작가
                span.prop-val
                  a(href=`/facet/Artists?q=${encodeURIComponent(vm.raw.artistName)}`)= vm.raw.artistName
            if vm.raw.creationYear
              .prop-row
                span.prop-key 제작연도
                span.prop-val= vm.raw.creationYear
            if vm.raw.genre
              .prop-row
                span.prop-key 장르
                span.prop-val= vm.raw.genre
            if vm.raw.style
              .prop-row
                span.prop-key 양식
                span.prop-val= vm.raw.style
            if vm.raw.medium
              .prop-row
                span.prop-key 매체
                span.prop-val= vm.raw.medium
            if vm.raw.material
              .prop-row
                span.prop-key 재료
                span.prop-val= Array.isArray(vm.raw.material) ? vm.raw.material.join(', ') : vm.raw.material
            if vm.raw.theme
              .prop-row
                span.prop-key 테마
                span.prop-val= Array.isArray(vm.raw.theme) ? vm.raw.theme.join(', ') : vm.raw.theme
            if vm.raw.movement
              .prop-row
                span.prop-key 운동
                span.prop-val= vm.raw.movement
            if vm.raw.orientation
              .prop-row
                span.prop-key 방향
                span.prop-val= vm.raw.orientation
            if vm.raw.size
              .prop-row
                span.prop-key 크기
                span.prop-val= vm.raw.size
            if vm.raw.country
              .prop-row
                span.prop-key 국가
                span.prop-val= vm.raw.country
            if vm.raw.priceValue
              .prop-row
                span.prop-key 경매가
                span.prop-val ₩#{Number(vm.raw.priceValue).toLocaleString()}
            each ex in (vm.extras || [])
              if ex.value
                .prop-row
                  span.prop-key= ex.label
                  span.prop-val= ex.value

    //- ── 작가 작품 Photo Gallery ────────────────────────────
    - var works = Array.isArray(vm.artistWorks) ? vm.artistWorks : []
    if vm.klassLabel === '작가'
      .gallery-section
        .gallery-hd
          .gallery-hd-title
            span.accent 🖼️
            | 작품 갤러리
            if works.length
              span.cnt-badge= works.length + '점'
          if works.length
            a.gallery-hd-more(href=`/facet/Artworks?q=${encodeURIComponent(vm.title)}`) 전체 작품 →

        if works.length
          .gallery-grid
            each w in works
              - var wTitle = w._label || w.title || w.artworkTitle || '무제'
              - var wId    = w._id.toString()
              a.gcard(
                href=`/rdf-resource/Artworks/${wId}`
                data-idx=works.indexOf(w)
              )
                .gcard-thumb
                  if w.imageUrl
                    img(src=w.imageUrl alt=wTitle loading='lazy')
                  else
                    | 🖼️
                .gcard-body
                  .gcard-title= wTitle
                  if w.creationYear
                    .gcard-year= w.creationYear
                  .gcard-tags
                    if w.genre
                      span.gtag.gtag-blue= w.genre
                    if w.style
                      span.gtag.gtag-gold= w.style
                    if w.medium
                      span.gtag.gtag-gray= w.medium
        else
          .gallery-empty
            .ei 🖼️
            p 등록된 작품이 없습니다.

  //- ── Lightbox ─────────────────────────────────────────────
  - var works2 = Array.isArray(vm.artistWorks) ? vm.artistWorks : []
  if vm.klassLabel === '작가' && works2.length
    //- JSON 데이터를 hidden script 태그에 삽입 (Pug 인터폴레이션 문제 우회)
    script#lbData(type="application/json")
      - var lbJson = works2.map(function(w){ return { id: w._id.toString(), title: (w._label||w.title||w.artworkTitle||'무제'), year: (w.creationYear||''), img: (w.imageUrl||'') }; })
      = JSON.stringify(lbJson)

    #lbOverlay.lb-overlay(onclick="lbClickOutside(event)")
      .lb-img-wrap
        button.lb-close(onclick="lbClose()" title="닫기") ✕
        #lbImgContainer
      .lb-nav
        button.lb-btn#lbPrev(onclick="lbMove(-1)") ← 이전
        .lb-caption
          div#lbCaption
          div.lb-counter#lbCounter
        button.lb-btn#lbNext(onclick="lbMove(1)") 다음 →

    script.
      (function () {
        var works = JSON.parse(document.getElementById('lbData').textContent || '[]');
        var cur = 0;

        function lbOpen(idx) {
          cur = idx;
          render();
          document.getElementById('lbOverlay').classList.add('open');
          document.body.style.overflow = 'hidden';
        }

        function lbClose() {
          document.getElementById('lbOverlay').classList.remove('open');
          document.body.style.overflow = '';
        }
        window.lbClose = lbClose;

        function lbClickOutside(e) {
          if (e.target.id === 'lbOverlay') lbClose();
        }
        window.lbClickOutside = lbClickOutside;

        function lbMove(dir) {
          cur = (cur + dir + works.length) % works.length;
          render();
        }
        window.lbMove = lbMove;

        function render() {
          var w = works[cur];
          var container = document.getElementById('lbImgContainer');
          if (w.img) {
            container.innerHTML = '<img src="' + w.img + '" alt="' + w.title.replace(/"/g,'&quot;') + '">';
          } else {
            container.innerHTML = '<div class="lb-placeholder">🖼️</div>';
          }
          document.getElementById('lbCaption').textContent = w.title + (w.year ? '  (' + w.year + ')' : '');
          document.getElementById('lbCounter').textContent = (cur + 1) + ' / ' + works.length;
          document.getElementById('lbPrev').disabled = false;
          document.getElementById('lbNext').disabled = false;
        }

        // 갤러리 카드 클릭 → Lightbox 열기
        document.querySelectorAll('.gcard').forEach(function (card) {
          card.addEventListener('click', function (e) {
            e.preventDefault();
            lbOpen(parseInt(card.getAttribute('data-idx'), 10));
          });
        });

        // 키보드 탐색
        document.addEventListener('keydown', function (e) {
          var overlay = document.getElementById('lbOverlay');
          if (!overlay.classList.contains('open')) return;
          if (e.key === 'ArrowLeft')  lbMove(-1);
          if (e.key === 'ArrowRight') lbMove(1);
          if (e.key === 'Escape')     lbClose();
        });
      })();
