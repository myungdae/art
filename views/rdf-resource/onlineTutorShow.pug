extends ../layout

block content
  .container.mx-auto.max-w-5xl.py-8
    // Title with Edit and Back to List buttons
    .flex.justify-between.items-center.mb-6
      h1.text-3xl.font-bold= vm.title || 'Online Tutor'
      .flex.gap-2
        a.btn.btn-outline-secondary(href="/facet/Online_Tutors" style="border-color: #6c757d; color: #6c757d;")
          i.fas.fa-list.mr-2
          | Back to List
        if vm.canEdit
          a.btn.btn-primary(href=`/online-tutors/${vm.id}/edit` style="background-color: #FF7A00; border-color: #FF7A00;")
            i.fas.fa-edit.mr-2
            | Edit

    h3 Description
    hr.my-3
    // Description (왼쪽)
    if vm.descriptionHtml
      .prose.max-w-none.mb-8.mx-auto.text-left
        != vm.descriptionHtml
    ul.nav.nav-tabs.justify-center.mb-4(role="tablist")
      li.nav-item
        a.nav-link.active(
          id="tab-basic",
          data-toggle="tab",
          href="#panel-basic",
          role="tab",
          aria-controls="panel-basic"
        ) Basic Information
      li.nav-item
        a.nav-link(
          id="tab-semantic",
          data-toggle="tab",
          href="#panel-semantic",
          role="tab",
          aria-controls="panel-semantic"
        ) Semantic Browsing
    // Tab panels
    .tab-content.text-left
      // Basic Information Panel
      .tab-pane.fade.show.active#panel-basic(role="tabpanel" aria-labelledby="tab-basic")
        if vm.meta.email
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Contact Email
            div.mt-2
              a.text-blue-600(href=`mailto:${vm.meta.email}`)= vm.meta.email

        if vm.meta.country
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Country
            div.mt-2.flex.flex-wrap.gap-2
              a(href=`/facet/${vm.facetBase}?country=${enc(vm.meta.country)}` class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition")= vm.meta.country

        if vm.meta.studentType
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Student Type
            div.mt-2.flex.flex-wrap.gap-2
              a(href=`/facet/${vm.facetBase}?studentType=${enc(vm.meta.studentType)}` class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition")= vm.meta.studentType

        if vm.meta.teachingAreas && vm.meta.teachingAreas.length
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Teaching Areas
            div.mt-2.flex.flex-wrap.gap-2
              each area in vm.meta.teachingAreas
                a(href=`/facet/${vm.facetBase}?teachingArea=${enc(area)}` class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition")= area

        if vm.meta.languages && vm.meta.languages.length
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Languages
            div.mt-2.flex.flex-wrap.gap-2
              each lang in vm.meta.languages
                a(href=`/facet/${vm.facetBase}?language=${enc(lang)}` class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition")= lang

        if vm.meta.jobLocation
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Location
            div.mt-2= vm.meta.jobLocation

        if vm.meta.homepage
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Homepage
            div.mt-2
              a.text-blue-600(href=vm.meta.homepage target="_blank" rel="noopener")= vm.meta.homepage

        if vm.meta.datePosted
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Updated
            - const d3 = new Date(vm.meta.datePosted)
            div.mt-2= d3.toISOString().slice(0,10)

      // Semantic Browsing Panel
      .tab-pane.fade#panel-semantic(role="tabpanel" aria-labelledby="tab-semantic")
        if vm.meta.Tutoring_Experience
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Tutoring Experience
            div.mt-2.flex.flex-wrap.gap-2
              a(href=`/facet/${vm.facetBase}?Tutoring_Experience=${enc(vm.meta.Tutoring_Experience)}` class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition")= vm.meta.Tutoring_Experience

        if vm.meta.Gender
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Gender
            div.mt-2.flex.flex-wrap.gap-2
              a(href=`/facet/${vm.facetBase}?Gender=${enc(vm.meta.Gender)}` class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition")= vm.meta.Gender

        if vm.meta.Expertise
          .border.rounded.p-3.mb-3
            div.text-xs.text-gray-500.uppercase Expertise
            div.mt-2.flex.flex-wrap.gap-2
              if Array.isArray(vm.meta.Expertise)
                each exp in vm.meta.Expertise
                  a(href=`/facet/${vm.facetBase}?Expertise=${enc(exp)}` class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition")= exp
              else
                a(href=`/facet/${vm.facetBase}?Expertise=${enc(vm.meta.Expertise)}` class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition")= vm.meta.Expertise

        if vm.semanticChips && vm.semanticChips.length
          .grid.grid-cols-1.md
            each chip in vm.semanticChips
              .border.rounded.p-3.mb-3
                div.text-xs.text-gray-500.uppercase= chip.label
                div.mt-2.flex.flex-wrap.gap-2
                  each val in chip.values
                    a(
                      href=`/facet/${vm.facetBase}?${encodeURIComponent(chip.key)}=${encodeURIComponent(val)}`,
                      class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition"
                    )= val
