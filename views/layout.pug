    // 모바일 햄버거 메뉴 토글
    script.
      (function () {
        var hamburger = document.getElementById('hamburgerToggle');
        var menu = document.getElementById('mainMenuMobile');
        var overlay = document.getElementById('menuOverlay');
        
        if (hamburger && menu && overlay) {
          hamburger.addEventListener('click', function(e){
            e.stopPropagation();
            menu.classList.add('show');
            overlay.classList.add('show');
          });
          
          overlay.addEventListener('click', function(){
            menu.classList.remove('show');
            overlay.classList.remove('show');
          });
          
          // 메뉴 링크 클릭 시 닫기
          var menuLinks = menu.querySelectorAll('a');
          menuLinks.forEach(function(link){
            link.addEventListener('click', function(){
              menu.classList.remove('show');
              overlay.classList.remove('show');
            });
          });
        }
      })();
    
    // 모바일 계정 드롭 토글
    script.
      (function () {
        var btn = document.getElementById('topMenuToggle');
        var drop = document.getElementById('topMenuDrop');
        if (!btn || !drop) return;
        btn.addEventListener('click', function(e){
          e.stopPropagation();
          drop.classList.toggle('show');
        });
        document.addEventListener('click', function(e){
          if (drop.classList.contains('show') && !drop.contains(e.target) && e.target !== btn) {
            drop.classList.remove('show');
          }
        });
      })();

    // 공용 유틸
    script.
      function previewFileName(inputId, labelId){
        const input = document.getElementById(inputId);
        const label = document.getElementById(labelId);
        if(!input || !label) return;
        const f = input.files && input.files[0];
        label.textContent = f ? f.name : 'No file selected';
      }

    block append_js
