doctype html
html(lang='en')
  head
    meta(http-equiv='Content-Type', content='text/html; charset=utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0')
    title Edu Bridge
    link(rel='shortcut icon', href='/assets/img/favicon.ico', type='image/x-icon')

    // ✅ CSS
    // ✅ Tailwind CDN (정상 작성)
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css")
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/semantic-ui@2.5.0/dist/semantic.min.css')
    link(rel='stylesheet', href='https://netdna.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css')
    link(rel='stylesheet', href='/assets/css/jquery-ui.min.css')
    link(rel='stylesheet', href='/assets/css/bootstrap.min.css')
    link(href='/assets/css/animate.min.css', rel='stylesheet')
    link(href='/assets/css/now-ui-kit.css?v=1.3.0', rel='stylesheet')
    link(href='/assets/css/custom.css', rel='stylesheet')
    


    // ✅ 💡 여기에 자식 템플릿에서 삽입할 추가 스크립트/스타일 블록
    block append_on_header

    style.
      .search-header { position: relative; padding: 40px 0 80px 0; background-color: #fff; }
      .menu-top { position: absolute; top: 30px; right: 50px; }
      .menu-top a {
        margin-left: 25px;
        font-size: 16pt;
        font-weight: bold;
        color: #000;
        text-decoration: none;
      }
      .menu-top a.logout { color: red; }

      .search-input {
        max-width: 600px;
        height: 60px;
        font-size: 16pt;
        border: 2px solid #ccc;
        border-radius: 30px;
        padding: 10px 25px;
      }

      .main-content {
        min-height: 500px; /* ✅ 그림 들어갈 넉넉한 높이 확보 */
        padding: 60px 30px;
        background-color: #fff;
      }

      footer.footer {
        background-color: #333;
        color: #fff;
        padding: 30px 0;
        margin-top: 0;
      }

  body
    include common_value

    // ✅ 상단 검색창 + 메뉴
    header.main-search-header.search-header
      .container-fluid
        .menu-top
          if session && session.user
            a(href="/user/mypage") Mypage
            if session.user.adsAvailable !== undefined
              | (#{session.user.adsAvailable} left)
            a.logout(href="/user/logout") Logout
          else
            a(href="/user/register") Membership
            a(href="/user/login") Login
          a(href="/admin/login") Admin
          if session && session.isAdmin
            a.logout(href="/admin/logout") Logout

        .text-center
          h2(style="font-weight: bold; font-size: 28px; margin-bottom: 25px;") Search the ESL Platform
          - if (!searchKeyword) searchKeyword = "Enter keyword..."
          .input-group.justify-content-center
            input#searchText.form-control.search-input(
              autocomplete='off',
              type='text',
              placeholder=searchKeyword.replace(/\[dot\]/g, '.'),
              value=searchText
            )
            span.input-group-append
              button.sstyly(
                style="margin-left:-55px;background:none;border:none;margin-top:5px;"
              )
                img(src="/assets/img/main/icon-search.png", alt="Search", width="30px")

    nav.navbar.navbar-expand-md.main_nav_bar
      .container
        ul.navbar-nav.justify-content-center
          li.nav-item.text-nowrap
            a.nav-link.h5.my-0(href='/') HOME

    // ✅ 넉넉한 메인 콘텐츠 영역
    main.main-content
      block content

    // ✅ 깔끔한 하단
    footer.footer
      .container
        .row.justify-content-center
          h6.text-white Linked Data Center

    // ✅ 필수 스크립트
    script(src='https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js')
    script(src='/assets/js/core/jquery-ui.min.js', type='text/javascript')
    script(src='/assets/js/core/popper.min.js', type='text/javascript')
    script(src='/assets/js/core/bootstrap.min.js', type='text/javascript')
    script(src='/assets/js/plugins/perfect-scrollbar.jquery.min.js')
    script(src='/assets/js/plugins/bootstrap-switch.js')
    script(src='/assets/js/plugins/nouislider.min.js', type='text/javascript')
    script(src='/assets/js/plugins/moment-with-locale.js', type='text/javascript')
    script(src='/assets/js/plugins/bootstrap-selectpicker.js')
    script(src='/assets/js/plugins/bootstrap-datetimepicker.js', type='text/javascript')
    script(src='/assets/js/now-ui-kit.js?v=1.3.0', type='text/javascript')
    script(src='/assets/js/plugins/bootstrap-notify.js', type='text/javascript')
    script(src='/assets/js/custom/searchBox.js', type='text/javascript')
    script(src='/assets/js/custom/commconst.js')
    script(src='/assets/js/custom/menu.js')
    script(src='https://cdn.jsdelivr.net/npm/semantic-ui@2.5.0/dist/semantic.min.js')

    script.
      $(document).ready(function () {
        $('#teachingAreaDropdown').dropdown({
          allowAdditions: true,
          forceSelection: false,
          fullTextSearch: true,
          allowReselection: true,
          onAdd: function (value, text) {
            console.log("➕ 추가됨:", value);
          }
        });
      });

    block append_js
