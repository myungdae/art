              // 텍스트는 검색바 아래에 배치
              h2(style="font-weight: bold; font-size: 50px; margin-bottom: 25px; color: #FFFFFF") ESL PLUS <br>The fast ESL hiring & tutoring hub
              p(style="font-size: 20px; margin-bottom: 25px; color: #FFFFFF") Teaching opportunities available around the world
        else 
          .head_div
              // 좌측 상단 브랜드 로고
              a.brand-logo(
                href=(typeof siteBrandLink!=='undefined' && siteBrandLink) || '/',
                aria-label=(typeof siteBrand!=='undefined' && siteBrand) || 'ESL Plus',
                title=(typeof siteBrand!=='undefined' && siteBrand) || 'ESL Plus'
