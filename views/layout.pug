//- views/layout.pug  — ART+ 미술 플랫폼
doctype html
html(lang='ko')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title= (typeof pageTitle !== 'undefined' && pageTitle) || 'ART+'
    link(rel='shortcut icon' href='/assets/img/favicon.ico' type='image/x-icon')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css')

    block append_on_header

    style.
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { background: #0d0d0d; color: #fff; font-family: 'Helvetica Neue', Arial, sans-serif; min-height: 100vh; }

      /* ── GNB ────────────────────────────────────────────────── */
      .art-gnb {
        position: sticky; top: 0; z-index: 100;
        background: rgba(10,10,10,0.95);
        border-bottom: 1px solid #1a1a1a;
        backdrop-filter: blur(10px);
        height: 64px;
      }
      .art-gnb-inner {
        max-width: 1340px; margin: 0 auto;
        display: flex; align-items: center; justify-content: space-between;
        padding: 0 24px; height: 64px;
      }
      .art-logo {
        display: flex; align-items: center; gap: 10px;
        text-decoration: none; flex-shrink: 0;
      }
      .art-logo-icon { font-size: 1.6rem; }
      .art-logo-text {
        font-size: 1.25rem; font-weight: 900; color: #fff; letter-spacing: -0.5px;
      }
      .art-logo-text span { color: #d4af37; }

      /* 데스크탑 nav */
      .art-nav { display: flex; align-items: center; gap: 4px; }
      .art-nav a {
        padding: 8px 14px; border-radius: 8px;
        color: rgba(255,255,255,0.6); text-decoration: none;
        font-size: 14px; font-weight: 700; transition: all 0.2s;
        white-space: nowrap;
      }
      .art-nav a:hover { color: #fff; background: rgba(255,255,255,0.06); }
      .art-nav a.active { color: #d4af37; background: rgba(212,175,55,0.1); }

      /* 우측 계정 메뉴 */
      .art-gnb-right { display: flex; align-items: center; gap: 8px; }
      .gnb-login {
        padding: 7px 16px; border-radius: 8px;
        color: rgba(255,255,255,0.6); text-decoration: none;
        font-size: 13px; font-weight: 700; transition: all 0.2s;
      }
      .gnb-login:hover { color: #fff; background: rgba(255,255,255,0.08); }
      .gnb-join {
        padding: 7px 16px; border-radius: 8px;
        background: #d4af37; color: #0d0d0d;
        text-decoration: none; font-size: 13px; font-weight: 800;
        transition: background 0.2s;
      }
      .gnb-join:hover { background: #c9a227; }
      .gnb-admin { color: #f87171; font-size: 12px; font-weight: 700; padding: 6px 12px; }

      /* 햄버거 */
      .art-hamburger {
        display: none; flex-direction: column; gap: 5px;
        cursor: pointer; padding: 6px; background: none; border: none;
      }
      .art-hamburger span {
        width: 22px; height: 2px; background: #fff; border-radius: 2px;
        transition: all 0.3s; display: block;
      }

      /* 모바일 드로어 */
      .art-drawer {
        position: fixed; top: 0; right: -300px; width: 280px; height: 100vh;
        background: #111; border-left: 1px solid #222;
        z-index: 200; transition: right 0.3s ease;
        padding: 70px 0 20px; overflow-y: auto;
      }
      .art-drawer.open { right: 0; }
      .art-drawer a {
        display: block; padding: 14px 24px; color: rgba(255,255,255,0.7);
        text-decoration: none; font-weight: 700; font-size: 15px;
        border-bottom: 1px solid #1a1a1a; transition: all 0.2s;
      }
      .art-drawer a:hover { color: #d4af37; background: rgba(212,175,55,0.05); }
      .art-drawer a.active { color: #d4af37; }
      .art-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,0.7);
        z-index: 199; display: none;
      }
      .art-overlay.open { display: block; }
      .drawer-close {
        position: absolute; top: 20px; right: 20px;
        background: rgba(255,255,255,0.1); border: none; border-radius: 8px;
        color: #fff; width: 36px; height: 36px; cursor: pointer;
        font-size: 18px; display: flex; align-items: center; justify-content: center;
      }

      /* ── Main & Footer ──────────────────────────────────────── */
      main.art-main { min-height: calc(100vh - 64px); }

      footer.art-footer {
        background: #0d0d0d; border-top: 1px solid #1a1a1a;
        padding: 48px 24px 24px;
      }
      .art-footer-inner {
        max-width: 1280px; margin: 0 auto;
        display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 40px;
      }
      .art-footer h4 {
        font-size: 13px; font-weight: 800; color: #d4af37;
        letter-spacing: 2px; text-transform: uppercase; margin-bottom: 16px;
      }
      .art-footer p, .art-footer a {
        font-size: 13px; color: rgba(255,255,255,0.4);
        text-decoration: none; line-height: 2.2;
      }
      .art-footer a:hover { color: #d4af37; }
      .art-footer-bottom {
        max-width: 1280px; margin: 32px auto 0;
        border-top: 1px solid #1a1a1a; padding-top: 24px;
        display: flex; justify-content: space-between; align-items: center;
        font-size: 12px; color: rgba(255,255,255,0.25);
      }
      .ontology-badge {
        display: inline-flex; align-items: center; gap: 6px;
        background: rgba(212,175,55,0.08); border: 1px solid rgba(212,175,55,0.2);
        border-radius: 50px; padding: 4px 12px;
        font-size: 11px; color: #d4af37; font-weight: 700;
      }

      @media (max-width: 900px) {
        .art-nav { display: none; }
        .art-gnb-right { display: none; }
        .art-hamburger { display: flex; }
        .art-footer-inner { grid-template-columns: 1fr; gap: 24px; }
        .art-footer-bottom { flex-direction: column; gap: 8px; }
      }

  body
    //- ── GNB ────────────────────────────────────────────────────
    nav.art-gnb
      .art-gnb-inner
        a.art-logo(href='/')
          .art-logo-icon 🎨
          .art-logo-text ART<span>+</span>

        .art-nav
          a(href='/' class=(currentPage==='/' ? 'active' : '')) HOME
          a(href='/facet/Artworks'    class=(currentPage && currentPage.indexOf('/facet/Artworks')===0    ? 'active' : '')) 🖼️ 작품
          a(href='/facet/Artists'     class=(currentPage && currentPage.indexOf('/facet/Artists')===0     ? 'active' : '')) 👤 작가
          a(href='/facet/Galleries'   class=(currentPage && currentPage.indexOf('/facet/Galleries')===0   ? 'active' : '')) 🏛️ 갤러리
          a(href='/facet/Exhibitions' class=(currentPage && currentPage.indexOf('/facet/Exhibitions')===0 ? 'active' : '')) 🎭 전시
          a(href='/facet/Auctions'    class=(currentPage && currentPage.indexOf('/facet/Auctions')===0    ? 'active' : '')) 🔨 경매
          a(href='/joseon_defense'    class=(currentPage && currentPage.indexOf('/joseon_defense')===0    ? 'active' : '')) 🏯 조선국방

        .art-gnb-right
          if session && session.user
            a.gnb-login(href='/user/mypage') 마이페이지
            a.gnb-login(href='/user/logout') 로그아웃
          else
            a.gnb-login(href='/user/login')   로그인
            a.gnb-join(href='/user/register') 회원가입
          if session && session.isAdmin
            a.gnb-admin(href='/admin/dashboard') ⚙ Admin

        button.art-hamburger#artHamburger(type='button' aria-label='메뉴')
          span
          span
          span

    .art-overlay#artOverlay
    .art-drawer#artDrawer
      button.drawer-close#drawerClose ✕
      a(href='/') HOME
      a(href='/facet/Artworks'    class=(currentPage && currentPage.indexOf('/facet/Artworks')===0    ? 'active' : '')) 🖼️ 작품
      a(href='/facet/Artists'     class=(currentPage && currentPage.indexOf('/facet/Artists')===0     ? 'active' : '')) 👤 작가
      a(href='/facet/Galleries'   class=(currentPage && currentPage.indexOf('/facet/Galleries')===0   ? 'active' : '')) 🏛️ 갤러리
      a(href='/facet/Exhibitions' class=(currentPage && currentPage.indexOf('/facet/Exhibitions')===0 ? 'active' : '')) 🎭 전시
      a(href='/facet/Auctions'    class=(currentPage && currentPage.indexOf('/facet/Auctions')===0    ? 'active' : '')) 🔨 경매
      a(href='/joseon_defense'    class=(currentPage && currentPage.indexOf('/joseon_defense')===0    ? 'active' : '')) 🏯 조선국방
      div(style='border-top:2px solid #222;margin:12px 0')
      if session && session.user
        a(href='/user/mypage') 마이페이지
        a(href='/user/logout') 로그아웃
      else
        a(href='/user/login')   로그인
        a(href='/user/register') 회원가입
      if session && session.isAdmin
        a(href='/admin/dashboard') ⚙ Admin

    //- ── Main ───────────────────────────────────────────────────
    main.art-main
      block content

    //- ── Footer ─────────────────────────────────────────────────
    footer.art-footer
      .art-footer-inner
        div
          h4 ART+
          p 한국 미술을 OWL 온톨로지 기반으로
          p 탐색하는 관계형 미술 플랫폼입니다.
          br
          span.ontology-badge 🔗 OWL Ontology Powered
        div
          h4 탐색
          a(href='/facet/Artworks')    작품 탐색
          br
          a(href='/facet/Artists')     작가 탐색
          br
          a(href='/facet/Galleries')   갤러리
          br
          a(href='/facet/Exhibitions') 전시
          br
          a(href='/facet/Auctions')    경매 기록
        div
          h4 회사 정보
          p Linked Data Center
          p 대표: 조명대
          p 사업자등록번호: 446-06-00440
          p 경기도 화성시 봉담읍 상리 1길 167
          a(href='mailto:myungdae.cho@gmail.com') myungdae.cho@gmail.com
      .art-footer-bottom
        span © 2025 ART+ · Linked Data Center
        span art.exko.kr

    //- ── Scripts ────────────────────────────────────────────────
    script(src='https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js')

    script.
      (function(){
        var btn     = document.getElementById('artHamburger');
        var drawer  = document.getElementById('artDrawer');
        var overlay = document.getElementById('artOverlay');
        var close   = document.getElementById('drawerClose');
        function open(){ drawer.classList.add('open'); overlay.classList.add('open'); }
        function shut(){ drawer.classList.remove('open'); overlay.classList.remove('open'); }
        if(btn)     btn.addEventListener('click', open);
        if(close)   close.addEventListener('click', shut);
        if(overlay) overlay.addEventListener('click', shut);
      })();

    block append_js
