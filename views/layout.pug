//- views/layout.pug
doctype html

html(lang=(typeof htmlLang !== 'undefined' && htmlLang ? htmlLang : 'en'))

  head
    meta(http-equiv='Content-Type', content='text/html; charset=utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0')

    // Title (Brand 우선, 없으면 기본)
    title= (typeof pageTitle !== 'undefined' && pageTitle) || (typeof siteBrand !== 'undefined' && siteBrand) || 'ESL Plus'
    link(rel='shortcut icon', href='/assets/img/favicon.ico', type='image/x-icon')

    // CSS
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/semantic-ui@2.5.0/dist/semantic.min.css')
    link(rel='stylesheet', href='https://netdna.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css')
    link(rel='stylesheet', href='/assets/css/jquery-ui.min.css')
    link(rel='stylesheet', href='/assets/css/bootstrap.min.css')
    link(href='/assets/css/animate.min.css', rel='stylesheet')
    link(href='/assets/css/now-ui-kit.css?v=1.3.0', rel='stylesheet')
    link(href='/assets/css/custom.css', rel='stylesheet')

    // ✅ Google Analytics (GA4)
    script(async src="https://www.googletagmanager.com/gtag/js?id=G-4645N65FCR")
    script.
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4645N65FCR');

    block append_on_header

    // ─────────────────────────────────────────────────────────
    // Global styles
    // ─────────────────────────────────────────────────────────
    style.
      /* 헤더 */
      .search-header {  background-color: #fff; display: flex; align-items: center; justify-content: space-between;  }
      .menu-top {  gap: 30px; padding-top: 20px}
      .menu-top a { font-weight: 700; color:#000; text-decoration: none; }

      /* 모바일: 우상단에 계정 토글 버튼, 드롭다운 */
      .menu-top-mob { position: absolute; top: 12px; right: 12px; display:none; z-index: 5; }
      .menu-drop {
        position: absolute; top: 44px; right: 0;
        background:#fff; border:1px solid #e5e7eb; border-radius:12px;
        box-shadow:0 8px 20px rgba(0,0,0,.08); padding:10px; width: 210px; display:none;
      }
      .container-fluid { padding: 0px; }
      .main-menu { display: flex; flex-direction: row; justify-content: center; }
      .account-menu { display: flex; flex-direction: row; justify-content: center; }
      .main_header {
        width: '100%';
        height: 750px;
        display: flex; flex-direction: column;
        background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url('assets/img/header-background.jpg');
        background-size: cover; background-position: center; background-repeat: no-repeat;
      }

      .main-menu a {font-size: 18px; color: #FFFFFF; height: 'auto'}
      .account-menu a {font-size: 14px; color:#D8D8D8}

      .menu-drop a { display:block; padding:8px 10px; color:#111; text-decoration:none; border-radius:8px; font-weight:700; }
      .menu-drop a:hover { background:#f3f4f6; }
      .menu-drop.show { display:block; }
      .head_div {display: flex; flex-direction: row; justify-content: center; }

      .black-text { color: black !important; }
      .gray-text { color:rgb(90, 90, 90) !important; }

      /* 상단 검색 인풋 */
      .search-input {
        max-width: 650px; height: 70px; font-size: 16pt;
        border: 7px solid #FF7A00 !important; border-radius: 12px !important; padding: 0 20px;
        background-color: white;
      }

      .main-content { min-height: 500px; padding: 60px 30px; background-color: #fff; }
      footer.footer { background-color: #E5E5E5; color: #666666; padding: 30px 0; margin-top: 0;}

      /* GNB(파란 바) */
      nav.main_nav_bar { background:#0d46ff; }
      nav.main_nav_bar .nav-link { color:#fff !important; font-weight:700; letter-spacing:.3px; }
      nav.main_nav_bar .navbar-nav { gap:24px; }
      nav.main_nav_bar .nav-link.active { text-decoration: underline; text-underline-offset: 6px; }
      nav.main_nav_bar #searchText, nav.main_nav_bar .sstyly { display:none !important; }

      /* 부트스트랩 토글러 색상 */
      .navbar-toggler { border-color: rgba(255,255,255,.55); }
      .navbar-toggler .fa { color:#fff; font-size:18px; }

      /* 브랜드 로고 (좌측 상단) */
      .brand-logo img{  width: 300px; height: auto }
      .other_a {color: black;}

      /* 모바일 레이아웃 스위치 */
      @media (max-width: 767.98px) {
        .menu-top { display:none; }
        .menu-top-mob { display:block; }
        .search-header { padding: 56px 0 56px 0; }
        .brand-logo{top:12px;left:12px}
        .brand-logo img{height:30px}
      }

    // My Page 스코프 (원본 유지)
    style.
      .mypage-scope {
        color:#222; --mp-text:#222; --mp-dim:#6b7280; --mp-bg:#f5f6f8; --mp-card:#f9f9f9;
        --mp-line:#e5e7eb; --mp-primary:#0d6efd; --mp-radius:16px;
      }
      .mypage-scope .container, .mypage-scope .container-fluid { color: var(--mp-text); }
      .mp-title-xl { font-size: 2.5rem; font-weight: 800; color: #333; letter-spacing: -0.2px; }
      .mp-subtext { color: var(--mp-dim); }
      .mp-card { background: var(--mp-card); border: 1px solid var(--mp-line); border-radius: var(--mp-radius); }
      .mp-card .card-body { padding: 1.25rem; }
      .mp-card .card-header { background: transparent; border-bottom: 1px solid var(--mp-line); padding: .875rem 1rem; }
      .mp-field label { font-size: .92rem; color: var(--mp-dim); margin-bottom: .25rem; }
      .mp-field .form-control, .mp-field .form-select, .mp-field textarea {
        background: #fff; color: #111; border: 1px solid #d1d5db; border-radius: 12px; padding: .7rem .9rem;
      }
      .mp-field .form-control:focus, .mp-field .form-select:focus, .mp-field textarea:focus {
        border-color: var(--mp-primary); box-shadow: 0 0 0 .25rem rgba(13,110,253,.15);
      }
      .mp-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      @media (max-width: 992px) { .mp-grid-2 { grid-template-columns: 1fr; } }
      .gap-6 { gap: 1.5rem !important; } .gap-8 { gap: 2rem !important; }
      .mp-muted { color: var(--mp-dim) !important; }
      .mp-divider { height: 1px; background: var(--mp-line); margin: 1rem 0; border: 0; }
      .mp-btn-group .btn { border-radius: 10px !important; }
      .mp-btn-tight .btn { padding-top: .55rem; padding-bottom: .55rem; }
      .btn-outline-dark[aria-disabled="true"] { pointer-events: none; opacity: .65; }
      .mp-list { list-style: none; margin: 0; padding: 0; }
      .mp-list li + li { margin-top: .75rem; }
      .mp-list-title { font-weight: 700; color: #111; }
      .mp-list-sub { color: var(--mp-dim); font-size: .925rem; margin-top: .15rem; }
      .mp-list a { text-decoration: none; color: var(--mp-primary); }
      .mp-list a:hover { text-decoration: underline; }
      @media (max-width: 576px) {
        .btn-block-mobile .btn { width: 100%; }
        .btn-block-mobile .btn + .btn { margin-top: .5rem; }
      }

  body
    include common_value

    // ───────── 상단 헤더 ─────────
    header.main-search-header.search-header(class=(currentPage==='/' ? '' : 'compact'))
      .container-fluid
        // 'HOME'에서만 보이는 메인 콘텐츠 (검색창 등)
        if currentPage==='/'
          .main_header
            .head_div
              // 좌측 상단 브랜드 로고
              a.brand-logo(
                href=(typeof siteBrandLink!=='undefined' && siteBrandLink) || '/',
                aria-label=(typeof siteBrand!=='undefined' && siteBrand) || 'ESL Plus',
                title=(typeof siteBrand!=='undefined' && siteBrand) || 'ESL Plus'
              )
                img(src="/assets/img/eslplus.svg", alt=(typeof siteBrand!=='undefined' && siteBrand) || 'ESL Plus')

              // 데스크탑: 우상단 계정 링크
              .menu-top.d-none.d-md-flex
                .main-menu
                  a.nav-link.h5.my-0(class=(currentPage==='/' ? 'active' : ''), href='/') HOME
                  a.nav-link.h5.my-0(class=(currentPage && (currentPage.indexOf('/facet/Job_Vacancies')===0 || currentPage.indexOf('/job-vacancies')===0)) ? 'active' : '', href='/facet/Job_Vacancies') JOB VACANCIES
                  a.nav-link.h5.my-0(class=(currentPage && currentPage.indexOf('/facet/Job_Seekers')===0) ? 'active' : '', href='/facet/Job_Seekers') JOB SEEKERS
                  a.nav-link.h5.my-0(class=(currentPage && currentPage.indexOf('/facet/Online_Tutors')===0) ? 'active' : '', href='/facet/Online_Tutors') ONLINE TUTORS
                .account-menu
                  if session && session.user
                    a.nav-link.h5.my-0(href="/user/mypage") Mypage
                    if session.user.adsAvailable !== undefined
                      | (#{session.user.adsAvailable} left)
                    a.nav-link.h5.my-0(href="/inquiry") Inquiry
                    a.logou.nav-link.h5.my-0(href="/user/logout") Logout
                  else
                    a.nav-link.h5.my-0(href="/user/register") Membership
                    a.nav-link.h5.my-0(href="/user/login") Login
                    a.nav-link.h5.my-0(href="/inquiry") Inquiry

                  if session && session.isAdmin
                    a.nav-link.h5.my-0(href="/admin/dashboard") Admin
                    a.nav-link.h5.my-0(href="/admin/logout").logout Logout
            .text-center(style="margin-top: 100px;")
              h2(style="font-weight: bold; font-size: 50px; margin-bottom: 25px; color: #FFFFFF") ESL PLUS <br>The fast ESL hiring & tutoring hub
              p(style="font-size: 20px; margin-bottom: 25px; color: #FFFFFF") Teaching opportunities available around the world

              - var _ph = (typeof searchKeyword!=='undefined' && searchKeyword) ? searchKeyword : "Enter keyword...";
              .input-group.justify-content-center
                input#searchText.form-control.search-input(
                  autocomplete='off',
                  type='text',
                  placeholder=_ph.replace(/\[dot\]/g, '.'),
                  value=searchText
                )
                span.input-group-append
                  button.sstyly(
                    style="margin-left:-55px;background:none;border:none;margin-top:5px; z-index: 2"
                    type="button"
                  )
                    img(src="/assets/img/search.png", alt="Search", width="30")

              // ✅ 홈 검색창 '바로 아래'에 꽂아 넣는 슬롯
              block home_below_search

        else
          .head_div
            a.brand-logo(
              href=(typeof siteBrandLink!=='undefined' && siteBrandLink) || '/',
              aria-label=(typeof siteBrand!=='undefined' && siteBrand) || 'ESL Plus',
              title=(typeof siteBrand!=='undefined' && siteBrand) || 'ESL Plus'
            )
              img(src="/assets/img/eslplus.svg", alt=(typeof siteBrand!=='undefined' && siteBrand) || 'ESL Plus')
            .menu-top.d-none.d-md-flex
              .main-menu
                a.nav-link.h5.my-0.black-text(class=(currentPage==='/' ? 'active' : ''), href='/') HOME
                a.nav-link.h5.my-0.black-text(class=(currentPage && (currentPage.indexOf('/facet/Job_Vacancies')===0 || currentPage.indexOf('/job-vacancies')===0)) ? 'active' : '', href='/facet/Job_Vacancies') JOB VACANCIES
                a.nav-link.h5.my-0.black-text(class=(currentPage && currentPage.indexOf('/facet/Job_Seekers')===0) ? 'active' : '', href='/facet/Job_Seekers') JOB SEEKERS
                a.nav-link.h5.my-0.black-text(class=(currentPage && currentPage.indexOf('/facet/Online_Tutors')===0) ? 'active' : '', href='/facet/Online_Tutors') ONLINE TUTORS
              .account-menu
                if session && session.user
                  a.gray-text.nav-link.h5(href="/user/mypage") Mypage
                  if session.user.adsAvailable !== undefined
                    | (#{session.user.adsAvailable} left)
                  a.nav-link.h5.my-0.gray-text(href="/inquiry") Inquiry
                  a.logout.nav-link.h5.my-0.gray-text(href="/user/logout") Logout
                else
                  a.nav-link.h5.my-0.gray-text(href="/user/register") Membership
                  a.nav-link.h5.my-0.gray-text(href="/user/login") Login
                  a.nav-link.h5.my-0.gray-text(href="/inquiry") Inquiry

                if session && session.isAdmin
                  a.nav-link.h5.my-0.gray-text(href="/admin/dashboard" ) Admin
                  a.nav-link.h5.my-0.gray-text(href="/admin/logout").logout Logout

        // 모바일: 우상단 계정 토글
        .menu-top-mob.d-md-none
          button#topMenuToggle.btn.btn-outline-dark.btn-sm(type="button", aria-label="Account")
            i.fa.fa-user
          .menu-drop#topMenuDrop
            if session && session.user
              a(href="/user/mypage") Mypage
              if session.user.adsAvailable !== undefined
                a(href="javascript:void(0)") (#{session.user.adsAvailable} left)
              a(href="/inquiry") Inquiry
              a(href="/user/logout").logout Logout
            else
              a(href="/user/register") Membership
              a(href="/user/login") Login
              a(href="/inquiry") Inquiry

            if session && session.isAdmin
              a(href="/admin/dashboard") Admin
              a(href="/admin/logout").logout Logout

    // 메인 컨텐츠
    main.main-content
      block content

    // footer
    footer.footer
      .container
        .d-flex.align-items-start
          div.logo-area
            img(src="/assets/img/linked-data.png" alt="Linked Data Center" style="max-height:80px")
          div.company-info
            h6 Company Information
            p Company Name: Linked Data Center
            p CEO: Youngdo Cho
            p Business Registration No.: 446-06-00440
            p E-Commerce Intermediary Registration No.: 2025-Seoul-Gangnam-0000
            p Address: 167, Sangri 1-gil, Bongdam-eup, Hwaseong-si, Gyeonggi-do, Apt. 601-101 (Jungheung S-Class Edu Foret)
            p Customer Support: myungdae.cho@gmail.com
          div.link-area
            a(href="/policy/terms") Terms of Service
            a(href="/policy/privacy") Privacy Policy
            a(href="/policy/refund") Refund Policy
      hr.my-3
      .row.mt-3
        .col.text-center
          p © 2025 ESL PLUS. All rights reserved.

