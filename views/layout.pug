                    a.nav-link.h5.my-0.gray-text(href="/admin/logout").logout Logout

        // 모바일: 햄버거 메뉴 (좌측)
        .menu-hamburger.d-md-none
          button#hamburgerToggle.btn.btn-outline-dark.btn-sm(type="button", aria-label="Menu")
