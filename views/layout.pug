    script(src='/assets/js/plugins/bootstrap-notify.js', type='text/javascript')
    script(src="/js/english-validation.js")

    // 커스텀
    script(src='/assets/js/custom/searchBox.js', type='text/javascript')
    script(src='/assets/js/custom/menu.js')
    script(src='/assets/js/custom/nav-prettify.js')
    script(src='/assets/js/custom/nav-dedupe.js')
    script(src='/assets/js/custom/nav-hardfix.js')

    // 모먼트 로케일 고정(안전)
    script.
      if (window.moment) { try { moment.locale('en'); } catch(e){} }

    // 모바일 계정 드롭 토글
    script.
      (function () {
        var btn = document.getElementById('topMenuToggle');
        var drop = document.getElementById('topMenuDrop');
        if (!btn || !drop) return;
        btn.addEventListener('click', function(e){
          e.stopPropagation();
          drop.classList.toggle('show');
        });
        document.addEventListener('click', function(e){
          if (drop.classList.contains('show') && !drop.contains(e.target) && e.target !== btn) {
            drop.classList.remove('show');
          }
        });
      })();

    // 공용 유틸
    script.
      function previewFileName(inputId, labelId){
        const input = document.getElementById(inputId);
        const label = document.getElementById(labelId);
        if(!input || !label) return;
        const f = input.files && input.files[0];
        label.textContent = f ? f.name : 'No file selected';
      }

    block append_js
