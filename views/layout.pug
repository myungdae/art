        // 모바일: 메인 메뉴 드로어 (메인 메뉴 + 계정 메뉴 통합)
        .menu-overlay#menuOverlay
        .main-menu-mobile#mainMenuMobile
          a(href="/", class=(currentPage==='/' ? 'active' : '')) HOME
          a(href="/facet/Job_Vacancies", class=(currentPage && (currentPage.indexOf('/facet/Job_Vacancies')===0 || currentPage.indexOf('/job-vacancies')===0)) ? 'active' : '') JOB VACANCIES
          a(href="/facet/Job_Seekers", class=(currentPage && currentPage.indexOf('/facet/Job_Seekers')===0) ? 'active' : '') JOB SEEKERS
          a(href="/facet/Online_Tutors", class=(currentPage && currentPage.indexOf('/facet/Online_Tutors')===0) ? 'active' : '') ONLINE TUTORS
          
          // 구분선
          div(style="border-top: 2px solid #ddd; margin: 10px 0;")
          
          // 계정 메뉴
          if session && session.user
            a(href="/user/mypage") Mypage
            if session.user.adsAvailable !== undefined
