//- views/layout.pug
doctype html
html(lang='en')
  head
    meta(http-equiv='Content-Type', content='text/html; charset=utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0')

    // 👇 레이아웃 반영 확인용 마킹
    title ESL · SMTP (LAYOUT-TEST)

    link(rel='shortcut icon', href='/assets/img/favicon.ico', type='image/x-icon')

    // CSS
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css")
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/semantic-ui@2.5.0/dist/semantic.min.css')
    link(rel='stylesheet', href='https://netdna.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css')
    link(rel='stylesheet', href='/assets/css/jquery-ui.min.css')
    link(rel='stylesheet', href='/assets/css/bootstrap.min.css')
    link(href='/assets/css/animate.min.css', rel='stylesheet')
    link(href='/assets/css/now-ui-kit.css?v=1.3.0', rel='stylesheet')
    link(href='/assets/css/custom.css', rel='stylesheet')

    block append_on_header

    // 스타일
    style.
      /* 헤더 */
      .search-header { position: relative; padding: 40px 0 80px 0; background-color: #fff; }
      .menu-top { position: absolute; top: 20px; right: 20px; display:flex; gap:18px; }
      .menu-top a { font-size: 15px; font-weight: 700; color:#000; text-decoration: none; }
      .menu-top a.logout { color: red; }

      /* 모바일: 우상단에 계정 토글 버튼, 드롭다운 */
      .menu-top-mob { position: absolute; top: 12px; right: 12px; display:none; z-index: 5; }
      .menu-drop {
        position: absolute; top: 44px; right: 0;
        background:#fff; border:1px solid #e5e7eb; border-radius:12px;
        box-shadow:0 8px 20px rgba(0,0,0,.08); padding:10px; width: 210px; display:none;
      }
      .menu-drop a { display:block; padding:8px 10px; color:#111; text-decoration:none; border-radius:8px; font-weight:700; }
      .menu-drop a:hover { background:#f3f4f6; }
      .menu-drop.show { display:block; }

      .search-input {
        max-width: 600px; height: 60px; font-size: 16pt;
        border: 2px solid #ccc; border-radius: 30px; padding: 10px 25px;
      }

      .main-content { min-height: 500px; padding: 60px 30px; background-color: #fff; }
      footer.footer { background-color: #333; color: #fff; padding: 30px 0; margin-top: 0; }

      /* GNB(파란 바) */
      nav.main_nav_bar { background:#0d46ff; }
      nav.main_nav_bar .nav-link { color:#fff !important; font-weight:700; letter-spacing:.3px; }
      nav.main_nav_bar .navbar-nav { gap:24px; }
      nav.main_nav_bar .nav-link.active { text-decoration: underline; text-underline-offset: 6px; }
      /* nav에 혹시 검색 DOM이 생겨도 숨김 (안전장치) */
      nav.main_nav_bar #searchText, nav.main_nav_bar .sstyly { display:none !important; }

      /* 부트스트랩 토글러 색상 */
      .navbar-toggler { border-color: rgba(255,255,255,.55); }
      .navbar-toggler .fa { color:#fff; font-size:18px; }

      /* 모바일 레이아웃 스위치 */
      @media (max-width: 767.98px) {
        .menu-top { display:none; }
        .menu-top-mob { display:block; }
        .search-header { padding: 56px 0 56px 0; }
      }

    // My Page 스코프 (원본 유지)
    style.
      .mypage-scope {
        color:#222; --mp-text:#222; --mp-dim:#6b7280; --mp-bg:#f5f6f8; --mp-card:#f9f9f9;
        --mp-line:#e5e7eb; --mp-primary:#0d6efd; --mp-radius:16px;
      }
      .mypage-scope .container, .mypage-scope .container-fluid { color: var(--mp-text); }
      .mp-title-xl { font-size: 2.5rem; font-weight: 800; color: #333; letter-spacing: -0.2px; }
      .mp-subtext { color: var(--mp-dim); }
      .mp-card { background: var(--mp-card); border: 1px solid var(--mp-line); border-radius: var(--mp-radius); }
      .mp-card .card-body { padding: 1.25rem; }
      .mp-card .card-header { background: transparent; border-bottom: 1px solid var(--mp-line); padding: .875rem 1rem; }
      .mp-field label { font-size: .92rem; color: var(--mp-dim); margin-bottom: .25rem; }
      .mp-field .form-control, .mp-field .form-select, .mp-field textarea {
        background: #fff; color: #111; border: 1px solid #d1d5db; border-radius: 12px; padding: .7rem .9rem;
      }
      .mp-field .form-control:focus, .mp-field .form-select:focus, .mp-field textarea:focus {
        border-color: var(--mp-primary); box-shadow: 0 0 0 .25rem rgba(13,110,253,.15);
      }
      .mp-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      @media (max-width: 992px) { .mp-grid-2 { grid-template-columns: 1fr; } }
      .gap-6 { gap: 1.5rem !important; } .gap-8 { gap: 2rem !important; }
      .mp-muted { color: var(--mp-dim) !important; }
      .mp-divider { height: 1px; background: var(--mp-line); margin: 1rem 0; border: 0; }
      .mp-btn-group .btn { border-radius: 10px !important; }
      .mp-btn-tight .btn { padding-top: .55rem; padding-bottom: .55rem; }
      .btn-outline-dark[aria-disabled="true"] { pointer-events: none; opacity: .65; }
      .mp-list { list-style: none; margin: 0; padding: 0; }
      .mp-list li + li { margin-top: .75rem; }
      .mp-list-title { font-weight: 700; color: #111; }
      .mp-list-sub { color: var(--mp-dim); font-size: .925rem; margin-top: .15rem; }
      .mp-list a { text-decoration: none; color: var(--mp-primary); }
      .mp-list a:hover { text-decoration: underline; }
      @media (max-width: 576px) {
        .btn-block-mobile .btn { width: 100%; }
        .btn-block-mobile .btn + .btn { margin-top: .5rem; }
      }

  body
    include common_value

    // ───────── 상단 헤더 ─────────
    header.main-search-header.search-header
      .container-fluid

        // 데스크탑: 우상단 계정 링크 (Inquiry 항상 노출 / Admin은 관리자만)
        .menu-top.d-none.d-md-flex
          if session && session.user
            a(href="/user/mypage") Mypage
            if session.user.adsAvailable !== undefined
              | (#{session.user.adsAvailable} left)
            a(href="/inquiry") Inquiry
            a.logout(href="/user/logout") Logout
          else
            a(href="/user/register") Membership
            a(href="/user/login") Login
            a(href="/inquiry") Inquiry

          if session && session.isAdmin
            a(href="/admin/dashboard") Admin
            a(href="/admin/logout").logout Logout

        // 모바일: 우상단 계정 토글 (Inquiry 항상 노출 / Admin은 관리자만)
        .menu-top-mob.d-md-none
          button#topMenuToggle.btn.btn-outline-dark.btn-sm(type="button", aria-label="Account")
            i.fa.fa-user
          .menu-drop#topMenuDrop
            if session && session.user
              a(href="/user/mypage") Mypage
              if session.user.adsAvailable !== undefined
                a(href="javascript:void(0)") (#{session.user.adsAvailable} left)
              a(href="/inquiry") Inquiry
              a(href="/user/logout").logout Logout
            else
              a(href="/user/register") Membership
              a(href="/user/login") Login
              a(href="/inquiry") Inquiry

            if session && session.isAdmin
              a(href="/admin/dashboard") Admin
              a(href="/admin/logout").logout Logout

        // 중앙 타이틀 + 검색
        .text-center
          // 👇 반영 확인용 마킹
          // INQUIRY-MARK
          h2(style="font-weight: bold; font-size: 28px; margin-bottom: 25px;") ESL · SMTP
          - if (!searchKeyword) searchKeyword = "Enter keyword..."
          .input-group.justify-content-center
            input#searchText.form-control.search-input(
              autocomplete='off',
              type='text',
              placeholder=searchKeyword.replace(/\[dot\]/g, '.'),
              value=searchText
            )
            span.input-group-append
              button.sstyly(
                style="margin-left:-55px;background:none;border:none;margin-top:5px;"
                type="button"
              )
                img(src="/assets/img/main/icon-search.png", alt="Search", width="30px")

    // ───────── GNB (부트스트랩 햄버거)
    nav.navbar.navbar-expand-md.main_nav_bar
      .container
        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#mainNav", aria-controls="mainNav", aria-expanded="false", aria-label="Toggle navigation")
          i.fa.fa-bars
        #mainNav.collapse.navbar-collapse
          ul.navbar-nav.justify-content-center.w-100
            li.nav-item.text-nowrap
              a.nav-link.h5.my-0(class=(currentPage==='/' ? 'active' : ''), href='/') HOME
          // NOTE: 카테고리 메뉴는 menu.js가 주입

    // 메인
    main.main-content
      block content

    // 푸터
    footer.footer
      .container
        .row.justify-content-center
          h6.text-white Linked Data Center

    // 스크립트
    script(src='https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js')
    script(src='/assets/js/core/jquery-ui.min.js', type='text/javascript')
    script(src='/assets/js/core/popper.min.js', type='text/javascript')
    script(src='/assets/js/core/bootstrap.min.js', type='text/javascript')
    script(src='/assets/js/plugins/perfect-scrollbar.jquery.min.js')
    script(src='/assets/js/plugins/bootstrap-switch.js')
    script(src='/assets/js/plugins/nouislider.min.js', type='text/javascript')
    script(src='/assets/js/plugins/moment-with-locale.js', type='text/javascript')
    script(src='/assets/js/plugins/bootstrap-selectpicker.js')
    script(src='/assets/js/plugins/bootstrap-datetimepicker.js', type='text/javascript')
    script(src='/assets/js/now-ui-kit.js?v=1.3.0', type='text/javascript')
    script(src='/assets/js/plugins/bootstrap-notify.js', type='text/javascript')

    // 커스텀
    script(src='/assets/js/custom/searchBox.js', type='text/javascript')
    script(src='/assets/js/custom/menu.js')
    script(src='/assets/js/custom/nav-prettify.js')

    // 모바일 계정 드롭 토글
    script.
      (function () {
        var btn = document.getElementById('topMenuToggle');
        var drop = document.getElementById('topMenuDrop');
        if (!btn || !drop) return;
        btn.addEventListener('click', function(e){
          e.stopPropagation();
          drop.classList.toggle('show');
        });
        document.addEventListener('click', function(e){
          if (drop.classList.contains('show') && !drop.contains(e.target) && e.target !== btn) {
            drop.classList.remove('show');
          }
        });
      })();

    // 공용 유틸
    script.
      function previewFileName(inputId, labelId){
        const input = document.getElementById(inputId);
        const label = document.getElementById(labelId);
        if(!input || !label) return;
        const f = input.files && input.files[0];
        label.textContent = f ? f.name : 'No file selected';
      }

    block append_js
