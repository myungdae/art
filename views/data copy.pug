extends layout
block content
	- var displayOnBottom = collections[resource + 'displayOnBottom']['@list'];
	- var displayOnMiddle = collections[resource + 'displayOnMiddle']['@list'];

	//- console.log('structure : ' + JSON.stringify(structure.class, null, '\t'));

	
	//- var class_facet = structure.class.map(function(v){let obj = {}; obj['id'] = v._id; obj['list'] = v.list; return obj});
	//- var subClass = structure.subClass.map(function(v){let obj = {}; obj['id'] = v._id; obj['subClass'] = v.list; return obj});
	//- - class_facet.forEach(function(v){subClass.forEach(function(w){if(v.id === w.id){v['subClass'] = w.subClass} }) });

	//- var displayOnMiddle = collections[resource + 'displayOnMiddle']['@list'].map(function(v){return v['@id']});


	.container(style="padding-top:30px;")
		.row
			.col.mx-auto
				h4.title #{title}
		form#formData
			<!-------------------- 신규등록 -------------------->
			.form-row
				.form-group.col-md-6
					label(for="inputID") ID
					input#inputID.form-control.border-top-0.border-left-0.border-right-0.rounded-0(type="text", placeholder="ID", value=(doc!==null?doc['@id'].replace(resource, ''):''), readonly=(doc))
				.form-group.col-md-6
					label(for="inputType") TYPE
					select#inputType.selectpicker.d-block(data-style="select-with-transition btn-neutral border text-dark btn-round", data-live-search="true", name='@type', disabled=(doc))
						each opt in structures
							option(value=opt._id, selected=opt._id===(doc?doc['@type']:default_title)) #{opt._id.replace(resource, '')}
			.form-row
				.form-group.col-md-6
					label(for='inputLabel') Label
					input#inputLabel.form-control.border-top-0.border-left-0.border-right-0.rounded-0(type="text", placeholder="label", value=(doc!==null?doc[label]['@value']?doc[label]['@value']?doc[label]['@value'].replace(/\[dot\]/g, '.'):doc[label].replace(/\[dot\]/g, '.'):'':''))
			.form-row
				.form-group.col-12
					label(for='desc') 설명
					textarea#desc.form-control.border-top-0.border-left-0.border-right-0.rounded-0(style='max-height:200px;', rows=5) #{(doc!==null?doc[description]?doc[description]['@value']?doc[description]['@value'].replace(/\[dot\]/g, '.'):doc[description].replace(/\[dot\]/g, '.'):'':'')}
			#divSubClass.d-none
				br
				h5.font-weight-bold 하위클래스
				hr
				.form-row.form-group
					input#inpSubClass.form-control.border-left-0.border-top-0.border-right-0.rounded-0(readonly)
				.form-row#sub_class
			br
			<!-------------------- 연계정보 -------------------->
			h5.font-weight-bold 연계정보
			hr
			.form-row#linked_info
				each item in structures
					- var key = (doc?doc['@type'] + '_' + item._id.replace(resource, ''):'');
					- var val = '';
					- if(doc)if(doc[key]) val = doc[key]['@id'];


					//- - console.log('-------------------------------------------------------');
					//- - console.log('id : ' + item._id.replace(resource, ''));
					//- - console.log('_id : ' + JSON.stringify(item.list, null, '\t'));
					//- - console.log('-------------------------------------------------------');



					.form-group.col-md-6(class=(item['_id'] === default_title?'d-none':''), data-title=val)
						label(for=item._id, data-title=item._id.replace(resource, '')) #{item._id.replace(resource, '')}
						select.selectpicker.d-block(id=item._id, data-style="select-with-transition btn-neutral border text-dark btn-round", data-live-search="true", name=item._id.replace(resource, ''), data-type='@type', title=item._id.replace(resource, '') + ' 선택')
							option(value='') #{item._id.replace(resource, '')} 선택
							option(data-divider='true')
							if(item.list)
								each opt in item.list


									//- console.log('opt : ' + JSON.stringify(opt, null, '\t'));
									//- console.log('opt : ' + opt);


									if(opt._label)


										//- - console.log('_label : ' + opt._label);
										//- - console.log('opt : ' + JSON.stringify(opt, null, '\t'));


										option(value=opt._id selected=opt._id===val) #{opt._label.replace(/\[dot\]/g , '.')}
			br
			<!-------------------- 속성정보 -------------------->
			h5.font-weight-bold 속성정보
			hr
			.form-row#attribute_info
				each item in displayOnBottom
					- var val = '';
					//- if(doc){if(doc[item['@id']]) val = doc[item['@id']]['@value'].replace(/\[dot\]/g, '.')}
					- if(doc){if(doc[item['@id']]) val = doc[item['@id']]['@value']}
					.form-group.col-md-6
						label.text-nowrap(for=item['@id']) #{item['@id'].replace(resource, '')}
						textarea.form-control.border-top-0.border-left-0.border-right-0.rounded-0(name=item['@id']) #{val}
			.row
				.mx-auto
					if(!doc)
						button.btn.btn-round.btn-primary(type='button', onclick='fnSubmit()') 제출
					if(doc)
						button.btn.btn-round.btn-success(type='button', onclick='fnUpdate()') 수정
						button.btn.btn-round.btn-danger(type='button', onclick='fnDelete()') 삭제
	// sub class modal popup
	#subClassModal.modal.fade(tabindex="-1" role="dialog" aria-hidden="true")
		.modal-dialog.modal-dialog-centered(role="document")
			.modal-content
				.modal-header
					h5#subClassLabel.modal-title
					button.close(type="button" data-dismiss="modal" aria-label="Close")
						span(aria-hidden="true") ×
				.modal-body
					.table
						#subClassList
					button.btn.btn-success.btn-sm(onclick='fnAppendRow()')
						i.now-ui-icons.ui-1_simple-add
					//.d-flex
					//	input.form-control.rounded-0.border-right-0.border-top-0.border-left-0
					//
					//	#appendSubClassList
				.modal-footer
					button.btn.btn-secondary(type="button" data-dismiss="modal") 닫기
					button.btn.btn-primary(type="button", onclick='fnUpdateSubClass()') 저장




					
block append_js
	script.
		let resource = '!{resource}';
		let description = '!{description}';
		let label = '!{label}';
		//	type 을 바꿀 때 연계정보 숨김/표시 처리
		$('#inputType').on('changed.bs.select', function(e){
			document.querySelectorAll('#linked_info > div').forEach(function(v){
				v.classList.add('d-none');
				v.classList.remove('d-block');
			});
			let type = e.currentTarget.value;
			let type_val = type.replace(resource, '');
			let replace = type_val;
			let replace_type = new RegExp(replace, "g");
			let displayOnMiddle = !{JSON.stringify(displayOnMiddle)};
			let filter = displayOnMiddle.filter(function(v){
				if(v['@id'].indexOf(type_val) > -1) return v;
			}).reduce(function(a, b){return a.concat(b['@id'].replace(resource, '').split('_'))}, [])
				.filter(function(value, index, self){return self.indexOf(value) === index});
			filter.splice(filter.indexOf(type_val), 1)
			filter.forEach(function(v){
				$('label[data-title="' + v + '"]')[0].parentNode.classList.add('d-block');
				$('label[data-title="' + v + '"]')[0].parentNode.classList.remove('d-none');
			});
			fnGenSubClass(type);
		});
		// sub class 만들어주는 함수
		fnGenSubClass = function(type){
			let html = '';
			let subClass = null;
			!{JSON.stringify(structure)}.forEach(function(v){if(v._id === type) subClass = v.subClass});
			if(subClass){
				// html += '<div class="table table-bordered">';
				html += '<table class="table table-striped">';
				html += '<thead>';
				html += '<tr><th class="font-weight-bold">#</th><th class="font-weight-bold text-center">sub class 명</th><th></th>';
				html += '<tbody>';
				subClass.forEach(function (v, i){
					let name = v['@type'].replace(resource, '');
					html += '<tr>' +
						'<td>' + (i +1) + '</td>' +
						'<td class="text-nowrap text-center">' + name + '</td>' +
						'<td><button type="button" class="btn btn-primary btn-round pull-right" data-toggle="modal" data-target="#subClassModal" onclick="fnGetSubClass(`' + name + '`)">하위클래스 보기</button></td>' +
						'</tr>';
				});
				html += '</tbody>';
				html += '</table>'
				document.querySelector('#sub_class').innerHTML = html;
				document.querySelector('#divSubClass').classList.remove('d-none');
			}else{
				document.querySelector('#sub_class').innerHTML = '';
				// document.querySelector('#inpSubClass').value = '';
				document.querySelector('#divSubClass').classList.add('d-none');
			}
		}
		// subClass 정보 추출
		fnGetSubClass = function(name){
			document.querySelector('#subClassLabel').innerText = name;
			$.ajax({
				url: '/data/subClass/' + name,
				method: 'GET',
				success: function (res) {
					let html = '<table class="table table-sm">';
					html += '<thead><tr><th>#</th><th class="text-center">name</th><th></th></tr>';
					html += '<tbody>';
					if(res.length > 0){
						res.forEach(function (v, i) {
							let val = v[label]['@value'] || v['@id'].replace(_resource, '');
							html += '<tr>';
							html += '<td>' + (i + 1) + '</td>';
							html += '<td class="text-center">' + val.replace(/\[dot\]/g, '.') + '</td>';
							html += '<td class="text-center">' +
								'<button class="btn btn-neutral btn-icon btn-round text-danger pull-right" rel="tooltip" data-original-title="제거" onclick="fnRemoveSubClass(`' + val.replace(/\[dot\]/g, '.') + '`)"><i class="now-ui-icons ui-1_simple-remove"></i></button>' +
								// '<button class="btn btn-neutral btn-icon btn-round text-success pull-right" rel="tooltip" data-original-title="선택" onclick="fnSetSubClass(`' + val + '`)"><i class="now-ui-icons ui-1_check"></i></button>' +
								'</td>';
							html += '</tr>';
						});
					}else{
						// html += '<tr><td>1</td><td class="text-center">데이터가 없습니다.</td></tr>';
					}
					html += '</tbody>';
					html += '</table>';
					document.querySelector('#subClassList').innerHTML = html;
				},
				error: function (err) {
					console.error(err);
				}
			});
		}
		// subClass row 추가하기
		fnAppendRow = function(){
			let tbody = document.querySelector('#subClassList table tbody');
			let row_count = tbody.childElementCount;
			let tr = document.createElement('tr');
			let td = document.createElement('td');
			td.innerText = row_count + 1;
			tr.appendChild(td);
			td = document.createElement('td');
			td.setAttribute('colspan', '2');
			let input = document.createElement('input');
			input.type = 'text';
			input.setAttribute('class', 'form-control text-center');
			td.appendChild(input);
			tr.appendChild(td);
			document.querySelector('#subClassList table tbody').append(tr);
		}
		// subClass update 함수
		fnUpdateSubClass = function(){
			let list = [];
			let type = document.querySelector('#subClassLabel').innerText;
			document.querySelectorAll('#subClassList table tbody tr input').forEach(function(v){
				if(v.value !== ''){
					let obj = {};
					obj['@id'] = resource + v.value.replace(/ /g, '_');
					obj['@type'] = resource + type;
					obj[label] = {'@type': 'http://www[dot]w3[dot]org/2001/XMLSchema#string', '@value': v.value}
					list.push(obj);
				}
			});
			$.ajax({
				url:'/data/subClass',
				method:'POST',
				data:{'list':JSON.stringify(list)},
				dataType:'json',
				success:function(res){
					if(res.result === 1){
						alert(res.message);
						$('#subClassModal').modal('hide');
					}
				},error:function(err){
					console.error(err);
				}
			})
			//- console.log('list : ', list);
		};
		// subClass 설정 함수
		// fnSetSubClass = function(val){
		// 	document.querySelector('#inpSubClass').value = val;
		// 	$('#subClassModal').modal('hide');
		// };
		// subClass 항목 삭제 함수
		fnRemoveSubClass = function(val){
			if(confirm('삭제하면 복구가 불가능 합니다. 계속하시겠습니까?')){
				$.ajax({
					url: '/data/checkDelete/' + val,
					method: 'GET',
					success: function (res) {
						if(res.length > 0){
							alert('연결되어 있는 데이터가 있어 삭제가 불가능 합니다.');
						}else{
							$.ajax({
								url: '/data/' + val,
								method: 'DELETE',
								success: function (res) {
									if(res.deletedCount === 1) {
										alert('삭제되었습니다.');
										$('#subClassModal').modal('hide');
									}
								},
								error: function (err) {
									console.error(err);
								}
							});
						}
					},
					error: function (err) {
						console.error(err);
					}
				});
			}
		}
		// 제출하기 버튼 클릭 이벤트
		fnSubmit = function(){
			let id = $('#inputID');
			let formData = fnCreateForm();
			$.ajax({
				url:'/data/create/' + id.val(),
				method:'POST',
				data:'query=' + JSON.stringify(formData),
				success:function(res){
					if(res.result === 1){
						alert(res.message);
						location.reload();
					}else if(res.result === 0){
						alert(res.message);
					}
				},
				error:function(err){
					console.error(err);
				}
			});
		}
		// 데이터 수정
		fnUpdate = function(){
			let id = $('#inputID');
			let formData = fnCreateForm();
			$.ajax({
				url: '/data/update/' + id.val(),
				method: 'PUT',
				data: 'query=' + JSON.stringify(formData),
				success: function (res) {
					if(res.result === 1){
						alert(res.message);
						location.reload();
					}
				},
				error: function (err) {
						console.error(err);
				}
			});
		}
		// 데이터 삭제
		fnDelete = function(){
			if(!confirm('삭제하시면 복구가 불가능 합니다. 계속하시겠습니까?')){
				return false;
			}
			let id = $('#inputID');
			$.ajax({
				url:'/data/' + id.val(),
				method:'DELETE',
				success:function(res){
					if(res.ok === 1){
						alert('삭제되었습니다.');
						location.href = '/data/create';
					}
				}
			})
		}
		fnCreateForm = function(){
			//	id 확인
			let id = $('#inputID');
			if (id.val() === '') {
				alert('Id 값은 필수입니다.');
				id.focus();
				return false;
			}
			//	label 확인
			let lbl = $('#inputLabel');
			if (lbl.val() === '') {
				alert('Label 값은 필수입니다.');
				lbl.focus();
				return false;
			}
			// let formData = '@id=' + resource + id.replace(/ /g, '_');
			let formData = {};
			formData['@id'] = resource + id.val().replace(/ /g, '_');
			//	@type 설정
			let type = $('#inputType').val();
			formData['@type'] = type;
			//	label 설정
			formData[label] = {'@type': 'http://www[dot]w3[dot]org/2001/XMLSchema#string', '@value': lbl.val()};
			//	description 설정
			let desc =$('#desc').val();
			if(desc !== ''){
				formData[description] = {
						'@type': 'http://www[dot]w3[dot]org/2001/XMLSchema#string',
						'@value': desc
				};
			}
			//	연계정보 설정 ex) {key:{'@id':value}} 형태
			let linked_info_node = document.querySelectorAll('#linked_info select');
			let list = Array.prototype.slice.call(linked_info_node);
			list.filter(function (v) {
				if (v.value !== '') return v;
			}).forEach(function (m) {
					formData[type + '_' + m.name] = {'@id': m.value};
				});
			let attribute_info_node = document.querySelectorAll('#attribute_info textarea');
			list = Array.prototype.slice.call(attribute_info_node);
			list.filter(function (v) {
				if (v.value !== '') return v;
			}).forEach(function (m) {
					formData[m.name] = {'@type': 'http://www[dot]w3[dot]org/2001/XMLSchema#string', '@value': m.value};
				});
			return formData;
		}
		//- console.log('doc : ', !{JSON.stringify(doc)})
		//- console.log('structure : ', !{JSON.stringify(structure)})
		//- console.log('structures : ', !{JSON.stringify(structures)})
		//- console.log('class facet : ', !{JSON.stringify(class_facet)})
		//- console.log('sub class : ', !{JSON.stringify(subClass)})
