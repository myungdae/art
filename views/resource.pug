extends layout

block content
  .container.mt-5
    .card.shadow.p-4

      // 1️⃣ JOB TITLE
      h2.mb-3.text-primary
        if doc['http://www.w3.org/2000/01/rdf-schema#label'] && doc['http://www.w3.org/2000/01/rdf-schema#label']['@value']
          = doc['http://www.w3.org/2000/01/rdf-schema#label']['@value']
        else
          | Untitled

      // 2️⃣ DESCRIPTION
      if doc['http://purl.org/dc/elements/1.1/description'] && doc['http://purl.org/dc/elements/1.1/description']['@value']
        p.lead.text-secondary= doc['http://purl.org/dc/elements/1.1/description']['@value']

      hr

      // 3️⃣ INVERSE RELATION
      h4.mt-4.mb-2 INVERSE RELATION

      p
        strong Host Country:
        if doc.hostCountry
          a(href=`/resource/inverse/${encodeURIComponent(doc.hostCountry)}`)= doc.hostCountry
        else
          | N/A

      p
        strong Student Type:
        if doc.studentType
          a(href=`/resource/inverse/${encodeURIComponent(doc.studentType)}`)= doc.studentType
        else
          | N/A

      p
        strong Teaching Area:
        if doc.teachingArea
          a(href=`/resource/inverse/${encodeURIComponent(doc.teachingArea)}`)= doc.teachingArea
        else
          | N/A

      hr

      // 4️⃣ RELATED INFORMATION
      if relatedFields.length
        h4.mt-4.mb-2 RELATED INFORMATION
        table.table.table-bordered
          tbody
            each item in relatedFields
              tr
                th= item.label
                td= item.value
