extends layout

block content
  .container.mt-5
    if doc
      .card.shadow.p-4
        // 1️⃣ JOB TITLE
        h2.mb-3.text-primary= doc['http://www.w3.org/2000/01/rdf-schema#label'] && doc['http://www.w3.org/2000/01/rdf-schema#label']['@value'] ? doc['http://www.w3.org/2000/01/rdf-schema#label']['@value'] : 'Untitled'

        // 2️⃣ DESCRIPTION
        if doc['http://purl.org/dc/elements/1.1/description'] && doc['http://purl.org/dc/elements/1.1/description']['@value']
          p.lead.text-secondary= doc['http://purl.org/dc/elements/1.1/description']['@value']
        
        hr

        // 3️⃣ INVERSE RELATION
        h4.text-dark.mt-4 INVERSE RELATION
        p
          strong Host Country:
          if doc.hostCountry
            a(href=`/resource/${encodeURIComponent(doc.hostCountry)}`)= doc.hostCountry
          else
            | N/A
        p
          strong Student Type:
          if doc.studentType
            = doc.studentType
          else
            | N/A
        p
          strong Teaching Area:
          if doc.teachingArea
            = doc.teachingArea
          else
            | N/A

        hr

        // 4️⃣ RELATED INFORMATION
        - const fields = ['Duration', 'Pay', 'Housing', 'Email', 'Company Name', 'Job Location', 'Cellphone Number', 'Skype ID', 'WeChat ID', 'Homepage']
        table.table.table-bordered
          tbody
            each field in fields
              if doc[field]
                tr
                  td= field
                  td= doc[field]
    else
      .alert.alert-danger Resource not found.
