extends layout
block content
	.container(style="padding-top:30px;")
		.row
			.col-3
				#list-tab.list-group(role="tablist")
					each item, idx in result

						//- - console.log('item : ' + JSON.stringify(item, null, 2));
						//- - console.log('idx : ' + idx);
						//- - console.log('item._id : ' + Array.isArray(item._id));

						- if(Array.isArray(item._id)) item._id = item._id[0];

						a.list-group-item.list-group-item-action.d-flex.justify-content-between.align-items-center(id='list-' + idx, class=(idx===0?'active':''), data-toggle='list', href='#list-body-' + idx, role='tab', aria-controls=item._id) #{item._id.replace(resource, '')}
							span.badge.badge-primary.badge-pill #{item.count}
			.col-9
				#nav-tabContent.tab-content
					each item, idx in result
						.tab-pane.fade.show(id='list-body-' + idx, class=(idx===0?'active':''), role='tabpanel', aria-labelledby='list-' + idx)
							each list in item.list
								.card(style='border-top:2px solid #000')
									.card-body
										.d-flex.justify-content-start
											a(href=list['@id'].replace(/\[dot\]/g, '.'))
												if(list[resource + '그림'])
													if(list[resource + '그림']['@value'])
														img(style='width:100px; min-width:100px;margin:10px;' name="pic" src=list[resource + '그림']['@value'])
												else
													img(style='width:100px; min-width:100px;margin:10px;' name="pic" src="/assets/img/empty.gif")
											.desc_wrap
												//- a.text-info.font-weight-bold(href=list['@id'].replace(/\[dot\]/g, '.')) #{list[label]['@value']?list[label]['@value']:list[label]} 
												if(list[label])
													a.text-info.font-weight-bold(href=list['@id'].replace(resource, '/resource/')) #{list[label]['@value']?list[label]['@value']:list[label]}
												if(list[description])
													p.description.overflow-auto.my-0(style='max-height:100px;') #{list[description]['@value']?list[description]['@value'].replace(/\[dot\]/g, '.'):list[description].replace(/\[dot\]/g, '.')}

