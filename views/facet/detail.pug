//- views/facet/detail.pug
extends ../layout

block content
  .container.mt-4
    if doc
      - const titleText = doc.displayLabel || doc._label || doc.title || doc.name || doc.jobTitle || doc.email || '(no title)'
      h1.h3.mt-2.mb-3= titleText

      if doc.displayDescription || doc._description || doc.description
        p.text-muted= doc.displayDescription || doc._description || doc.description

      // 상세 원본 필드(디버깅 겸 확인용)
      .card.mt-3
        .card-header.bg-white
          h5.mb-0 Details
        .card-body
          pre.mb-0(style="white-space:pre-wrap")= JSON.stringify(doc, null, 2)
    else
      .alert.alert-warning Not found.
