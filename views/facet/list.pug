//- views/facet/list.pug
extends ../layout

block content
  .container.mx-auto.pt-3.pb-4
    // ───────── 헤더 + 검색 ─────────
    .flex.items-center.justify-between.mb-2
      - var titleMap = { Job_Vacancies: 'Job Vacancies', Job_Seekers: 'Job Seekers', Online_Tutors: 'Online Tutors' };
      - var hz = (typeof hideZero !== 'undefined' && hideZero) ? true : false;
      - var isPreview = (typeof facetSourceStyle !== 'undefined' && facetSourceStyle === 'resources') ? true : false;
      - var showPreviewNote = isPreview && !(docs && docs.length);
      - var sourceChip = (typeof facetSourceStyle !== 'undefined' && typeof facetSourceColl !== 'undefined') ? (String(facetSourceStyle) + ':' + String(facetSourceColl)) : null;

      h1.text-2xl.font-bold.flex.items-center.gap-2
        span= (titleMap && titleMap[klass]) ? titleMap[klass] : (klass || 'List')
        if typeof total !== 'undefined'
          span.text-gray-500.text-base (#{total})
        if showPreviewNote
          span.text-xs.text-gray-500.ml-1 (preview)

      // 우측: 검색창 + 소스 배지
      .flex.items-center.gap-2
        if sourceChip
          span.text-xs.border.rounded-full.px-2.py-1.bg-gray-50.text-gray-600(title="facet data source")= sourceChip
        form(method="GET", action='/facet/' + klass, class="flex gap-2")
          input(type="text", name="q", value=q || "", placeholder="Search title/description...", class="border rounded px-3 py-2")
          if facetCfg && facetCfg.groups
            each g in facetCfg.groups
              if selected && selected[g.key]
                each v in selected[g.key]
                  input(type="hidden", name=g.key, value=v)
          input(type="hidden", name="limit", value=limit)
          if hz
            input(type="hidden", name="hideZero", value="1")
          button(type="submit", class="px-4 py-2 rounded bg-blue-600 text-white") Search

    if showPreviewNote
      p.text-sm.text-gray-500.mb-3 Temporary preview list (data from resources)

    // ───────── 모바일 전용: 상단 가로 필터바 + 계정 링크 ─────────
    //   ✅ style 속성 멀티라인 제거 → 아래 style 블록으로 이동(에러 방지)
    style.
      /* 모바일 상단바/오버레이/드롭다운 기본값 */
      #facetMobileBar{z-index:2147483647;position:sticky;top:0}
      @media (max-width: 767.98px){
        #facetMobileBar{will-change:transform;backface-visibility:hidden;transform:translateZ(0)}
      }
      html,body{overscroll-behavior-y:contain}
      body.facet-open{position:fixed;overflow:hidden;width:100%}
      .facet-menu{
        position:fixed;left:-9999px;top:-9999px;
        background:#fff;border:1px solid #e5e7eb;border-radius:12px;
        box-shadow:0 8px 24px rgba(0,0,0,.15);
        width:16rem;max-height:60vh;overflow:auto;padding:8px;
        z-index:2147483647;
        -webkit-overflow-scrolling:touch;
      }
      .facet-pill{touch-action:manipulation}

    // 모바일 바
    div(id="facetMobileBar" class="block md:hidden bg-white border-b py-2 mb-3 sticky top-0")
      form(id="facetFormMobileInline" method="GET", action='/facet/' + klass, class="container mx-auto")
        // 유지 파라미터
        input(type="hidden", name="q", value=q || "")
        input(type="hidden", name="limit", value=limit)
        if hz
          input(type="hidden", name="hideZero", value="1")

        - var orderMap = { country:0, studentType:1, teachingArea:2 };
        - var groups = (facetCfg && facetCfg.groups) ? facetCfg.groups.slice() : [];
        - groups.sort(function(a,b){
        -   var ai = Object.prototype.hasOwnProperty.call(orderMap, a.key) ? orderMap[a.key] : 99;
        -   var bi = Object.prototype.hasOwnProperty.call(orderMap, b.key) ? orderMap[b.key] : 99;
        -   return ai - bi;
        - });
        - var top3 = groups.slice(0,3);
        - var sel = selected || {};

        // 칩 3개 + Hide 0
        div(class="flex items-center gap-2 px-2 overflow-x-auto")
          each g in top3
            - var selCnt = (sel[g.key] && sel[g.key].length) ? sel[g.key].length : 0
            - var menuId = 'fm-' + g.key
            // 버튼
            button(type="button" class="facet-pill px-3 py-2 rounded border bg-white flex items-center gap-2" data-key=g.key aria-controls=menuId aria-expanded="false")
              span= g.label
              if selCnt > 0
                span(class="text-xs text-blue-600") (#{selCnt})
              span(class="text-gray-500") ▼
            // 드롭다운(기본은 화면 밖 → JS로 위치/표시)
            div(id=menuId class="facet-menu" data-key=g.key)
              - var facetList = (facets && facets[g.key]) || []
              - var selList = sel[g.key] || []
              if facetList.length
                each f in facetList
                  - var checked = selList.indexOf(f._id) !== -1
                  label(class="flex items-center gap-2 py-1")
                    input(type="checkbox", form="facetFormMobileInline", name=g.key, value=f._id, checked=checked)
                    span(class="flex-1 truncate")= f._id
                    span(class="text-xs text-gray-500") (#{f.c})
              else
                p(class="text-sm text-gray-400 p-2") No values

          // Hide 0 토글
          label(class="flex items-center gap-2 px-3 py-2 rounded border bg-white ml-1")
            input#hzToggleMob(type="checkbox", checked=hz)
            span(class="text-sm text-gray-700") Hide 0


    // ───────── 공통 리스트 영역 ─────────
    .grid.grid-cols-12.gap-6
      // 좌측: 데스크탑 사이드 패싯
      div(class="hidden md:block md:col-span-3")
        form#facetForm(method="GET", action='/facet/' + klass, class="space-y-6 border rounded p-3")
          input(type="hidden", name="q", value=q || "")
          input(type="hidden", name="limit", value=limit)
          if hz
            input(type="hidden", name="hideZero", value="1")

          .mb-2
            label(class="flex items-center gap-2 cursor-pointer")
              input#hzToggle(type="checkbox", checked=hz)
              span.text-sm.text-gray-700 Hide items with 0

          if facetCfg && facetCfg.groups && facetCfg.groups.length
            each g in facetCfg.groups
              div(class="space-y-2")
                h3.font-semibold.text-gray-700= g.label
                div(class="space-y-1 max-h-64 overflow-auto pr-1")
                  - var facetList2 = (facets && facets[g.key]) || []
                  - var selList2 = (selected && selected[g.key]) || []
                  if facetList2.length
                    each f in facetList2
                      - var checked2 = selList2.indexOf(f._id) !== -1
                      label(class="flex items-center gap-2")
                        input(type="checkbox", name=g.key, value=f._id, checked=checked2)
                        span.flex-1.truncate= f._id
                        span.text-xs.text-gray-500 (#{f.c})
                  else
                    p.text-sm.text-gray-400 No values

          .pt-2.flex.items-center.gap-2
            a(href='/facet/' + klass + (hz ? '?hideZero=1' : ''), class="px-3 py-2 rounded border inline-block") Clear
            if Object.keys(selected || {}).some(function(k){ return (selected[k]||[]).length; })
              span.text-xs.text-gray-500 Selected filters active

      // 우측: 리스트
      div(class="col-span-12 md:col-span-9")
        if !docs || !docs.length
          .text-gray-500 No results.
        else
          ul.space-y-3
            each d in docs
              - var posted = (d.datePosted && new Date(d.datePosted).toISOString().slice(0,10)) || (d.updatedAt && new Date(d.updatedAt).toISOString().slice(0,10)) || '-'
              - var titleText = d.displayLabel || d._label || d.title || d.name || d.jobTitle || d.email || '(no title)'
              - var hrefDetail = '/rdf-resource/' + klass + '/' + d._id
              li.border.rounded.p-3
                .flex.items-center.gap-3
                  .min-w-0.flex-1
                    h2.font-semibold.text-lg.truncate
                      a(href=hrefDetail)= titleText
                    // 메타
                    - var parts = []
                    - var fieldsForMeta = ['country','Country','studentType','StudentType','teachingArea','Teaching_Area','Nationality','Preferred_Work_Location','Major','Expertise','Tutoring_Experience','Gender']
                    - for (var i = 0; i < fieldsForMeta.length; i++) {
                    -   var k = fieldsForMeta[i];
                    -   if (!d || typeof d[k] === 'undefined' || d[k] === null) continue;
                    -   if (Array.isArray(d[k]) && d[k].length) parts.push(d[k].join(', '));
                    -   else if (d[k]) parts.push(d[k]);
                    - }
                    if parts.length
                      p(class="text-sm text-gray-600 mt-1")= parts.join(' · ')
                    p.text-sm.mt-1 Posted: #{posted}
                  .shrink-0
                    a(href=hrefDetail, class="text-blue-700 underline") View

        // ───────── Pagination ─────────
        if typeof total !== 'undefined' && total > limit
          - var totalPages = Math.ceil(total / limit)
          - var qs = ''
          - if (q) { qs += '&q=' + encodeURIComponent(q) }
          - if (facetCfg && facetCfg.groups) {
          -   for (var gi = 0; gi < facetCfg.groups.length; gi++) {
          -     var gg = facetCfg.groups[gi];
          -     var selArr = (selected && selected[gg.key]) || [];
          -     for (var sj = 0; sj < selArr.length; sj++) {
          -       qs += '&' + encodeURIComponent(gg.key) + '=' + encodeURIComponent(selArr[sj]);
          -     }
          -   }
          - }
          - if (hz) { qs += '&hideZero=1' }
          nav.mt-6.flex.items-center.gap-2.flex-wrap
            if page > 1
              a(href='/facet/' + klass + '?page=' + (page-1) + '&limit=' + limit + qs, class="px-3 py-1 border rounded") Prev
            span.text-sm Page #{page} / #{totalPages}
            if page < totalPages
              a(href='/facet/' + klass + '?page=' + (page+1) + '&limit=' + limit + qs, class="px-3 py-1 border rounded") Next

  // ───────── 스크립트 ─────────
  script.
    (function(){
      // 데스크탑: 체크 변경 즉시 제출
      var fd = document.getElementById('facetForm');
      if (fd) {
        var cbs = fd.querySelectorAll('input[type="checkbox"][name]');
        for (var i=0; i<cbs.length; i++) cbs[i].addEventListener('change', function(){ fd.submit(); });
        var hzT = document.getElementById('hzToggle');
        if (hzT) {
          hzT.addEventListener('change', function(){
            var h = fd.querySelector('input[name="hideZero"]');
            if (!h) { h = document.createElement('input'); h.type='hidden'; h.name='hideZero'; fd.appendChild(h); }
            h.value = hzT.checked ? '1' : '';
            fd.submit();
          });
        }
      }

      // ── 모바일: 버튼 기반 드롭다운(레이아웃 흔들림 방지)
      var bar = document.getElementById('facetMobileBar');
      if (!bar) return;

      // 투명 오버레이 (바깥 클릭 닫기 + body lock)
      var overlay = document.getElementById('facetOverlay');
      if (!overlay){
        overlay = document.createElement('div');
        overlay.id = 'facetOverlay';
        overlay.setAttribute('style','position:fixed; inset:0; z-index:2147483646; display:none; background:rgba(0,0,0,0);');
        document.body.appendChild(overlay);
      }

      var scrollYStore = 0;
      function lockBody(){
        if (document.body.classList.contains('facet-open')) return;
        scrollYStore = window.scrollY || window.pageYOffset || 0;
        document.body.classList.add('facet-open');
        document.body.style.top = '-' + scrollYStore + 'px';
      }
      function unlockBody(){
        if (!document.body.classList.contains('facet-open')) return;
        document.body.classList.remove('facet-open');
        document.body.style.top = '';
        window.scrollTo(0, scrollYStore || 0);
      }

      // 위치 계산: body(0,0) 기준에 두고 transform만 변경
      var ticking=false;
      function positionMenuFor(btn, menu){
        var r = btn.getBoundingClientRect();
        var MENU_W = 256, GAP = 8, PAD = 8;
        var left = Math.max(PAD, Math.min(window.innerWidth - PAD - MENU_W, r.left));
        var top  = Math.max(PAD, r.bottom + GAP);
        menu.style.left = '0px';
        menu.style.top  = '0px';
        menu.style.transform = 'translate3d(' + Math.round(left) + 'px,' + Math.round(top) + 'px,0)';
      }
      function schedulePosition(btn, menu){
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function(){ positionMenuFor(btn, menu); ticking=false; });
      }

      function closeAll(){
        var pills = bar.querySelectorAll('.facet-pill[aria-expanded="true"]');
        for (var i=0;i<pills.length;i++) pills[i].setAttribute('aria-expanded','false');
        var menus = document.querySelectorAll('.facet-menu[data-key]');
        for (var j=0;j<menus.length;j++){
          menus[j].style.left = '-9999px';
          menus[j].style.top  = '-9999px';
          menus[j].style.transform = 'translate3d(0,0,0)';
        }
        overlay.style.display = 'none';
        unlockBody();
      }

      bar.addEventListener('click', function(ev){
        var btn = ev.target.closest('button.facet-pill[data-key]');
        if (!btn) return;
        ev.preventDefault();

        var key  = btn.getAttribute('data-key');
        var menu = document.getElementById('fm-' + key);
        if (!menu) return;

        var isOpen = (btn.getAttribute('aria-expanded') === 'true');
        if (isOpen){
          btn.setAttribute('aria-expanded','false');
          menu.style.left='-9999px'; menu.style.top='-9999px'; menu.style.transform='translate3d(0,0,0)';
          overlay.style.display='none';
          unlockBody();
        } else {
          // 모두 닫기 후 이 메뉴 열기
          closeAll();
          if (menu.parentElement !== document.body) document.body.appendChild(menu);
          btn.setAttribute('aria-expanded','true');
          overlay.style.display='block';
          lockBody();
          schedulePosition(btn, menu);
        }
      });

      overlay.addEventListener('click', closeAll);
      document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeAll(); });

      window.addEventListener('scroll', function(){
        var opened = bar.querySelector('.facet-pill[aria-expanded="true"]');
        if (!opened) return;
        var key = opened.getAttribute('data-key');
        var menu = document.getElementById('fm-'+key);
        if (menu) schedulePosition(opened, menu);
      }, {passive:true});

      window.addEventListener('resize', function(){
        var opened = bar.querySelector('.facet-pill[aria-expanded="true"]');
        if (!opened) return;
        var key = opened.getAttribute('data-key');
        var menu = document.getElementById('fm-'+key);
        if (menu) schedulePosition(opened, menu);
      });

      // 모바일 체크 변경 즉시 제출(폼 밖 메뉴 포함)
      var formM = document.getElementById('facetFormMobileInline');
      if (formM){
        var mobCbs = document.querySelectorAll('input[type="checkbox"][name][form="facetFormMobileInline"]');
        for (var k=0;k<mobCbs.length;k++){
          mobCbs[k].addEventListener('change', function(){ formM.submit(); });
        }
        var hzM = document.getElementById('hzToggleMob');
        if (hzM){
          hzM.addEventListener('change', function(){
            var h = formM.querySelector('input[name="hideZero"]');
            if (!h) { h = document.createElement('input'); h.type='hidden'; h.name='hideZero'; formM.appendChild(h); }
            h.value = hzM.checked ? '1' : '';
            formM.submit();
          });
        }
      }
    })();
