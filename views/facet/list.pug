//- views/facet/list.pug
extends ../layout

block content
  style.
    html, body { 
      overflow-x: hidden !important; 
      width: 100%; 
      max-width: 100vw;
    }
    * {
      max-width: 100%;
    }
    
    /* Selected filter highlighting */
    label:has(input[type="checkbox"]:checked) {
      background-color: #fff7ed !important;
      border: 2px solid #f97316 !important;
      box-shadow: 0 2px 4px rgba(249, 115, 22, 0.2);
    }
    
    label:has(input[type="checkbox"]:checked):hover {
      background-color: #ffedd5 !important;
    }
    
    input[type="checkbox"]:checked {
      accent-color: #f97316;
    }
    
    /* Smooth transitions */
    label {
      transition: all 0.2s ease;
    }
    @media (max-width: 768px) {
      .container { 
        overflow-x: hidden !important; 
        max-width: 100vw !important;
        padding-left: 1rem !important;
        padding-right: 1rem !important;
      }
      .mobile-facet-dropdown { 
        position: relative; 
        max-width: 100%;
      }
      .mobile-facet-dropdown button {
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .mobile-facet-content {
        display: none;
        position: absolute;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 0.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        z-index: 50;
        min-width: 200px;
        max-width: calc(100vw - 2rem);
        max-height: 300px;
        overflow-y: auto;
        left: 0;
        right: auto;
      }
      .mobile-facet-dropdown.open .mobile-facet-content { display: block; }
      .mobile-facet-dropdown.open .dropdown-icon { transform: rotate(180deg); }
      .dropdown-icon { 
        display: inline-block;
        transition: transform 0.2s ease;
        margin-left: 0.25rem;
        font-size: 0.75rem;
      }
    }
  
  .container.mx-auto.py-4.px-3(class="md:py-6", style="overflow-x: hidden; max-width: 100vw;")
    // 헤더 + 검색 + 정렬
    .mb-4
      - const titleMap = { Job_Vacancies: 'Job Vacancies', Job_Seekers: 'Job Seekers', Online_Tutors: 'Online Tutors' }
      h1.text-xl.font-bold.mb-3(class="md:text-2xl", style="word-break: break-word;")
        = titleMap && titleMap[klass] ? titleMap[klass] : (klass || 'List')
        if typeof total !== 'undefined'
          span.text-gray-500.text-sm(class="md:text-base") &nbsp;(#{total})

      // 모바일: 세로 스택 레이아웃 / 데스크톱: 가로 배치
      .flex.flex-col.gap-2(class="md:flex-row md:gap-3")
        // 검색창 (현재 선택된 facet 보존)
        form(method="GET", action=`/facet/${klass}`, class="flex gap-2 flex-1")
          input(type="text", name="q", value=q || "", placeholder="Search...", class="border rounded px-3 py-2 flex-1 text-sm")
          if facetCfg && facetCfg.groups
            each g in facetCfg.groups
              if selected && selected[g.key]
                each v in selected[g.key]
                  input(type="hidden", name=g.key, value=v)
          input(type="hidden", name="limit", value=limit)
          input(type="hidden", name="sort", value=sort || "recent")
          button(type="submit", class="px-3 py-2 rounded bg-blue-600 text-white text-sm") Search
        
        // 정렬 드롭다운
        form(method="GET", action=`/facet/${klass}`, class="flex gap-2 items-center")
          input(type="hidden", name="q", value=q || "")
          if facetCfg && facetCfg.groups
            each g in facetCfg.groups
              if selected && selected[g.key]
                each v in selected[g.key]
                  input(type="hidden", name=g.key, value=v)
          input(type="hidden", name="limit", value=limit)
          label(class="text-xs md:text-sm font-medium text-gray-700 whitespace-nowrap") Sort:
          select(name="sort", class="border rounded px-2 py-2 text-xs md:text-sm", onchange="this.form.submit()")
            option(value="recent", selected=(sort === 'recent' || !sort)) Most Recent
            option(value="oldest", selected=(sort === 'oldest')) Oldest First
            option(value="alpha-asc", selected=(sort === 'alpha-asc')) A-Z
            option(value="alpha-desc", selected=(sort === 'alpha-desc')) Z-A

    //- 모바일 전용: 상단 horizontal 드롭다운 패싯
    .mb-4(class="block md:hidden", style="max-width: 100vw; overflow-x: hidden;")
      form#mobileFacetForm(method="GET", action=`/facet/${klass}`)
        input(type="hidden", name="q", value=q || "")
        input(type="hidden", name="limit", value=limit)
        input(type="hidden", name="sort", value=sort || "recent")
        
        .flex.flex-wrap.gap-2(style="max-width: 100%; overflow-x: hidden;")
          if facetCfg && facetCfg.groups && facetCfg.groups.length
            each g in facetCfg.groups
              - var selCount = (selected && selected[g.key] && selected[g.key].length) || 0
              .mobile-facet-dropdown(style="max-width: 48%;")
                button(type="button", onclick="toggleMobileDropdown(this)", class="w-full px-3 py-2 border rounded bg-white text-sm font-medium flex items-center justify-between", style="max-width: 100%;")
                  span(style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1;")= g.label
                  .flex.items-center.gap-1(style="flex-shrink: 0;")
                    if selCount > 0
                      span(class="px-1.5 py-0.5 bg-orange-500 text-white rounded-full text-xs")= selCount
                    span.dropdown-icon ▼
                
                .mobile-facet-content.p-3
                  .space-y-2
                    - var facetList = (facets && facets[g.key]) || []
                    - var selList = (selected && selected[g.key]) || []
                    if facetList.length
                      each f in facetList
                        - var checked = selList.indexOf(f._id) !== -1
                        label.flex.items-center.gap-2.text-sm.cursor-pointer.p-2.rounded.transition-colors(
                          class=checked ? "bg-orange-50 border-2 border-orange-500" : "hover:bg-gray-50",
                          style=checked ? "background-color: #fff7ed; border-color: #f97316;" : ""
                        )
                          input(type="checkbox", name=g.key, value=f._id, checked=checked, onchange="document.getElementById('mobileFacetForm').submit()", class="w-4 h-4 accent-orange-500")
                          span.flex-1(class=checked ? "font-bold text-orange-900" : "", style=checked ? "color: #7c2d12; font-weight: 700;" : "")= f._id
                          span.text-xs(class=checked ? "text-orange-600 font-semibold" : "text-gray-500", style=checked ? "color: #ea580c; font-weight: 600;" : "") (#{f.c})
                    else
                      p.text-xs.text-gray-400 No values

    .grid.grid-cols-12.gap-4(class="md:gap-6")
      //- 데스크톱 전용: 좌측 vertical 패싯 (모바일에서 숨김)
      div(class="hidden md:block md:col-span-3")
        form#facetForm(method="GET", action=`/facet/${klass}`, class="space-y-6 border rounded p-3")
          input(type="hidden", name="q", value=q || "")
          input(type="hidden", name="limit", value=limit)
          input(type="hidden", name="sort", value=sort || "recent")

          if facetCfg && facetCfg.groups && facetCfg.groups.length
            each g in facetCfg.groups
              .space-y-2
                h3.font-semibold.text-gray-700= g.label
                .space-y-1.max-h-64.overflow-auto.pr-1
                  - var facetList = (facets && facets[g.key]) || []
                  - var selList = (selected && selected[g.key]) || []
                  if facetList.length
                    each f in facetList
                      - var checked = selList.indexOf(f._id) !== -1
                      label.flex.items-center.gap-2.p-2.rounded.cursor-pointer.transition-colors(
                        class=checked ? "bg-orange-50 border-2 border-orange-500" : "hover:bg-gray-50",
                        style=checked ? "background-color: #fff7ed; border-color: #f97316;" : ""
                      )
                        //- 동일 name으로 여러 값 전송
                        input(type="checkbox", name=g.key, value=f._id, checked=checked, class="w-4 h-4 accent-orange-500")
                        span.flex-1.truncate(class=checked ? "font-bold text-orange-900" : "", style=checked ? "color: #7c2d12; font-weight: 700;" : "")= f._id
                        span.text-xs(class=checked ? "text-orange-600 font-semibold" : "text-gray-500", style=checked ? "color: #ea580c; font-weight: 600;" : "") (#{f.c})
                  else
                    p.text-sm.text-gray-400 No values

      //- 리스트 (모바일: 전체 너비 / 데스크톱: 9칸)
      div(class="col-span-12 md:col-span-9")
        if !docs || !docs.length
          .text-gray-500 No results.
        else
          ul.space-y-3
            each d in docs
              - var posted = (d.datePosted && new Date(d.datePosted).toISOString().slice(0,10)) || (d.updatedAt && new Date(d.updatedAt).toISOString().slice(0,10)) || '-'
              - var titleText = d.displayLabel || d._label || d.title || d.name || d.jobTitle || d.email || '(no title)'
              li.border.rounded.p-3(style="max-width: calc(100vw - 2rem); overflow: hidden;")
                .flex.flex-col.items-start.gap-2(class="md:flex-row md:items-center md:gap-3")
                  .min-w-0.flex-1(style="max-width: 100%; overflow: hidden;")
                    h2.font-semibold.text-base(class="md:text-lg", style="word-break: break-word; overflow-wrap: break-word;")
                      a(href=`/rdf-resource/${klass}/${d._id}`)= titleText

                    // 하부 메타: 가능한 필드를 자동 모아 표시
                    - var parts = []
                    - var fieldsForMeta = ['country','Country','studentType','StudentType','teachingArea','Teaching_Area','Nationality','Preferred_Work_Location','Major','Expertise','Tutoring_Experience','Gender']
                    - for (var i = 0; i < fieldsForMeta.length; i++) {
                    -   var k = fieldsForMeta[i];
                    -   if (!d || typeof d[k] === 'undefined' || d[k] === null) continue;
                    -   if (Array.isArray(d[k]) && d[k].length) parts.push(d[k].join(', '));
                    -   else if (d[k]) parts.push(d[k]);
                    - }
                    if parts.length
                      p(class="text-xs md:text-sm text-gray-600 mt-0.5", style="word-break: break-word; overflow-wrap: break-word;")= parts.join(' · ')

                    p.text-xs.mt-1(class="md:text-sm") Posted: #{posted}
                  .shrink-0
                    a(href=`/rdf-resource/${klass}/${d._id}`, class="text-blue-700 underline text-sm") View

        // 페이지네이션
        if typeof total !== 'undefined' && total > limit
          - var totalPages = Math.ceil(total / limit)
          - var qs = ''
          - if (q) { qs += '&q=' + encodeURIComponent(q) }
          - if (sort) { qs += '&sort=' + encodeURIComponent(sort) }
          - if (facetCfg && facetCfg.groups) {
          -   for (var gi = 0; gi < facetCfg.groups.length; gi++) {
          -     var gg = facetCfg.groups[gi];
          -     var sel = (selected && selected[gg.key]) || [];
          -     for (var sj = 0; sj < sel.length; sj++) {
          -       qs += '&' + encodeURIComponent(gg.key) + '=' + encodeURIComponent(sel[sj]);
          -     }
          -   }
          - }
          nav.mt-6.flex.items-center.gap-2.flex-wrap
            if page > 1
              a(href=`/facet/${klass}?page=${page-1}&limit=${limit}${qs}`, class="px-3 py-1 border rounded") Prev
            span.text-sm Page #{page} / #{totalPages}
            if page < totalPages
              a(href=`/facet/${klass}?page=${page+1}&limit=${limit}${qs}`, class="px-3 py-1 border rounded") Next

  //- JavaScript: 데스크톱 패싯 체크박스 자동 제출 + 모바일 드롭다운 토글
  script.
    // 데스크톱 패싯 체크박스 변경 시 자동 제출
    (function(){
      var f = document.getElementById('facetForm');
      if(!f) return;
      var cbs = f.querySelectorAll('input[type="checkbox"]');
      for (var i=0; i<cbs.length; i++) {
        cbs[i].addEventListener('change', function(){ f.submit(); });
      }
    })();
    
    // 모바일 드롭다운 토글 함수
    function toggleMobileDropdown(btn) {
      var dropdown = btn.closest('.mobile-facet-dropdown');
      var isOpen = dropdown.classList.contains('open');
      
      // 다른 모든 드롭다운 닫기
      document.querySelectorAll('.mobile-facet-dropdown.open').forEach(function(el) {
        if (el !== dropdown) {
          el.classList.remove('open');
        }
      });
      
      // 현재 드롭다운 토글
      if (isOpen) {
        dropdown.classList.remove('open');
      } else {
        dropdown.classList.add('open');
      }
    }
    
    // 드롭다운 외부 클릭 시 닫기
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.mobile-facet-dropdown')) {
        document.querySelectorAll('.mobile-facet-dropdown.open').forEach(function(el) {
          el.classList.remove('open');
        });
      }
    });
