//- views/facet/list.pug
extends ../layout

block content
  .container.mx-auto.py-6
    // 헤더 + 검색
    .flex.items-center.justify-between.mb-4
      h1.text-2xl.font-bold
        | #{klass}
        if typeof total !== 'undefined'
          span.text-gray-500.text-base (#{total})

      // 검색창 (현재 선택된 facet 보존)
      form(method="GET", action=`/facet/${klass}`, class="flex gap-2")
        input(type="text", name="q", value=q || "", placeholder="Search title/description...", class="border rounded px-3 py-2")
        if facetCfg && facetCfg.groups
          each g in facetCfg.groups
            if selected && selected[g.key]
              each v in selected[g.key]
                input(type="hidden", name=g.key, value=v)
        input(type="hidden", name="limit", value=limit)
        button(type="submit", class="px-4 py-2 rounded bg-blue-600 text-white") Search

    .grid.grid-cols-12.gap-6
      // 좌측: 패싯
      div(class="col-span-12 md:col-span-3")
        form#facetForm(method="GET", action=`/facet/${klass}`, class="space-y-6 border rounded p-3")
          input(type="hidden", name="q", value=q || "")
          input(type="hidden", name="limit", value=limit)

          if facetCfg && facetCfg.groups && facetCfg.groups.length
            each g in facetCfg.groups
              .space-y-2
                h3.font-semibold.text-gray-700= g.label
                .space-y-1.max-h-64.overflow-auto.pr-1
                  - const facetList = (facets && facets[g.key]) || []
                  - const selList = (selected && selected[g.key]) || []
                  if facetList.length
                    each f in facetList
                      - const checked = selList.includes(f._id)
                      label.flex.items-center.gap-2
                        input(type="checkbox", name=g.key, value=f._id, checked=checked)
                        span.flex-1.truncate= f._id
                        span.text-xs.text-gray-500 (#{f.c})
                  else
                    p.text-sm.text-gray-400 No values

          .pt-2
            a(href=`/facet/${klass}`, class="px-3 py-2 rounded border inline-block") Clear

      // 우측: 리스트
      div(class="col-span-12 md:col-span-9")
        if !docs || !docs.length
          .text-gray-500 No results.
        else
          ul.space-y-3
            each d in docs
              - const posted = (d.datePosted && new Date(d.datePosted).toISOString().slice(0,10)) || '-'
              // 카드
              li.border.rounded.p-3
                .flex.items-center.gap-3
                  .min-w-0.flex-1
                    h2.font-semibold.text-lg.truncate
                      a(href=`/rdf-resource/${klass}/${d._id}`)= d._label || d.title || '(no title)'

                    // 항목 하부 메타: 가능한 필드를 자동으로 모아 표시
                    - const parts = []
                    - const fieldsForMeta = ['country','studentType','teachingArea','Nationality','Preferred_Work_Location','Major','Expertise','Tutoring_Experience','Gender']
                    - fieldsForMeta.forEach(function(k){
                    -   if (Array.isArray(d[k]) && d[k].length) parts.push(d[k].join(', '))
                    -   else if (d[k]) parts.push(d[k])
                    - })
                    p.text-sm.text-gray-600(class="mt-0.5") #{(parts && parts.length) ? parts.join(' · ') : '-'}

                    p.text-sm.mt-1 Posted: #{posted}
                  .shrink-0
                    a(href=`/rdf-resource/${klass}/${d._id}`, class="text-blue-700 underline") View

        // 페이지네이션
        if typeof total !== 'undefined' && total > limit
          - const totalPages = Math.ceil(total / limit);
          - const buildQs = () => {
          -   let s = ''
          -   if (q) s += '&q=' + encodeURIComponent(q)
          -   if (facetCfg && facetCfg.groups) {
          -     facetCfg.groups.forEach(g => {
          -       (selected[g.key] || []).forEach(v => { s += '&' + encodeURIComponent(g.key) + '=' + encodeURIComponent(v) })
          -     })
          -   }
          -   return s
          - }
          nav.mt-6.flex.items-center.gap-2.flex-wrap
            if page > 1
              a(href=`/facet/${klass}?page=${page-1}&limit=${limit}${buildQs()}`, class="px-3 py-1 border rounded") Prev
            span.text-sm Page #{page} / #{totalPages}
            if page < totalPages
              a(href=`/facet/${klass}?page=${page+1}&limit=${limit}${buildQs()}`, class="px-3 py-1 border rounded") Next

  // 체크박스 변경 즉시 적용
  script.
    (function(){
      var f = document.getElementById('facetForm');
      if(!f) return;
      f.querySelectorAll('input[type="checkbox"]').forEach(function(cb){
        cb.addEventListener('change', function(){ f.submit(); });
      });
    })();
