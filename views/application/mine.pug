extends ../layout

block content
  .container.py-6
    h1.text-2xl.font-bold.mb-6 My Applications

    .max-w-4xl.mx-auto
      if !applications || applications.length === 0
        .bg-yellow-50.border.border-yellow-200.rounded.p-4.text-center
          p.text-gray-700 You haven't applied to any jobs yet.
          a.inline-block.mt-3.bg-blue-600.text-white.px-4.py-2.rounded.hover_bg-blue-700(href="/job-vacancies") Browse Jobs
      else
        .space-y-4
          each app in applications
            .border.rounded.p-4.bg-white.shadow-sm
              .flex.justify-between.items-start
                div
                  h3.text-lg.font-semibold.mb-1
                    a.text-blue-600.hover_underline(href=`/applications/${app._id}`)= app.jobTitle || 'Untitled Job'
                  if app.companyName
                    p.text-sm.text-gray-600 #{app.companyName}
                  p.text-xs.text-gray-500 Applied on #{app.appliedAt ? new Date(app.appliedAt).toLocaleDateString() : 'N/A'}
                div
                  - const statusColors = { pending: 'bg-yellow-100 text-yellow-800', reviewed: 'bg-blue-100 text-blue-800', accepted: 'bg-green-100 text-green-800', rejected: 'bg-red-100 text-red-800', withdrawn: 'bg-gray-100 text-gray-800' }
                  span.px-3.py-1.rounded.text-sm(class=statusColors[app.status] || 'bg-gray-100')= app.status.charAt(0).toUpperCase() + app.status.slice(1)
              
              .mt-3.flex.gap-2
                a.text-blue-600.text-sm.hover_underline(href=`/applications/${app._id}`) View Details
                if app.jobVacancy && app.jobVacancy._id
                  a.text-blue-600.text-sm.hover_underline(href=`/rdf-resource/Job_Vacancies/${app.jobVacancy._id}`) View Job
                if app.status === 'pending' || app.status === 'reviewed'
                  form.inline(method="POST", action=`/applications/${app._id}/withdraw`, onsubmit="return confirm('Are you sure you want to withdraw this application?')")
                    button.text-red-600.text-sm.hover_underline(type="submit") Withdraw
