extends ../layout

block content
  .container.py-6
    .max-w-3xl.mx-auto
      // Header
      .flex.justify-between.items-start.mb-6
        div
          h1.text-2xl.font-bold.mb-2 Application Details
          - const statusColors = { pending: 'bg-yellow-100 text-yellow-800', reviewed: 'bg-blue-100 text-blue-800', accepted: 'bg-green-100 text-green-800', rejected: 'bg-red-100 text-red-800', withdrawn: 'bg-gray-100 text-gray-800' }
          span.px-3.py-1.rounded(class=statusColors[application.status] || 'bg-gray-100')= application.status.charAt(0).toUpperCase() + application.status.slice(1)
        div
          a.text-blue-600.hover_underline(href=isApplicant ? '/applications/mine' : '/applications/received') ← Back

      // Job Information
      .bg-blue-50.border.border-blue-200.rounded.p-4.mb-6
        h2.text-xl.font-semibold.mb-3 Job Information
        .space-y-2
          p
            strong Position: 
            if application.jobVacancy && application.jobVacancy._id
              a.text-blue-600.hover_underline(href=`/rdf-resource/Job_Vacancies/${application.jobVacancy._id}`)= application.jobTitle || 'N/A'
            else
              | #{application.jobTitle || 'N/A'}
          if application.companyName
            p
              strong Company: 
              | #{application.companyName}
          if application.jobVacancy
            if application.jobVacancy.country
              p
                strong Country: 
                | #{application.jobVacancy.country}
            if application.jobVacancy.jobLocation
              p
                strong Location: 
                | #{application.jobVacancy.jobLocation}

      // Applicant Information
      .bg-green-50.border.border-green-200.rounded.p-4.mb-6
        h2.text-xl.font-semibold.mb-3 Applicant Information
        .space-y-2
          p
            strong Name: 
            | #{application.applicantName || 'N/A'}
          p
            strong Email: 
            | #{application.applicantEmail || 'N/A'}
          p
            strong Applied on: 
            | #{application.appliedAt ? new Date(application.appliedAt).toLocaleDateString() : 'N/A'}

      // Cover Letter
      .bg-white.border.rounded.p-4.mb-6
        h2.text-xl.font-semibold.mb-3 Cover Letter
        .whitespace-pre-wrap.text-gray-700= application.coverLetter || 'No cover letter provided'

      // Resume
      if application.resume && application.resume.trim()
        .bg-white.border.rounded.p-4.mb-6
          h2.text-xl.font-semibold.mb-3 Resume / Additional Information
          .whitespace-pre-wrap.text-gray-700= application.resume

      // Employer Note (if exists and viewer is employer)
      if isEmployer && application.employerNote
        .bg-yellow-50.border.border-yellow-200.rounded.p-4.mb-6
          h2.text-xl.font-semibold.mb-3 Your Note
          .whitespace-pre-wrap.text-gray-700= application.employerNote

      // Action Buttons (for employers)
      if isEmployer
        .bg-gray-50.border.rounded.p-4
          h2.text-xl.font-semibold.mb-3 Update Status
          form(method="POST", action=`/applications/${application._id}/status`)
            .space-y-4
              .space-y-1
                label.block(for="status") Status
                select#status(name="status" required class="w-full border rounded px-3 py-2")
                  option(value="pending", selected=application.status === 'pending') Pending
                  option(value="reviewed", selected=application.status === 'reviewed') Reviewed
                  option(value="accepted", selected=application.status === 'accepted') Accepted
                  option(value="rejected", selected=application.status === 'rejected') Rejected

              .space-y-1
                label.block(for="employerNote") Note (optional)
                textarea#employerNote(name="employerNote" rows="3" class="w-full border rounded px-3 py-2" placeholder="Add a note about this application...")= application.employerNote || ""

              button.bg-blue-600.text-white.px-6.py-2.rounded.hover_bg-blue-700(type="submit") Update

      // Withdraw Button (for applicants)
      if isApplicant && (application.status === 'pending' || application.status === 'reviewed')
        .bg-gray-50.border.rounded.p-4.mt-4
          h2.text-xl.font-semibold.mb-3 Withdraw Application
          p.text-sm.text-gray-600.mb-3 If you're no longer interested in this position, you can withdraw your application.
          form(method="POST", action=`/applications/${application._id}/withdraw`, onsubmit="return confirm('Are you sure you want to withdraw this application?')")
            button.bg-red-600.text-white.px-6.py-2.rounded.hover_bg-red-700(type="submit") Withdraw Application
