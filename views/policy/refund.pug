extends ../layout

block content
  .container.mx-auto.max-w-4xl.py-10
    h1.text-3xl.font-bold.mb-2 Refund Policy / 환불규정
    p.text-sm.text-gray-500.mb-6 Last updated: #{lastUpdated || '2025-08-24'}

    .flex.items-center.gap-3.mb-6
      span.font-medium Language:
      button.lang-btn.px-3.py-1.rounded.border(data-target="ko") 한국어
      button.lang-btn.px-3.py-1.rounded.border(data-target="en") English

    .lang.lang-ko
      ol.list-decimal.ml-6.space-y-3
        li 결제 후 서비스 이용 전: 전액 환불 가능(결제일로부터 7일 이내 신청)
        li 매칭 서비스 진행 후: 환불 불가(법정 사유는 예외 적용)
        li 환불절차: 고객센터 접수 → 확인 → 7일 이내 환불 처리
        li 환불수단: 결제 시 사용한 동일 수단으로 환불

    .lang.lang-en.hidden
      ol.list-decimal.ml-6.space-y-3
        li Full refund available before service use (request within 7 days from payment date).
        li No refund once the matching service has been initiated (except as required by law).
        li Procedure: Contact support → verification → refund within 7 days.
        li Method: Refunded via the original payment method.

  script.
    (function(){
      const $btns = document.querySelectorAll('.lang-btn');
      const show = t => {
        document.querySelectorAll('.lang').forEach(el => el.classList.add('hidden'));
        const target = document.querySelector('.lang-' + t);
        if (target) target.classList.remove('hidden');
      };
      $btns.forEach(b=>b.addEventListener('click',()=>show(b.dataset.target)));
      show('ko');
    })();

