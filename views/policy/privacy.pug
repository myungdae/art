extends ../layout

block content
  .container.mx-auto.max-w-4xl.py-10
    h1.text-3xl.font-bold.mb-2 Privacy Policy
    p.text-sm.text-gray-500.mb-6 Last updated: #{lastUpdated || '2025-08-24'}

    p.mb-4 #{companyName || 'Company'} ("#{siteName || 'ESL PLUS'}") processes personal data in compliance with applicable laws as follows:
    ol.list-decimal.ml-6.space-y-3
      li Data collected: Name, contact details, email, payment information, and other data necessary for service provision.
      li Purpose: Membership management, matching service operation, payment and refund processing.
      li Retention: Preserved per statutory periods; otherwise deleted upon achieving the purpose.
      li Data Protection Officer (DPO): #{dpoName || 'Designated Person'} / Contact: #{supportEmail || 'support@example.com'}
      li Users may request access, correction, deletion, or restriction of processing.
