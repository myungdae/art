extends ../layout

block content
  .container.py-6
    h1.text-2xl.font-bold.mb-6 New Job Vacancy

    if errors && Object.keys(errors).length
      .max-w-2xl.mx-auto.bg-red-50.border.border-red-200.rounded.p-3.mb-5
        ul
          each val, key in errors
            li #[strong #{key}] #{val}

    form(method="POST", action="/job-vacancies", onsubmit="if(window.CKEDITOR){for (var n in CKEDITOR.instances){CKEDITOR.instances[n].updateElement();}} return true;")
      .max-w-2xl.mx-auto.space-y-5

        // Title
        .space-y-1
          label.block(for="title") Title
          input#title(type="text" name="title" required class="w-full border rounded px-3 py-2" value=(values && values.title) || "")

        // Description (CKEditor)
        .space-y-1
          label.block(for="description") Description
          textarea#description(name="description" rows="8" class="w-full border rounded px-3 py-2")= (values && values.description) || ""

        // Host Country (자동완성: DB 값)
        .space-y-1
          label.block(for="country") Host Country
          select#country(name="country" required class="w-full border rounded px-3 py-2")
            option(value="") -- Select host country --
            each c in (countries || [])
              option(value=c, selected=(values && values.country === c))= c

        // Student Type
        .space-y-1
          label.block(for="studentType") Student Type
          select#studentType(name="studentType" required class="w-full border rounded px-3 py-2")
            option(value="") -- Select student type --
            each s in (studentTypes || [])
              option(value=s, selected=(values && values.studentType === s))= s

        // Teaching Area (checkbox grid)
        .space-y-1
          label(for="teachingArea") Teaching Area
          .grid.grid-cols-2.gap-2(class="md:grid-cols-3")
            each t in (teachingAreas || [])
              - const picked = Array.isArray(values && values.teachingArea) ? values.teachingArea.includes(t) : ((values && values.teachingArea) ? values.teachingArea === t : false)
              label.flex.items-center.gap-2
                input(type="checkbox", name="teachingArea", value=t, checked=picked)
                | #{t}
          p.text-xs.text-gray-500 Select one or more.

        // Extra Teaching Areas
        .space-y-1
          label(for="extraTeachingArea") Extra Teaching Areas (comma-separated)
          input#extraTeachingArea(type="text" name="extraTeachingArea" value=(values && values.extraTeachingArea) || "")

        // Advanced RDF overrides
        details.mt-6
          summary.cursor-pointer.font-medium Advanced (RDF) options
          .mt-3.space-y-3
            .space-y-1
              label(for="_labelOverride") Title (rdfs:label override)
              input#_labelOverride(type="text" name="_labelOverride" value=(values && values._labelOverride) || "")
            .space-y-1
              label(for="_descriptionOverride") Description (dc:description override)
              textarea#_descriptionOverride(name="_descriptionOverride" rows="3")= (values && values._descriptionOverride) || ""

        // Date Posted
        .space-y-1
          label.block(for="datePosted") Date Posted
          input#datePosted(type="date" name="datePosted" class="w-full border rounded px-3 py-2" value=(values && values.datePosted) || "")

        // Contact Email
        .space-y-1
          label.block(for="email") Contact Email
          input#email(type="email" name="email" class="w-full border rounded px-3 py-2" value=(values && values.email) || "")

        // Company Name
        .space-y-1
          label.block(for="companyName") Company Name
          input#companyName(type="text" name="companyName" class="w-full border rounded px-3 py-2" value=(values && values.companyName) || "")

        // Job Location
        .space-y-1
          label.block(for="jobLocation") Job Location
          input#jobLocation(type="text" name="jobLocation" class="w-full border rounded px-3 py-2" value=(values && values.jobLocation) || "")

        // Pay
        .space-y-1
          label.block(for="pay") Pay
          input#pay(type="text" name="pay" class="w-full border rounded px-3 py-2" value=(values && values.pay) || "")

        // Housing
        .space-y-1
          label.block(for="housing") Housing
          input#housing(type="text" name="housing" class="w-full border rounded px-3 py-2" value=(values && values.housing) || "")

        // Cellphone
        .space-y-1
          label.block(for="cellphoneNumber") Cellphone
          input#cellphoneNumber(type="text" name="cellphoneNumber" class="w-full border rounded px-3 py-2" value=(values && values.cellphoneNumber) || "")

        // Homepage
        .space-y-1
          label.block(for="homepage") Homepage
          input#homepage(type="url" name="homepage" class="w-full border rounded px-3 py-2" value=(values && values.homepage) || "")

      .max-w-2xl.mx-auto.mt-6.flex.gap-3
        button(type="submit" class="px-4 py-2 rounded bg-blue-600 text-white") Save
        a(href="/job-vacancies" class="px-4 py-2 rounded border") Cancel

  script(src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js")
  style.
    /* Hide CKEditor license notification */
    .cke_notification_warning,
    .cke_notification {
      display: none !important;
    }
    .validation-warning {
      background-color: #fff3cd;
      border: 1px solid #ffc107;
      color: #856404;
      padding: 8px 12px;
      border-radius: 4px;
      margin-top: 5px;
      font-size: 0.875rem;
      display: none;
    }
  script.
    (function () {
      // ===== Content Validation =====
      
      // For Title fields: Block emojis + non-English languages
      function containsNonEnglishWithEmoji(text) {
        const nonEnglishRegex = /[\u3000-\u303f\u3040-\u309f\u30a0-\u30ff\uff00-\uff9f\u4e00-\u9faf\u3400-\u4dbf\uac00-\ud7a3]|[\u{1F300}-\u{1F9FF}]|[\u2600-\u27BF]/u;
        
        if (nonEnglishRegex.test(text)) {
          return 'Non-English characters or emojis detected';
        }
        return null;
      }
      
      // For Description fields: Block non-English languages only (emojis allowed)
      function containsNonEnglishLanguagesOnly(text) {
        const languageRegex = /[\u3000-\u303f\u3040-\u309f\u30a0-\u30ff\uff00-\uff9f\u4e00-\u9faf\u3400-\u4dbf\uac00-\ud7a3]/u;
        
        if (languageRegex.test(text)) {
          return 'Non-English characters detected (Korean, Chinese, or Japanese)';
        }
        return null;
      }

      function showWarning(inputId, message) {
        let warning = document.getElementById(inputId + '-warning');
        if (!warning) {
          warning = document.createElement('div');
          warning.id = inputId + '-warning';
          warning.className = 'validation-warning';
          const input = document.getElementById(inputId);
          input.parentNode.insertBefore(warning, input.nextSibling);
        }
        warning.textContent = '⚠️ ' + message + ' - Please use English only with standard punctuation.';
        warning.style.display = 'block';
      }

      function hideWarning(inputId) {
        const warning = document.getElementById(inputId + '-warning');
        if (warning) {
          warning.style.display = 'none';
        }
      }

      function validateField(inputId, allowEmoji = false) {
        const input = document.getElementById(inputId);
        if (!input || !input.value) return true;
        
        // Use appropriate validation function based on field type
        const error = allowEmoji 
          ? containsNonEnglishLanguagesOnly(input.value)
          : containsNonEnglishWithEmoji(input.value);
        
        if (error) {
          showWarning(inputId, error);
          return false;
        } else {
          hideWarning(inputId);
          return true;
        }
      }

      // ===== Apply validation to all text inputs =====
      // Title and other fields: strict (no emojis)
      const strictFields = ['title', 'companyName', 'jobLocation', 'pay', 'housing', 'extraTeachingArea'];
      
      // Track validation state for each field
      const fieldValidationState = {};
      strictFields.forEach(f => { fieldValidationState[f] = true; });
      
      // Prevent focus on next fields if Title has errors
      function preventNextFieldFocus() {
        const titleValid = fieldValidationState['title'];
        const allFields = document.querySelectorAll('input, textarea, select, button');
        
        if (!titleValid) {
          // Find title field position
          const titleField = document.getElementById('title');
          if (!titleField) return;
          
          let foundTitle = false;
          allFields.forEach(field => {
            if (field === titleField) {
              foundTitle = true;
            } else if (foundTitle && field.id !== 'title') {
              // Disable fields after title
              field.addEventListener('mousedown', function(e) {
                if (!fieldValidationState['title']) {
                  e.preventDefault();
                  alert('⚠️ Please fix the Title field first!\n\nTitle contains non-English characters or emojis.\nYou must use English only before proceeding.');
                  document.getElementById('title').focus();
                }
              });
              
              field.addEventListener('focus', function(e) {
                if (!fieldValidationState['title']) {
                  e.preventDefault();
                  this.blur();
                  alert('⚠️ Please fix the Title field first!\n\nTitle contains non-English characters or emojis.\nYou must use English only before proceeding.');
                  document.getElementById('title').focus();
                }
              });
            }
          });
        }
      }
      
      strictFields.forEach(fieldId => {
        const field = document.getElementById(fieldId);
        if (field) {
          field.addEventListener('blur', () => {
            // Strict validation (no emojis)
            const isValid = validateField(fieldId, false);
            fieldValidationState[fieldId] = isValid;
            
            // Special handling for Title field
            if (fieldId === 'title') {
              preventNextFieldFocus();
            }
          });
          
          field.addEventListener('input', () => {
            // Real-time validation after first warning
            if (document.getElementById(fieldId + '-warning')) {
              const isValid = validateField(fieldId, false);
              fieldValidationState[fieldId] = isValid;
              
              if (fieldId === 'title') {
                preventNextFieldFocus();
              }
            }
          });
        }
      });
      
      // Initial setup - prevent focus if Title already has content
      const titleField = document.getElementById('title');
      if (titleField && titleField.value) {
        const isValid = validateField('title');
        fieldValidationState['title'] = isValid;
        preventNextFieldFocus();
      }

      // ===== Form submission validation =====
      const form = document.querySelector('form');
      const submitButton = form ? form.querySelector('button[type="submit"]') : null;
      
      if (form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          
          // Update CKEditor content
          if (window.CKEDITOR) {
            for (var n in CKEDITOR.instances) {
              CKEDITOR.instances[n].updateElement();
            }
          }

          // Validate description from CKEditor (emojis allowed)
          const description = document.getElementById('description');
          if (description && description.value) {
            // Strip HTML tags before validation
            const plainText = description.value.replace(/<[^>]*>/g, '');
            const descError = containsNonEnglishLanguagesOnly(plainText);
            if (descError) {
              showWarning('description', descError);
              alert('⚠️ ' + descError + '\n\nEmojis are allowed, but Korean, Chinese, and Japanese text is not permitted.\nPlease remove non-English text from Description field before submitting.');
              return false;
            }
          }

          // Validate all strict fields (no emojis allowed)
          let hasErrors = false;
          let firstErrorField = null;
          
          strictFields.forEach(fieldId => {
            if (!validateField(fieldId, false)) {
              hasErrors = true;
              if (!firstErrorField) {
                firstErrorField = fieldId;
              }
            }
          });

          if (hasErrors) {
            alert('⚠️ Non-English characters or emojis detected in Title or other fields!\n\n' +
                  'Title, Company Name, and other text fields: No emojis allowed.\n' +
                  'Description field: Emojis are OK! 😊\n\n' +
                  'Please check: Title and other text fields.');
            // Focus on first error
            if (firstErrorField) {
              document.getElementById(firstErrorField)?.focus();
            }
            return false;
          }
          
          // If all validations pass, submit the form
          if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent = 'Submitting...';
          }
          form.submit();
        });
      }

      // ===== CKEditor initialization =====
      function init() {
        if (window.CKEDITOR && document.getElementById('description')) {
          CKEDITOR.replace('description', { 
            removePlugins: 'cloudservices,easyimage,notification', 
            height: 260,
            versionCheck: false
          });
          
          // Add validation on CKEditor change (emojis allowed)
          CKEDITOR.instances.description.on('blur', function() {
            const data = CKEDITOR.instances.description.getData();
            const plainText = data.replace(/<[^>]*>/g, ''); // Strip HTML tags
            const error = containsNonEnglishLanguagesOnly(plainText);
            if (error) {
              showWarning('description', error + ' (Emojis are OK! 😊)');
            } else {
              hideWarning('description');
            }
          });
        }
      }
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else { 
        init(); 
      }
    })();
