extends ../layout

block append_on_header
  script(src="/vendor/ckeditor/ckeditor.js")

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-8
        .card.shadow
          .card-header.bg-danger.text-white
            h4.mb-0 Add New Job Vacancy

          .card-body
            form(method="POST", action="/job-vacancies/new")

              // ✅ Title → rdfs:label
              .form-group.mb-3
                label Job Title (URI)
                input.form-control(type="text", name="title", required)

              // ✅ Description → dc:description + CKEditor
              .form-group.mb-4
                label Job Description
                textarea.form-control(name="description", id="description", rows="8")

              // ✅ Host Country
              .form-group.mb-3
                label Host Country ✍️
                .d-flex.align-items-center
                  select.form-select(name="countrySelect")
                    option(value="") -- Select Existing Country --
                    if values && values.countries
                      each c in values.countries
                        option(value=c)= c
                  button.btn.btn-outline-dark.ms-2(
                    type="button",
                    onclick="toggleInput('countryInput')"
                  ) +
                input#countryInput.form-control.mt-2(type="text", name="country", placeholder="Enter new country", style="display: none")

              // ✅ Student Type
              .form-group.mb-3
                label Student Type ✍️
                .d-flex.align-items-center
                  select.form-select(name="studentTypeSelect")
                    option(value="") -- Select Existing Type --
                    if values && values.studentTypes
                      each t in values.studentTypes
                        option(value=t)= t
                  button.btn.btn-outline-dark.ms-2(
                    type="button",
                    onclick="toggleInput('studentTypeInput')"
                  ) +
                input#studentTypeInput.form-control.mt-2(type="text", name="studentType", placeholder="Enter new student type", style="display: none")

              // ✅ Teaching Area
              .form-group.mb-3
                label Teaching Area ✍️
                .d-flex.align-items-center
                  select.form-select(name="teachingAreaSelect")
                    option(value="") -- Select Existing Area --
                    if values && values.teachingAreas
                      each a in values.teachingAreas
                        option(value=a)= a
                  button.btn.btn-outline-dark.ms-2(
                    type="button",
                    onclick="toggleInput('teachingAreaInput')"
                  ) +
                input#teachingAreaInput.form-control.mt-2(type="text", name="teachingArea", placeholder="Enter new teaching area", style="display: none")

              // ✅ Duration
              .form-group.mb-3
                label Duration
                input.form-control(type="text", name="duration")

              // ✅ Pay
              .form-group.mb-3
                label Pay
                input.form-control(type="text", name="pay")

              // ✅ Housing
              .form-group.mb-4
                label Housing
                input.form-control(type="text", name="housing")

              // ✅ Additional Fields
              .form-group.mb-3
                label Email
                input.form-control(type="email", name="email")

              .form-group.mb-3
                label Company Name
                input.form-control(type="text", name="companyName")

              .form-group.mb-3
                label Job Location
                input.form-control(type="text", name="jobLocation")

              .form-group.mb-3
                label Cellphone Number
                input.form-control(type="text", name="cellphoneNumber")

              .form-group.mb-3
                label Skype ID
                input.form-control(type="text", name="skypeId")

              .form-group.mb-3
                label WeChat ID
                input.form-control(type="text", name="wechatId")

              .form-group.mb-4
                label Homepage
                input.form-control(type="url", name="homepage")

              // ✅ Submit
              button.btn.btn-success.btn-block(type="submit") Submit

block append_js
  script.
    function toggleInput(id) {
      const el = document.getElementById(id);
      el.style.display = (el.style.display === 'none') ? 'block' : 'none';
    }
    CKEDITOR.replace('description');