extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-10
        .card.shadow
          .card-header.bg-light
            h4.mb-0.text-dark New Job Vacancy

          .card-body
            form(method="POST", action="/job-vacancies/new")

              // ✅ Job Title
              .form-group.mb-3
                label(for="title") Job Title *
                input.form-control#title(type="text", name="title", required, placeholder="Job Title", oninput="validateTitle(this)")
                small.text-danger#title-error(style="display:none") ❌ Emojis or Korean characters are not allowed.

              // ✅ Description
              .form-group.mb-4
                label(for="description") Job Description *
                textarea.form-control(name="description", id="description", rows="8")

              // ✅ Country + StudentType
              .form-row
                .form-group.col-md-6
                  label(for="country") Host Country
                  select.form-control(name="country", id="country", required)
                    option(disabled selected value='') Select Country
                    each v in countries
                      option(value=v)= v

                .form-group.col-md-6
                  label(for="studentType") Student Type
                  select.form-control(name="studentType", id="studentType", required)
                    option(disabled selected value='') Select Student Type
                    each v in studentTypes
                      option(value=v)= v

              // ✅ Teaching Area
              .form-group
                label(for="teachingArea") Teaching Area
                select.form-control(name="teachingArea", id="teachingArea", required)
                  option(disabled selected value='') Select Teaching Area
                  each v in teachingAreas
                    option(value=v)= v

              // ✅ 기타 기본 필드
              .form-row
                .form-group.col-md-6
                  label(for="duration") Duration
                  input.form-control(type="text", name="duration", placeholder="e.g. 12 months")

                .form-group.col-md-6
                  label(for="pay") Pay
                  input.form-control(type="text", name="pay", placeholder="e.g. $2500/month")

              .form-row
                .form-group.col-md-6
                  label(for="housing") Housing
                  input.form-control(type="text", name="housing", placeholder="e.g. Provided")

                .form-group.col-md-6
                  label(for="email") Email
                  input.form-control(type="email", name="email", placeholder="Your contact email")

              .form-row
                .form-group.col-md-6
                  label(for="companyName") Company Name
                  input.form-control(type="text", name="companyName")

                .form-group.col-md-6
                  label(for="jobLocation") Job Location
                  input.form-control(type="text", name="jobLocation")

              .form-row
                .form-group.col-md-6
                  label(for="cellphoneNumber") Cellphone Number
                  input.form-control(type="text", name="cellphoneNumber")

                .form-group.col-md-6
                  label(for="skypeId") Skype ID
                  input.form-control(type="text", name="skypeId")

              .form-row
                .form-group.col-md-6
                  label(for="wechatId") WeChat ID
                  input.form-control(type="text", name="wechatId")

                .form-group.col-md-6
                  label(for="homepage") Homepage
                  input.form-control(type="text", name="homepage")

              // ✅ Date Posted (숨김 처리)
              input(type="hidden", name="datePosted", value=new Date().toISOString().substring(0, 10))

              // ✅ Payment Options
              .form-group.mt-5
                h4.text-primary.mb-3 Select a Payment Option
                .form-row
                  each opt, idx in ['1', '4', '12', '24']
                    .col-md-6.mb-2
                      .form-check
                        input.form-check-input.ml-3(type="radio", name="adPackage", id="ad-" + opt, value=opt)
                        label.form-check-label(for="ad-" + opt).ml-2
                          if opt == '1'
                            | 1 Ad — $30 one-time payment
                          else if opt == '4'
                            | 4 Ads — $100 
                            span.text-danger (save $20)
                          else if opt == '12'
                            | 12 Ads — $250 
                            span.text-danger (save $110)
                          else if opt == '24'
                            | 24 Ads — $450 
                            span.text-danger (save $270)
              
              // ✅ Resume Access 라디오 정렬
              .form-group.mt-4
                label.mb-2.d-block Add Resume Access?
                .form-check.form-check-inline.ml-3
                  input.form-check-input(type="radio", name="resumeAccess", id="resumeYes", value="yes", checked)
                  label.form-check-label(for="resumeYes") Yes
                .form-check.form-check-inline
                  input.form-check-input(type="radio", name="resumeAccess", id="resumeNo", value="no")
                  label.form-check-label(for="resumeNo") No


              // ✅ Submit 버튼
              button.btn.btn-success.btn-block.mt-4(type="submit")
                | 🚀 Submit Job Posting

block append_js
  script(src="https://cdn.ckeditor.com/ckeditor5/41.0.0/classic/ckeditor.js")
  script.
    ClassicEditor
      .create(document.querySelector('#description'))
      .catch(error => console.error(error));

    function validateTitle(input) {
      const emojiRegex = /[\p{Emoji_Presentation}\p{Extended_Pictographic}]/gu;
      const koreanRegex = /[ㄱ-ㅎㅏ-ㅣ가-힣]/;
      const errorElem = document.getElementById('title-error');
      if (emojiRegex.test(input.value) || koreanRegex.test(input.value)) {
        errorElem.style.display = 'block';
        input.classList.add('is-invalid');
      } else {
        errorElem.style.display = 'none';
        input.classList.remove('is-invalid');
      }
    }
