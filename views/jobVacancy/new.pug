extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-10
        if message && showPayment
          .card.shadow
            .card-header.bg-light
              h4.mb-0.text-dark New Job Vacancy
            .card-body
              .alert.alert-success(role="alert")
                span ✅ #{message}
              p.text-dark.mt-4 Please proceed to payment to publish your ad.
              form(method="GET", action="/paypal/checkout")
                input(type="hidden", name="package", value="basic")
                button.btn.btn-warning.mt-3(type="submit") Proceed to Payment

        else
          .card.shadow
            .card-header.bg-light
              h4.mb-0.text-dark New Job Vacancy

            .card-body
              form(method="POST", action="/job-vacancies/new")
                .form-group.mb-3
                  label(for="title") Job Title
                  input.form-control#title(type="text", name="title", required, placeholder="Job Title", oninput="validateTitle(this)")
                  small.text-danger#title-error(style="display:none") ❌ Emojis or Korean characters are not allowed.

                .form-group.mb-4
                  label(for="description") Job Description
                  textarea.form-control(name="description", id="description", rows="8")

                .form-group.mb-3
                  label(for="country") Host Country
                  select.form-control(name="country", id="country", required)
                    option(disabled selected value='') Select Country
                    each v in countries
                      option(value=v)= v

                .form-group.mb-3
                  label(for="studentType") Student Type
                  select.form-control(name="studentType", id="studentType", required)
                    option(disabled selected value='') Select Student Type
                    each v in studentTypes
                      option(value=v)= v

                .form-group.mb-3
                  label(for="teachingArea") Teaching Area
                  select.form-control(name="teachingArea", id="teachingArea", required)
                    option(disabled selected value='') Select Teaching Area
                    each v in teachingAreas
                      option(value=v)= v

                .form-group.mb-3
                  label(for="duration") Duration
                  input.form-control(type="text", name="duration", id="duration", placeholder="Duration")

                .form-group.mb-3
                  label(for="pay") Pay
                  input.form-control(type="text", name="pay", id="pay", placeholder="Pay")

                .form-group.mb-3
                  label(for="housing") Housing
                  input.form-control(type="text", name="housing", id="housing", placeholder="Housing")

                .form-group.mb-3
                  label(for="email") Email
                  input.form-control(type="email", name="email", id="email", placeholder="Email")

                .form-group.mb-3
                  label(for="companyName") Company Name
                  input.form-control(type="text", name="companyName", id="companyName", placeholder="Company Name")

                .form-group.mb-3
                  label(for="jobLocation") Job Location
                  input.form-control(type="text", name="jobLocation", id="jobLocation", placeholder="Job Location")

                .form-group.mb-3
                  label(for="cellphoneNumber") Cellphone Number
                  input.form-control(type="text", name="cellphoneNumber", id="cellphoneNumber", placeholder="Cellphone Number")

                .form-group.mb-3
                  label(for="skypeId") Skype ID
                  input.form-control(type="text", name="skypeId", id="skypeId", placeholder="Skype ID")

                .form-group.mb-3
                  label(for="wechatId") WeChat ID
                  input.form-control(type="text", name="wechatId", id="wechatId", placeholder="WeChat ID")

                .form-group.mb-3
                  label(for="homepage") Homepage
                  input.form-control(type="text", name="homepage", id="homepage", placeholder="Homepage")

                .form-group.mb-3
                  label(for="datePosted") Date Posted
                  input.form-control(type="date", name="datePosted", id="datePosted")

                .form-group.mt-5
                  h4.text-primary.mb-3 Select a Payment Option
                  each opt in ['1', '4', '12', '24']
                    .form-check
                      input.form-check-input(type="radio", name="adPackage", id="ad-" + opt, value=opt)
                      label.form-check-label(for="ad-" + opt)
                        if opt == '1'
                          | 1 Ad — $30 one-time payment
                        else if opt == '4'
                          | 4 Ads — $100 one-time payment 
                          span.text-danger (save $20)
                        else if opt == '12'
                          | 12 Ads — $250 one-time payment 
                          span.text-danger (save $110)
                        else if opt == '24'
                          | 24 Ads — $450 one-time payment 
                          span.text-danger (save $270)

                // 📌 라디오 버튼 정렬 개선
                div.form-group
                  label.mb-2 Add Resume Access?
                
                  div
                    label.mr-4
                      input(type="radio", name="resumeAccess", value="yes", checked)
                      |  Yes
                    label
                      input(type="radio", name="resumeAccess", value="no")
                      |  No


                button.btn.btn-success.btn-block.mt-4(type="submit") Submit

block append_js
                script(src="https://cdn.ckeditor.com/ckeditor5/41.0.0/classic/ckeditor.js")
                script.
                  ClassicEditor
                    .create(document.querySelector('#description'))
                    .catch(error => console.error(error));
                
                  function validateTitle(input) {
                    const emojiRegex = /[\p{Emoji_Presentation}\p{Extended_Pictographic}]/gu;
                    const koreanRegex = /[ㄱ-ㅎㅏ-ㅣ가-힣]/;
                    const errorElem = document.getElementById('title-error');
                    if (emojiRegex.test(input.value) || koreanRegex.test(input.value)) {
                      errorElem.style.display = 'block';
                      input.classList.add('is-invalid');
                    } else {
                      errorElem.style.display = 'none';
                      input.classList.remove('is-invalid');
                    }
                  }

