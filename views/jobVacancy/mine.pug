extends ../layout

block content
  .container.py-6
    h1.text-2xl.font-bold.mb-6 My Job Vacancies

    a(href="/job-vacancies/new" class="inline-block mb-4 px-4 py-2 rounded bg-blue-600 text-white") New Job

    if jobs && jobs.length
      ul.space-y-3
        each j in jobs
          li.border.rounded.p-3
            h2.font-semibold.text-lg= j.title
            p.text-sm.text-gray-600
              | #{j.country || '-'} · #{j.studentType || '-'} · #{j.teachingArea || '-'}
            p.text-sm.mt-1 Posted: #{(j.datePosted && new Date(j.datePosted).toISOString().slice(0,10)) || '-'}
            .mt-2
              a(href=`/job-vacancies/${j._id}/edit` class="px-3 py-1 rounded border") Edit
    else
      p.text-gray-500 You have no job vacancies yet.
