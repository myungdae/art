extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-4 Job Vacancies

    if jobs.length === 0
      p.text-muted No job postings available.
    else
      table.table.table-bordered
        thead
          tr
            th Title
            th Country
            th Date Posted
            th Actions
        tbody
          each job in jobs
            tr
              td= job.title
              td= job.country || '—'
              td= job.datePosted ? job.datePosted.toISOString().substring(0, 10) : '—'
              td
                a.btn.btn-sm.btn-primary(href=`/job-vacancies/${job._id}`) View
                a.btn.btn-sm.btn-warning.ms-1(href=`/job-vacancies/${job._id}/edit`) Edit
