extends ../layout

block content
  .container.mt-5
    .row.justify-content-between.align-items-center.mb-4
      .col-auto
        h2.text-dark.mb-0 Job Vacancies
      .col-auto
        a.btn.btn-success(href='/job-vacancies/new') + Post New Job

    .row
      each job in jobs
        .col-md-6.mb-4
          .card.shadow-sm
            .card-body
              h5.card-title.text-primary= job.title
              p.mb-1
                small.text-muted #{job.country} | #{job.studentType} | #{job.teachingArea}
              p.mb-2 #{job.companyName} — #{job.jobLocation}

              .btn-group
                a.btn.btn-outline-primary.btn-sm(href="/job-vacancies/" + job._id) View
                a.btn.btn-outline-warning.btn-sm(href="/job-vacancies/" + job._id + "/edit") Edit
                form(method="POST", action="/job-vacancies/" + job._id + "/delete", style="display:inline")
                  button.btn.btn-outline-danger.btn-sm(type="submit" onclick="return confirm('Are you sure?')") Delete
