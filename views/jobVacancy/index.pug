extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-10
        .card.shadow
          .card-header.bg-primary.text-white.text-center
            h4.mb-0 Edit Job Advertisement

          .card-body
            form(method="POST", action=`/job-vacancies/${jobVacancy._id}?_method=PUT`, onsubmit="return handleCustomFields()")

              .form-group.mb-3
                label(for="title") Job Title
                input.form-control#title(type="text", name="title", required, value=jobVacancy.title, oninput="validateTitle(this)")
                small.text-danger#title-error(style="display:none") ❌ Emojis or Korean characters are not allowed.

              .form-group.mb-4
                label(for="description") Job Description
                textarea.form-control(name="description", id="description", rows="8")= jobVacancy.description

              .form-group.mb-3
                label(for="country") Host Country
                select.form-control#countrySelect(name="country")
                  option(disabled value='') Select Country
                  each v in countries
                    option(value=v selected=(v === jobVacancy.country))= v
                small.text-muted.mt-1 You can also add a new country:
                input.form-control.mt-1(type="text", id="customCountry", placeholder="Or enter a new Country")

              .form-group.mb-3
                label(for="studentType") Student Type
                select.form-control#studentTypeSelect(name="studentType")
                  option(disabled value='') Select Student Type
                  each v in studentTypes
                    option(value=v selected=(v === jobVacancy.studentType))= v
                small.text-muted.mt-1 You can also add a new student type:
                input.form-control.mt-1(type="text", id="customStudentType", placeholder="Or enter a new Student Type")

              .form-group.mb-3
                label(for="teachingArea") Teaching Area
                select.form-control#teachingArea(name="teachingArea")
                  option(disabled value='') Select Teaching Area
                  each v in teachingAreas
                    option(value=v selected=(v === jobVacancy.teachingArea))= v
                small.text-muted.mt-1 You can also add a new teaching area:
                input.form-control.mt-1(type="text", id="customTeachingArea", placeholder="Or enter a new Teaching Area")

              .form-group.mb-3
                label(for="duration") Duration
                input.form-control(type="text", name="duration", id="duration", value=jobVacancy.duration)

              .form-group.mb-3
                label(for="pay") Pay
                input.form-control(type="text", name="pay", id="pay", value=jobVacancy.pay)

              .form-group.mb-3
                label(for="housing") Housing
                input.form-control(type="text", name="housing", id="housing", value=jobVacancy.housing)

              .form-group.mb-3
                label(for="email") Email
                input.form-control(type="email", name="email", id="email", value=jobVacancy.email)

              .form-group.mb-3
                label(for="companyName") Company Name
                input.form-control(type="text", name="companyName", id="companyName", value=jobVacancy.companyName)

              .form-group.mb-3
                label(for="jobLocation") Job Location
                input.form-control(type="text", name="jobLocation", id="jobLocation", value=jobVacancy.jobLocation)

              .form-group.mb-3
                label(for="cellphoneNumber") Cellphone Number
                input.form-control(type="text", name="cellphoneNumber", id="cellphoneNumber", value=jobVacancy.cellphoneNumber)

              .form-group.mb-3
                label(for="skypeId") Skype ID
                input.form-control(type="text", name="skypeId", id="skypeId", value=jobVacancy.skypeId)

              .form-group.mb-3
                label(for="wechatId") WeChat ID
                input.form-control(type="text", name="wechatId", id="wechatId", value=jobVacancy.wechatId)

              .form-group.mb-3
                label(for="homepage") Homepage
                input.form-control(type="text", name="homepage", id="homepage", value=jobVacancy.homepage)

              .form-group.mb-3
                label(for="datePosted") Date Posted
                input.form-control(type="date", name="datePosted", id="datePosted", value=datePostedFormatted)

              .form-group
                label.mb-2 Add Resume Access?
                .form-check.form-check-inline
                  input.form-check-input(type="radio", name="resumeAccess", id="resumeYes", value="yes", checked=(jobVacancy.resumeAccess === 'yes'))
                  label.form-check-label(for="resumeYes") Yes
                .form-check.form-check-inline
                  input.form-check-input(type="radio", name="resumeAccess", id="resumeNo", value="no", checked=(jobVacancy.resumeAccess === 'no'))
                  label.form-check-label(for="resumeNo") No

              button.btn.btn-primary.btn-block.mt-4(type="submit") Update

block append_js
  script(src="https://cdn.ckeditor.com/ckeditor5/41.0.0/classic/ckeditor.js")
  script.
    ClassicEditor
      .create(document.querySelector('#description'))
      .catch(error => console.error(error));

    function validateTitle(input) {
      const emojiRegex = /[\p{Emoji_Presentation}\p{Extended_Pictographic}]/gu;
      const koreanRegex = /[\u3131-\uD79D]/;
      const errorElem = document.getElementById('title-error');
      if (emojiRegex.test(input.value) || koreanRegex.test(input.value)) {
        errorElem.style.display = 'block';
        input.classList.add('is-invalid');
      } else {
        errorElem.style.display = 'none';
        input.classList.remove('is-invalid');
      }
    }

    function handleCustomFields() {
      const form = document.querySelector('form');

      const customCountry = document.getElementById('customCountry')?.value.trim();
      const customStudent = document.getElementById('customStudentType')?.value.trim();
      const customTeaching = document.getElementById('customTeachingArea')?.value.trim();

      if (customCountry) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'country';
        input.value = customCountry;
        form.appendChild(input);
        document.getElementById('countrySelect').disabled = true;
      }

      if (customStudent) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'studentType';
        input.value = customStudent;
        form.appendChild(input);
        document.getElementById('studentTypeSelect').disabled = true;
      }

      if (customTeaching) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'teachingArea';
        input.value = customTeaching;
        form.appendChild(input);
        document.getElementById('teachingArea').disabled = true;
      }

      return true;
    }
