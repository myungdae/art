extends ../layout

block content
  h1 Job Vacancies

  if jobVacancies.length
    table.table.table-striped
      thead
        tr
          th Title
          th Country
          th Posted At
          th Actions
      tbody
        each job in jobVacancies
          tr
            td= job.title
            td= job.country
            td= job.createdAt.toISOString().split('T')[0]
            td
              if currentUser && String(job.createdBy) === String(currentUser._id)
                a(href=`/job-vacancies/${job._id}`) View
                |  
                a(href=`/job-vacancies/${job._id}/edit`) Edit
                |  
                form(method="POST", action=`/job-vacancies/${job._id}?_method=DELETE`, style="display:inline")
                  button.btn.btn-danger(type="submit") Delete
              else
                a(href=`/job-vacancies/${job._id}`) View
  else
    p.text-muted No job vacancies available.
