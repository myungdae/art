extends ../layout

block content
  .container.mx-auto.max-w-6xl.py-8

    h1.text-3xl.font-bold.mb-6 Job Vacancies

    - const enc = encodeURIComponent;

    // == Top chips (DB 기반) ==
    if countries && countries.length
      h2.text-sm.font-semibold.text-gray-600.mb-2 Countries
      div(class="flex flex-wrap gap-2 mb-6")
        each c in countries
          a(
            href=`/facet/Job_Vacancies?country=${enc(c)}`
            class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition"
          )= c

    if studentTypes && studentTypes.length
      h2.text-sm.font-semibold.text-gray-600.mb-2 Student Types
      div(class="flex flex-wrap gap-2 mb-6")
        each s in studentTypes
          a(
            href=`/facet/Job_Vacancies?studentType=${enc(s)}`
            class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition"
          )= s

    if teachingAreas && teachingAreas.length
      h2.text-sm.font-semibold.text-gray-600.mb-2 Teaching Areas
      div(class="flex flex-wrap gap-2 mb-8")
        each t in teachingAreas
          a(
            href=`/facet/Job_Vacancies?teachingArea=${enc(t)}`
            class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition"
          )= t

    // == Active filters summary (list 페이지 자체 필터를 쓰시는 경우 표시) ==
    if filters && (filters.country || filters.studentType || filters.teachingArea)
      div(class="mb-6")
        span.text-sm.text-gray-600 Active filters:
        if filters.country
          span(class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full bg-gray-100 text-sm") Country: #{filters.country}
        if filters.studentType
          span(class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full bg-gray-100 text-sm") Student: #{filters.studentType}
        if filters.teachingArea
          span(class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full bg-gray-100 text-sm") Area: #{filters.teachingArea}
        a(href="/job-vacancies" class="ml-3 text-sm text-blue-600 hover:underline") Clear all

    // == List ==
    if !jobs || !jobs.length
      p.text-gray-500 No jobs found.
    else
      div(class="space-y-4")
        each j in jobs
          .border.rounded.p-4
            // Title + link to RDF resource view
            .flex.items-start.justify-between
              h3.text-xl.font-semibold
                a.text-blue-700(href=`/rdf-resource/Job_Vacancies/${j._id}`)= j.title || '(Untitled)'
              if j.datePosted
                - const d = new Date(j.datePosted)
                span.text-sm.text-gray-500= d.toISOString().slice(0,10)

            if j.companyName
              p.text-gray-600.mt-1= j.companyName

            // Meta chips under each item — facet로 연결 (UX 통일)
            div(class="mt-3 flex flex-wrap gap-2")
              if j.country
                a(
                  href=`/facet/Job_Vacancies?country=${enc(j.country)}`
                  class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition"
                )= j.country

              if j.studentType
                a(
                  href=`/facet/Job_Vacancies?studentType=${enc(j.studentType)}`
                  class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition"
                )= j.studentType

              if j.teachingArea
                - const tas = Array.isArray(j.teachingArea) ? j.teachingArea : [j.teachingArea]
                each t in tas
                  a(
                    href=`/facet/Job_Vacancies?teachingArea=${enc(t)}`
                    class="inline-flex items-center px-3 py-1 rounded-full border hover:bg-gray-50 transition"
                  )= t

            // Optional brief description (text-only preview)
            if j.description
              p.text-gray-700.mt-3
                = (j.description || '').replace(/<[^>]*>/g, '').slice(0, 180)
                if (j.description || '').length > 180
                  |  ...

            // Actions
            div(class="mt-3 flex items-center gap-3")
              a.text-blue-600.hover:underline(href=`/rdf-resource/Job_Vacancies/${j._id}`) View
              a.text-blue-600.hover:underline(href=`/job-vacancies/${j._id}/edit`) Edit
