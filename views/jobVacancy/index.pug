extends ../layout

block content
  .container.mt-5
    .row.justify-content-between.align-items-center.mb-4
      .col-auto
        h2.text-dark.mb-0 Job Vacancies
      .col-auto
        a.btn.btn-dark.btn-lg.fw-bold.fs-4.text-white(href='/job-vacancies/new') Post New Job Vacancy

    .row
      each job in jobs
        .col-md-6.mb-4
          .card.shadow-sm
            .card-body
              h5.card-title.text-primary= job.title
              p.mb-1
                small.text-muted #{job.country} | #{job.studentType} | #{job.teachingArea}
              p.mb-2 #{job.companyName} — #{job.jobLocation}
              
              p.text-danger.small
              | job.user = #{JSON.stringify(job.user)}
              br
              | job.user._id = #{job.user && job.user._id}
              br
              | session.user._id = #{session && session.user && session.user._id}


              .btn-group
                a.btn.btn-outline-primary.btn-sm(href="/job-vacancies/" + job._id) View

                // ✅ 조건부로만 Edit/Delete
                if session && session.user && job.user && job.user._id && String(session.user._id) === String(job.user._id)
                  a.btn.btn-outline-warning.btn-sm(href="/job-vacancies/" + job._id + "/edit") Edit
                  form(method="POST", action="/job-vacancies/" + job._id + "?_method=DELETE", style="display:inline")
                    button.btn.btn-outline-danger.btn-sm(type="submit" onclick="return confirm('Are you sure you want to delete this ad?')") Delete
