extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-10
        .card.shadow
          .card-header.bg-primary.text-white.text-center
            h4.mb-0 Post a Job Ad

          .card-body
            form(method="POST", action="/job-vacancies", onsubmit="return handleCustomFields()")
              // ✅ Job Title → rdfs:label
              .form-group.mb-3
                label(for="title") Job Title
                input.form-control#title(type="text", name="rdfs:label[@value]", required, placeholder="Job Title", oninput="validateTitle(this)")
                small.text-danger#title-error(style="display:none") ❌ Emojis or Korean characters are not allowed.

              // ✅ Description → dc:description
              .form-group.mb-4
                label(for="description") Job Description
                textarea.form-control(name="http://purl.org/dc/elements/1.1/description[@value]", id="description", rows="8")

              // ✅ Host Country (널가드)
              .form-group.mb-3
                label(for="country") Host Country
                select.form-control#countrySelect(name="country")
                  option(disabled selected value='') Select Country
                  if countries && countries.length
                    each v in countries
                      option(value=v)= v
                  else
                    option(disabled value='') (no presets)
                small.text-muted.mt-1 You can also add a new country:
                input.form-control.mt-1(type="text", id="customCountry", placeholder="Or enter a new Country")

              // ✅ Student Type (널가드)
              .form-group.mb-3
                label(for="studentType") Student Type
                select.form-control#studentTypeSelect(name="studentType")
                  option(disabled selected value='') Select Student Type
                  if studentTypes && studentTypes.length
                    each v in studentTypes
                      option(value=v)= v
                  else
                    option(disabled value='') (no presets)
                small.text-muted.mt-1 You can also add a new student type:
                input.form-control.mt-1(type="text", id="customStudentType", placeholder="Or enter a new Student Type")

              // ✅ Teaching Area (널가드)
              .form-group.mb-3
                label(for="teachingArea") Teaching Area
                select.form-control#teachingArea(name="teachingArea")
                  option(disabled selected value='') Select Teaching Area
                  if teachingAreas && teachingAreas.length
                    each v in teachingAreas
                      option(value=v)= v
                  else
                    option(disabled value='') (no presets)
                small.text-muted.mt-1 You can also add a new teaching area:
                input.form-control.mt-1(type="text", id="customTeachingArea", placeholder="Or enter a new Teaching Area")

              .form-group.mb-3
                label(for="duration") Duration
                input.form-control(type="text", name="duration", id="duration", placeholder="Duration")

              .form-group.mb-3
                label(for="pay") Pay
                input.form-control(type="text", name="pay", id="pay", placeholder="Pay")

              .form-group.mb-3
                label(for="housing") Housing
                input.form-control(type="text", name="housing", id="housing", placeholder="Housing")

              .form-group.mb-3
                label(for="email") Email
                input.form-control(type="email", name="email", id="email", placeholder="Email")

              .form-group.mb-3
                label(for="companyName") Company Name
                input.form-control(type="text", name="companyName", id="companyName", placeholder="Company Name")

              .form-group.mb-3
                label(for="jobLocation") Job Location
                input.form-control(type="text", name="jobLocation", id="jobLocation", placeholder="Job Location")

              .form-group.mb-3
                label(for="cellphoneNumber") Cellphone Number
                input.form-control(type="text", name="cellphoneNumber", id="cellphoneNumber", placeholder="Cellphone Number")

              .form-group.mb-3
                label(for="skypeId") Skype ID
                input.form-control(type="text", name="skypeId", id="skypeId", placeholder="Skype ID")

              .form-group.mb-3
                label(for="wechatId") WeChat ID
                input.form-control(type="text", name="wechatId", id="wechatId", placeholder="WeChat ID")

              .form-group.mb-3
                label(for="homepage") Homepage
                input.form-control(type="text", name="homepage", id="homepage", placeholder="Homepage")

              .form-group.mb-3
                label(for="datePosted") Date Posted
                input.form-control(type="date", name="datePosted", id="datePosted")

              // === Advertisement Plan (Employer) ===
              .form-group.mb-3
                label(for="adCount") Advertisement Plan
                .d-flex.flex-wrap
                  if adPlans && adPlans.length
                    each plan, idx in adPlans
                      .form-check.form-check-inline.me-3.mt-2
                        input.form-check-input(type="radio", name="adCount", id=`adCount-${plan.ads}`, value=plan.ads, required, checked=idx === 0)
                        label.form-check-label(for=`adCount-${plan.ads}`)= plan.label
                  else
                    - const _plans = [1, 4, 12, 24]
                    each v, idx in _plans
                      .form-check.form-check-inline.me-3.mt-2
                        input.form-check-input(type="radio", name="adCount", id=`adCount-${v}`, value=v, required, checked=idx === 0)
                        label.form-check-label(for=`adCount-${v}`)= `${v} Ad${v > 1 ? 's' : ''}`
                if typeof tokensLeft !== 'undefined' && tokensLeft !== null
                  small.text-muted.d-block.mt-1 You currently have #{tokensLeft} promotion tokens.

              .form-group
                label.mb-2 Add Resume Access?
                .form-check.form-check-inline
                  input.form-check-input(type="radio", name="resumeAccess", id="resumeYes", value="yes", checked)
                  label.form-check-label(for="resumeYes") Yes
                .form-check.form-check-inline
                  input.form-check-input(type="radio", name="resumeAccess", id="resumeNo", value="no")
                  label.form-check-label(for="resumeNo") No

              button.btn.btn-primary.btn-block.mt-4(type="submit") Submit

block append_js
  script(src="https://cdn.ckeditor.com/ckeditor5/41.0.0/classic/ckeditor.js")
  script.
    ClassicEditor
      .create(document.querySelector('#description'))
      .catch(error => console.error(error));

    function validateTitle(input) {
      const emojiRegex = /[\p{Emoji_Presentation}\p{Extended_Pictographic}]/gu;
      const koreanRegex = /[ㄱ-ㅎㅏ-ㅣ가-힣]/;
      const errorElem = document.getElementById('title-error');
      if (emojiRegex.test(input.value) || koreanRegex.test(input.value)) {
        errorElem.style.display = 'block';
        input.classList.add('is-invalid');
      } else {
        errorElem.style.display = 'none';
        input.classList.remove('is-invalid');
      }
    }

    function handleCustomFields() {
      const form = document.querySelector('form');

      const customCountry = document.getElementById('customCountry')?.value.trim();
      const customStudent = document.getElementById('customStudentType')?.value.trim();
      const customTeaching = document.getElementById('customTeachingArea')?.value.trim();

      const countrySelect = document.getElementById('countrySelect');
      const studentTypeSelect = document.getElementById('studentTypeSelect');
      const teachingSelect = document.getElementById('teachingArea');

      if (customCountry && countrySelect.value === '') {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'country';
        input.value = customCountry;
        form.appendChild(input);
        countrySelect.disabled = true;
      }

      if (customStudent && studentTypeSelect.value === '') {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'studentType';
        input.value = customStudent;
        form.appendChild(input);
        studentTypeSelect.disabled = true;
      }

      if (customTeaching && teachingSelect.value === '') {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'teachingArea';
        input.value = customTeaching;
        form.appendChild(input);
        teachingSelect.disabled = true;
      }

      return true;
    }
