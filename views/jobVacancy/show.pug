extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-10
        if !jobVacancy
          .alert.alert-danger ❌ Error: Job data not found or has been deleted.
        else
          .card.shadow
            .card-header.bg-light.d-flex.justify-content-between.align-items-center
              h4.mb-0.text-dark= jobVacancy._label || jobVacancy.title || 'Untitled'
              a.btn.btn-outline-primary(href='/job-vacancies') ← Back to List

            .card-body
              h5.mb-3 📝 Job Description
              .job-description.border.p-3.bg-light
                if stripped
                  div= stripped
                else
                  p.text-muted No description provided.

              hr

              h5.mb-3 RELATED INFORMATION
              table.table.table-bordered
                tbody
                  tr
                    th Duration
                    td= jobVacancy.duration && jobVacancy.duration.trim() !== '' ? jobVacancy.duration : 'N/A'
                  tr
                    th Pay
                    td= jobVacancy.pay && jobVacancy.pay.trim() !== '' ? jobVacancy.pay : 'N/A'
                  tr
                    th Housing
                    td= jobVacancy.housing && jobVacancy.housing.trim() !== '' ? jobVacancy.housing : 'N/A'
                  tr
                    th Teaching Area
                    td
                      if jobVacancy.teachingArea && jobVacancy.teachingArea.length > 0
                        - const areas = Array.isArray(jobVacancy.teachingArea) ? jobVacancy.teachingArea : [jobVacancy.teachingArea]
                        each area, index in areas
                          span.badge.bg-primary.me-1.mb-1= area
                      else
                        | N/A
                  tr
                    th Extra Teaching Areas
                    td
                      if jobVacancy.extraTeachingArea && jobVacancy.extraTeachingArea.trim() !== ''
                        - const extraAreas = jobVacancy.extraTeachingArea.split(',').map(a => a.trim()).filter(a => a)
                        if extraAreas.length > 0
                          each area in extraAreas
                            span.badge.bg-secondary.me-1.mb-1= area
                        else
                          = jobVacancy.extraTeachingArea
                      else
                        | N/A
                  tr
                    th Email
                    td= jobVacancy.email && jobVacancy.email.trim() !== '' ? jobVacancy.email : 'N/A'
                  tr
                    th Company Name
                    td= jobVacancy.companyName && jobVacancy.companyName.trim() !== '' ? jobVacancy.companyName : 'N/A'
                  tr
                    th Job Location
                    td= jobVacancy.jobLocation && jobVacancy.jobLocation.trim() !== '' ? jobVacancy.jobLocation : 'N/A'
                  tr
                    th Cellphone Number
                    td= jobVacancy.cellphoneNumber && jobVacancy.cellphoneNumber.trim() !== '' ? jobVacancy.cellphoneNumber : 'N/A'
                  tr
                    th Skype ID
                    td= jobVacancy.skypeId && jobVacancy.skypeId.trim() !== '' ? jobVacancy.skypeId : 'N/A'
                  tr
                    th WeChat ID
                    td= jobVacancy.wechatId && jobVacancy.wechatId.trim() !== '' ? jobVacancy.wechatId : 'N/A'
                  tr
                    th Homepage
                    td
                      if jobVacancy.homepage && jobVacancy.homepage.trim() !== ''
                        a(href=jobVacancy.homepage, target="_blank")= jobVacancy.homepage
                      else
                        | N/A

              .mt-4.d-flex.justify-content-end
                a.btn.btn-secondary.me-2(href=`/job-vacancies/${jobVacancy._id}/edit`) Edit
                form(method="POST", action=`/job-vacancies/${jobVacancy._id}?_method=DELETE`)
                  button.btn.btn-danger(type="submit" onclick="return confirm('Are you sure you want to delete this ad?')") Delete
