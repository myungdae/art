extends ../layout

block append_on_header
  script(src="/vendor/ckeditor/ckeditor.js")

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-8
        .card.shadow
          .card-header.bg-warning.text-white
            h4.mb-0 Edit Job Vacancy

          .card-body
            form(method="POST", action=`/job-vacancies/${jobVacancy._id}/edit`, onsubmit="return validateForm()")

              // ✅ Title
              .form-group.mb-3
                label Job Title
                input.form-control(type="text", name="title", id="title", required, value=jobVacancy.title)
                div#titleError.text-danger.mt-1

              // ✅ Description + CKEditor
              .form-group.mb-4
                label Job Description
                textarea.form-control(name="description", id="description", rows="8")= jobVacancy.description

              // ✅ Host Country
              .form-group.mb-3
                label Host Country ✍️
                .d-flex.align-items-center
                  select.form-select(name="countrySelect")
                    option(value="") -- Select Existing Country --
                    if values && values.countries
                      each c in values.countries
                        option(value=c selected=(jobVacancy.country === c))= c
                  button.btn.btn-outline-dark.ms-2(
                    type="button",
                    onclick="toggleInput('countryInput')"
                  ) +
                input#countryInput.form-control.mt-2(type="text", name="country", placeholder="Enter new country", style="display: none")

              // ✅ Student Type
              .form-group.mb-3
                label Student Type ✍️
                .d-flex.align-items-center
                  select.form-select(name="studentTypeSelect")
                    option(value="") -- Select Existing Type --
                    if values && values.studentTypes
                      each t in values.studentTypes
                        option(value=t selected=(jobVacancy.studentType === t))= t
                  button.btn.btn-outline-dark.ms-2(
                    type="button",
                    onclick="toggleInput('studentTypeInput')"
                  ) +
                input#studentTypeInput.form-control.mt-2(type="text", name="studentType", placeholder="Enter new student type", style="display: none")

              // ✅ Teaching Area
              .form-group.mb-3
                label Teaching Area ✍️
                .d-flex.align-items-center
                  select.form-select(name="teachingAreaSelect")
                    option(value="") -- Select Existing Area --
                    if values && values.teachingAreas
                      each a in values.teachingAreas
                        option(value=a selected=(jobVacancy.teachingArea === a))= a
                  button.btn.btn-outline-dark.ms-2(
                    type="button",
                    onclick="toggleInput('teachingAreaInput')"
                  ) +
                input#teachingAreaInput.form-control.mt-2(type="text", name="teachingArea", placeholder="Enter new teaching area", style="display: none")

              // ✅ Duration
              .form-group.mb-3
                label Duration
                input.form-control(type="text", name="duration", value=jobVacancy.duration)

              // ✅ Pay
              .form-group.mb-3
                label Pay
                input.form-control(type="text", name="pay", value=jobVacancy.pay)

              // ✅ Housing
              .form-group.mb-3
                label Housing
                input.form-control(type="text", name="housing", value=jobVacancy.housing)

              // ✅ Additional Info
              .form-group.mb-3
                label Email
                input.form-control(type="email", name="email", value=jobVacancy.email)

              .form-group.mb-3
                label Company Name
                input.form-control(type="text", name="companyName", value=jobVacancy.companyName)

              .form-group.mb-3
                label Job Location
                input.form-control(type="text", name="jobLocation", value=jobVacancy.jobLocation)

              .form-group.mb-3
                label Cellphone Number
                input.form-control(type="text", name="cellphoneNumber", value=jobVacancy.cellphoneNumber)

              .form-group.mb-3
                label Skype ID
                input.form-control(type="text", name="skypeId", value=jobVacancy.skypeId)

              .form-group.mb-3
                label WeChat ID
                input.form-control(type="text", name="wechatId", value=jobVacancy.wechatId)

              .form-group.mb-4
                label Homepage
                input.form-control(type="url", name="homepage", value=jobVacancy.homepage)

              // ✅ Submit
              button.btn.btn-success.btn-block(type="submit") Update

block append_js
  script.
    function validateForm() {
      const title = document.getElementById('title').value.trim();
      const errorDiv = document.getElementById('titleError');
      const forbidden = /[^\w\s\-]/;

      if (!title) {
        errorDiv.innerText = '❌ Job Title is required';
        return false;
      }

      if (forbidden.test(title)) {
        errorDiv.innerText = '❌ Title cannot include emojis or special characters';
        return false;
      }

      errorDiv.innerText = '';
      return true;
    }

    function toggleInput(id) {
      const el = document.getElementById(id);
      el.style.display = (el.style.display === 'none') ? 'block' : 'none';
    }

    CKEDITOR.replace('description');
