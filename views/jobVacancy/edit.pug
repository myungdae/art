extends ../layout

block append_on_header
  script(src="/vendor/ckeditor/ckeditor.js")

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-8
        .card.shadow
          .card-header.bg-light
            h4.mb-0.text-dark Edit Job Vacancy

          .card-body
            form(method="POST", action="/job-vacancies/" + jobVacancy._id + "/edit")

              .form-group.mb-3
                label(for="title") Job Title
                input.form-control#title(type="text", name="title", required, placeholder="Job Title", value=jobVacancy.title, oninput="validateTitle(this)")
                small.text-danger#title-error(style="display:none") ❌ Emojis or special characters are not allowed.

              .form-group.mb-4
                label(for="description") Job Description
                textarea.form-control(name="description", id="description", rows="8")= jobVacancy.description

              .form-group.mb-3
                label(for="country") Host Country
                .input-group
                  select.form-control(name="country", id="country", required)
                    option(disabled value='') Select Country
                    each v in countries
                      option(value=v selected=(v === jobVacancy.country))= v
                  button.btn.btn-outline-secondary(type="button", onclick="addOption('country')") +

              .form-group.mb-3
                label(for="studentType") Student Type
                .input-group
                  select.form-control(name="studentType", id="studentType", required)
                    option(disabled value='') Select Student Type
                    each v in studentTypes
                      option(value=v selected=(v === jobVacancy.studentType))= v
                  button.btn.btn-outline-secondary(type="button", onclick="addOption('studentType')") +

              .form-group.mb-3
                label(for="teachingArea") Teaching Area
                .input-group
                  select.form-control(name="teachingArea", id="teachingArea", required)
                    option(disabled value='') Select Teaching Area
                    each v in teachingAreas
                      option(value=v selected=(v === jobVacancy.teachingArea))= v
                  button.btn.btn-outline-secondary(type="button", onclick="addOption('teachingArea')") +

              .form-group.mb-3
                label(for="duration") Duration
                input.form-control(type="text", name="duration", id="duration", placeholder="Duration", value=jobVacancy.duration)

              .form-group.mb-3
                label(for="pay") Pay
                input.form-control(type="text", name="pay", id="pay", placeholder="Pay", value=jobVacancy.pay)

              .form-group.mb-3
                label(for="housing") Housing
                input.form-control(type="text", name="housing", id="housing", placeholder="Housing", value=jobVacancy.housing)

              .form-group.mb-3
                label(for="email") Email
                input.form-control(type="email", name="email", id="email", placeholder="Email", value=jobVacancy.email)

              .form-group.mb-3
                label(for="companyName") Company Name
                input.form-control(type="text", name="companyName", id="companyName", placeholder="Company Name", value=jobVacancy.companyName)

              .form-group.mb-3
                label(for="jobLocation") Job Location
                input.form-control(type="text", name="jobLocation", id="jobLocation", placeholder="Job Location", value=jobVacancy.jobLocation)

              .form-group.mb-3
                label(for="cellphoneNumber") Cellphone Number
                input.form-control(type="text", name="cellphoneNumber", id="cellphoneNumber", placeholder="Cellphone Number", value=jobVacancy.cellphoneNumber)

              .form-group.mb-3
                label(for="skypeId") Skype ID
                input.form-control(type="text", name="skypeId", id="skypeId", placeholder="Skype ID", value=jobVacancy.skypeId)

              .form-group.mb-3
                label(for="wechatId") WeChat ID
                input.form-control(type="text", name="wechatId", id="wechatId", placeholder="WeChat ID", value=jobVacancy.wechatId)

              .form-group.mb-3
                label(for="homepage") Homepage
                input.form-control(type="text", name="homepage", id="homepage", placeholder="Homepage", value=jobVacancy.homepage)

              .form-group.mb-3
                label(for="datePosted") Date Posted
                input.form-control(type="date", name="datePosted", id="datePosted", value=datePostedFormatted)

              .form-group.mt-5
                h4.text-primary.mb-3 Select a Payment Option
                each opt in ['1', '4', '12', '24']
                  .form-check
                    input.form-check-input(type="radio", name="adPackage", id="ad-" + opt, value=opt, checked=(jobVacancy.adPackage == opt))
                    label.form-check-label(for="ad-" + opt)
                      if opt == '1'
                        | 1 Ad — $30 one-time payment
                      else if opt == '4'
                        | 4 Ads — $100 one-time payment 
                        span.text-danger (save $20)
                      else if opt == '12'
                        | 12 Ads — $250 one-time payment 
                        span.text-danger (save $110)
                      else if opt == '24'
                        | 24 Ads — $450 one-time payment 
                        span.text-danger (save $270)

                .form-check.mt-3
                  input.form-check-input(type="checkbox", name="addResumeAccess", value="yes", id="resumeAccess", checked=jobVacancy.addResumeAccess)
                  label.form-check-label(for="resumeAccess")
                    strong Add 30 days Access to Teacher Resume Database — $50

              button.btn.btn-primary.btn-block.mt-4(type="submit") Update

block append_js
  script.
    CKEDITOR.replace('description');

    function addOption(fieldId) {
      const value = prompt("Enter new option:");
      if (value) {
        const select = document.getElementById(fieldId);
        const option = document.createElement("option");
        option.value = value;
        option.text = value;
        option.selected = true;
        select.add(option);
      }
    }

    function validateTitle(input) {
      const regex = /[\p{Emoji_Presentation}\p{Extended_Pictographic}]/gu;
      const errorElem = document.getElementById('title-error');
      if (regex.test(input.value)) {
        errorElem.style.display = 'block';
        input.classList.add('is-invalid');
      } else {
        errorElem.style.display = 'none';
        input.classList.remove('is-invalid');
      }
    }
