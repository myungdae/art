extends ../layout

block content
  .container.mt-5
    h2.mb-4 Edit Job Vacancy

    form(method="POST", action=`/job-vacancies/${jobVacancy._id}/edit`)
      .form-group.mb-3
        label(for="title") Job Title
        input.form-control(type="text", id="title", name="title", required, value=jobVacancy.title, oninput="validateTitle()")
        small#titleError.text-danger

      .form-group.mb-3
        label(for="description") Description
        textarea.form-control(name="description", id="description")= jobVacancy.description

      .form-group.mb-3
        label(for="country") Country
        input.form-control(type="text", name="country", id="country", value=jobVacancy.country)

      .form-group.mb-3
        label(for="studentType") Student Type
        input.form-control(type="text", name="studentType", id="studentType", value=jobVacancy.studentType)

      .form-group.mb-3
        label(for="teachingArea") Teaching Area
        input.form-control(type="text", name="teachingArea", id="teachingArea", value=jobVacancy.teachingArea)

      .form-group.mb-3
        label(for="duration") Duration
        input.form-control(type="text", name="duration", id="duration", value=jobVacancy.duration)

      .form-group.mb-3
        label(for="pay") Pay
        input.form-control(type="text", name="pay", id="pay", value=jobVacancy.pay)

      .form-group.mb-3
        label(for="housing") Housing
        input.form-control(type="text", name="housing", id="housing", value=jobVacancy.housing)

      .form-group.mb-3
        label(for="email") Email
        input.form-control(type="email", name="email", id="email", value=jobVacancy.email)

      .form-group.mb-3
        label(for="companyName") Company Name
        input.form-control(type="text", name="companyName", id="companyName", value=jobVacancy.companyName)

      .form-group.mb-3
        label(for="jobLocation") Job Location
        input.form-control(type="text", name="jobLocation", id="jobLocation", value=jobVacancy.jobLocation)

      .form-group.mb-3
        label(for="cellphoneNumber") Cellphone Number
        input.form-control(type="text", name="cellphoneNumber", id="cellphoneNumber", value=jobVacancy.cellphoneNumber)

      .form-group.mb-3
        label(for="skypeId") Skype ID
        input.form-control(type="text", name="skypeId", id="skypeId", value=jobVacancy.skypeId)

      .form-group.mb-3
        label(for="wechatId") WeChat ID
        input.form-control(type="text", name="wechatId", id="wechatId", value=jobVacancy.wechatId)

      .form-group.mb-3
        label(for="homepage") Homepage
        input.form-control(type="text", name="homepage", id="homepage", value=jobVacancy.homepage)

      .form-group.mb-3
        label Date Posted
        input.form-control(type="date", name="datePosted", value=datePostedFormatted)

      button.btn.btn-primary(type="submit") Update

  script.
    function validateTitle() {
      const titleInput = document.getElementById('title');
      const errorMsg = document.getElementById('titleError');
      const value = titleInput.value;
      const forbidden = /[^\w\s\-가-힣]/;

      if (!value.trim()) {
        errorMsg.textContent = '❌ Job Title is required';
      } else if (forbidden.test(value)) {
        errorMsg.textContent = '❌ Title cannot include emojis or special characters';
      } else {
        errorMsg.textContent = '';
      }
    }
