extends ../layout

block append_on_header
  script(src="/vendor/ckeditor/ckeditor.js")

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-8
        if !jobVacancy
          .alert.alert-danger Job vacancy data not found.
        else
          .card.shadow
            .card-header.bg-warning.text-white
              h4.mb-0 Edit Job Vacancy

            .card-body
              form(method="POST", action=`/job-vacancies/${jobVacancy._id}/edit`)
                .form-group.mb-3
                  label Job Title (URI)
                  input.form-control(type="text", name="title", value=jobVacancy.title)

                .form-group.mb-4
                  label Job Description
                  textarea.form-control(name="description", id="description", rows="8")= jobVacancy.description

                .form-group.mb-3
                  label Host Country
                  input.form-control(type="text", name="country", value=jobVacancy.country)

                .form-group.mb-3
                  label Student Type
                  input.form-control(type="text", name="studentType", value=jobVacancy.studentType)

                .form-group.mb-3
                  label Teaching Area
                  input.form-control(type="text", name="teachingArea", value=jobVacancy.teachingArea)

                .form-group.mb-3
                  label Duration
                  input.form-control(type="text", name="duration", value=jobVacancy.duration)

                .form-group.mb-3
                  label Pay
                  input.form-control(type="text", name="pay", value=jobVacancy.pay)

                .form-group.mb-3
                  label Housing
                  input.form-control(type="text", name="housing", value=jobVacancy.housing)

                // ✅ 추가 필드들
                .form-group.mb-3
                  label Email
                  input.form-control(type="email", name="email", value=jobVacancy.email)

                .form-group.mb-3
                  label Company Name
                  input.form-control(type="text", name="companyName", value=jobVacancy.companyName)

                .form-group.mb-3
                  label Job Location
                  input.form-control(type="text", name="jobLocation", value=jobVacancy.jobLocation)

                .form-group.mb-3
                  label Cellphone Number
                  input.form-control(type="text", name="cellphoneNumber", value=jobVacancy.cellphoneNumber)

                .form-group.mb-3
                  label Skype ID
                  input.form-control(type="text", name="skypeId", value=jobVacancy.skypeId)

                .form-group.mb-3
                  label WeChat ID
                  input.form-control(type="text", name="wechatId", value=jobVacancy.wechatId)

                .form-group.mb-4
                  label Homepage
                  input.form-control(type="url", name="homepage", value=jobVacancy.homepage)

                button.btn.btn-primary(type="submit") Update

block append_js
  script.
    CKEDITOR.replace('description');
