//- views/joseon-defense/facet.pug — 조선 국방 온톨로지 패싯 탐색 (라이트 테마 v2)
extends ./layout

block content
  style.
    /* ── 페이지 헤더 ─────────────────────────────────────────── */
    .facet-header {
      background: linear-gradient(180deg, #fffdf7 0%, #f5f3ee 100%);
      border-bottom: 1px solid var(--border);
      padding: 32px 24px 24px;
    }
    .facet-header-inner { max-width: 1300px; margin: 0 auto; }
    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 12px; font-weight: 700; color: var(--text-muted);
      text-decoration: none; margin-bottom: 14px; transition: color 0.18s;
    }
    .back-link:hover { color: var(--gold); }
    .page-badge {
      display: inline-flex; align-items: center; gap: 7px;
      background: var(--gold-bg);
      border: 1px solid var(--gold-border);
      border-radius: 50px; padding: 3px 13px;
      font-size: 9px; font-weight: 800; color: var(--gold);
      letter-spacing: 2px; text-transform: uppercase; margin-bottom: 10px;
    }
    .page-title {
      font-size: clamp(1.5rem, 3vw, 2.1rem);
      font-weight: 900; color: var(--text); line-height: 1.2; margin-bottom: 5px;
    }
    .page-count { font-size: 13px; color: var(--text-muted); }
    .page-count strong { color: var(--gold); font-weight: 800; }

    /* ── 클래스 탭 바 ─────────────────────────────────────────── */
    .class-tabs {
      background: #fffdf7;
      border-bottom: 1px solid var(--border);
      overflow-x: auto; scrollbar-width: none;
    }
    .class-tabs::-webkit-scrollbar { display: none; }
    .class-tabs-inner {
      max-width: 1300px; margin: 0 auto;
      display: flex; padding: 0 24px; gap: 0;
    }
    .class-tab {
      padding: 12px 18px;
      font-size: 13px; font-weight: 700;
      color: var(--text-3);
      text-decoration: none; white-space: nowrap;
      border-bottom: 2.5px solid transparent;
      transition: color 0.18s, border-color 0.18s;
      flex-shrink: 0;
    }
    .class-tab:hover { color: var(--gold); }
    .class-tab.active { color: var(--gold); border-bottom-color: var(--gold); }

    /* ── 메인 레이아웃 ────────────────────────────────────────── */
    .facet-layout {
      max-width: 1300px; margin: 0 auto;
      display: grid; grid-template-columns: 252px 1fr;
      gap: 0; padding: 28px 24px 80px;
    }
    @media (max-width: 960px) {
      .facet-layout { grid-template-columns: 1fr; }
      .facet-sidebar { display: none; }
    }

    /* ── 사이드바 ────────────────────────────────────────────── */
    .facet-sidebar {
      padding-right: 22px;
      border-right: 1px solid var(--border);
      position: sticky; top: 78px;
      max-height: calc(100vh - 100px);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--border-dark) transparent;
    }
    .facet-sidebar::-webkit-scrollbar { width: 3px; }
    .facet-sidebar::-webkit-scrollbar-thumb { background: var(--border-dark); border-radius: 2px; }

    /* 패싯 그룹 */
    .filter-group { margin-bottom: 20px; }
    .filter-group-header { display: flex; align-items: center; gap: 7px; margin-bottom: 8px; }
    .filter-title {
      font-size: 10px; font-weight: 800; color: var(--gold);
      text-transform: uppercase; letter-spacing: 2px; flex: 1;
    }
    /* Domain→Range 뱃지 */
    .filter-rel-badge {
      font-size: 9px; font-weight: 700;
      color: var(--gold-light);
      background: var(--gold-bg);
      border: 1px solid var(--gold-border);
      border-radius: 4px; padding: 1px 6px;
      white-space: nowrap;
    }
    .filter-rel-desc {
      font-size: 10px; color: var(--text-muted);
      margin-bottom: 7px; line-height: 1.5; padding-left: 1px;
    }

    /* 서브클래스 칩 */
    .filter-chips { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 2px; }
    .filter-chip {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 4px 11px; border-radius: 50px;
      font-size: 12px; font-weight: 700;
      background: #fff;
      border: 1.5px solid var(--border);
      color: var(--text-2);
      text-decoration: none; transition: all 0.16s;
      box-shadow: var(--shadow-sm);
    }
    .filter-chip:hover {
      background: var(--gold-bg);
      border-color: var(--gold-border);
      color: var(--gold);
    }
    .filter-chip.active {
      background: var(--gold-bg);
      border-color: var(--gold);
      color: var(--gold);
      box-shadow: 0 0 0 2px rgba(139,105,20,0.12);
    }
    .chip-cnt {
      font-size: 10px; font-weight: 800;
      background: rgba(139,105,20,0.1);
      color: var(--gold); border-radius: 50px;
      padding: 0 5px; min-width: 18px; text-align: center;
    }
    .chip-rm { font-size: 11px; opacity: 0.6; margin-left: 1px; }

    /* 목록형 패싯 */
    .filter-list { list-style: none; padding: 0; margin: 0; }
    .filter-list li { margin-bottom: 1px; }
    .filter-list a {
      display: flex; align-items: center; justify-content: space-between;
      padding: 6px 9px; border-radius: 8px;
      font-size: 13px; color: var(--text-2);
      text-decoration: none; transition: all 0.16s; gap: 6px;
    }
    .filter-list a:hover { background: var(--gold-bg); color: var(--gold); }
    .filter-list a.active {
      background: var(--gold-bg);
      color: var(--gold); font-weight: 700;
      border: 1px solid var(--gold-border);
    }
    .filter-list-label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .filter-cnt {
      font-size: 10px; font-weight: 700; flex-shrink: 0;
      background: rgba(139,105,20,0.08);
      border: 1px solid var(--gold-border);
      color: var(--gold); padding: 1px 7px; border-radius: 50px;
    }
    .filter-inverse-icon { font-size: 9px; color: var(--text-muted); flex-shrink: 0; }

    /* 구분선 */
    .filter-divider { border: none; border-top: 1px solid var(--border); margin: 14px 0; }

    /* ── 검색 바 ─────────────────────────────────────────────── */
    .search-bar-wrap { margin: 0 0 18px 0; }
    .search-bar { display: flex; gap: 8px; }
    .search-input {
      flex: 1; background: #fff;
      border: 1.5px solid var(--border); border-radius: 10px;
      padding: 10px 16px; font-size: 14px;
      color: var(--text); outline: none;
      transition: border-color 0.18s, box-shadow 0.18s;
      box-shadow: var(--shadow-sm);
    }
    .search-input::placeholder { color: var(--text-muted); }
    .search-input:focus { border-color: var(--gold-light); box-shadow: 0 0 0 3px rgba(201,162,39,0.12); }
    .search-btn {
      background: var(--gold); color: #fff; border: none;
      border-radius: 10px; padding: 10px 22px;
      font-size: 14px; font-weight: 800;
      cursor: pointer; transition: background 0.18s; flex-shrink: 0;
      box-shadow: var(--shadow-sm);
    }
    .search-btn:hover { background: #6b5010; }

    /* ── 활성 필터 배너 ───────────────────────────────────────── */
    .active-filters-bar {
      display: flex; flex-wrap: wrap; gap: 6px;
      margin-bottom: 16px; align-items: center;
    }
    .active-filters-label {
      font-size: 11px; font-weight: 700; color: var(--text-muted);
    }
    .active-filter-tag {
      display: inline-flex; align-items: center; gap: 5px;
      background: var(--gold-bg);
      border: 1px solid var(--gold-border);
      border-radius: 50px; padding: 4px 11px;
      font-size: 12px; font-weight: 700; color: var(--gold);
      text-decoration: none; transition: all 0.16s;
    }
    .active-filter-tag:hover { background: rgba(139,105,20,0.14); border-color: var(--gold); }
    .active-filter-tag .rm { font-size: 12px; opacity: 0.6; }
    .clear-all-btn {
      font-size: 11px; color: var(--text-muted);
      text-decoration: none; padding: 4px 10px;
      border-radius: 50px; border: 1px solid var(--border);
      transition: all 0.16s;
    }
    .clear-all-btn:hover { color: var(--gold); border-color: var(--gold-border); }

    /* ── 결과 헤더 ───────────────────────────────────────────── */
    .result-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 16px; flex-wrap: wrap; gap: 10px;
    }
    .result-count { font-size: 14px; color: var(--text-3); }
    .result-count strong { color: var(--gold); font-weight: 800; }
    .sort-select {
      background: #fff; border: 1.5px solid var(--border); border-radius: 8px;
      color: var(--text-2); padding: 6px 12px; font-size: 13px;
      cursor: pointer; outline: none; box-shadow: var(--shadow-sm);
      transition: border-color 0.18s;
    }
    .sort-select:focus { border-color: var(--gold-light); }

    /* ── 결과 카드 ───────────────────────────────────────────── */
    .result-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 14px;
    }
    .result-card {
      background: var(--bg-card);
      border: 1.5px solid var(--border);
      border-radius: 14px; padding: 18px;
      text-decoration: none; display: block;
      transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s;
      box-shadow: var(--shadow-sm);
    }
    .result-card:hover {
      border-color: var(--gold);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }
    .rc-type {
      display: flex; align-items: center; gap: 5px;
      font-size: 10px; font-weight: 800; color: var(--gold);
      letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 8px;
    }
    .rc-type-badge {
      background: var(--gold-bg); border: 1px solid var(--gold-border);
      border-radius: 4px; padding: 2px 7px;
      font-size: 10px; font-weight: 800; color: var(--gold);
      letter-spacing: 1px;
    }
    .rc-title {
      font-size: 15px; font-weight: 900; color: var(--text);
      line-height: 1.4; margin-bottom: 7px;
    }
    .rc-meta {
      font-size: 12px; color: var(--text-3); line-height: 1.6; margin-bottom: 3px;
    }
    .rc-rank {
      font-size: 11px; color: var(--gold);
      background: var(--gold-bg); border: 1px solid var(--gold-border);
      border-radius: 4px; padding: 2px 7px; display: inline-block;
      margin-top: 6px; font-weight: 700;
    }
    .rc-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 9px; }
    .rc-tag {
      font-size: 11px; padding: 2px 8px; border-radius: 50px;
      background: #f0ede5; border: 1px solid var(--border);
      color: var(--text-3);
    }
    .rc-year {
      font-size: 11px; color: var(--text-muted); margin-top: 7px;
    }

    /* 빈 결과 */
    .empty-state {
      text-align: center; padding: 80px 24px; color: var(--text-muted);
    }
    .empty-state .ei { font-size: 3rem; margin-bottom: 16px; }
    .empty-state .ei-msg { font-size: 15px; color: var(--text-3); }
    .empty-state a { color: var(--gold); text-decoration: underline; }

    /* ── 결과 영역 패딩 ──────────────────────────────────────── */
    .result-area { padding-left: 26px; min-width: 0; }

  //- ── 페이지 헤더 ──────────────────────────────────────────────
  .facet-header
    .facet-header-inner
      a.back-link(href='/joseon-defense') ← 조선 국방 온톨로지 홈
      .page-badge 🔗 OWL ONTOLOGY
      h1.page-title
        span= classIcon + ' ' + classLabel
      p.page-count
        | 전체 
        strong= allCount
        |  개 중 
        strong= totalCount
        |  개 표시

  //- ── 클래스 탭 바 (TABS 동적 렌더링) ─────────────────────────
  .class-tabs
    .class-tabs-inner
      each tab in tabs
        a.class-tab(
          href=`/joseon-defense/facet/${tab.key}`
          class=(currentClass===tab.key ? 'active' : '')
        )= tab.icon + ' ' + tab.label

  //- ── 메인 레이아웃 ────────────────────────────────────────────
  .facet-layout

    //- ── 사이드바 ──────────────────────────────────────────────
    .facet-sidebar

      - // URL 조합 헬퍼
      - function buildUrl(baseClass, currentFilters, addKey, addVal, removeKey) {
      -   var params = Object.assign({}, currentFilters);
      -   if (removeKey) delete params[removeKey];
      -   if (addKey && addVal) {
      -     if (params[addKey] === addVal) delete params[addKey];
      -     else params[addKey] = addVal;
      -   }
      -   var qs = Object.entries(params).map(function(e){ return e[0]+'='+encodeURIComponent(e[1]); }).join('&');
      -   return '/joseon-defense/facet/' + baseClass + (qs ? '?' + qs : '');
      - }

      if filters && filters.length
        each fg in filters
          .filter-group
            .filter-group-header
              p.filter-title= fg.label
              if fg.relBadge
                span.filter-rel-badge= fg.relBadge
            if fg.relDesc
              p.filter-rel-desc= fg.relDesc

            //- 서브클래스: 칩 스타일
            if fg.key === 'subclass'
              .filter-chips
                each opt in fg.options
                  - var isActive = (selectedFilters && selectedFilters['subclass'] === opt.value)
                  - var chipUrl  = buildUrl(currentClass, selectedFilters, 'subclass', opt.value, null)
                  a.filter-chip(href=chipUrl class=(isActive ? 'active' : ''))
                    span= opt.label
                    span.chip-cnt= opt.count
                    if isActive
                      span.chip-rm ✕

            //- 일반 목록형 패싯
            else
              ul.filter-list
                each opt in fg.options
                  li
                    - var isActive  = (selectedFilters && selectedFilters[fg.key] === opt.value)
                    - var filterUrl = buildUrl(currentClass, selectedFilters, fg.key, opt.value, null)
                    a(href=filterUrl class=(isActive ? 'active' : ''))
                      if fg.isInverse
                        span.filter-inverse-icon(title='역관계') ↩
                      span.filter-list-label= opt.label
                      span.filter-cnt= opt.count

          hr.filter-divider

      else
        p(style='font-size:12px; color:var(--text-muted); padding: 8px 0;') 이 클래스에 대한 패싯 정보가 없습니다.

    //- ── 결과 영역 ──────────────────────────────────────────────
    .result-area

      //- 검색 바
      .search-bar-wrap
        form.search-bar(method='GET' action=`/joseon-defense/facet/${currentClass}`)
          if selectedFilters
            each val, key in selectedFilters
              input(type='hidden' name=key value=val)
          input.search-input(
            type='text' name='q' value=searchQuery
            placeholder=`${classLabel} 검색...`
          )
          button.search-btn(type='submit') 검색

      //- 활성 필터 배너
      - var hasFilters = (selectedFilters && Object.keys(selectedFilters).length > 0) || searchQuery
      if hasFilters
        .active-filters-bar
          span.active-filters-label 필터:
          if searchQuery
            - var noSearchUrl = '/joseon-defense/facet/'+currentClass+(Object.keys(selectedFilters||{}).length ? '?'+Object.entries(selectedFilters||{}).map(function(e){return e[0]+'='+encodeURIComponent(e[1]);}).join('&') : '')
            a.active-filter-tag(href=noSearchUrl)
              span 🔍 #{searchQuery}
              span.rm ✕
          if selectedFilters
            each val, key in selectedFilters
              - var removeUrl = buildUrl(currentClass, selectedFilters, null, null, key)
              - var tagLabel  = val
              - if (filters) { filters.forEach(function(fg){ if(fg.key===key && fg.options){ fg.options.forEach(function(o){ if(o.value===val) tagLabel=o.label; }); } }); }
              a.active-filter-tag(href=removeUrl)
                span= tagLabel
                span.rm ✕
          a.clear-all-btn(href=`/joseon-defense/facet/${currentClass}`) 전체 해제

      //- 결과 헤더 + 정렬
      .result-header
        p.result-count
          strong= totalCount
          |  개의 개체
          if allCount !== totalCount
            |  (전체 #{allCount} 중)
        select.sort-select(
          onchange=`location.href='/joseon-defense/facet/${currentClass}?sort='+this.value+'${Object.keys(selectedFilters||{}).length ? '&'+Object.entries(selectedFilters||{}).map(function(e){return e[0]+'='+encodeURIComponent(e[1]);}).join('&') : ''}${searchQuery ? '&q='+encodeURIComponent(searchQuery) : ''}'`
        )
          option(value='alpha' selected=(sortBy==='alpha'))  이름순
          option(value='year'  selected=(sortBy==='year'))   연도순

      //- 결과 카드 그리드
      if items && items.length
        .result-grid
          each item in items
            a.result-card(href=`/joseon-defense/resource/${item.resourceId}`)
              .rc-type
                span= item.classIcon
                span.rc-type-badge= item.classLabel || currentClass
              p.rc-title= item.label
              if item.description
                p.rc-meta= item.description.length > 85 ? item.description.slice(0,85)+'…' : item.description
              if item.periodLabel
                p.rc-meta= item.periodLabel
              else if item.yearStart || item.yearEnd
                p.rc-year
                  if item.yearStart
                    | #{item.yearStart}
                  if item.yearStart && item.yearEnd
                    |  ~
                  if item.yearEnd
                    |  #{item.yearEnd}
              if item.dynastyEraLabel
                p.rc-meta(style='font-size:11px; color:var(--gold); font-weight:700;') 🕰️ #{item.dynastyEraLabel}
              else if item.centuryLabel
                p.rc-meta(style='font-size:11px; color:var(--gold);') #{item.centuryLabel}
              if item.rankLabel
                span.rc-rank= item.rankLabel
              if item.specNote
                p.rc-meta(style='font-size:11px; color:var(--text-muted)') #{item.specNote.length > 60 ? item.specNote.slice(0,60)+'…' : item.specNote}
              if item.tags && item.tags.length
                .rc-tags
                  each tag in item.tags.slice(0,4)
                    span.rc-tag= tag
      else
        .empty-state
          p.ei= classIcon
          p.ei-msg 해당 클래스의 인스턴스가 없습니다.
          if Object.keys(selectedFilters||{}).length
            p(style='font-size:13px; margin-top:10px')
              a(href=`/joseon-defense/facet/${currentClass}`) 필터를 해제
              |  하면 더 많은 결과를 볼 수 있습니다.
          else
            p(style='font-size:13px; margin-top:8px') TTL 파일에 인스턴스 데이터를 추가하면 여기에 표시됩니다.
