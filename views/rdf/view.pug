extends ../layout

block content
  .container.mt-5
    // ✅ Top Title as Job Title
    if doc.title
      h2.text-center.mb-4.text-success #{doc.title}

    // ✅ Description Section (plaintext only)
    if doc.description
      h4.text-primary.mb-2 Description
      p.mb-4 #{doc.description.replace(/(<([^>]+)>)/gi, '')} // HTML 태그 제거 처리

    // ✅ Inverse Connection Section
    h4.text-primary.mt-4.mb-3 Inverse Connection
    ul.list-group.mb-4
      if doc.country
        li.list-group-item
          strong Country: 
          a.ms-2(href=`/facet/country?filter=country:${doc.country}`)= doc.country
      if doc.studentType
        li.list-group-item
          strong Student Type: 
          a.ms-2(href=`/facet/studentType?filter=studentType:${doc.studentType}`)= doc.studentType
      if doc.teachingArea
        li.list-group-item
          strong Teaching Area: 
          a.ms-2(href=`/facet/teachingArea?filter=teachingArea:${doc.teachingArea}`)= doc.teachingArea

    // ✅ Job Details Section
    h4.text-primary.mb-3 Job Details
    ul.list-group
      if doc.duration
        li.list-group-item
          strong Duration: 
          span.ms-2= doc.duration
      if doc.pay
        li.list-group-item
          strong Pay: 
          span.ms-2 $#{doc.pay}/month
      if doc.housing
        li.list-group-item
          strong Housing: 
          span.ms-2= doc.housing
      if doc.email
        li.list-group-item
          strong Email: 
          span.ms-2= doc.email
      if doc.companyName
        li.list-group-item
          strong Company Name: 
          span.ms-2= doc.companyName
      if doc.jobLocation
        li.list-group-item
          strong Job Location: 
          span.ms-2= doc.jobLocation
      if doc._id
        li.list-group-item
          strong Internal ID: 
          span.ms-2= doc._id
