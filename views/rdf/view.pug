extends ../layout

block content
  .container.mt-5
    if notFound
      h2.text-danger Resource not found
    else
      .card.shadow
        .card-header.bg-primary.text-white.text-center
          h3.mb-0= label

        .card-body
          if description
            .mb-4
              h5.text-secondary Description
              .border.p-2.bg-light
                != description

          // ✅ Country & Target Info
          - const coreKeys = ['country', 'studentType', 'teachingArea'];
          .mb-4
            h5.text-secondary Country & Target Info
            ul.list-group
              each key in coreKeys
                if doc[key]
                  li.list-group-item
                    b= key + ': '
                    a(href=`/facet/${key}/${encodeURIComponent(doc[key])}`)= doc[key]

          // ✅ Job Details
          - const ignoreKeys = ['@id', 'rdfs:label', 'http://purl[dot]org/dc/elements/1[dot]1/description', ...coreKeys];
          .mb-4
            h5.text-secondary Job Details
            ul.list-group
              each val, key in doc
                if !ignoreKeys.includes(key) && val
                  li.list-group-item
                    b= key.replace('res:', '') + ': '
                    | #{val}
