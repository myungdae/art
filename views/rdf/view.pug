extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-4 RDF Resource Detail

    if triples && triples.length
      each t in triples
        .mb-4.p-3.border.rounded
          p.mb-1.text-muted Subject:
          code.d-block.mb-2= t.subject

          p.mb-1.text-muted Predicate:
          code.d-block.mb-2= t.predicate

          p.mb-1.text-muted Object:
          code.d-block= t.object
    else
      .alert.alert-danger.mt-4 No RDF triples found.
