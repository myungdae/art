extends ../layout

block content
  .container.mt-5
    if doc
      h1.text-center.mb-4= doc['title'] || 'Untitled'

      if doc['http://purl.org/dc/elements/1.1/description']
        .mb-4
          h5 Description</h5>
          .card.p-3
            .desc-content !{doc['http://purl.org/dc/elements/1.1/description'].toString()}

      ul.list-group.mb-4
        if doc['country']
          li.list-group-item
            strong Country:
            a.ms-2(href='/facet/country/' + encodeURIComponent(doc['country']))= doc['country']

        if doc['studentType']
          li.list-group-item
            strong Student Type:
            a.ms-2(href='/facet/studentType/' + encodeURIComponent(doc['studentType']))= doc['studentType']

        if doc['teachingArea']
          li.list-group-item
            strong Teaching Area:
            a.ms-2(href='/facet/teachingArea/' + encodeURIComponent(doc['teachingArea']))= doc['teachingArea']

      a.btn.btn-outline-primary.mt-4(href='/facet/Job_Vacancies') ← Back to List

    else
      .alert.alert-danger.mt-5 ❌ No RDF document found.
