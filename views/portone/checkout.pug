extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-8
        .card.shadow-lg(style="border: 2px solid #4CAF50;")
          .card-header.text-center(style="background-color: #4CAF50; color: white;")
            h2
              i.fas.fa-briefcase.me-2
              | Purchase Job Vacancy Ads
          
          .card-body.p-4
            p.lead.text-center.mb-4
              | Select a package to post your job vacancies
            
            .row.g-3
              each pkg in packages
                .col-md-6
                  .card.h-100.package-card(
                    data-package=pkg.value
                    data-price=pkg.price
                    style="cursor: pointer; border: 2px solid #ddd; transition: all 0.3s;"
                  )
                    .card-body.text-center
                      h4.card-title= pkg.label
                      h3.text-primary.my-3
                        | $#{pkg.price}
                      if pkg.discount
                        p.text-success.mb-0
                          small
                            i.fas.fa-tag.me-1
                            | Save $#{pkg.discount}
                      
                      button.btn.btn-lg.mt-3(
                        type="button"
                        onclick=`openPortoneCheckout('${pkg.value}', ${pkg.price})`
                        style="background-color: #4CAF50; border-color: #4CAF50; color: white; width: 100%;"
                      )
                        i.fas.fa-shopping-cart.me-2
                        | Select
            
            hr.my-4
            
            .text-center
              p.text-muted
                i.fas.fa-lock.me-1
                | Secure payment powered by PortOne (Eximbay)
              p.mb-0
                a.btn.btn-outline-secondary(href="/user/mypage")
                  i.fas.fa-arrow-left.me-2
                  | Back to My Page

  //- PortOne SDK Script (V1 for legacy channel)
  script(src="https://cdn.iamport.kr/v1/iamport.js")
  
  script.
    // IMP (PortOne V1) 초기화
    const IMP = window.IMP;
    IMP.init('#{storeId}');

    function openPortoneCheckout(packageId, price) {
      try {
        // 고유 주문번호 생성 (사용자 정보 포함)
        const userId = '#{user._id}';
        const merchantUid = 'employer_' + packageId + '_' + userId.substring(0, 8) + '_' + new Date().getTime();
        
        console.log('🔍 V1 Payment request:', {
          pg: 'eximbay.#{channelKey}',
          pay_method: 'card',
          merchant_uid: merchantUid,
          name: 'Job Ad Package - ' + packageId + ' ads',
          amount: price,
          buyer_email: '#{user.email}',
          buyer_name: '#{user.name || user.email}'
        });
        
        // PortOne V1 결제 요청
        IMP.request_pay({
          pg: 'eximbay',
          pay_method: 'card',
          merchant_uid: merchantUid,
          name: 'Job Ad Package - ' + packageId + ' ads',
          amount: price,
          buyer_email: '#{user.email}',
          buyer_name: '#{user.name || user.email}',
          buyer_tel: '#{user.phone || "010-0000-0000"}'
        }, function(response) {
          console.log('🔍 V1 Payment response:', response);

          
          if (response.success) {
            // 결제 성공 - 서버 검증
            fetch('/portone/verify', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                imp_uid: response.imp_uid,
                merchant_uid: response.merchant_uid
              })
            })
            .then(res => res.json())
            .then(verifyResult => {
              if (verifyResult.success) {
                window.location.href = '/portone/success?type=employer';
              } else {
                alert('Payment verification failed: ' + verifyResult.message);
              }
            });
          } else {
            // 결제 실패
            alert('Payment failed: ' + response.error_msg);
          }
        });
      } catch (error) {
        console.error('Payment error:', error);
        alert('Payment error occurred: ' + error.message);
      }
    }

    // 카드 hover 효과
    document.querySelectorAll('.package-card').forEach(card => {
      card.addEventListener('mouseenter', function() {
        this.style.borderColor = '#4CAF50';
        this.style.transform = 'translateY(-5px)';
        this.style.boxShadow = '0 10px 20px rgba(76, 175, 80, 0.2)';
      });
      card.addEventListener('mouseleave', function() {
        this.style.borderColor = '#ddd';
        this.style.transform = 'translateY(0)';
        this.style.boxShadow = 'none';
      });
    });
