extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-8
        .card.shadow-lg(style="border: 2px solid #4CAF50;")
          .card-header.text-center(style="background-color: #4CAF50; color: white;")
            h2
              i.fas.fa-briefcase.me-2
              | Purchase Job Vacancy Ads
          
          .card-body.p-4
            p.lead.text-center.mb-4
              | Select a package to post your job vacancies
            
            .row.g-3
              each pkg in packages
                .col-md-6
                  .card.h-100.package-card(
                    data-package=pkg.value
                    data-price=pkg.price
                    style="cursor: pointer; border: 2px solid #ddd; transition: all 0.3s;"
                  )
                    .card-body.text-center
                      h4.card-title= pkg.label
                      h3.text-primary.my-3
                        | $#{pkg.price}
                      if pkg.discount
                        p.text-success.mb-0
                          small
                            i.fas.fa-tag.me-1
                            | Save $#{pkg.discount}
                      
                      button.btn.btn-lg.mt-3(
                        type="button"
                        onclick=`openPortoneCheckout('${pkg.value}', ${pkg.price})`
                        style="background-color: #4CAF50; border-color: #4CAF50; color: white; width: 100%;"
                      )
                        i.fas.fa-shopping-cart.me-2
                        | Select
            
            hr.my-4
            
            //- PayPal 버튼 렌더링 영역
            #payment-section.mt-4(style="display: none;")
              .card.border-primary
                .card-body
                  h5.card-title.text-center.mb-3 Complete Your Payment
                  p.text-center.text-muted#selected-package-info
                  .portone-ui-container#paypal-button-container
                  .text-center.mt-3
                    button.btn.btn-outline-secondary(onclick="cancelPayment()")
                      i.fas.fa-times.me-2
                      | Cancel
            
            .text-center
              p.text-muted
                i.fas.fa-lock.me-1
                | Secure payment powered by PortOne & PayPal
              p.mb-0
                a.btn.btn-outline-secondary(href="/user/mypage")
                  i.fas.fa-arrow-left.me-2
                  | Back to My Page

  //- PortOne SDK Script (V2)
  script(src="https://cdn.portone.io/v2/browser-sdk.js")
  
  script.
    let currentPaymentUI = null;
    let selectedPackage = null;
    let selectedPrice = null;

    // PortOne SDK 초기화 대기
    function waitForPortOne(callback) {
      if (typeof PortOne !== 'undefined') {
        callback();
      } else {
        setTimeout(() => waitForPortOne(callback), 100);
      }
    }

    function openPortoneCheckout(packageId, price) {
      selectedPackage = packageId;
      selectedPrice = price;
      
      // 패키지 정보 표시
      document.getElementById('selected-package-info').textContent = 
        `Package: ${packageId} job ads - $${price} USD`;
      
      // 패키지 선택 영역 숨기고 결제 영역 표시
      document.querySelector('.row.g-3').style.display = 'none';
      document.getElementById('payment-section').style.display = 'block';
      
      waitForPortOne(async () => {
        try {
          const userId = '#{user._id}';
          const merchantUid = 'employer_' + packageId + '_' + userId.substring(0, 8) + '_' + new Date().getTime();
          
          // Customer 정보 준비
          const customerData = {
            fullName: '#{user.name || user.email}',
            email: '#{user.email}'
          };
          
          const userPhone = '#{user.phone || ""}';
          if (userPhone) {
            customerData.phoneNumber = userPhone;
          }
          
          console.log('🔍 PayPal Payment UI request:', {
            uiType: 'PAYPAL_SPB',
            storeId: '#{storeId}',
            channelKey: '#{channelKey}',
            paymentId: merchantUid,
            orderName: 'Job Ad Package - ' + packageId + ' ads',
            totalAmount: price,
            currency: 'USD'
          });
          
          // PayPal 버튼 렌더링 (V2 SDK - loadPaymentUI)
          const requestData = {
            uiType: 'PAYPAL_SPB',
            storeId: '#{storeId}',
            channelKey: '#{channelKey}',
            paymentId: merchantUid,
            orderName: 'Job Ad Package - ' + packageId + ' ads',
            totalAmount: price,
            currency: 'USD',
            customer: customerData
          };
          
          currentPaymentUI = await PortOne.loadPaymentUI(
            requestData,
            {
              onPaymentSuccess: async (response) => {
                console.log('Payment success:', response);
                
                // 서버 검증
                try {
                  const verification = await fetch('/portone/verify', {
                    method: 'POST',
                    headers: {
                      'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                      imp_uid: response.paymentId,
                      merchant_uid: merchantUid
                    })
                  });

                  const verifyResult = await verification.json();
                  
                  if (verifyResult.success) {
                    window.location.href = '/portone/success?type=employer';
                  } else {
                    alert('Payment verification failed: ' + verifyResult.message);
                  }
                } catch (error) {
                  console.error('Verification error:', error);
                  alert('Payment verification error: ' + error.message);
                }
              },
              onPaymentFail: (error) => {
                console.error('Payment failed:', error);
                alert('Payment failed: ' + (error.message || 'Unknown error'));
                cancelPayment();
              }
            }
          );
          
        } catch (error) {
          console.error('Payment UI error:', error);
          alert('Payment initialization error: ' + error.message);
          cancelPayment();
        }
      });
    }
    
    function cancelPayment() {
      document.querySelector('.row.g-3').style.display = 'flex';
      document.getElementById('payment-section').style.display = 'none';
      selectedPackage = null;
      selectedPrice = null;
    }

    // 카드 hover 효과
    document.querySelectorAll('.package-card').forEach(card => {
      card.addEventListener('mouseenter', function() {
        this.style.borderColor = '#4CAF50';
        this.style.transform = 'translateY(-5px)';
        this.style.boxShadow = '0 10px 20px rgba(76, 175, 80, 0.2)';
      });
      card.addEventListener('mouseleave', function() {
        this.style.borderColor = '#ddd';
        this.style.transform = 'translateY(0)';
        this.style.boxShadow = 'none';
      });
    });
