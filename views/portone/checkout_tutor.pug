extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-6
        .card.shadow-lg(style="border: 2px solid #4CAF50;")
          .card-header.text-center(style="background-color: #4CAF50; color: white;")
            h2
              i.fas.fa-chalkboard-teacher.me-2
              | Purchase Tutor Listing Visibility
          
          .card-body.p-4
            .text-center.mb-4
              h3= label
              h2.text-primary.my-3
                | $#{price}
              p.text-muted
                | #{days} days of visibility
            
            hr.my-4
            
            .alert.alert-info
              i.fas.fa-info-circle.me-2
              | Your tutor profile will be visible to students for #{days} days.
            
            .list-group.mb-4
              .list-group-item
                i.fas.fa-check-circle.text-success.me-2
                | Profile visible in search results
              .list-group-item
                i.fas.fa-check-circle.text-success.me-2
                | Direct contact from students
              .list-group-item
                i.fas.fa-check-circle.text-success.me-2
                | Featured in tutor listings
              .list-group-item
                i.fas.fa-check-circle.text-success.me-2
                | #{days} days of active visibility
            
            //- Payment Method Selection
            #payment-method-selection(style="display: none;")
              .card.border-primary.mb-3
                .card-body
                  h5.card-title.text-center.mb-4 Select Payment Method
                  
                  .row.g-3.mb-3
                    .col-md-6
                      .card.payment-method-card(
                        onclick="selectPaymentMethod('toss')"
                        style="cursor: pointer; border: 2px solid #0064FF; transition: all 0.3s;"
                      )
                        .card-body.text-center.py-4
                          i.fas.fa-credit-card.fa-3x.mb-3(style="color: #0064FF;")
                          h5 Domestic Payment
                          p.text-muted.mb-0.small Card / Bank Transfer / Virtual Account
                          p.text-muted.mb-0.small Toss Payments
                    
                    .col-md-6
                      .card.payment-method-card(
                        onclick="selectPaymentMethod('paypal')"
                        style="cursor: pointer; border: 2px solid #0070BA; transition: all 0.3s;"
                      )
                        .card-body.text-center.py-4
                          i.fab.fa-paypal.fa-3x.mb-3(style="color: #0070BA;")
                          h5 International Payment
                          p.text-muted.mb-0.small Credit/Debit Card
                          p.text-muted.mb-0.small PayPal
                  
                  .text-center
                    button.btn.btn-outline-secondary(onclick="cancelPaymentMethodSelection()")
                      i.fas.fa-times.me-2
                      | Cancel
            
            //- Payment UI Section
            #payment-section(style="display: none;")
              .card.border-primary.mb-3
                .card-body
                  h5.card-title.text-center.mb-3 Complete Your Payment
                  .portone-ui-container#payment-button-container
                  .text-center.mt-3
                    button.btn.btn-outline-secondary(onclick="cancelPayment()")
                      i.fas.fa-times.me-2
                      | Back
            
            .d-grid.gap-2#action-buttons
              button.btn.btn-lg(
                type="button"
                onclick=`openPortoneCheckout(${days}, ${price})`
                style="background-color: #4CAF50; border-color: #4CAF50; color: white; font-size: 1.25rem; padding: 15px;"
              )
                i.fas.fa-shopping-cart.me-2
                | Purchase Now - $#{price}
              
              a.btn.btn-outline-secondary(href="/user/mypage-tutor")
                i.fas.fa-arrow-left.me-2
                | Back to My Page
            
            hr.my-4
            
            .text-center
              p.text-muted.mb-0
                i.fas.fa-lock.me-1
                | Secure payment powered by PortOne
              p.text-muted.small.mb-0
                | 🌍 International: PayPal | 🇰🇷 Korea: Toss Payments

  //- PortOne SDK Script
  script(src="https://cdn.portone.io/v2/browser-sdk.js")
  
  script.
    let currentPaymentUI = null;
    let selectedDays = null;
    let selectedPrice = null;
    let selectedPaymentMethod = null;

    // Wait for PortOne SDK initialization
    function waitForPortOne(callback) {
      if (typeof PortOne !== 'undefined') {
        callback();
      } else {
        setTimeout(() => waitForPortOne(callback), 100);
      }
    }

    function openPortoneCheckout(days, price) {
      selectedDays = days;
      selectedPrice = price;
      
      // Hide button section and show payment method selection
      document.getElementById('action-buttons').style.display = 'none';
      document.getElementById('payment-method-selection').style.display = 'block';
    }
    
    function cancelPaymentMethodSelection() {
      document.getElementById('action-buttons').style.display = 'grid';
      document.getElementById('payment-method-selection').style.display = 'none';
      selectedDays = null;
      selectedPrice = null;
    }
    
    function selectPaymentMethod(method) {
      selectedPaymentMethod = method;
      
      // Hide payment method selection and show payment UI
      document.getElementById('payment-method-selection').style.display = 'none';
      document.getElementById('payment-section').style.display = 'block';
      
      // Load UI based on selected payment method
      if (method === 'paypal') {
        loadPayPalUI();
      } else if (method === 'toss') {
        loadTossPaymentsUI();
      }
    }
    
    function loadPayPalUI() {
      
      waitForPortOne(async () => {
        try {
          const userId = '#{user._id}';
          const merchantUid = 'tutor_' + selectedDays + 'd_' + userId.substring(0, 8) + '_' + new Date().getTime();
          
          // Prepare customer data
          const customerData = {
            fullName: '#{user.name || user.email}',
            email: '#{user.email}'
          };
          
          const userPhone = '#{user.phone || ""}';
          if (userPhone) {
            customerData.phoneNumber = userPhone;
          }
          
          console.log('🔍 PayPal Payment UI request:', {
            uiType: 'PAYPAL_SPB',
            storeId: '#{storeId}',
            channelKey: '#{paypalChannelKey}',
            paymentId: merchantUid,
            orderName: 'Tutor Listing Visibility - ' + selectedDays + ' days',
            totalAmount: selectedPrice,
            currency: 'USD'
          });
          
          // Render PayPal button
          const requestData = {
            uiType: 'PAYPAL_SPB',
            storeId: '#{storeId}',
            channelKey: '#{paypalChannelKey}',
            paymentId: merchantUid,
            orderName: 'Tutor Listing Visibility - ' + selectedDays + ' days',
            totalAmount: selectedPrice,
            currency: 'USD',
            customer: customerData
          };
          
          currentPaymentUI = await PortOne.loadPaymentUI(
            requestData,
            {
              onPaymentSuccess: async (response) => {
                console.log('Payment success:', response);
                
                try {
                  const verification = await fetch('/portone/verify', {
                    method: 'POST',
                    headers: {
                      'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                      imp_uid: response.paymentId,
                      merchant_uid: merchantUid
                    })
                  });

                  const verifyResult = await verification.json();
                  
                  if (verifyResult.success) {
                    window.location.href = '/portone/success?type=tutor';
                  } else {
                    alert('Payment verification failed: ' + verifyResult.message);
                  }
                } catch (error) {
                  console.error('Verification error:', error);
                  alert('Payment verification error: ' + error.message);
                }
              },
              onPaymentFail: (error) => {
                console.error('Payment failed:', error);
                alert('Payment failed: ' + (error.message || 'Unknown error'));
                cancelPayment();
              }
            }
          );
          
        } catch (error) {
          console.error('Payment UI error:', error);
          alert('Payment initialization error: ' + error.message);
          cancelPayment();
        }
      });
    }
    
    function loadTossPaymentsUI() {
      waitForPortOne(async () => {
        try {
          const userId = '#{user._id}';
          const merchantUid = 'tutor_' + selectedDays + 'd_' + userId.substring(0, 8) + '_' + new Date().getTime();
          
          // Prepare customer data
          const customerData = {
            fullName: '#{user.name || user.email}',
            email: '#{user.email}'
          };
          
          const userPhone = '#{user.phone || ""}';
          if (userPhone) {
            customerData.phoneNumber = userPhone;
          }
          
          // Detect mobile device
          const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
          
          console.log('🔍 Toss Payments request:', {
            storeId: '#{storeId}',
            channelKey: '#{tossChannelKey}',
            paymentId: merchantUid,
            orderName: 'Tutor Listing Visibility - ' + selectedDays + ' days',
            totalAmount: selectedPrice,
            currency: 'KRW',
            isMobile: isMobile
          });
          
          // Toss Payments checkout
          // Note: Do not specify payMethod or windowType - PortOne handles them automatically
          const response = await PortOne.requestPayment({
            storeId: '#{storeId}',
            channelKey: '#{tossChannelKey}',
            paymentId: merchantUid,
            orderName: 'Tutor Listing Visibility - ' + selectedDays + ' days',
            totalAmount: selectedPrice * 1300,
            currency: 'KRW',
            customer: customerData,
            redirectUrl: window.location.origin + '/portone/success?type=tutor'
          });
          
          if (response.code != null) {
            console.error('Payment failed:', response);
            alert('Payment failed: ' + response.message);
            cancelPayment();
            return;
          }
          
          // Payment success - server verification
          try {
            const verification = await fetch('/portone/verify', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                imp_uid: response.paymentId,
                merchant_uid: merchantUid
              })
            });

            const verifyResult = await verification.json();
            
            if (verifyResult.success) {
              window.location.href = '/portone/success?type=tutor';
            } else {
              alert('Payment verification failed: ' + verifyResult.message);
            }
          } catch (error) {
            console.error('Verification error:', error);
            alert('Payment verification error: ' + error.message);
          }
          
        } catch (error) {
          console.error('Payment error:', error);
          alert('Payment initialization error: ' + error.message);
          cancelPayment();
        }
      });
    }
    
    function cancelPayment() {
      // Hide payment UI and return to payment method selection
      document.getElementById('payment-section').style.display = 'none';
      document.getElementById('payment-method-selection').style.display = 'block';
      selectedPaymentMethod = null;
      
      // Clear container
      const container = document.getElementById('payment-button-container');
      if (container) {
        container.innerHTML = '';
      }
    }
    
    // Payment method card hover effects
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.payment-method-card').forEach(card => {
        card.addEventListener('mouseenter', function() {
          this.style.transform = 'translateY(-5px)';
          this.style.boxShadow = '0 10px 20px rgba(0, 0, 0, 0.1)';
        });
        card.addEventListener('mouseleave', function() {
          this.style.transform = 'translateY(0)';
          this.style.boxShadow = 'none';
        });
      });
    });
