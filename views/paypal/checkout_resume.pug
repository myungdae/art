//- views/paypal/checkout_resume.pug
extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-4 Purchase Resume Visibility

    if preselectDays
      .alert.alert-info.text-center
        | Preselected: #{preselectDays} days

    p.mb-3 Select a plan:

    form#resumeForm
      .list-group.mb-3
        each pkg in packages
          label.list-group-item.list-group-item-action
            input.form-check-input.me-2(type="radio", name="planId", value=pkg.value checked=(String(preselectDays||'')===String(pkg.days||pkg.value)))
            | #{pkg.label} — $#{pkg.price}

      // PayPal 버튼 표시 영역
      #paypal-buttons

  // ✅ PayPal SDK: 서버에서 넘긴 client id 사용
  script(src=`https://www.paypal.com/sdk/js?client-id=${paypalClientId}&currency=USD&intent=capture&commit=true&components=buttons`)
  script.
    (function() {
      const form = document.getElementById('resumeForm');

      function getSelectedPlanId() {
        const el = form.querySelector('input[name="planId"]:checked');
        return el ? el.value : null;
      }

      paypal.Buttons({
        style: { layout: 'vertical', shape: 'rect' },

        // 주문 생성: 서버에 planId 전달
        createOrder: async function(data, actions) {
          const planId = getSelectedPlanId();
          if (!planId) {
            alert('Please select a plan.');
            throw new Error('No plan selected');
          }
          const res = await fetch('/paypal/create-order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ planId })
          });
          const json = await res.json();
          if (!json.id) {
            const msg = json.error || 'Failed to create order';
            alert(msg);
            throw new Error(msg);
          }
          return json.id; // PayPal SDK가 결제창을 엽니다
        },

        // 승인 시: 서버에서 캡처 실행
        onApprove: async function(data, actions) {
          const orderID = data.orderID;
          const res = await fetch(`/paypal/capture-order/${orderID}`, {
            method: 'POST'
          });
          const json = await res.json();

          if (json.status === 'redirect' && json.url) {
            window.location.href = json.url; // ex) /user/mypage-jobseeker
            return;
          }

          // 폴백
          alert('Payment captured. Redirecting to My Page...');
          window.location.href = '/user/mypage-jobseeker';
        },

        onError: function(err) {
          console.error('PayPal error:', err);
          alert('PayPal error occurred. Please try again.');
        }
      }).render('#paypal-buttons');
    })();
