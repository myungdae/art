extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-6
        .card.shadow
          .card-header.text-center(style="background-color: #f8f9fa;")
            h3(style="color: black; font-weight: bold;") Select an Ad Package

          .card-body(style="background-color: white; color: black; font-size: 16px;")
            form#paymentForm
              .form-group.mb-4
                each pkg in packages
                  .form-check
                    input.form-check-input(
                      type="radio",
                      name="adPackage",
                      id=`pkg-${pkg.value}`,
                      value=pkg.value,
                      checked=pkg.value === '1',
                      onchange="setPackage(this.value)"
                    )
                    label.form-check-label(for=`pkg-${pkg.value}`)= pkg.label

              #paypal-button-container.mt-4

            .text-center.mt-3
              a.btn.btn-outline-secondary(href="/user/mypage") Back to My Page

  // ✅ PayPal SDK
  script(src="https://www.paypal.com/sdk/js?client-id=YOUR_CLIENT_ID&currency=USD")

  // ✅ PayPal Button Logic
  script.
    let selectedPackage = '1';
    function setPackage(value) {
      selectedPackage = value;
    }

    paypal.Buttons({
      createOrder: function (data, actions) {
        return fetch('/paypal/create-order', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ package: selectedPackage })
        })
        .then(res => res.json())
        .then(order => order.id);
      },
      onApprove: function (data, actions) {
        return fetch(`/paypal/capture-order/${data.orderID}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ package: selectedPackage })
        })
        .then(res => res.json())
        .then(details => {
          alert('✅ Payment successful!');
          window.location.href = '/user/mypage';
        });
      },
      onError: function (err) {
        console.error('❌ Payment error:', err);
        alert('❌ Payment failed. Please try again.');
      }
    }).render('#paypal-button-container');
