extends ../layout

block content
  - const packages = [{ value: '1', label: '1 Ad — $30' }, { value: '4', label: '4 Ads — $100 (Save $20)' }, { value: '12', label: '12 Ads — $250 (Save $110)' }, { value: '24', label: '24 Ads — $450 (Save $270)' }]

  .container.mt-5
    .row.justify-content-center
      .col-md-8.col-lg-6
        .card.shadow-lg.rounded
          .card-header.text-center(style="background-color: #f15a29;")
            h3.text-white.mb-0(style="font-weight: bold; font-size: 1.6rem") Buy Job Vacancy Ads

          .card-body.px-4.py-4(style="background-color: white; color: black; font-size: 16px;")
            h4.text-center.mb-4 Welcome, #{user.username}!

            form#paymentForm
              .form-group.mb-4.pl-4
                each pkg in packages
                  .form-check.d-flex.align-items-center.justify-content-start.mb-2(style="padding-left: 1.5rem;")
                    input.form-check-input.mt-0.mr-2(
                      type="radio",
                      name="adPackage",
                      id=`pkg-${pkg.value}`,
                      value=pkg.value,
                      checked=pkg.value === '1',
                      onchange="setPackage(this.value)"
                    )
                    label.form-check-label(for=`pkg-${pkg.value}` style="font-size: 1rem;")= pkg.label

              #paypal-button-container.mt-4

            .text-center.mt-4
              a.btn.btn-outline-secondary.btn-lg(href="/user/mypage") Back to My Page

  // ✅ Load PayPal SDK
  script(src="https://www.paypal.com/sdk/js?client-id=AdCfY_Fv91WJinsDArKeBbdCpOMCO4SK7D-0ZjmbngMFffGJHJRyQIlSg7Av8cLPfh7jCRmeqyJyDIut&currency=USD")

  // ✅ PayPal Logic
  script.
    let selectedPackage = '1';

    function setPackage(value) {
      selectedPackage = value;
    }

    paypal.Buttons({
      createOrder: function (data, actions) {
        return fetch('/paypal/create-order', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ package: selectedPackage })
        })
        .then(res => res.json())
        .then(order => order.id);
      },
      onApprove: function (data, actions) {
        return fetch(`/paypal/capture-order/${data.orderID}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ package: selectedPackage })
        })
        .then(res => res.json())
        .then(details => {
          alert('✅ Payment successful!');
          window.location.href = '/job-vacancies/new_paid_user';
        });
      },
      onError: function (err) {
        console.error('❌ Payment error:', err);
        alert('❌ Payment failed. Please try again.');
      }
    }).render('#paypal-button-container');
