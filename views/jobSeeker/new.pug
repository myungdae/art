//- views/jobSeeker/new.pug
extends ../layout

// 템플릿 기본 프리셋 (서버 미전달 시 사용)
- const _defNat  = ['Korean','Japanese','Chinese','Malaysian','Thai','American','British'];
- const _defLoc  = ['Korea','Japan','China','Malaysia','Thailand','Remote'];
- const _defMaj  = ['English','ESL','Education','Art','Biology','Social Studies','Spanish'];
- const _defLang = ['English','Korean','Japanese','Chinese','Spanish','French','German'];

- const _nationalities = (typeof nationalities !== 'undefined' && nationalities && nationalities.length) ? nationalities : _defNat;
- const _prefLocs      = (typeof preferredWorkLocations !== 'undefined' && preferredWorkLocations && preferredWorkLocations.length) ? preferredWorkLocations : _defLoc;
- const _majors        = (typeof majors !== 'undefined' && majors && majors.length) ? majors : _defMaj;
- const _languages     = (typeof languages !== 'undefined' && languages && languages.length) ? languages : _defLang;

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-10
        .card.shadow
          .card-header.bg-primary.text-white.text-center
            h4.mb-0 New Job Seeker

          .card-body
            if errors && errors.email
              .alert.alert-danger #{errors.email}

            form(method="POST", action="/job-seekers", onsubmit="return handleCustomFields()")
              // ===== Job Title (semantic: rdfs:label) =====
              .form-group.mb-3
                label(for="jsTitle") Job Title
                input.form-control#jsTitle(
                  type="text",
                  name="rdfs:label[@value]",
                  placeholder="e.g., ESL Teacher, Homeroom Teacher",
                  value=values && values['rdfs:label[@value]'] || ""
                )

              // ===== Description (CKEditor, semantic: dc:description) =====
              .form-group.mb-4
                label(for="description") Description
                textarea.form-control(
                  name="http://purl.org/dc/elements/1.1/description[@value]",
                  id="description",
                  rows="8"
                ) #{values && values['http://purl.org/dc/elements/1.1/description[@value]'] || ''}

              // ===== Email =====
              .form-group.mb-3
                label(for="email") Email *
                input.form-control#email(type="email", name="email", required, placeholder="email@example.com", value=values && values.email || "")

              // ===== Languages =====
              .form-group.mb-3
                label(for="languageSpoken") Languages Spoken (comma-separated or pick)
                .d-flex.gap-2.flex-wrap.mb-2
                  each lang in _languages
                    .form-check.form-check-inline.me-3
                      input.form-check-input(type="checkbox", id=`lang-${lang}`, value=lang, onchange="toggleLang(this)")
                      label.form-check-label(for=`lang-${lang}`)= lang
                input.form-control#languageSpoken(type="text", name="languageSpoken", placeholder="e.g., English, Korean", value=values && values.languageSpoken || "")

              // ===== Date Available =====
              .form-group.mb-3
                label(for="dateAvailable") Date Available
                input.form-control#dateAvailable(type="date", name="dateAvailable", value=values && values.dateAvailable || "")

              // ===== Semantic: Nationality / Preferred Work Location / Major =====
              .form-group.mb-3
                label(for="nationality") Nationality (semantic)
                select.form-control#nationalitySelect(name="http://schema.org/nationality[@value]")
                  option(disabled selected value="") Select Nationality
                  each v in _nationalities
                    option(value=v selected=(values && values['http://schema.org/nationality[@value]'] === v))= v
                small.text-muted.mt-1 You can also add a new nationality:
                input.form-control.mt-1(type="text", id="customNationality", placeholder="Or enter a new Nationality")

              .form-group.mb-3
                label(for="preferredWorkLocation") Preferred Work Location (semantic)
                select.form-control#prefLocSelect(name="esl:preferredWorkLocation[@value]")
                  option(disabled selected value="") Select Preferred Work Location
                  each v in _prefLocs
                    option(value=v selected=(values && values['esl:preferredWorkLocation[@value]'] === v))= v
                small.text-muted.mt-1 You can also add a new location:
                input.form-control.mt-1(type="text", id="customPrefLoc", placeholder="Or enter a new Location")

              .form-group.mb-3
                label(for="major") Major (semantic)
                select.form-control#majorSelect(name="esl:major[@value]")
                  option(disabled selected value="") Select Major
                  each v in _majors
                    option(value=v selected=(values && values['esl:major[@value]'] === v))= v
                small.text-muted.mt-1 You can also add a new major:
                input.form-control.mt-1(type="text", id="customMajor", placeholder="Or enter a new Major")

              button.btn.btn-primary.btn-block.mt-3(type="submit") Save

block append_js
  // CKEditor 5
  script(src="https://cdn.ckeditor.com/ckeditor5/41.0.0/classic/ckeditor.js")
  script.
    // CKEditor init
    ClassicEditor.create(document.querySelector('#description')).catch(console.error);

    function toggleLang(cb){
      const input = document.getElementById('languageSpoken');
      const current = input.value ? input.value.split(',').map(s=>s.trim()).filter(Boolean) : [];
      const idx = current.indexOf(cb.value);
      if (cb.checked && idx === -1) current.push(cb.value);
      if (!cb.checked && idx !== -1) current.splice(idx, 1);
      input.value = current.join(', ');
    }

    function handleCustomFields() {
      const form = document.querySelector('form');

      const nat = document.getElementById('customNationality')?.value.trim();
      const natSel = document.getElementById('nationalitySelect');
      if (nat && natSel.value === '') {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'http://schema.org/nationality[@value]';
        input.value = nat;
        form.appendChild(input);
        natSel.disabled = true;
      }

      const loc = document.getElementById('customPrefLoc')?.value.trim();
      const locSel = document.getElementById('prefLocSelect');
      if (loc && locSel.value === '') {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'esl:preferredWorkLocation[@value]';
        input.value = loc;
        form.appendChild(input);
        locSel.disabled = true;
      }

      const maj = document.getElementById('customMajor')?.value.trim();
      const majSel = document.getElementById('majorSelect');
      if (maj && majSel.value === '') {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'esl:major[@value]';
        input.value = maj;
        form.appendChild(input);
        majSel.disabled = true;
      }
      return true;
    }
