//- views/jobSeeker/new.pug
extends ../layout

block content
  // ⬇️ 프리셋은 블록 안에서 선언해야 합니다.
  - const _defNationalities = ['Korea','Japan','China','Malaysia','Thailand'];
  - const _defWorkLoc       = ['Korea','Japan','China','Malaysia','Thailand'];
  - const _defMajors        = ['English','Education','TESOL','Linguistics','Business'];

  - const _nationalities = (typeof nationalities !== 'undefined' && nationalities?.length) ? nationalities : _defNationalities;
  - const _workLocs      = (typeof workLocations !== 'undefined' && workLocations?.length) ? workLocations : _defWorkLoc;
  - const _majors        = (typeof majors !== 'undefined' && majors?.length) ? majors : _defMajors;

  .container.mt-5
    .row.justify-content-center
      .col-md-10
        .card.shadow
          .card-header.bg-primary.text-white.text-center
            h4.mb-0 New Job Seeker

          .card-body
            form(method="POST", action="/job-seekers", onsubmit="return handleCustomFields()")
              // ===== Job Title (rdfs:label)
              .form-group.mb-3
                label(for="title") Job Title
                input.form-control#title(type="text", name="rdfs:label[@value]", placeholder="e.g., ESL Teacher")

              // ===== Description (CKEditor, dc:description)
              .form-group.mb-4
                label(for="description") Description
                textarea.form-control(name="http://purl.org/dc/elements/1.1/description[@value]", id="description", rows="8")

              // ===== Nationality (semantic)
              .form-group.mb-3
                label(for="nationalitySelect") Nationality
                select.form-control#nationalitySelect(name="esl:Nationality[@value]")
                  option(disabled selected value="") Select Nationality
                  each v in _nationalities
                    option(value=v)= v
                small.text-muted.mt-1 You can also type a new nationality:
                input.form-control.mt-1(type="text", id="customNationality", placeholder="Or enter a new nationality")

              // ===== Preferred Work Location (semantic)
              .form-group.mb-3
                label(for="workLocSelect") Preferred Work Location
                select.form-control#workLocSelect(name="esl:Preferred_Work_Location[@value]")
                  option(disabled selected value="") Select Preferred Work Location
                  each v in _workLocs
                    option(value=v)= v
                small.text-muted.mt-1 You can also type a new location:
                input.form-control.mt-1(type="text", id="customWorkLoc", placeholder="Or enter a new work location")

              // ===== Major (semantic)
              .form-group.mb-3
                label(for="majorSelect") Major
                select.form-control#majorSelect(name="esl:Major[@value]")
                  option(disabled selected value="") Select Major
                  each v in _majors
                    option(value=v)= v
                small.text-muted.mt-1 You can also type a new major:
                input.form-control.mt-1(type="text", id="customMajor", placeholder="Or enter a new major")

              // ===== Email / Languages / Date Available (일반 필드)
              .form-group.mb-3
                label(for="email") Email
                input.form-control#email(type="email", name="email", placeholder="email@example.com")

              .form-group.mb-3
                label(for="languageSpoken") Languages Spoken
                input.form-control#languageSpoken(type="text", name="languageSpoken", placeholder="e.g., English, Korean")

              .form-group.mb-3
                label(for="dateAvailable") Date Available
                input.form-control#dateAvailable(type="date", name="dateAvailable")

              button.btn.btn-primary.btn-block.mt-3(type="submit") Save

block append_js
  // CKEditor
  script(src="https://cdn.ckeditor.com/ckeditor5/41.0.0/classic/ckeditor.js")
  
  style.
    .validation-warning {
      background-color: #fff3cd;
      border: 1px solid #ffc107;
      color: #856404;
      padding: 8px 12px;
      border-radius: 4px;
      margin-top: 5px;
      font-size: 0.875rem;
      display: none;
    }
  
  script.
    let editorInstance = null;
    ClassicEditor.create(document.querySelector('#description'))
      .then(editor => { editorInstance = editor; })
      .catch(console.error);

    // ===== English-only validation =====
    function containsNonEnglish(text) {
      // Detect: Korean, Chinese, Japanese, Emojis only
      const nonEnglishRegex = /[\u3000-\u303f\u3040-\u309f\u30a0-\u30ff\uff00-\uff9f\u4e00-\u9faf\u3400-\u4dbf\uac00-\ud7a3]|[\u{1F300}-\u{1F9FF}]|[\u2600-\u27BF]/u;
      
      if (nonEnglishRegex.test(text)) {
        return 'Non-English characters detected (Korean, Chinese, Japanese, or emojis)';
      }
      return null;
    }

    function showWarning(inputId, message) {
      let warning = document.getElementById(inputId + '-warning');
      if (!warning) {
        warning = document.createElement('div');
        warning.id = inputId + '-warning';
        warning.className = 'validation-warning';
        const input = document.getElementById(inputId);
        if (input && input.parentNode) {
          input.parentNode.insertBefore(warning, input.nextSibling);
        }
      }
      warning.textContent = '⚠️ ' + message + ' - Please use English only with standard punctuation.';
      warning.style.display = 'block';
    }

    function hideWarning(inputId) {
      const warning = document.getElementById(inputId + '-warning');
      if (warning) {
        warning.style.display = 'none';
      }
    }

    function validateField(inputId) {
      const input = document.getElementById(inputId);
      if (!input || !input.value) return true;
      
      const error = containsNonEnglish(input.value);
      if (error) {
        showWarning(inputId, error);
        return false;
      } else {
        hideWarning(inputId);
        return true;
      }
    }

    // Apply validation to text inputs
    const textFields = ['title', 'customNationality', 'customWorkLoc', 'customMajor', 'languageSpoken'];
    
    // Track validation state
    const fieldValidationState = {};
    textFields.forEach(f => { fieldValidationState[f] = true; });
    
    // Prevent focus on next fields if Title has errors
    function preventNextFieldFocus() {
      const titleValid = fieldValidationState['title'];
      const allFields = document.querySelectorAll('input, textarea, select, button');
      
      if (!titleValid) {
        const titleField = document.getElementById('title');
        if (!titleField) return;
        
        let foundTitle = false;
        allFields.forEach(field => {
          if (field === titleField) {
            foundTitle = true;
          } else if (foundTitle && field.id !== 'title') {
            field.addEventListener('mousedown', function(e) {
              if (!fieldValidationState['title']) {
                e.preventDefault();
                alert('⚠️ Please fix the Job Title field first!\n\nOnly English characters are allowed.');
                document.getElementById('title').focus();
              }
            });
            
            field.addEventListener('focus', function(e) {
              if (!fieldValidationState['title']) {
                e.preventDefault();
                this.blur();
                alert('⚠️ Please fix the Job Title field first!\n\nOnly English characters are allowed.');
                document.getElementById('title').focus();
              }
            });
          }
        });
      }
    }
    
    textFields.forEach(fieldId => {
      const field = document.getElementById(fieldId);
      if (field) {
        field.addEventListener('blur', () => {
          const isValid = validateField(fieldId);
          fieldValidationState[fieldId] = isValid;
          if (fieldId === 'title') preventNextFieldFocus();
        });
        
        field.addEventListener('input', () => {
          if (document.getElementById(fieldId + '-warning')) {
            const isValid = validateField(fieldId);
            fieldValidationState[fieldId] = isValid;
            if (fieldId === 'title') preventNextFieldFocus();
          }
        });
      }
    });
    
    // Initial setup
    const titleField = document.getElementById('title');
    if (titleField && titleField.value) {
      const isValid = validateField('title');
      fieldValidationState['title'] = isValid;
      preventNextFieldFocus();
    }

    function handleCustomFields() {
      const form = document.querySelector('form');
      
      // Validate description from CKEditor
      if (editorInstance) {
        const descData = editorInstance.getData();
        const plainText = descData.replace(/<[^>]*>/g, '');
        const descError = containsNonEnglish(plainText);
        if (descError) {
          alert('⚠️ ' + descError + ' in Description field.\n\nPlease use English only.');
          return false;
        }
      }

      // Validate all text fields
      let hasErrors = false;
      let firstErrorField = null;
      
      textFields.forEach(fieldId => {
        if (!validateField(fieldId)) {
          hasErrors = true;
          if (!firstErrorField) {
            firstErrorField = fieldId;
          }
        }
      });

      if (hasErrors) {
        alert('⚠️ Non-English characters or emojis detected!\n\n' +
              'Only English characters and standard punctuation are allowed.\n\n' +
              'Please check all text fields.');
        if (firstErrorField) {
          document.getElementById(firstErrorField)?.focus();
        }
        return false;
      }

      const natSel = document.getElementById('nationalitySelect');
      const natNew = document.getElementById('customNationality')?.value.trim();
      if (natNew && natSel.value === '') {
        const i = document.createElement('input');
        i.type = 'hidden'; i.name = 'esl:Nationality[@value]'; i.value = natNew;
        form.appendChild(i); natSel.disabled = true;
      }

      const wlSel = document.getElementById('workLocSelect');
      const wlNew = document.getElementById('customWorkLoc')?.value.trim();
      if (wlNew && wlSel.value === '') {
        const i = document.createElement('input');
        i.type = 'hidden'; i.name = 'esl:Preferred_Work_Location[@value]'; i.value = wlNew;
        form.appendChild(i); wlSel.disabled = true;
      }

      const mjSel = document.getElementById('majorSelect');
      const mjNew = document.getElementById('customMajor')?.value.trim();
      if (mjNew && mjSel.value === '') {
        const i = document.createElement('input');
        i.type = 'hidden'; i.name = 'esl:Major[@value]'; i.value = mjNew;
        form.appendChild(i); mjSel.disabled = true;
      }
      return true;
    }
