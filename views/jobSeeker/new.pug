extends ../layout

block append_on_header
  script(src="/vendor/ckeditor/ckeditor.js")

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-8
        .card.shadow-lg
          .card-header.bg-success.text-white
            h4.mb-0 New Job Seeker

          .card-body.bg-dark.text-light
            form(method="POST", action="/job-seekers/new")
              
              .form-floating.mb-3
                input.form-control#jobTitle(
                  type="text", 
                  name="jobTitle", 
                  required, 
                  placeholder="Job Title"
                )
                label(for="jobTitle") Job Title

              .mb-4
                label.text-white.mb-2 Job Description
                textarea.form-control(
                  name="description", 
                  id="description", 
                  rows="8"
                )

              .form-floating.mb-3
                input.form-control#name(
                  type="text", 
                  name="name", 
                  required, 
                  placeholder="Your Name"
                )
                label(for="name") Your Name

              .form-floating.mb-3
                input.form-control#email(
                  type="email", 
                  name="email", 
                  placeholder="Email"
                )
                label(for="email") Email

              .form-floating.mb-3
                input.form-control#nationality(
                  type="text", 
                  name="nationality", 
                  placeholder="Nationality"
                )
                label(for="nationality") Nationality

              .form-floating.mb-3
                input.form-control#preferredWorkLocation(
                  type="text", 
                  name="preferredWorkLocation", 
                  placeholder="Preferred Work Location"
                )
                label(for="preferredWorkLocation") Preferred Work Location

              .form-floating.mb-3
                input.form-control#major(
                  type="text", 
                  name="major", 
                  placeholder="Major"
                )
                label(for="major") Major

              .form-floating.mb-3
                input.form-control#languageSpoken(
                  type="text", 
                  name="languageSpoken", 
                  placeholder="Languages Spoken"
                )
                label(for="languageSpoken") Languages Spoken

              .form-floating.mb-3
                input.form-control#availableFrom(
                  type="date", 
                  name="availableFrom", 
                  placeholder="Available From"
                )
                label(for="availableFrom") Available From

              button.btn.btn-success.btn-block.mt-4(type="submit") Submit

block append_js
  script.
    CKEDITOR.replace('description');
