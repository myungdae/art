//- views/jobSeeker/new.pug
extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-10
        .card.shadow
          .card-header.bg-primary.text-white.text-center
            h4.mb-0 New Job Seeker
          .card-body
            form(method="POST", action="/job-seekers", onsubmit="return handleCustomFields()")
              // ===== Job Title
              .mb-3
                label(for="title") Job Title
                input#title.form-control(type="text", name="rdfs:label[@value]", placeholder="e.g., ESL Teacher")

              // ===== Description
              .mb-4
                label(for="description") Description
                textarea#description.form-control(name="http://purl.org/dc/elements/1.1/description[@value]", rows="8")

              // ===== Nationality (datalist + hidden semantic field)
              .mb-3
                label(for="nationalityUi") Nationality
                input#nationalityUi.form-control(
                  type="text"
                  list="nationality-list"
                  placeholder="Select or type nationality"
                  autocomplete="off"
                )
                //- 서버로 보낼 실제 필드
                input#nationalityHidden(type="hidden", name="esl:Nationality[@value]")

                //- 초기 프리셋 (서버에서 전달된 nationalities 없으면 기본값 사용)
                - const _nats = (typeof nationalities !== 'undefined' && nationalities && nationalities.length) ? nationalities : ['Korean','American','British','Japanese','Chinese']
                datalist#nationality-list
                  each n in _nats
                    option(value=n)= n
                small.text-muted Type to search or enter a new nationality.

              // ===== Preferred Work Location
              .mb-3
                label(for="workLoc") Preferred Work Location
                input#workLoc.form-control(type="text", name="esl:Preferred_Work_Location[@value]", placeholder="e.g., Korea or Remote")

              // ===== Major
              .mb-3
                label(for="major") Major
                input#major.form-control(type="text", name="esl:Major[@value]", placeholder="e.g., Education")

              // ===== Email / Languages / Date
              .mb-3
                label(for="email") Email
                input#email.form-control(type="email", name="email", placeholder="email@example.com")

              .mb-3
                label(for="languageSpoken") Languages Spoken
                input#languageSpoken.form-control(type="text", name="languageSpoken", placeholder="e.g., English, Korean")

              .mb-3
                label(for="dateAvailable") Date Available
                input#dateAvailable.form-control(type="date", name="dateAvailable")

              button.btn.btn-primary.mt-3(type="submit") Save

block append_js
  // CKEditor
  script(src="https://cdn.ckeditor.com/ckeditor5/41.0.0/classic/ckeditor.js")
  script.
    (function () {
      if (window.ClassicEditor) {
        ClassicEditor.create(document.querySelector('#description')).catch(console.error);
      }

      // hidden 필드에 UI 값 동기화
      function syncNationality() {
        var ui  = document.getElementById('nationalityUi');
        var hid = document.getElementById('nationalityHidden');
        if (ui && hid) hid.value = (ui.value || '').trim();
      }
      document.getElementById('nationalityUi')?.addEventListener('input', syncNationality);

      // 폼 제출 시 한 번 더 동기화
      window.handleCustomFields = function () {
        syncNationality();
        return true;
      };

      // 최신 국적 목록을 API에서 로드하여 datalist 갱신
      fetch('/api/nationalities')
        .then(function (r) { return r.json(); })
        .then(function (arr) {
          var dl = document.getElementById('nationality-list');
          if (!dl || !Array.isArray(arr)) return;
          dl.innerHTML = '';
          arr.forEach(function (n) {
            var opt = document.createElement('option');
            opt.value = n;
            dl.appendChild(opt);
          });
        })
        .catch(function () { /* no-op */ });
    })();
