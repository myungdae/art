extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-8
        .card.shadow
          .card-header.bg-primary.text-white
            h4.mb-0 Add Job Seeker

          .card-body
            form(method="POST", action="/job-seekers/new")
              .form-group.mb-3
                label Name
                input.form-control(type="text", name="name", placeholder="Name")

              .form-group.mb-3
                label Country
                input.form-control(type="text", name="country", placeholder="Country")

              .form-group.mb-3
                label Nationality
                input.form-control(type="text", name="nationality", placeholder="Nationality")

              .form-group.mb-3
                label Major
                input.form-control(type="text", name="major", placeholder="Major")

              .form-group.mb-3
                label Preferred Work Location
                input.form-control(type="text", name="preferredLocation", placeholder="e.g., Seoul, Busan")

              .form-group.mb-3
                label Education Background
                input.form-control(type="text", name="education", placeholder="e.g., Graduate, Bachelor")

              .form-group.mb-4
                label Available From
                input.form-control(type="date", name="availableFrom")

              button.btn.btn-success.btn-block(type="submit") Submit
