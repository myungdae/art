extends ../layout

block content
  .container.mt-5
    .d-flex.justify-content-between.align-items-center.mb-4
      h2.text-primary Job Seeker List
      a.btn.btn-success(href="/job-seekers/new") + New Job Seeker

    if seekers.length
      table.table.table-striped.table-hover
        thead
          tr
            th Name
            th Job Title
            th Language(s)
            th Preferred Location
            th Available From
            th Actions
        tbody
          each seeker in seekers
            tr
              td= seeker.name || '-'
              td= seeker.jobTitle || '-'
              td= seeker.languageSpoken || '-'
              td= seeker.preferredWorkLocation || '-'
              td= seeker.availableFrom ? seeker.availableFrom.toISOString().slice(0, 10) : '-'
              td
                a.btn.btn-sm.btn-outline-primary(href=`/job-seekers/${seeker._id}/edit`) Edit
                |  
                a.btn.btn-sm.btn-outline-danger(href=`/job-seekers/${seeker._id}/delete`) Delete
    else
      .alert.alert-info.mt-4 No job seekers found.
