//- views/jobSeeker/edit.pug
extends ../layout

block content
  // 프리셋(블록 안에서 선언)
  - const _defNationalities = ['Korea','Japan','China','Malaysia','Thailand'];
  - const _defWorkLoc       = ['Korea','Japan','China','Malaysia','Thailand'];
  - const _defMajors        = ['English','Education','TESOL','Linguistics','Business'];

  - const _nationalities = (typeof nationalities !== 'undefined' && nationalities && nationalities.length) ? nationalities : _defNationalities;
  - const _workLocs      = (typeof workLocations !== 'undefined' && workLocations && workLocations.length) ? workLocations : _defWorkLoc;
  - const _majors        = (typeof majors !== 'undefined' && majors && majors.length) ? majors : _defMajors;

  // 현재 값
  - const _title = jobSeeker?.title || jobSeeker?._label || '';
  - const _desc  = jobSeeker?.description || jobSeeker?._description || '';
  - const _nat   = jobSeeker?.nationality || jobSeeker?.['esl:Nationality[@value]'] || '';
  - const _loc   = jobSeeker?.preferredWorkLocation || jobSeeker?.['esl:Preferred_Work_Location[@value]'] || '';
  - const _maj   = jobSeeker?.major || jobSeeker?.['esl:Major[@value]'] || '';

  - const _natIn = _nat && _nationalities.indexOf(_nat) !== -1;
  - const _locIn = _loc && _workLocs.indexOf(_loc) !== -1;
  - const _majIn = _maj && _majors.indexOf(_maj) !== -1;

  .container.mt-5
    .row.justify-content-center
      .col-md-10
        .card.shadow
          .card-header.bg-warning.text-white.text-center
            h4.mb-0 Edit Job Seeker

          .card-body
            form.form(method="POST", action=`/job-seekers/${jobSeeker._id}?_method=PUT`, onsubmit="return handleCustomFields()")
              // ===== Job Title (rdfs:label)
              .form-group.mb-3
                label(for="title") Job Title
                input.form-control#title(type="text", name="rdfs:label[@value]", value=_title, placeholder="e.g., ESL Teacher")

              // ===== Description (CKEditor, dc:description)
              .form-group.mb-4
                label(for="description") Description
                textarea.form-control(name="http://purl.org/dc/elements/1.1/description[@value]", id="description", rows="8")= _desc

              // ===== Nationality (semantic)
              .form-group.mb-3
                label(for="nationalitySelect") Nationality
                select.form-control#nationalitySelect(name="esl:Nationality[@value]")
                  option(disabled value="") Select Nationality
                  each v in _nationalities
                    option(value=v selected=(_nat===v))= v
                  if _nat && !_natIn
                    option(value=_nat selected)= _nat
                small.text-muted.mt-1 You can also type a new nationality:
                input.form-control.mt-1(type="text", id="customNationality", placeholder="Or enter a new nationality")

              // ===== Preferred Work Location (semantic)
              .form-group.mb-3
                label(for="workLocSelect") Preferred Work Location
                select.form-control#workLocSelect(name="esl:Preferred_Work_Location[@value]")
                  option(disabled value="") Select Preferred Work Location
                  each v in _workLocs
                    option(value=v selected=(_loc===v))= v
                  if _loc && !_locIn
                    option(value=_loc selected)= _loc
                small.text-muted.mt-1 You can also type a new location:
                input.form-control.mt-1(type="text", id="customWorkLoc", placeholder="Or enter a new work location")

              // ===== Major (semantic)
              .form-group.mb-3
                label(for="majorSelect") Major
                select.form-control#majorSelect(name="esl:Major[@value]")
                  option(disabled value="") Select Major
                  each v in _majors
                    option(value=v selected=(_maj===v))= v
                  if _maj && !_majIn
                    option(value=_maj selected)= _maj
                small.text-muted.mt-1 You can also type a new major:
                input.form-control.mt-1(type="text", id="customMajor", placeholder="Or enter a new major")

              // ===== Email / Languages / Date Available
              .form-group.mb-3
                label(for="email") Email
                input.form-control#email(type="email", name="email", value=(jobSeeker.email || ''), placeholder="email@example.com")

              .form-group.mb-3
                label(for="languageSpoken") Languages Spoken
                input.form-control#languageSpoken(type="text", name="languageSpoken", value=(jobSeeker.languageSpoken || ''), placeholder="e.g., English, Korean")

              .form-group.mb-3
                label(for="dateAvailable") Date Available
                - const _dateAvail = jobSeeker?.dateAvailable && typeof jobSeeker.dateAvailable.toISOString === 'function' ? jobSeeker.dateAvailable.toISOString().substring(0,10) : (jobSeeker?.dateAvailable || '')
                input.form-control#dateAvailable(type="date", name="dateAvailable", value=_dateAvail)

              button.btn.btn-warning.btn-block.mt-3(type="submit") Update

block append_js
  // CKEditor
  script(src="https://cdn.ckeditor.com/ckeditor5/41.0.0/classic/ckeditor.js")
  
  style.
    .validation-warning {
      background-color: #fff3cd;
      border: 1px solid #ffc107;
      color: #856404;
      padding: 8px 12px;
      border-radius: 4px;
      margin-top: 5px;
      font-size: 0.875rem;
      display: none;
    }
  
  script.
    let editorInstance = null;
    ClassicEditor.create(document.querySelector('#description'))
      .then(editor => { editorInstance = editor; })
      .catch(console.error);

    // ===== English-only validation =====
    
    // For Title fields: Block emojis + non-English languages
    function containsNonEnglishWithEmoji(text) {
      const nonEnglishRegex = /[\u3000-\u303f\u3040-\u309f\u30a0-\u30ff\uff00-\uff9f\u4e00-\u9faf\u3400-\u4dbf\uac00-\ud7a3]|[\u{1F300}-\u{1F9FF}]|[\u2600-\u27BF]/u;
      
      if (nonEnglishRegex.test(text)) {
        return 'Non-English characters or emojis detected';
      }
      return null;
    }
    
    // For Description fields: Block non-English languages only (emojis allowed)
    function containsNonEnglishLanguagesOnly(text) {
      const languageRegex = /[\u3000-\u303f\u3040-\u309f\u30a0-\u30ff\uff00-\uff9f\u4e00-\u9faf\u3400-\u4dbf\uac00-\ud7a3]/u;
      
      if (languageRegex.test(text)) {
        return 'Non-English characters detected (Korean, Chinese, or Japanese)';
      }
      return null;
    }

    function showWarning(inputId, message) {
      let warning = document.getElementById(inputId + '-warning');
      if (!warning) {
        warning = document.createElement('div');
        warning.id = inputId + '-warning';
        warning.className = 'validation-warning';
        const input = document.getElementById(inputId);
        if (input && input.parentNode) {
          input.parentNode.insertBefore(warning, input.nextSibling);
        }
      }
      warning.textContent = '⚠️ ' + message + ' - Please use English only with standard punctuation.';
      warning.style.display = 'block';
    }

    function hideWarning(inputId) {
      const warning = document.getElementById(inputId + '-warning');
      if (warning) {
        warning.style.display = 'none';
      }
    }

    function validateField(inputId, allowEmoji = false) {
      const input = document.getElementById(inputId);
      if (!input || !input.value) return true;
      
      // Use appropriate validation function based on field type
      const error = allowEmoji 
        ? containsNonEnglishLanguagesOnly(input.value)
        : containsNonEnglishWithEmoji(input.value);
      
      if (error) {
        showWarning(inputId, error);
        return false;
      } else {
        hideWarning(inputId);
        return true;
      }
    }

    // Apply validation to text inputs
    // Title and other fields: strict (no emojis)
    const strictFields = ['title', 'customNationality', 'customWorkLoc', 'customMajor', 'languageSpoken'];
    
    strictFields.forEach(fieldId => {
      const field = document.getElementById(fieldId);
      if (field) {
        field.addEventListener('blur', () => validateField(fieldId, false));
        field.addEventListener('input', () => {
          if (document.getElementById(fieldId + '-warning')) {
            validateField(fieldId, false);
          }
        });
      }
    });

    function handleCustomFields() {
      const form = document.querySelector('form');
      
      // Validate description from CKEditor (emojis allowed)
      if (editorInstance) {
        const descData = editorInstance.getData();
        const plainText = descData.replace(/<[^>]*>/g, '');
        const descError = containsNonEnglishLanguagesOnly(plainText);
        if (descError) {
          alert('⚠️ ' + descError + ' in Description field.\n\nEmojis are allowed 😊, but Korean, Chinese, and Japanese text is not permitted.');
          return false;
        }
      }

      // Validate all strict fields (no emojis)
      let hasErrors = false;
      strictFields.forEach(fieldId => {
        if (!validateField(fieldId, false)) {
          hasErrors = true;
        }
      });

      if (hasErrors) {
        alert('⚠️ Non-English characters or emojis detected!\n\n' +
              'Job Title and other fields: No emojis allowed.\n' +
              'Description field: Emojis are OK! 😊\n\n' +
              'Please check all text fields.');
        return false;
      }

      const natSel = document.getElementById('nationalitySelect');
      const natNew = document.getElementById('customNationality')?.value.trim();
      if (natNew && natSel && natSel.value === '') {
        const i = document.createElement('input');
        i.type = 'hidden'; i.name = 'esl:Nationality[@value]'; i.value = natNew;
        form.appendChild(i); natSel.disabled = true;
      }

      const wlSel = document.getElementById('workLocSelect');
      const wlNew = document.getElementById('customWorkLoc')?.value.trim();
      if (wlNew && wlSel && wlSel.value === '') {
        const i = document.createElement('input');
        i.type = 'hidden'; i.name = 'esl:Preferred_Work_Location[@value]'; i.value = wlNew;
        form.appendChild(i); wlSel.disabled = true;
      }

      const mjSel = document.getElementById('majorSelect');
      const mjNew = document.getElementById('customMajor')?.value.trim();
      if (mjNew && mjSel && mjSel.value === '') {
        const i = document.createElement('input');
        i.type = 'hidden'; i.name = 'esl:Major[@value]'; i.value = mjNew;
        form.appendChild(i); mjSel.disabled = true;
      }
      return true;
    }
