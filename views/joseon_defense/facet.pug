//- views/joseon_defense/facet.pug — 조선 국방 온톨로지 패싯 탐색
extends ../layout

block content
  style.
    html, body { background: #0e0c08; color: #f0e8d0; }

    /* ── 페이지 헤더 ────────────────────────────────────────── */
    .facet-header {
      background: linear-gradient(180deg, #1a1508 0%, #0e0c08 100%);
      border-bottom: 1px solid #2a2010;
      padding: 40px 24px 32px;
    }
    .facet-header-inner {
      max-width: 1280px; margin: 0 auto;
    }
    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 13px; font-weight: 700; color: rgba(240,232,208,0.4);
      text-decoration: none; margin-bottom: 20px;
      transition: color 0.2s;
    }
    .back-link:hover { color: #d4af37; }
    .page-badge {
      display: inline-flex; align-items: center; gap: 7px;
      background: rgba(139,105,20,0.18);
      border: 1px solid rgba(212,175,55,0.35);
      border-radius: 50px; padding: 4px 16px;
      font-size: 10px; font-weight: 800; color: #c9a227;
      letter-spacing: 2px; text-transform: uppercase;
      margin-bottom: 14px;
    }
    .page-title {
      font-size: clamp(1.6rem, 3.5vw, 2.4rem);
      font-weight: 900; color: #f0e8d0; line-height: 1.2;
      margin-bottom: 8px;
    }
    .page-count {
      font-size: 14px; color: rgba(240,232,208,0.45);
    }
    .page-count strong { color: #c9a227; }

    /* ── 클래스 탭 바 ────────────────────────────────────────── */
    .class-tabs {
      background: #1a1508;
      border-bottom: 1px solid #2a2010;
      overflow-x: auto;
    }
    .class-tabs-inner {
      max-width: 1280px; margin: 0 auto;
      display: flex; padding: 0 24px;
    }
    .class-tab {
      padding: 14px 20px;
      font-size: 13px; font-weight: 700;
      color: rgba(240,232,208,0.45);
      text-decoration: none; white-space: nowrap;
      border-bottom: 2.5px solid transparent;
      transition: color 0.2s, border-color 0.2s;
    }
    .class-tab:hover { color: #d4af37; }
    .class-tab.active { color: #d4af37; border-bottom-color: #d4af37; }

    /* ── 메인 레이아웃 ───────────────────────────────────────── */
    .facet-layout {
      max-width: 1280px; margin: 0 auto;
      display: grid; grid-template-columns: 240px 1fr;
      gap: 0; padding: 32px 24px 80px;
    }
    @media (max-width: 900px) {
      .facet-layout { grid-template-columns: 1fr; }
      .facet-sidebar { display: none; }
    }

    /* ── 사이드바 ────────────────────────────────────────────── */
    .facet-sidebar {
      padding-right: 24px; border-right: 1px solid #2a2010;
    }
    .filter-group { margin-bottom: 28px; }
    .filter-title {
      font-size: 11px; font-weight: 800; color: #c9a227;
      text-transform: uppercase; letter-spacing: 2px;
      margin-bottom: 12px;
    }
    .filter-list { list-style: none; padding: 0; margin: 0; }
    .filter-list li { margin-bottom: 4px; }
    .filter-list a {
      display: flex; align-items: center; justify-content: space-between;
      padding: 7px 10px; border-radius: 8px;
      font-size: 13px; color: rgba(240,232,208,0.6);
      text-decoration: none; transition: all 0.2s;
    }
    .filter-list a:hover {
      background: rgba(212,175,55,0.08);
      color: #d4af37;
    }
    .filter-list a.active {
      background: rgba(212,175,55,0.12);
      color: #d4af37; font-weight: 700;
    }
    .filter-cnt {
      font-size: 11px; font-weight: 700;
      background: rgba(201,162,39,0.12);
      border: 1px solid rgba(201,162,39,0.25);
      color: #c9a227; padding: 1px 7px; border-radius: 50px;
    }

    /* ── 검색 바 ─────────────────────────────────────────────── */
    .search-bar-wrap {
      margin: 0 0 24px 0;
    }
    .search-bar {
      display: flex; gap: 8px;
    }
    .search-input {
      flex: 1; background: #1a1508;
      border: 1.5px solid #2a2010; border-radius: 10px;
      padding: 11px 16px; font-size: 14px;
      color: #f0e8d0; outline: none;
      transition: border-color 0.2s;
    }
    .search-input::placeholder { color: rgba(240,232,208,0.3); }
    .search-input:focus { border-color: #c9a227; }
    .search-btn {
      background: #c9a227; color: #0e0c08;
      border: none; border-radius: 10px;
      padding: 11px 22px; font-size: 14px; font-weight: 800;
      cursor: pointer; transition: background 0.2s;
    }
    .search-btn:hover { background: #a07800; }

    /* ── 결과 헤더 ──────────────────────────────────────────── */
    .result-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 20px; flex-wrap: wrap; gap: 12px;
    }
    .result-count { font-size: 14px; color: rgba(240,232,208,0.5); }
    .result-count strong { color: #c9a227; }
    .sort-select {
      background: #1a1508; border: 1px solid #2a2010; border-radius: 8px;
      color: rgba(240,232,208,0.7); padding: 7px 12px; font-size: 13px;
      cursor: pointer; outline: none;
    }

    /* ── 결과 카드 ──────────────────────────────────────────── */
    .result-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 16px;
    }
    .result-card {
      background: #1a1508; border: 1px solid #2a2010;
      border-radius: 14px; padding: 20px;
      text-decoration: none; display: block;
      transition: border-color 0.2s, transform 0.2s;
    }
    .result-card:hover {
      border-color: #c9a227;
      transform: translateY(-3px);
    }
    .rc-type {
      font-size: 10px; font-weight: 800; color: #c9a227;
      letter-spacing: 1.5px; text-transform: uppercase;
      margin-bottom: 8px;
    }
    .rc-title {
      font-size: 15px; font-weight: 800; color: #f0e8d0;
      line-height: 1.4; margin-bottom: 8px;
    }
    .rc-meta { font-size: 12px; color: rgba(240,232,208,0.45); line-height: 1.6; }
    .rc-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .rc-tag {
      font-size: 11px; padding: 2px 9px; border-radius: 50px;
      background: rgba(240,232,208,0.06);
      border: 1px solid rgba(240,232,208,0.13);
      color: rgba(240,232,208,0.5);
    }
    .rc-date {
      font-size: 11px; color: rgba(240,232,208,0.3);
      margin-top: 8px;
    }

    /* 빈 결과 */
    .empty-state {
      text-align: center; padding: 80px 24px;
      color: rgba(240,232,208,0.35);
    }
    .empty-state .ei { font-size: 3rem; margin-bottom: 16px; }

    /* ── 주요 필터 태그 ─────────────────────────────────────── */
    .active-filters {
      display: flex; flex-wrap: wrap; gap: 8px;
      margin-bottom: 20px;
    }
    .active-filter {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(201,162,39,0.12);
      border: 1px solid rgba(201,162,39,0.3);
      border-radius: 50px; padding: 5px 14px;
      font-size: 12px; font-weight: 700; color: #c9a227;
      text-decoration: none;
    }
    .active-filter .rm { color: #c9a227; font-size: 14px; }

    /* 패스트 탐색 기간 태그 */
    .year-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .year-tag {
      font-size: 11px; padding: 2px 10px; border-radius: 50px;
      background: rgba(99,102,241,0.12);
      border: 1px solid rgba(99,102,241,0.25);
      color: #a5b4fc;
      text-decoration: none;
    }
    .year-tag:hover { background: rgba(99,102,241,0.2); }

  //- ── 페이지 헤더 ────────────────────────────────────────────
  .facet-header
    .facet-header-inner
      a.back-link(href='/joseon_defense') ← 조선 국방 온톨로지 홈
      .page-badge 🔗 OWL Ontology
      h1.page-title
        span= classIcon + ' ' + classLabel
      p.page-count
        strong= totalCount
        |  개의 개체

  //- ── 클래스 탭 바 ───────────────────────────────────────────
  .class-tabs
    .class-tabs-inner
      a.class-tab(href='/joseon_defense/facet/Commander'     class=(currentClass==='Commander'     ? 'active' : '')) 👤 지휘관
      a.class-tab(href='/joseon_defense/facet/King'          class=(currentClass==='King'          ? 'active' : '')) 👑 국왕
      a.class-tab(href='/joseon_defense/facet/Fortress'      class=(currentClass==='Fortress'      ? 'active' : '')) 🏯 성곽
      a.class-tab(href='/joseon_defense/facet/Battle'        class=(currentClass==='Battle'        ? 'active' : '')) ⚔️ 전투
      a.class-tab(href='/joseon_defense/facet/War'           class=(currentClass==='War'           ? 'active' : '')) 🏳️ 전쟁
      a.class-tab(href='/joseon_defense/facet/WeaponSystem'  class=(currentClass==='WeaponSystem'  ? 'active' : '')) 🗡️ 무기
      a.class-tab(href='/joseon_defense/facet/MilitaryOrganization' class=(currentClass==='MilitaryOrganization' ? 'active' : '')) 🚩 군사조직
      a.class-tab(href='/joseon_defense/facet/MilitaryFacility' class=(currentClass==='MilitaryFacility' ? 'active' : '')) 🔱 군사시설
      a.class-tab(href='/joseon_defense/facet/EnemyForce'   class=(currentClass==='EnemyForce'   ? 'active' : '')) 🗺️ 외적
      a.class-tab(href='/joseon_defense/facet/Heritage'     class=(currentClass==='Heritage'     ? 'active' : '')) 🏛️ 유산
      a.class-tab(href='/joseon_defense/facet/Place'        class=(currentClass==='Place'        ? 'active' : '')) 📍 장소
      a.class-tab(href='/joseon_defense/facet/MilitaryEvent' class=(currentClass==='MilitaryEvent' ? 'active' : '')) 📜 군사사건

  //- ── 메인 레이아웃 ──────────────────────────────────────────
  .facet-layout
    //- 사이드바
    .facet-sidebar
      if filters && filters.length
        each fg in filters
          .filter-group
            p.filter-title= fg.label
            ul.filter-list
              each opt in fg.options
                li
                  - var isActive = (selectedFilters && selectedFilters[fg.key] === opt.value)
                  - var url = isActive ? ('/joseon_defense/facet/' + currentClass) : ('/joseon_defense/facet/' + currentClass + '?' + fg.key + '=' + encodeURIComponent(opt.value))
                  a(href=url class=(isActive ? 'active' : ''))
                    span= opt.label
                    span.filter-cnt= opt.count

    //- 결과 영역
    div(style='padding-left: 28px; min-width: 0')
      //- 검색 바
      .search-bar-wrap
        form.search-bar(method='GET' action=`/joseon_defense/facet/${currentClass}`)
          input.search-input(
            type='text' name='q' value=searchQuery
            placeholder=`${classLabel} 검색...`
          )
          button.search-btn(type='submit') 검색

      //- 활성 필터 태그
      if searchQuery
        .active-filters
          a.active-filter(href=`/joseon_defense/facet/${currentClass}`)
            span 검색: #{searchQuery}
            span.rm ✕

      //- 결과 헤더
      .result-header
        p.result-count
          strong= totalCount
          |  개의 개체
        select.sort-select(onchange=`location.href='/joseon_defense/facet/${currentClass}?sort='+this.value`)
          option(value='latest' selected=(sortBy==='latest')) 최신순
          option(value='alpha'  selected=(sortBy==='alpha'))  이름순

      //- 결과 카드 그리드
      if items && items.length
        .result-grid
          each item in items
            a.result-card(href=`/joseon_defense/resource/${item.resourceId}`)
              p.rc-type= item.classLabel || currentClass
              p.rc-title= item.label
              if item.description
                p.rc-meta= item.description
              if item.yearStart || item.yearEnd
                p.rc-meta
                  if item.yearStart
                    | #{item.yearStart}
                  if item.yearStart && item.yearEnd
                    |  ~ 
                  if item.yearEnd
                    | #{item.yearEnd}
              if item.tags && item.tags.length
                .rc-tags
                  each tag in item.tags
                    span.rc-tag= tag
              if item.periodLabel
                p.rc-meta= item.periodLabel
      else
        .empty-state
          p.ei 📜
          p 해당 클래스의 인스턴스가 없습니다.
          p(style='font-size:13px; margin-top:8px') TTL 파일에 인스턴스 데이터를 추가하면 여기에 표시됩니다.
