extends ../layout

block content
  h2 Add Online Tutor

  form(action="/online-tutor/new" method="post")
    label Name
    input(type="text" name="name")
    br

    label Nationality
    input(type="text" name="nationality")
    br

    label Gender
    input(type="text" name="gender")
    br

    label Expertise (comma-separated)
    input(type="text" name="expertise")
    br

    label Tutoring Experience
    input(type="text" name="tutoringExperience")
    br

    label Communication Methods (comma-separated)
    input(type="text" name="communicationMethods")
    br

    label Available Time
    input(type="text" name="availableTime")
    br

    label Available From
    input(type="date" name="availableFrom")
    br

    button(type="submit") Save
