extends ../layout

block content
  h2 Online Tutors List
  a(href="/online-tutor/new") Add New Tutor

  table.table.table-striped.mt-3
    thead
      tr
        th Name
        th Nationality
        th Gender
        th Expertise
        th Tutoring Experience
        th Communication Methods
        th Available Time
        th Available From
        th Actions
    tbody
      each tutor in tutors
        tr
          td= tutor.name
          td= tutor.nationality
          td= tutor.gender
          td= tutor.expertise.join(', ')
          td= tutor.tutoringExperience
          td= tutor.communicationMethods.join(', ')
          td= tutor.availableTime
          td= tutor.availableFrom ? tutor.availableFrom.toISOString().substring(0,10) : ''
          td
            a(href=`/online-tutor/edit/${tutor._id}`) Edit
            |  
            a(href=`/online-tutor/delete/${tutor._id}`) Delete
