//- views/onlineTutor/visibility.pug
extends ../layout

block content
  // ── 버튼·컨테이너 가시화 강제
  style.
    .purchase-cta, .purchase-cta * { visibility: visible !important; opacity: 1 !important; }
    .buy-btn { min-height: 84px; }

  .container.mt-5.mb-5
    h2.text-center.mb-4 Purchase Tutor Listing Visibility

    .card.shadow-sm.mx-auto(style="max-width: 720px")
      .card-body
        p.lead.mb-3
          | Choose how long your tutor profile should be visible to 
          b students and parents 
          | (and schools looking for online lessons).

        ul.mb-4.text-muted
          li Your profile will be discoverable in the Online Tutors section during the active period.
          li You can create or update your tutor profile while visibility is active.
          li When the period expires, the profile becomes hidden until you renew.

        // ✅ 버튼을 a 링크(GET)로 변경 → 보임/동작 보장
        .row.g-3.purchase-cta
          .col-12.col-md-4
            a.buy-btn.btn.btn-primary.w-100.py-3(href="/user/online-tutors/visibility/start?days=30")
              strong 30 Days
              br
              span.small Keep me listed for a month
          .col-12.col-md-4
            a.buy-btn.btn.btn-primary.w-100.py-3(href="/user/online-tutors/visibility/start?days=90")
              strong 90 Days
              br
              span.small Great for a semester
          .col-12.col-md-4
            a.buy-btn.btn.btn-primary.w-100.py-3(href="/user/online-tutors/visibility/start?days=365")
              strong 365 Days
              br
              span.small Year-round visibility

        .mt-3.text-center
          a.btn.btn-link(href="/user/mypage-tutor") ← Back to My Page
