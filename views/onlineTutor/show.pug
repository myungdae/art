extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-10
        .card.shadow
          .card-header.bg-info.text-white.text-center
            h4.mb-0= tutor.name

          .card-body
            if tutor.jobTitle
              p
                strong Job Title:
                |  #{tutor.jobTitle}

            if tutor.description
              p
                strong Description:
                br
                | !{tutor.description}

            p
              strong Gender:
              |  #{tutor.gender}

            if tutor.expertise && tutor.expertise.length
              p
                strong Expertise:
                |  #{tutor.expertise.join(', ')}

            p
              strong Tutoring Experience:
              |  #{tutor.tutoringExperience}

            if tutor.communicationMethods && tutor.communicationMethods.length
              p
                strong Communication Methods:
                |  #{tutor.communicationMethods.join(', ')}

            if tutor.language
              p
                strong Main Language:
                |  #{tutor.language}

            if tutor.languagesSpoken && tutor.languagesSpoken.length
              p
                strong Languages Spoken:
                |  #{tutor.languagesSpoken.join(', ')}

            if tutor.email
              p
                strong Email:
                |  #{tutor.email}

            if tutor.skypeId
              p
                strong Skype ID:
                |  #{tutor.skypeId}

            if tutor.zoomId
              p
                strong Zoom ID:
                |  #{tutor.zoomId}

            if tutor.hourlyRate
              p
                strong Hourly Rate (USD):
                |  $#{tutor.hourlyRate}

            if tutor.availableFrom
              - const fromDate = new Date(tutor.availableFrom).toLocaleDateString('en-CA')
              p
                strong Available From:
                |  #{fromDate}

            if tutor.availableTime
              p
                strong Available Time:
                |  #{tutor.availableTime}

            .mt-4
              a.btn.btn-warning(href=`/online-tutor/${tutor._id}/edit`) Edit
              a.btn.btn-secondary.ms-2(href="/online-tutor") ← Back to List
