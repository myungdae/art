//- views/onlineTutor/new.pug
extends ../layout

block content
  - var errors = (typeof errors === 'object' && errors) ? errors : {};
  - var values = (typeof values === 'object' && values) ? values : {};
  - var expertiseList = Array.isArray(expertiseList) ? expertiseList : ['Conversation','Grammar','BusinessEnglish','ExamPrep','TOEFL','IELTS','Kids','Pronunciation','IT','Coding','AI Literacy','Music Composing','Drawing'];
  - var expList = Array.isArray(expList) ? expList : ['Beginner','Intermediate','Advanced','5+ years','10+ years'];
  - var genderList = Array.isArray(genderList) ? genderList : ['Male','Female','Other','Prefer not to say'];

  .container.my-5
    h2.text-center.mb-4 Create Tutor Profile

    .row.justify-content-center
      .col-lg-9

        if Object.keys(errors).length
          .alert.alert-danger
            strong Please fix the following:
            ul.mb-0.mt-2
              each msg, key in errors
                li #{msg}

        form#tutorForm(action="/online-tutors" method="POST" novalidate)
          // ---------------- Basic Info ----------------
          .card.mb-3.border-0.shadow-sm
            .card-header.bg-white
              h5.mb-0 Basic Info
            .card-body
              .form-group
                label(for="title") Title (optional)
                input#title.form-control(type="text" name="title" value=(values.title || '') placeholder="e.g., Friendly Online Tutor")

              .form-group
                label(for="description") Description
                textarea#description.form-control(name="description" rows="6" placeholder="Introduce yourself, experience, specialties…")= values.description || ''

              .form-row
                .form-group.col-md-6
                  label(for="tutoringExperience") Tutoring Experience *
                  select#tutoringExperience.form-control(name="Tutoring_Experience" required)
                    option(value="") Select…
                    each item in expList
                      option(value=item selected=(values.Tutoring_Experience===item))= item
                  if errors.Tutoring_Experience
                    .invalid-feedback.d-block= errors.Tutoring_Experience

                .form-group.col-md-6
                  label(for="gender") Gender *
                  select#gender.form-control(name="Gender" required)
                    option(value="") Select…
                    each item in genderList
                      option(value=item selected=(values.Gender===item))= item
                  if errors.Gender
                    .invalid-feedback.d-block= errors.Gender

              .form-group
                label(for="email") Contact Email *
                input#email.form-control(
                  type="email"
                  name="email"
                  required
                  value=(values.email || (session && session.user && session.user.email) || '')
                  placeholder="you@example.com"
                )
                if errors.email
                  .invalid-feedback.d-block= errors.email

          // ---------------- Expertise ----------------
          .card.mb-3.border-0.shadow-sm
            .card-header.bg-white
              h5.mb-0 Expertise *
            .card-body
              - var selectedExp = Array.isArray(values.Expertise) ? (values.Expertise[0] || '') : (values.Expertise || '')
              .form-group
                label.sr-only(for="expertise") Expertise
                select#expertise.form-control(name="Expertise" required)
                  option(value="") Select…
                  each item in expertiseList
                    option(value=item selected=(selectedExp===item))= item
                if errors.Expertise
                  .invalid-feedback.d-block= errors.Expertise

              .form-group.mt-3
                label(for="extraExpertise") Add more expertise (comma-separated)
                input#extraExpertise.form-control(type="text" name="extraExpertise" value=(values.extraExpertise || ''))
                small.form-text.text-muted You can type new expertise here (comma-separated). We'll add them even if not in the list.

          // ---------------- Actions ----------------
          .d-flex.justify-content-between.align-items-center.bg-white.py-3
            small.text-muted * Required fields
            .text-right
              a.btn.btn-light.mr-2(href="/facet/Online_Tutors") Cancel
              button.btn.btn-primary(type="submit") Save

  // 보조 스타일
  style.
    .card { border-radius: .75rem; }
    .card-header { border-bottom: 1px solid rgba(0,0,0,.05); }
    .form-control, .btn { border-radius: .6rem; }
    .validation-warning {
      background-color: #fff3cd;
      border: 1px solid #ffc107;
      color: #856404;
      padding: 8px 12px;
      border-radius: 4px;
      margin-top: 5px;
      font-size: 0.875rem;
      display: none;
    }

  script.
    // ===== English-only validation =====
    (function() {
      function containsNonEnglish(text) {
        // Detect: Korean, Chinese, Japanese, Emojis only
        const nonEnglishRegex = /[\u3000-\u303f\u3040-\u309f\u30a0-\u30ff\uff00-\uff9f\u4e00-\u9faf\u3400-\u4dbf\uac00-\ud7a3]|[\u{1F300}-\u{1F9FF}]|[\u2600-\u27BF]/u;
        
        if (nonEnglishRegex.test(text)) {
          return 'Non-English characters detected (Korean, Chinese, Japanese, or emojis)';
        }
        return null;
      }

      function showWarning(inputId, message) {
        let warning = document.getElementById(inputId + '-warning');
        if (!warning) {
          warning = document.createElement('div');
          warning.id = inputId + '-warning';
          warning.className = 'validation-warning';
          const input = document.getElementById(inputId);
          if (input && input.parentNode) {
            input.parentNode.insertBefore(warning, input.nextSibling);
          }
        }
        warning.textContent = '⚠️ ' + message + ' - Please use English only with standard punctuation.';
        warning.style.display = 'block';
      }

      function hideWarning(inputId) {
        const warning = document.getElementById(inputId + '-warning');
        if (warning) {
          warning.style.display = 'none';
        }
      }

      function validateField(inputId) {
        const input = document.getElementById(inputId);
        if (!input || !input.value) return true;
        
        const error = containsNonEnglish(input.value);
        if (error) {
          showWarning(inputId, error);
          return false;
        } else {
          hideWarning(inputId);
          return true;
        }
      }

      // Apply validation to text inputs
      const textFields = ['title', 'description', 'extraExpertise'];
      
      // Track validation state
      const fieldValidationState = {};
      textFields.forEach(f => { fieldValidationState[f] = true; });
      
      // Prevent focus on next fields if Title has errors
      function preventNextFieldFocus() {
        const titleValid = fieldValidationState['title'];
        const allFields = document.querySelectorAll('input, textarea, select, button');
        
        if (!titleValid) {
          const titleField = document.getElementById('title');
          if (!titleField) return;
          
          let foundTitle = false;
          allFields.forEach(field => {
            if (field === titleField) {
              foundTitle = true;
            } else if (foundTitle && field.id !== 'title') {
              field.addEventListener('mousedown', function(e) {
                if (!fieldValidationState['title']) {
                  e.preventDefault();
                  alert('⚠️ Please fix the Title field first!\n\nOnly English characters are allowed.');
                  document.getElementById('title').focus();
                }
              });
              
              field.addEventListener('focus', function(e) {
                if (!fieldValidationState['title']) {
                  e.preventDefault();
                  this.blur();
                  alert('⚠️ Please fix the Title field first!\n\nOnly English characters are allowed.');
                  document.getElementById('title').focus();
                }
              });
            }
          });
        }
      }
      
      textFields.forEach(fieldId => {
        const field = document.getElementById(fieldId);
        if (field) {
          field.addEventListener('blur', () => {
            const isValid = validateField(fieldId);
            fieldValidationState[fieldId] = isValid;
            if (fieldId === 'title') preventNextFieldFocus();
          });
          
          field.addEventListener('input', () => {
            if (document.getElementById(fieldId + '-warning')) {
              const isValid = validateField(fieldId);
              fieldValidationState[fieldId] = isValid;
              if (fieldId === 'title') preventNextFieldFocus();
            }
          });
        }
      });
      
      // Initial setup
      const titleField = document.getElementById('title');
      if (titleField && titleField.value) {
        const isValid = validateField('title');
        fieldValidationState['title'] = isValid;
        preventNextFieldFocus();
      }

      // Form submission validation
      const form = document.getElementById('tutorForm');
      if (form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          
          // Validate all text fields
          let hasErrors = false;
          let firstErrorField = null;
          
          textFields.forEach(fieldId => {
            if (!validateField(fieldId)) {
              hasErrors = true;
              if (!firstErrorField) {
                firstErrorField = fieldId;
              }
            }
          });

          if (hasErrors) {
            alert('⚠️ Non-English characters or emojis detected!\n\n' +
                  'Only English characters and standard punctuation are allowed.\n\n' +
                  'Please check: Title, Description, and Extra Expertise fields.');
            if (firstErrorField) {
              document.getElementById(firstErrorField)?.focus();
            }
            return false;
          }
          
          // If validation passes, submit
          const submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';
          }
          form.submit();
        });
      }
    })();

  // CKEditor (Classic)
  script(src="/vendor/ckeditor/ckeditor.js")
  script.
    (function () {
      if (window.CKEDITOR) {
        CKEDITOR.replace('description', {
          height: 260,
          removePlugins: 'elementspath',
          resize_enabled: false
        });
      }
    })();

  // 중복 제출 방지
  script.
    (function () {
      var form = document.getElementById('tutorForm');
      if (!form) return;
      var submitting = false;
      form.addEventListener('submit', function (e) {
        if (submitting) {
          e.preventDefault();
          return;
        }
        submitting = true;
        var btn = form.querySelector('button[type="submit"]');
        if (btn) {
          btn.disabled = true;
          btn.innerText = 'Saving...';
        }
      });
    })();
