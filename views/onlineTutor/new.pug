//- views/onlineTutor/new.pug (핵심만 교체)
extends ../layout

block content
  h1 New Online Tutor

  if errors && Object.keys(errors).length
    .alert.alert-danger
      ul
        each msg, key in errors
          li #{key}: #{msg}

  form#tutorForm(action="/online-tutors" method="POST")
    .form-group
      label(for="title") Title
      input#title.form-control(type="text" name="title" value=(values && values.title) || '')

    .form-group
      label(for="description") Description
      textarea#description.form-control(name="description") #{(values && values.description) || ''}

    .form-group
      label Expertise (pick at least one)
      .d-flex.flex-wrap
        each item in expertiseList
          - const checked = values && values.Expertise && values.Expertise.includes(item)
          .form-check.mr-3
            input.form-check-input(type="checkbox" id=`exp_${item}` name="Expertise" value=item checked=checked)
            label.form-check-label(for=`exp_${item}`)= item

    .form-group
      label(for="extraExpertise") Extra expertise (comma-separated)
      input#extraExpertise.form-control(type="text" name="extraExpertise" value=(values && values.extraExpertise) || '')

    .form-group
      label(for="Tutoring_Experience") Tutoring Experience
      select#Tutoring_Experience.form-control(name="Tutoring_Experience" required)
        option(value="") Select...
        each item in expList
          - const sel = values && values.Tutoring_Experience === item
          option(value=item selected=sel)= item

    .form-group
      label(for="Gender") Gender
      select#Gender.form-control(name="Gender" required)
        option(value="") Select...
        each g in genderList
          - const sel = values && values.Gender === g
          option(value=g selected=sel)= g

    .form-group
      label(for="email") Email (optional)
      input#email.form-control(type="email" name="email" value=(values && values.email) || '')

    button.btn.btn-primary(type="submit") Save
    a.btn.btn-secondary(href="/facet/Online_Tutors") Cancel
