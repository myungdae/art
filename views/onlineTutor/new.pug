//- views/onlineTutor/new.pug
extends ../layout

block content
  - var errors = (typeof errors === 'object' && errors) ? errors : {};
  - var values = (typeof values === 'object' && values) ? values : {};
  - var expertiseList = Array.isArray(expertiseList) ? expertiseList : ['Conversation','Grammar','BusinessEnglish','ExamPrep','TOEFL','IELTS','Kids','Pronunciation'];
  - var expList = Array.isArray(expList) ? expList : ['Beginner','Intermediate','Advanced','5+ years','10+ years'];
  - var genderList = Array.isArray(genderList) ? genderList : ['Male','Female','Other','Prefer not to say'];

  .container.my-5
    h2.text-center.mb-4 Create Tutor Profile

    .row.justify-content-center
      .col-lg-9

        if Object.keys(errors).length
          .alert.alert-danger
            strong Please fix the following:
            ul.mb-0.mt-2
              each msg, key in errors
                li #{msg}

        form#tutorForm(action="/online-tutors" method="POST" novalidate)
          // ---------------- Basic Info ----------------
          .card.mb-3.border-0.shadow-sm
            .card-header.bg-white
              h5.mb-0 Basic Info
            .card-body
              .form-group
                label(for="title") Title (optional)
                input#title.form-control(type="text" name="title" value=(values.title || '') placeholder="e.g., Friendly Online Tutor")

              .form-group
                label(for="description") Description
                textarea#description.form-control(name="description" rows="6" placeholder="Introduce yourself, experience, specialties…")= values.description || ''

              .form-row
                .form-group.col-md-6
                  label(for="tutoringExperience") Tutoring Experience *
                  select#tutoringExperience.form-control(name="Tutoring_Experience" required)
                    option(value="") Select…
                    each item in expList
                      option(value=item selected=(values.Tutoring_Experience===item))= item
                  if errors.Tutoring_Experience
                    .invalid-feedback.d-block= errors.Tutoring_Experience

                .form-group.col-md-6
                  label(for="gender") Gender *
                  select#gender.form-control(name="Gender" required)
                    option(value="") Select…
                    each item in genderList
                      option(value=item selected=(values.Gender===item))= item
                  if errors.Gender
                    .invalid-feedback.d-block= errors.Gender

              .form-group
                label(for="email") Contact Email *
                input#email.form-control(
                  type="email"
                  name="email"
                  required
                  value=(values.email || (session && session.user && session.user.email) || '')
                  placeholder="you@example.com"
                )
                if errors.email
                  .invalid-feedback.d-block= errors.email

          // ---------------- Expertise ----------------
          .card.mb-3.border-0.shadow-sm
            .card-header.bg-white
              h5.mb-0 Expertise *
            .card-body
              - var selectedExp = Array.isArray(values.Expertise) ? (values.Expertise[0] || '') : (values.Expertise || '')
              .form-group
                label.sr-only(for="expertise") Expertise
                select#expertise.form-control(name="Expertise" required)
                  option(value="") Select…
                  each item in expertiseList
                    option(value=item selected=(selectedExp===item))= item
                if errors.Expertise
                  .invalid-feedback.d-block= errors.Expertise

              .form-group.mt-3
                label(for="extraExpertise") Add more expertise (comma-separated)
                input#extraExpertise.form-control(type="text" name="extraExpertise" value=(values.extraExpertise || ''))
                small.form-text.text-muted You can type new expertise here (comma-separated). We'll add them even if not in the list.

          // ---------------- Actions ----------------
          .d-flex.justify-content-between.align-items-center.bg-white.py-3
            small.text-muted * Required fields
            .text-right
              a.btn.btn-light.mr-2(href="/facet/Online_Tutors") Cancel
              button.btn.btn-primary(type="submit") Save

  // 보조 스타일
  style.
    .card { border-radius: .75rem; }
    .card-header { border-bottom: 1px solid rgba(0,0,0,.05); }
    .form-control, .btn { border-radius: .6rem; }

  // CKEditor (Classic)
  script(src="/vendor/ckeditor/ckeditor.js")
  script.
    (function () {
      if (window.CKEDITOR) {
        CKEDITOR.replace('description', {
          height: 260,
          removePlugins: 'elementspath',
          resize_enabled: false
        });
      }
    })();

  // 중복 제출 방지
  script.
    (function () {
      var form = document.getElementById('tutorForm');
      if (!form) return;
      var submitting = false;
      form.addEventListener('submit', function (e) {
        if (submitting) {
          e.preventDefault();
          return;
        }
        submitting = true;
        var btn = form.querySelector('button[type="submit"]');
        if (btn) {
          btn.disabled = true;
          btn.innerText = 'Saving...';
        }
      });
    })();
