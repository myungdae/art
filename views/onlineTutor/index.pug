//- views/onlineTutor/index.pug (견고 폴백 버전)
extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-5(style="font-size: 2.2rem; font-weight: bold;") Online Tutors

    if tutors && tutors.length
      table.table.table-bordered.table-hover(style="font-size: 1.1rem;")
        thead
          tr
            th Name
            th Job Title
            th Expertise
            th Experience
            th Actions
        tbody
          each tutor in tutors
            //- -------- 폴백 계산 영역 --------
            - const _label     = (tutor && tutor._label) ? String(tutor._label).trim() : '';
            - const _title     = (tutor && tutor.title) ? String(tutor.title).trim() : '';
            - const _name      = (tutor && tutor.name) ? String(tutor.name).trim() : '';
            - const _jobTitle  = (tutor && tutor.jobTitle) ? String(tutor.jobTitle).trim() : '';
            - const nameText   = _label || _title || _name || _jobTitle || 'no title';
            - const jobTitleText = _title || _jobTitle || '—';

            - const expRawA  = (tutor && Array.isArray(tutor.Expertise)) ? tutor.Expertise : [];
            - const expRawB  = (tutor && Array.isArray(tutor.expertise)) ? tutor.expertise : [];
            - const expRawC  = (tutor && tutor.Expertise && !Array.isArray(tutor.Expertise)) ? [tutor.Expertise] : [];
            - const expRawD  = (tutor && tutor.expertise && !Array.isArray(tutor.expertise)) ? [tutor.expertise] : [];
            - const expMerged = [].concat(expRawA, expRawB, expRawC, expRawD).filter(Boolean);
            - const expertiseText = expMerged.length ? expMerged.join(', ') : '—';

            - const teachExpA = (tutor && tutor.Tutoring_Experience) ? String(tutor.Tutoring_Experience).trim() : '';
            - const teachExpB = (tutor && tutor.tutoringExperience) ? String(tutor.tutoringExperience).trim() : '';
            - const experienceText = teachExpA || teachExpB || '—';
            //- --------------------------------

            tr
              td
                a(href=`/rdf-resource/Online_Tutors/${tutor._id}`)= nameText
              td= jobTitleText
              td= expertiseText
              td= experienceText
              td
                a.btn.btn-outline-primary.btn-sm.me-1(href=`/rdf-resource/Online_Tutors/${tutor._id}`) View
                a.btn.btn-outline-secondary.btn-sm.me-1(href=`/online-tutors/${tutor._id}/edit`) Edit
                form.d-inline(method="POST", action=`/online-tutors/${tutor._id}?_method=DELETE`)
                  button.btn.btn-sm.btn-danger(type="submit", onclick="return confirm('Delete this tutor?')") Delete
    else
      p.text-muted.text-center.mt-4(style="font-size: 1.2rem;") No online tutors registered yet.

    .text-center.mt-5
      a.btn.btn-success(
        href="/online-tutors/new",
        style="font-size: 1.6rem; padding: 14px 28px; font-weight: bold; color: white;"
      ) ➕ Add New Tutor

