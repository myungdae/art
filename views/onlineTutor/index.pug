extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-5(style="font-size: 2.2rem; font-weight: bold;") Online Tutors

    if tutors.length
      table.table.table-bordered.table-hover(style="font-size: 1.1rem;")
        thead
          tr
            th Name
            th Job Title
            th Expertise
            th Experience
            th Actions
        tbody
          each tutor in tutors
            tr
              td #{tutor.name}
              td #{tutor.jobTitle || '—'}
              td #{(tutor.expertise || []).join(', ')}
              td #{tutor.tutoringExperience || '—'}
              td
                a.btn.btn-outline-primary.btn-sm.me-1(href=`/rdf-resource/Online_Tutors/${tutor._id}`) View
                a.btn.btn-outline-secondary.btn-sm.me-1(href=`/online-tutors/${tutor._id}/edit`) Edit
                form.d-inline(method="POST", action=`/online-tutors/${tutor._id}?_method=DELETE`)
                  button.btn.btn-sm.btn-danger(type="submit", onclick="return confirm('Delete this tutor?')") Delete
    else
      p.text-muted.text-center.mt-4(style="font-size: 1.2rem;") No online tutors registered yet.

    .text-center.mt-5
      a.btn.btn-success(
        href="/online-tutors/new",
        style="font-size: 1.6rem; padding: 14px 28px; font-weight: bold; color: white;"
      ) ➕ Add New Tutor
