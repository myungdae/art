extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-4 Edit Online Tutor

    form(method="POST", action=`/online-tutor/${tutor._id}?_method=PUT`)
      .form-group.mb-3
        label(for="name") Name
        input.form-control(type="text", name="name", value=tutor.name, required)

      .form-group.mb-3
        label(for="jobTitle") Job Title
        input.form-control(type="text", name="jobTitle", value=tutor.jobTitle)

      .form-group.mb-3
        label(for="description") Description
        textarea.form-control(name="description", rows="4")= tutor.description

      .form-group.mb-3
        label(for="gender") Gender
        select.form-control(name="gender")
          option(value="") -- Select --
          option(value="Male", selected=tutor.gender=='Male') Male
          option(value="Female", selected=tutor.gender=='Female') Female
          option(value="Other", selected=tutor.gender=='Other') Other

      .form-group.mb-3
        label Expertise (multiple)
        div
          input.form-check-input(type="checkbox", name="expertise", value="Grammar", checked=tutor.expertise.includes('Grammar'))
          | Grammar
        div
          input.form-check-input(type="checkbox", name="expertise", value="Speaking", checked=tutor.expertise.includes('Speaking'))
          | Speaking
        div
          input.form-check-input(type="checkbox", name="expertise", value="Writing", checked=tutor.expertise.includes('Writing'))
          | Writing

      .form-group.mb-3
        label(for="tutoringExperience") Tutoring Experience
        input.form-control(type="text", name="tutoringExperience", value=tutor.tutoringExperience)

      .form-group.mb-3
        label Communication Methods
        div
          input.form-check-input(type="checkbox", name="communicationMethods", value="Skype", checked=tutor.communicationMethods.includes('Skype'))
          | Skype
        div
          input.form-check-input(type="checkbox", name="communicationMethods", value="Zoom", checked=tutor.communicationMethods.includes('Zoom'))
          | Zoom
        div
          input.form-check-input(type="checkbox", name="communicationMethods", value="Email", checked=tutor.communicationMethods.includes('Email'))
          | Email

      .form-group.mb-3
        label(for="email") Email
        input.form-control(type="email", name="email", value=tutor.email)

      .form-group.mb-3
        label(for="skypeId") Skype ID
        input.form-control(type="text", name="skypeId", value=tutor.skypeId)

      .form-group.mb-3
        label(for="zoomId") Zoom ID
        input.form-control(type="text", name="zoomId", value=tutor.zoomId)

      .form-group.mb-3
        label(for="hourlyRate") Hourly Rate (USD)
        input.form-control(type="number", name="hourlyRate", value=tutor.hourlyRate, step="1")

      .form-group.mb-3
        label(for="availableFrom") Available From (Date)
        input.form-control(type="date", name="availableFrom", value=tutor.availableFrom.toISOString().substring(0, 10))

      .form-group.mb-3
        label(for="availableTime") Available Time
        input.form-control(type="text", name="availableTime", value=tutor.availableTime)

      .form-group.mb-4
        label(for="languagesSpoken") Languages Spoken (comma-separated)
        input.form-control(type="text", name="languagesSpoken", value=(tutor.languagesSpoken || []).join(', '))

      button.btn.btn-primary(type="submit") Update Tutor
      a.btn.btn-secondary.ms-2(href=`/online-tutor/${tutor._id}`) Cancel
