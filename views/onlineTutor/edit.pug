extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-10
        .card.shadow
          .card-header.bg-warning.text-white.text-center
            h4.mb-0 Edit Online Tutor

          .card-body
            form(method="POST", action=`/online-tutor/${tutor._id}?_method=PUT`, onsubmit="return handleCustomFields()")
              .form-group.mb-3
                label(for="name") Name
                input.form-control(type="text", name="name", required, value=tutor.name)

              .form-group.mb-3
                label(for="jobTitle") Job Title
                input.form-control(type="text", name="jobTitle", value=tutor.jobTitle)

              .form-group.mb-3
                label(for="description") Description
                textarea.form-control#editor(name="description", rows="4")= tutor.description

              // ✅ Gender
              .form-group.mb-3
                label(for="gender") Gender
                select.form-control#genderSelect(name="gender")
                  each v in genders
                    option(value=v selected=(tutor.gender === v ? 'selected' : false))= v
                small.text-muted.mt-1 You can also add a new gender:
                input.form-control.mt-1(type="text", id="customGender", placeholder="Or enter a new gender")

              // ✅ Expertise (checkbox)
              .form-group.mb-3
                label Expertise
                each v in expertises
                  div
                    input(type="checkbox", name="expertise", value=v, id=`expertise-${v}` checked=tutor.expertise.includes(v))
                    label(for=`expertise-${v}`)= v
                small.text-muted.mt-1 You can also add a new expertise:
                input.form-control.mt-1(type="text", id="customExpertise", placeholder="Or enter a new expertise")

              // ✅ Tutoring Experience
              .form-group.mb-3
                label(for="tutoringExperience") Tutoring Experience
                select.form-control#experienceSelect(name="tutoringExperience")
                  each v in tutoringExperiences
                    option(value=v selected=(tutor.tutoringExperience === v ? 'selected' : false))= v
                small.text-muted.mt-1 You can also add a new experience:
                input.form-control.mt-1(type="text", id="customExperience", placeholder="Or enter a new experience")

              // ✅ Communication Methods (checkbox)
              .form-group.mb-3
                label Communication Methods
                each v in communicationMethods
                  div
                    input(type="checkbox", name="communicationMethods", value=v, id=`comm-${v}` checked=tutor.communicationMethods.includes(v))
                    label(for=`comm-${v}`)= v
                small.text-muted.mt-1 You can also add a new method:
                input.form-control.mt-1(type="text", id="customCommunication", placeholder="Or enter a new method")

              // ✅ Language
              .form-group.mb-3
                label(for="language") Main Language
                select.form-control#languageSelect(name="language", required)
                  each v in languages
                    option(value=v selected=(tutor.language === v ? 'selected' : false))= v
                small.text-muted.mt-1 You can also add a new language:
                input.form-control.mt-1(type="text", id="customLanguage", placeholder="Or enter a new language")

              .form-group.mb-3
                label(for="email") Email
                input.form-control(type="email", name="email", value=tutor.email)

              .form-group.mb-3
                label(for="skypeId") Skype ID
                input.form-control(type="text", name="skypeId", value=tutor.skypeId)

              .form-group.mb-3
                label(for="zoomId") Zoom ID
                input.form-control(type="text", name="zoomId", value=tutor.zoomId)

              .form-group.mb-3
                label(for="hourlyRate") Hourly Rate (USD)
                input.form-control(type="number", name="hourlyRate", value=tutor.hourlyRate)

              .form-group.mb-3
                label(for="availableFrom") Available From
                - const formattedDate = tutor.availableFrom ? tutor.availableFrom.toISOString().substring(0, 10) : ''
                input.form-control(type="date", name="availableFrom", value=formattedDate)

              .form-group.mb-3
                label(for="availableTime") Available Time
                input.form-control(type="text", name="availableTime", value=tutor.availableTime)

              .form-group.mb-3
                label(for="languagesSpoken") Languages Spoken (comma-separated)
                input.form-control(type="text", name="languagesSpoken", value=tutor.languagesSpoken ? tutor.languagesSpoken.join(', ') : '')

              button.btn.btn-primary.mt-4(type="submit") Update Tutor
              a.btn.btn-secondary.ms-2(href="/online-tutor") Cancel

block append_js
  script.
    function handleCustomFields() {
      const form = document.querySelector('form');
      const customFields = [
        { id: 'customGender', selectId: 'genderSelect', name: 'gender' },
        { id: 'customExpertise', selectId: null, name: 'expertise' },
        { id: 'customExperience', selectId: 'experienceSelect', name: 'tutoringExperience' },
        { id: 'customCommunication', selectId: null, name: 'communicationMethods' },
        { id: 'customLanguage', selectId: 'languageSelect', name: 'language' }
      ];
      customFields.forEach(field => {
        const customValue = document.getElementById(field.id)?.value.trim();
        if (customValue) {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = field.name;
          input.value = customValue;
          form.appendChild(input);
          if (field.selectId) {
            const selectEl = document.getElementById(field.selectId);
            if (selectEl) selectEl.disabled = true;
          }
        }
      });
      return true;
    }

  script(src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js")
  script.
    CKEDITOR.replace('editor');
