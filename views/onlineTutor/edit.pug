extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-4 Edit Tutor Profile

    form(method="POST", action=`/online-tutor/${tutor._id}?_method=PUT`)
      .form-group.mb-3
        label(for="name") Name
        input.form-control(type="text", name="name", id="name", required, value=tutor.name)

      .form-group.mb-3
        label(for="jobTitle") Job Title
        input.form-control(type="text", name="jobTitle", id="jobTitle", value=tutor.jobTitle || '')

      .form-group.mb-3
        label(for="expertise") Expertise (comma-separated)
        input.form-control(type="text", name="expertise", id="expertise", value=(tutor.expertise || []).join(', '))

      .form-group.mb-3
        label(for="tutoringExperience") Experience Level
        select.form-control(name="tutoringExperience", id="tutoringExperience")
          - const levels = ['Beginner', 'Intermediate', 'Advanced', 'Expert']
          each level in levels
            option(value=level selected=(tutor.tutoringExperience === level)) #{level}

      .form-group.mb-3
        label(for="bio") Bio
        textarea.form-control(name="bio", id="bio", rows="5")= tutor.bio || ''

      .form-group.mb-3
        label(for="language") Language
        input.form-control(type="text", name="language", id="language", value=tutor.language || '')

      .form-group.mb-3
        label(for="location") Location
        input.form-control(type="text", name="location", id="location", value=tutor.location || '')

      .form-group.mb-3
        label(for="email") Contact Email
        input.form-control(type="email", name="email", id="email", required, value=tutor.email)

      .form-group.mb-3
        label(for="availableFrom") Available From (Date)
        - const availableFromValue = tutor.availableFrom ? new Date(tutor.availableFrom).toISOString().substring(0, 10) : ''
        input.form-control(type="date", name="availableFrom", id="availableFrom", value=availableFromValue)

      .form-group.mb-3
        label(for="availableTime") Available Time
        input.form-control(type="text", name="availableTime", id="availableTime", value=tutor.availableTime || '')

      .form-group.mb-4
        label(for="rate") Hourly Rate (USD)
        input.form-control(type="number", name="rate", id="rate", step="1", min="0", value=tutor.rate || '')

      .text-center
        button.btn.btn-primary(type="submit" style="padding: 10px 30px; font-size: 1.2rem;") ✅ Update Tutor Profile

    .text-center.mt-3
      a.btn.btn-outline-secondary(href="/online-tutor") ← Back to List
