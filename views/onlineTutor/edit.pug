//- views/onlineTutor/edit.pug
extends ../layout

block content
  - var errors = (typeof errors === 'object' && errors) ? errors : {};
  - var onlineTutor = (typeof onlineTutor === 'object' && onlineTutor) ? onlineTutor : {};
  - var expertiseList = Array.isArray(expertiseList) ? expertiseList : ['Conversation','Grammar','BusinessEnglish','ExamPrep','TOEFL','IELTS','Kids','Pronunciation'];
  - var expList = Array.isArray(expList) ? expList : ['Beginner','Intermediate','Advanced','5+ years','10+ years'];
  - var genderList = Array.isArray(genderList) ? genderList : ['Male','Female','Other','Prefer not to say'];

  .container.my-5
    h2.text-center.mb-4 Edit Tutor Profile

    .row.justify-content-center
      .col-lg-9
        if Object.keys(errors).length
          .alert.alert-danger
            strong Please fix the following:
            ul.mb-0.mt-2
              each msg, key in errors
                li #{msg}

        form#tutorForm(action=`/online-tutors/${onlineTutor._id || ''}` method="POST" novalidate)
          input(type="hidden" name="_method" value="PUT")

          .card.mb-3.border-0.shadow-sm
            .card-header.bg-white
              h5.mb-0 Basic Info
            .card-body
              .form-group
                label(for="title") Title (optional)
                input#title.form-control(type="text" name="title" value=onlineTutor.title || '')

              .form-group
                label(for="description") Description
                textarea#description.form-control(name="description" rows="5")= onlineTutor.description || ''

              .form-row
                .form-group.col-md-6
                  label(for="tutoringExperience") Tutoring Experience *
                  select#tutoringExperience.form-control(name="Tutoring_Experience" required)
                    option(value="") Select…
                    each item in expList
                      option(value=item selected=(onlineTutor.Tutoring_Experience===item))= item
                  if errors.Tutoring_Experience
                    .invalid-feedback.d-block= errors.Tutoring_Experience

                .form-group.col-md-6
                  label(for="gender") Gender *
                  select#gender.form-control(name="Gender" required)
                    option(value="") Select…
                    each item in genderList
                      option(value=item selected=(onlineTutor.Gender===item))= item
                  if errors.Gender
                    .invalid-feedback.d-block= errors.Gender

              .form-group
                label(for="email") Contact Email *
                input#email.form-control(
                  type="email"
                  name="email"
                  required
                  value=onlineTutor.email || (session && session.user && session.user.email) || ''
                  placeholder="you@example.com"
                )
                if errors.email
                  .invalid-feedback.d-block= errors.email

          .card.mb-3.border-0.shadow-sm
            .card-header.bg-white
              h5.mb-0 Expertise *
            .card-body
              .form-group
                each item, idx in expertiseList
                  - const checked = Array.isArray(onlineTutor.Expertise) && onlineTutor.Expertise.includes(item)
                  .form-check.mb-2
                    input.form-check-input(type="checkbox" id=`ex_${idx}` name="Expertise" value=item checked=checked)
                    label.form-check-label(for=`ex_${idx}`)= item
              if errors.Expertise
                .invalid-feedback.d-block.mt-2= errors.Expertise

              .form-group.mt-3
                label(for="extraExpertise") Add more expertise (comma-separated)
                input#extraExpertise.form-control(type="text" name="extraExpertise" value="")

          .d-flex.justify-content-between.align-items-center.bg-white.py-3
            small.text-muted * Required fields
            .text-right
              a.btn.btn-light.mr-2(href="/facet/Online_Tutors") Cancel
              button.btn.btn-primary(type="submit") Save changes

  style.
    .card-body .form-group{ max-height: 280px; overflow:auto; padding-right:.5rem; }

  script.
    (function(){
      var form = document.getElementById('tutorForm');
      if(!form) return;
      var submitting = false;
      form.addEventListener('submit', function(e){
        if(submitting){ e.preventDefault(); return; }
        submitting = true;
        var btn = form.querySelector('button[type="submit"]');
        if(btn){ btn.disabled = true; btn.innerText = 'Saving...'; }
      });
    })();
