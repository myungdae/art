extends ../layout

block content
  h2 Edit Online Tutor

  form(action=`/online-tutor/edit/${tutor._id}` method="post")
    label Name
    input(type="text" name="name" value=tutor.name)
    br

    label Nationality
    input(type="text" name="nationality" value=tutor.nationality)
    br

    label Gender
    input(type="text" name="gender" value=tutor.gender)
    br

    label Expertise (comma-separated)
    input(type="text" name="expertise" value=tutor.expertise.join(', '))
    br

    label Tutoring Experience
    input(type="text" name="tutoringExperience" value=tutor.tutoringExperience)
    br

    label Communication Methods (comma-separated)
    input(type="text" name="communicationMethods" value=tutor.communicationMethods.join(', '))
    br

    label Available Time
    input(type="text" name="availableTime" value=tutor.availableTime)
    br

    label Available From
    input(type="date" name="availableFrom" value=(tutor.availableFrom.toISOString().substring(0,10)))
    br

    button(type="submit") Update
