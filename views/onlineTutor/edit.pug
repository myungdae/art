extends ../layout

block content
  .container.mt-5
    h2.text-center.mb-4 Edit Online Tutor

    form(method="POST", action=`/online-tutor/${tutor._id}?_method=PUT`)
      .form-group.mb-3
        label(for="name") Name
        input.form-control(type="text", name="name", required, value=tutor.name)

      .form-group.mb-3
        label(for="jobTitle") Job Title
        input.form-control(type="text", name="jobTitle", value=tutor.jobTitle)

      .form-group.mb-3
        label(for="description") Description
        textarea.form-control(name="description")= tutor.description

      .form-group.mb-3
        label(for="gender") Gender
        select.form-control(name="gender")
          option(value="") Select Gender
          option(value="Male", selected=tutor.gender === 'Male') Male
          option(value="Female", selected=tutor.gender === 'Female') Female
          option(value="Other", selected=tutor.gender === 'Other') Other

      .form-group.mb-3
        label(for="expertise") Expertise (comma-separated)
        input.form-control(type="text", name="expertise", value=(tutor.expertise || []).join(', '))

      .form-group.mb-3
        label(for="tutoringExperience") Experience Level
        select.form-control(name="tutoringExperience")
          option(value="") Select Experience
          option(value="Beginner", selected=tutor.tutoringExperience === 'Beginner') Beginner
          option(value="Intermediate", selected=tutor.tutoringExperience === 'Intermediate') Intermediate
          option(value="Advanced", selected=tutor.tutoringExperience === 'Advanced') Advanced

      .form-group.mb-3
        label Communication Methods
        div
          label.me-2
            input(type="checkbox", name="communicationMethods", value="Skype", checked=(tutor.communicationMethods || []).includes("Skype"))
            | Skype
          label.me-2
            input(type="checkbox", name="communicationMethods", value="Zoom", checked=(tutor.communicationMethods || []).includes("Zoom"))
            | Zoom

      .form-group.mb-3
        label(for="email") Email
        input.form-control(type="email", name="email", value=tutor.email)

      .form-group.mb-3
        label(for="skypeId") Skype ID
        input.form-control(type="text", name="skypeId", value=tutor.skypeId)

      .form-group.mb-3
        label(for="zoomId") Zoom ID
        input.form-control(type="text", name="zoomId", value=tutor.zoomId)

      .form-group.mb-3
        label(for="hourlyRate") Hourly Rate (USD)
        input.form-control(type="number", name="hourlyRate", value=tutor.hourlyRate)

      .form-group.mb-3
        label(for="availableFrom") Available From (Date)
        - const dateValue = tutor.availableFrom ? new Date(tutor.availableFrom).toISOString().substring(0, 10) : ''
        input.form-control(type="date", name="availableFrom", value=dateValue)

      .form-group.mb-3
        label(for="availableTime") Available Time
        input.form-control(type="text", name="availableTime", value=tutor.availableTime)

      .form-group.mb-4
        label(for="languagesSpoken") Languages Spoken (comma-separated)
        input.form-control(type="text", name="languagesSpoken", value=(tutor.languagesSpoken || []).join(', '))

      .text-center
        button.btn.btn-primary.btn-lg(type="submit") ✅ Save Changes
        a.btn.btn-secondary.ms-3(href="/online-tutor") Cancel
