extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-8
        .card.shadow-lg(style="border: 2px solid #FF7A00;")
          .card-header.text-center(style="background-color: #FF7A00; color: white;")
            h2
              i.fas.fa-file-alt.me-2
              | Purchase Resume Access
          
          .card-body.p-4
            p.lead.text-center.mb-4
              | Get access to view job seekers' resumes
            
            .row.g-3
              each pkg in packages
                .col-md-4
                  .card.h-100.package-card(
                    data-package=pkg.value
                    data-price=pkg.price
                    style="cursor: pointer; border: 2px solid #ddd; transition: all 0.3s;"
                    class=preselectDays == pkg.days ? 'border-primary' : ''
                  )
                    .card-body.text-center
                      h5.card-title= pkg.label
                      h3.text-primary.my-3
                        | $#{pkg.price}
                      p.text-muted
                        small #{pkg.days} days access
                      
                      button.btn.btn-lg.mt-3(
                        type="button"
                        onclick=`openPaddleCheckout('${pkg.value}', ${pkg.price}, ${pkg.days})`
                        style="background-color: #FF7A00; border-color: #FF7A00; color: white; width: 100%;"
                      )
                        i.fas.fa-shopping-cart.me-2
                        | Select
            
            hr.my-4
            
            .alert.alert-info
              i.fas.fa-info-circle.me-2
              | Resume access allows you to view and contact job seekers directly.
            
            .text-center
              p.text-muted
                i.fas.fa-lock.me-1
                | Secure payment powered by Paddle
              p.mb-0
                a.btn.btn-outline-secondary(href="/user/mypage-employer")
                  i.fas.fa-arrow-left.me-2
                  | Back to My Page

  //- Paddle Script
  script(src=paddleEnvironment === 'sandbox' ? 'https://sandbox-cdn.paddle.com/paddle/v2/paddle.js' : 'https://cdn.paddle.com/paddle/v2/paddle.js')
  
  script.
    // Initialize Paddle
    if (typeof Paddle !== 'undefined') {
      Paddle.Environment.set('#{paddleEnvironment}');
      Paddle.Initialize({
        token: '#{process.env.PADDLE_CLIENT_TOKEN || "test_xxxxx"}'
      });
    }

    function openPaddleCheckout(planId, price, days) {
      if (typeof Paddle === 'undefined') {
        alert('Paddle is not loaded. Please refresh the page.');
        return;
      }

      const customData = {
        userId: '#{user._id}',
        type: 'resume',
        resumeDays: days,
        accessPeriod: days
      };

      Paddle.Checkout.open({
        items: [{
          priceId: 'pri_resume_' + planId, // 실제 Paddle Price ID로 교체 필요
          quantity: 1
        }],
        customData: customData,
        successCallback: function(data) {
          window.location.href = '/paddle/success?type=resume';
        }
      });
    }

    // 카드 hover 효과
    document.querySelectorAll('.package-card').forEach(card => {
      card.addEventListener('mouseenter', function() {
        this.style.borderColor = '#FF7A00';
        this.style.transform = 'translateY(-5px)';
        this.style.boxShadow = '0 10px 20px rgba(255, 122, 0, 0.2)';
      });
      card.addEventListener('mouseleave', function() {
        if (!this.classList.contains('border-primary')) {
          this.style.borderColor = '#ddd';
        }
        this.style.transform = 'translateY(0)';
        this.style.boxShadow = 'none';
      });
    });
