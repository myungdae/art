extends layout

block content
  .container.mt-5
    h2= doc['rdfs:label']?.['@value'] || doc['@id']
    p= doc['http://purl.org/dc/elements/1.1/description']?.['@value'] || 'No description available'
    
    if doc.resumeAccess
      ul
        li 📅 Start: #{new Date(doc.resumeAccess.startDate).toISOString().substring(0,10)}
        li ⏳ Duration: #{doc.resumeAccess.durationDays} days

    pre= JSON.stringify(doc, null, 2)
