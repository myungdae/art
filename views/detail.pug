extends layout

block content
  .container
    h2.mt-4.mb-3= item['rdfs:label']?.['@value'] || item['@id'] || 'No Title'
    p= item['http://purl.org/dc/elements/1.1/description']?.['@value'] || 'No description'

    if item.resumeAccess
      ul
        if item.resumeAccess.startDate
          li 📅 Start Date: #{new Date(item.resumeAccess.startDate).toISOString().substring(0,10)}
        if item.resumeAccess.durationDays
          li ⏳ Duration: #{item.resumeAccess.durationDays} days

    if item.hostCountry
      p Host Country: #{item.hostCountry}
    if item.studentType
      p Student Type: #{item.studentType}
    if item.teachingArea
      p Teaching Area: #{item.teachingArea}

    a.btn.btn-primary.mt-3(href='/facet/Job_Seekers') ← Back to List
