extends layout

block content
  .container.mt-5
    h2.mb-4.text-primary Inverse Relation Results for "#{value}"

    if data.length
      ul.list-group
        each job in data
          li.list-group-item
            a(href=`/resource/${encodeURIComponent(job['@id'].split('/').pop())}`)
              if job['http://www.w3.org/2000/01/rdf-schema#label'] && job['http://www.w3.org/2000/01/rdf-schema#label']['@value']
                = job['http://www.w3.org/2000/01/rdf-schema#label']['@value']
              else
                | Untitled
    else
      p.text-muted No related jobs found for "#{value}"
