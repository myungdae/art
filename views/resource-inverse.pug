extends layout

block content
  .container.mt-5
    if jobs.length
      h3.text-primary Related Jobs
      ul.list-group
        each job in jobs
          li.list-group-item
            a(href=`/resource/${encodeURIComponent(job['@id'].split('/').pop())}`)
              = job['http://www.w3.org/2000/01/rdf-schema#label'] && job['http://www.w3.org/2000/01/rdf-schema#label']['@value'] ? job['http://www.w3.org/2000/01/rdf-schema#label']['@value'] : 'Untitled'
    else
      p.text-muted No related jobs found.
