extends layout

block content
  .container.mt-4
    .row
      .col-md-3
        h3 Filters
        each filter in filters
          h4= filter.display
          ul.list-unstyled
            each opt in filter.options
              li
                a(
                  href=`?${filter.name}=${encodeURIComponent(opt.value)}`
                  class="text-decoration-none"
                )
                  | #{opt.label} (#{opt.count})

      .col-md-9
        if data && data.length
          each item in data
            .card.mb-3
              .card-body
                // 리소스명 링크
                a(
                  href=`/resource/${item['@id'].split('/').pop()}`
                  class="fw-bold text-primary"
                )
                  = item['@id'].split('/').pop()

                // Description만 출력
                if item['http://purl.org/dc/elements/1.1/description']
                  p.text-secondary= item['http://purl.org/dc/elements/1.1/description']['@value']
                else
                  p.text-muted No description available
        else
          p.text-muted No data found.
