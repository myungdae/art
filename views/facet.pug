extends layout

block content
  .container
    .row
      .col-md-3
        if filters && filters.length
          h3.mb-3 Facet Filters
          each filterGroup in filters
            h5.mt-3= filterGroup.name
            each option in filterGroup.options
              a.btn.btn-outline-secondary.btn-sm.mb-1(href=`?filter=${encodeURIComponent(option.value)}`)
                = option.label
                span.badge= option.count

      .col-md-9.d-flex.flex-wrap.justify-content-center
        if data.length
          each item in data
            - var title = (item['rdfs:label'] && item['rdfs:label']['@value']) ? item['rdfs:label']['@value'] : (item['@id'] || 'No Title');
            - var desc = (item.description && item.description['@value']) ? item.description['@value'] : 'No description';
            .card.mb-3.p-3(style="width: 18rem;")
              h4= title
              p= desc
              a.btn.btn-primary.mt-2(href=`/detail/${item._id}`) View Details
        else
          p.text-muted No records found.
