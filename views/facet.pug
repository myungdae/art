extends layout

block content
  h2.text-center.mb-4 Facet View
  p.text-center.text-muted Total records found: #{data.length}

  if data.length === 0
    p.text-center.text-danger No records found.
  else
    .container
      .row
        each item in data
          .col-md-6.col-lg-4.mb-4
            .card.p-3
              - var label = (item['rdfs:label'] && item['rdfs:label']['@value']) || item['@id'] || 'No Title';
              - var desc = (item['http://purl.org/dc/elements/1.1/description'] && item['http://purl.org/dc/elements/1.1/description']['@value']) || 'No description';

              h4= label
              p= desc

              if item.resumeAccess
                ul
                  li 📅 Start: #{new Date(item.resumeAccess.startDate).toISOString().substring(0,10)}
                  li ⏳ Duration: #{item.resumeAccess.durationDays} days
