extends layout

block content
  .container.mx-auto.px-4.py-8
    h2.text-2xl.font-bold.mb-6= facetType

    div(class="grid grid-cols-1 md:grid-cols-4 gap-8")
      // ✅ 필터 영역
      div.col-span-1#filters
        h4.mb-4.text-xl.font-semibold.text-gray-700 Filters
        form(method="GET", action=`/facet/${facetType}`)
          each facet in facetList
            if facet && facet.values && facet.values.length
              h5.mt-4.mb-2.text-md.font-semibold.text-gray-600= facet._id
              each val in facet.values
                div.flex.items-center.mb-1
                  - const checkboxId = `${facet._id}:${val.val}`
                  input(
                    type="checkbox",
                    name="filter",
                    id=checkboxId,
                    value=checkboxId,
                    checked=filter_item && filter_item.some(item => item.title === facet._id && item.value === val.val)
                  )
                  label(for=checkboxId class="ml-2 text-sm") #{val.val} (#{val.count})
          button(type="submit" class="mt-4 px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600") Apply Filters

      // ✅ 콘텐츠 카드 영역
      div.col-span-3
        if docs.length
          each doc in docs
            div(class="card shadow-md bg-white p-6 mb-6 rounded-lg transition transform hover:scale-105")
              h3.text-xl.font-semibold.text-blue-700.mb-2= doc._label || 'No Title'
              p.text-gray-700.mb-3!= doc._description || 'No description available.'

              - const fullId = doc._id;
              - const showLink = baseURI && fullId && fullId.startsWith(baseURI);
              - const safeId = showLink ? fullId.replace(baseURI, '') : null;

              if showLink && safeId
                a(
                  href='/resource/' + safeId,
                  class="text-blue-500 font-semibold hover:underline"
                ) → View Resource
              else
                span.text-gray-400 No valid link
        else
          p.text-gray-500.mt-6 No resources found.
