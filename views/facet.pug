extends layout

block content
  .container.mt-5
    h2.text-center.mb-4 #{facetType.replace(/_/g, ' ')}

    .row
      // ✅ 필터 영역
      .col-md-3
        h5.mb-3 Filters
        form(method='get', action='/facet/' + facetType)
          each facet in facetList
            .mb-3
              strong= facet._id
              each val in facet.values
                .form-check
                  input.form-check-input(type='checkbox', name='filter', value=facet._id + ':' + val.val, id=facet._id + '-' + val.val)
                  label.form-check-label(for=facet._id + '-' + val.val)= `${val.val} (${val.count})`
          button.btn.btn-sm.btn-primary.mt-3(type='submit') Apply Filters

      // ✅ 결과 영역
      .col-md-9
        if docs.length === 0
          .alert.alert-warning.text-center.mt-4 No results found for "#{facetType}"
        else
          each doc in docs
            .card.shadow-sm.mb-3.p-3
              h5.text-primary= doc[titleKey] || 'Untitled'
              p.mb-1.text-muted(style="font-size: 0.9rem")= doc[descriptionKey] || 'No description.'
              a(href=doc['@id'], target="_blank") View Resource →
