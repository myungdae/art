# baseURI: http://joseon-defense.eventpool.kr/ontology
# 출처: 이원승, 『전라병영성의 영웅과 보물들』(2025) + 조선시대 국방 온톨로지 v0.1

@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix jos: <http://joseon-defense.eventpool.kr/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix res: <http://joseon-defense.eventpool.kr/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://joseon-defense.eventpool.kr/ontology>
  rdf:type owl:Ontology ;
  dc:description "전라병영성과 조선시대 지방군사체계를 중심으로 한 Static Ontology — 이원승(2025) 자료 보강판"@ko ;
  rdfs:label "조선시대 국방 온톨로지 v0.2"@ko ;
.

