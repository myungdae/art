# ════════════════════════════════════════════
#  Object Properties
# ════════════════════════════════════════════

jos:WeaponDevelopedBy
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:WeaponSystem ;
  rdfs:label "무기체계가 개발되다"@ko ;
  rdfs:range jos:Person ;
  owl:inverseOf jos:developedWeapon ;
.
jos:againstEnemy
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:MilitaryEvent ;
  rdfs:label "적대세력을 상대하다"@ko ;
  rdfs:range jos:EnemyForce ;
.
jos:appointedBy
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:Commander ;
  rdfs:label "임명을 받다"@ko ;
  rdfs:range jos:King ;
  owl:inverseOf jos:appoints ;
.
jos:appoints
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:King ;
  rdfs:label "임명하다"@ko ;
  rdfs:range jos:Commander ;
  owl:inverseOf jos:appointedBy ;
.
jos:build
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:Person ;
  rdfs:label "축성/건립하다"@ko ;
  rdfs:range jos:MilitaryFacility ;
  owl:inverseOf jos:builtBy ;
.
jos:builtBy
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:MilitaryFacility ;
  rdfs:label "축성/건립 주도자"@ko ;
  rdfs:range jos:Person ;
  owl:inverseOf jos:build ;
.
jos:commandedBy
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:MilitaryOrganization ;
  rdfs:label "지휘를 받다"@ko ;
  rdfs:range jos:Commander ;
  owl:inverseOf jos:commands ;
.
jos:commands
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:Commander ;
  rdfs:label "지휘하다"@ko ;
  rdfs:range jos:MilitaryOrganization ;
  owl:inverseOf jos:commandedBy ;
.
jos:developedWeapon
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:Person ;
  rdfs:label "무기체계를 개발하다"@ko ;
  rdfs:range jos:WeaponSystem ;
  owl:inverseOf jos:WeaponDevelopedBy ;
.
jos:hasFacility
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:Fortress ;
  rdfs:label "군사시설을 갖다"@ko ;
  rdfs:range jos:MilitaryFacility ;
.
jos:hasHeadquarters
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:MilitaryOrganization ;
  rdfs:label "지휘부를 두다"@ko ;
  rdfs:range jos:CommandPost ;
.
jos:hasHeritage
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:Place ;
  rdfs:label "유산을 갖다"@ko ;
  rdfs:range jos:Heritage ;
.
jos:hasSubordinateCommand
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:CommandPost ;
  rdfs:label "예하 지휘부를 두다"@ko ;
  rdfs:range jos:CommandPost ;
.
jos:involvesForce
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:MilitaryEvent ;
  rdfs:label "군사조직이 관여하다"@ko ;
  rdfs:range jos:MilitaryOrganization ;
.
jos:occurredAt
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:MilitaryEvent ;
  rdfs:label "발생장소"@ko ;
  rdfs:range jos:Place ;
.
jos:participatedIn
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:Person ;
  rdfs:label "참전/참여하다"@ko ;
  rdfs:range jos:MilitaryEvent ;
.
jos:stationedAt
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:MilitaryOrganization ;
  rdfs:label "주둔하다"@ko ;
  rdfs:range jos:Place ;
.
jos:subordinateTo
  rdf:type owl:ObjectProperty ;
  rdfs:label "예속되다"@ko ;
  owl:inverseOf jos:hasSubordinateCommand ;
.
jos:usedInMilitaryEvent
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:WeaponSystem ;
  rdfs:label "군사이벤트에 사용되다"@ko ;
  rdfs:range jos:MilitaryEvent ;
  owl:inverseOf jos:usesWeapon ;
.
jos:usesWeapon
  rdf:type owl:ObjectProperty ;
  rdfs:domain jos:MilitaryEvent ;
  rdfs:label "무기체계를 사용하다"@ko ;
  rdfs:range jos:WeaponSystem ;
  owl:inverseOf jos:usedInMilitaryEvent ;
.

