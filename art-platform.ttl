res:Artwork_001
  rdf:type :Artwork ;
  :artworkTitle "어디서 무엇이 되어 다시 만나랴" ;
  :belongsToGenre res:Painting ;
  :belongsToStyle res:Dansaekhwa ;
  :createdBy res:Kim_Whanki ;
  :creationYear "1970"^^xsd:gYear ;
  :exhibitedIn res:ExampleExhibition ;
  :hasPriceRecord res:PriceRecord_001 ;
  :usesMaterial res:Canvas ;
  :usesMedium res:Oil ;
.
